<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="GVL_HMI" Id="{5828944f-83a4-4424-b97b-86bf15c25bfa}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    stCommands 				: ST_HmiCommands;
    stStatus 				: ST_HmiStatus;
    StatusHMI 				: ST_StatusBanner;
    astActiveEvents 		: ARRAY[0..50] OF ST_ActiveEvents;
    astEventsHistory 		: ARRAY[0..200] OF ST_EventsHistory;
    astTestHistory 			: ARRAY[0..2000] OF ST_TestHistory;
    stEventsAssigment 		: ST_EventsAssigmentGeneral;
    sSystemTime 			: STRING(255);
    sSystemDate 			: STRING(255);
    stStatistics 			: ST_HmiStatistics;
    bBlink_1Hz 				: BOOL;
    bHMIAlive 				: BOOL;
	bLogoutRequest 			: BOOL := FALSE;
	bLogoutFaultActive 		: BOOL := FALSE;
	uiTestHistoryWriteIndex : UINT := 0;
	uiTestHistoryCount 		: UINT := 0;
	// HMI logout diagnostics
	bHmiLogoutAutoCycle 	: BOOL := FALSE;
	bHmiLogoutStopped   	: BOOL := FALSE;
	bUnlockDoorVisible 		: BOOL  := FALSE; 
	bUnlockDoorPopupRequest : BOOL := FALSE;

    // Manual camera: 0 = no selection, 1..4 = image/program 0..3.
    udiCameraManualImageSelection : UDINT;
    bCameraManualTrigger : BOOL;
    bCameraManualAllowed : BOOL;
    bCameraConnected : BOOL;
    bCameraManualReady : BOOL;
    bCameraManualBusy : BOOL;
    bCameraManualPass : BOOL;
    bCameraManualFail : BOOL;
    udiCameraManualCaptureCount : UDINT;
    sCameraManualMessage : STRING(160);
    // Manual image preparation and explicit PBUP state confirmation.
    bVisionImagePrepare : BOOL;
    bVisionImageRelease : BOOL;
    bVisionImagePrepareAllowed : BOOL;
    bVisionImageReleaseAllowed : BOOL;
    bVisionImagePrepared : BOOL;
    bVisionImage1Allowed : BOOL;
    bVisionPbupFittedEdit : BOOL;
    bVisionPbupFittedApplied : BOOL;
    bVisionPbupConfirm : BOOL;
    bVisionPbupEditAllowed : BOOL;
    bVisionPbupReferenceKnown : BOOL;
    uiVisionPbupNest : UINT;
    sVisionPbupStatus : STRING(160);
    bVisionPbupSaveRequest : BOOL; // PLC-internal, not an HMI write command.
    bVisionPbupSaving : BOOL;
    bVisionPbupSaveError : BOOL;
    udiVisionPbupSaveErrorId : UDINT;
    sVisionPbupSaveStatus : STRING(160);
    stPatchProcessEdit : ST_PatchProcessSettings;
    stPatchProcessApplied : ST_PatchProcessSettings;
    bPatchSettingsApply : BOOL;
    bPatchSettingsCancel : BOOL;
    sPatchSettingsMessage : STRING(160);
    stVisionProcessEdit : ST_CameraProcessSettings;
    stVisionProcessApplied : ST_CameraProcessSettings;
    bVisionSettingsApply : BOOL;
    bVisionSettingsCancel : BOOL;
    sVisionSettingsMessage : STRING(160);
    bStationSettingsAllowed : BOOL;
    bStationSettingsSaving : BOOL;
    bStationSettingsSaveError : BOOL;
    udiStationSettingsSaveErrorId : UDINT;
    // Main-door head-temperature setting: edit/Apply boundary, not a TwinSAFE parameter.
    rSafetyDoorHotLimitEditC : REAL := 40.0;
    rSafetyDoorHotLimitAppliedC : REAL := 40.0;
    bSafetySettingsApply : BOOL;
    bSafetySettingsCancel : BOOL;
    bSafetySettingsAllowed : BOOL;
    sSafetySettingsMessage : STRING(160);
    // Read-only explanation of the existing manual Stake Patch permission.
    sHeatStakeManualStakeMessage : STRING(160);
    bVisionPickupFrontEdit : BOOL;
    bVisionPickupFrontApplied : BOOL;
    bCameraReset : BOOL; // One-shot local camera recovery; never triggers a capture.
    bCameraResetAllowed : BOOL;
END_VAR
VAR_GLOBAL CONSTANT
	// Colors
    sWHITE 					: STRING(40) := '{"color":"rgba(255,255,255,255)"}';
    sBLACK 					: STRING(40) := '{"color":"rgba(0,0,0,1)"}';
    sYELLOW 				: STRING(40) := '{"color":"rgba(255,255,0,1)"}';
    sGREEN 					: STRING(40) := '{"color":"rgba(70,166,63,1)"}';
	sORANGE 				: STRING(40) := '{"color":"rgba(232,107,23,1)"}';
    sRED 					: STRING(40) := '{"color":"rgba(255,0,0,1)"}';
    sBLUEInProgress 		: STRING(40) := '{"color":"rgba(54,100,221,1)"}';
    sGREY 					: STRING(40) := '{"color":"rgba(164,158,158,1)"}';
    sDARKGREY 				: STRING(40) := '{"color":"rgba(50,50,50,1)"}';
    sTRANSP 				: STRING(40) := '{"color":"rgba(255,255,255,0)"}';
    sREDFail 				: STRING(40) := '{"color":"rgba(244,68,68,255)"}';
	
	// System Info
    sSystemName 			: STRING := 'TM431-EP3R2/25 - Patch Press';
    sApplication 			: STRING := 'Patch Press Machine';
    sProjectID 				: STRING := 'TE1108';
    sSoftwareVersion 		: STRING := 'v0.1.0-foundation';
	sTwincat				: STRING := 'TwinCAT 3.1.4026.22';
	sTwincatHMI				: STRING := 'TE2000 v14.13.0';
	sHMIServer				: STRING := 'TF2000 v14.13.0';
	sSoftwareDate			: STRING := 'November 2026';
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>