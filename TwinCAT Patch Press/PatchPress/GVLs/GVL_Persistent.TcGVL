<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="GVL_Persistent" Id="{d2386cb0-572d-4679-ac47-58b48784a66e}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL PERSISTENT RETAIN
    astEventsHistory : ARRAY[0..200] OF ST_EventsHistory;
    stHeatStakeTemperatureSettings : ST_HeatStakeTemperatureSettings;
    stHeatStakeProcessSettings : ST_HeatStakeProcessSettings;

    // Persistent authority for the four index-table nest enable states.
    aNestEnabled : ARRAY[1..4] OF BOOL := [TRUE, TRUE, TRUE, TRUE];
	
	
	// =====================================================
	// TEST HISTORY
	// =====================================================
	
	// Circular buffer containing the last 2001 completed
	// product test results.
	//
	// Production Statistics reset does NOT modify this data.
	astTestHistory : ARRAY[0..2000] OF ST_TestHistory;
	
	// Next position to be written in the circular buffer.
	uiTestHistoryWriteIndex : UINT := 0;
	
	// Number of valid history entries currently available.
	// Saturates at 2001 when the buffer becomes full.
	uiTestHistoryCount : UINT := 0;


    // =====================================================
    // CSV - FINAL PRODUCT RESULT HANDOFF
    // =====================================================
    // Persistent handoff between Machine and PRG_CSV.

    stCSVPendingRecord : ST_CycleDataCSV;
    bCSVPendingRecord  : BOOL := FALSE;

    // CSV diagnostics
    bCSVQueueOverflow : BOOL := FALSE;
    udiCSVRecordsDropped : UDINT := 0;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>