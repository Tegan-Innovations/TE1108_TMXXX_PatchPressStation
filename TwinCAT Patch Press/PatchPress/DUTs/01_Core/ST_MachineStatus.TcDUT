<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_MachineStatus" Id="{ede7ab68-974c-4ea1-931a-df520c97456a}">
    <Declaration><![CDATA[TYPE ST_MachineStatus :
STRUCT
    eMachineState           : E_MachineState;
    eProcessCycleState      : E_CycleState;
    eIndexState             : E_IndexState;
    stIndexStatus           : ST_IndexStatus;
    stMainDoorLock          : ST_MainDoorLockStatus;
    eInitialisingWaitReason : E_InitialisingWaitReason;
    eStoppingWaitReason     : E_StoppingWaitReason;
    eOperatorExchangeState  : E_OperatorExchangeState;
    eOperatorInstruction    : E_OperatorInstruction;
    stOperatorStation       : ST_OperatorStationStatus;
    stPatchDispense         : ST_PatchStageStatus;
    stHeatStake             : ST_PatchStageStatus;
    stHeatStakeTemperature  : ST_HeatStakeTemperatureStatus;
    stHeatStakeProcess      : ST_HeatStakeProcessStatus;

    // Current physical nest located at each process station.
    // 0 = position unknown / nest mapping unavailable.
    uiPatchDispenseNestId    : UINT;
    uiHeatStakeNestId        : UINT;
    uiVisionNestId           : UINT;

    // Heat Stake Manual Mode permissives / diagnostics
    bHeatStakeManualEnableAllowed   : BOOL;
    bHeatStakeManualStakeAllowed    : BOOL;
    bHeatStakeManualUnlockAllowed   : BOOL;
    bHeatStakeManualLockAllowed     : BOOL;
    bHeatStakeManualHeadDownAllowed : BOOL;
    bHeatStakeManualHeadUpAllowed   : BOOL;
    bHeatStakeManualSupportAllowed  : BOOL;
    bHeatStakeManualActionBusy      : BOOL;
    bHeatStakeManualHeadUnlocked    : BOOL;

    stVision                : ST_PatchStageStatus;
    bReady                  : BOOL;
    bBusy                   : BOOL;
    bFaulted                : BOOL;
    bInitialisationTimeoutFault : BOOL;
    bStoppingTimeoutFault   : BOOL;
    bProcessCycleTimeoutFault : BOOL;
    bSafetyStopRequested    : BOOL;
    bSafetyRunRequested     : BOOL;
    bEventFault             : BOOL;
    bCycleStopRequested     : BOOL;
    bIndexPermissive        : BOOL;
    bEnableSetting          : BOOL;
    bAllStationsCommissioned: BOOL;
    bAutoCycleAllowed       : BOOL;
    bDisabledNestPartIndexBlocked : BOOL;
    bDisabledNestPartPopupRequest : BOOL;
    uiDisabledNestPartPopupNestId : UINT;
    // Reject chute full controlled-stop interlock.
    bRejectChuteFullLatched : BOOL;
    bRejectChutePopupRequest : BOOL;
    bRejectChuteStopRequest : BOOL;
    bRejectChuteResetBlocked : BOOL;
    // Heat Stake head cylinder diagnostics.
    bHeatStakeHeadUp : BOOL;
    bHeatStakeHeadDown : BOOL;
    bHeatStakeHeadDownTimeoutFault : BOOL;
    bHeatStakeHeadUpTimeoutFault : BOOL;
    bHeatStakeHeadSensorConflictFault : BOOL;
    stPermissives           : ST_MachinePermissives;
    stLastResult            : ST_ProcessResult;
    aNest                   : ARRAY[1..4] OF ST_Nest;
    aNestStatistics         : ARRAY[1..4] OF ST_NestStatistics;
    sMachineMessage         : STRING(160);
    sOperatorMessage        : STRING(255);
    sAutoCycleBlockReason   : STRING(160);
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>