<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_MachineCommand" Id="{2c23b498-612b-4807-9b9e-fd8aed679576}">
    <Declaration><![CDATA[TYPE ST_MachineCommand :
STRUCT
    bStart                : BOOL;
    bStop                 : BOOL;
    bReset                : BOOL;
    bManualRequest        : BOOL;
    bManualIndexForward   : BOOL;
    bManualIndexHome      : BOOL;
    bIndexerManualEnable  : BOOL;
    bManualMainDoorUnlock : BOOL;
    bAcknowledge          : BOOL;
    bAcknowledgePuckRemovalFault : BOOL;
	ePowerCmd : E_PLC_Power := E_PLC_Power.Idle;

    // Operator/nest light request from HMI.
    bOperatorLight        : BOOL;
	
	// =====================================================
	// Vision Manual Mode
	// =====================================================
	
	bVisionManualEnable                : BOOL;
	
	bVisionHorizontalBackRequest       : BOOL;
	bVisionHorizontalFrontRequest      : BOOL;
	
	bVisionVerticalUpRequest           : BOOL;
	bVisionVerticalIntermediateRequest : BOOL;
	bVisionVerticalFullDownRequest     : BOOL;
	
	bVisionGripOpenRequest             : BOOL;
	bVisionGripCloseRequest            : BOOL;
	
	bVisionRotate0Request              : BOOL;
	bVisionRotate180Request            : BOOL;
	
	bVisionSupportExtendRequest        : BOOL;
	bVisionManualRunSequence 		   : BOOL;
	bVisionManualHomeRequest 		   : BOOL;
	
    // Heat Stake Manual Mode
    bHeatStakeManualEnable        : BOOL;
    bHeatStakeManualStakePatch    : BOOL;
    bHeatStakeManualUnlock        : BOOL;
    bHeatStakeManualLock          : BOOL;
    bHeatStakeManualHeadDown      : BOOL;
    bHeatStakeManualHeadUp        : BOOL;
    bHeatStakeManualSupportUp     : BOOL;

    bAcknowledgeDisabledNestPartPopup : BOOL;
    bAcknowledgeRejectChuteFull : BOOL;
    uiResetStatisticsNestId : UINT;
	
	//camera
	
	
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>