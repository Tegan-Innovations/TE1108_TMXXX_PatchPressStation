<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_HeatStakeTemperatureSettings" Id="{2907f69b-5179-4b5c-980d-9151f1af054e}">
    <Declaration><![CDATA[TYPE ST_HeatStakeTemperatureSettings :
STRUCT
    rSetpointC              : LREAL := 80.0;
    rLowLimitC              : LREAL := 70.0;
    rHighLimitC             : LREAL := 90.0;
    rMaxTcDifferenceC       : LREAL := 10.0;

    tLowTemperatureTimeout  : TIME := T#5M;

    // Conservative initial tuning. FB_CTRL_PID is used with D disabled,
    // therefore the initial behaviour is PI.
    rKp                     : LREAL := 4.0;
    tTn                     : TIME := T#15S;
    tTv                     : TIME := T#0S;
    tTd                     : TIME := T#0S;

    tControllerCycle        : TIME := T#100MS;
    rOutputMinPercent       : LREAL := 0.0;
    rOutputMaxPercent       : LREAL := 100.0;

    // Warm-up boost: full power while the process is well below setpoint.
    // PID takes over once the PV reaches Setpoint - WarmupBoostDelta.
    bWarmupBoostEnabled      : BOOL := TRUE;
    rWarmupBoostDeltaC       : LREAL := 10.0;
    rWarmupBoostOutputPercent : LREAL := 100.0;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
