<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_PatchFeedSettings" Id="{8ff0b69c-10ea-461e-bce7-f564092e0db0}">
    <Declaration><![CDATA[TYPE ST_PatchFeedSettings :
STRUCT
    // Sensor-controlled travel; negative Waste Roll direction confirmed during commissioning.
    bWasteRollConfigured : BOOL := TRUE;
    eWasteRollDirection : MC_Direction := MC_Negative_Direction;
    lrWasteRollVelocity : LREAL := 50.0;
    lrPatchFeedRollVelocity : LREAL := 200.0;
    lrDriveMotorVelocity : LREAL := 40.0;
    // 0 selects the commissioned NC acceleration/deceleration/jerk.
    lrAcceleration : LREAL := 0.0;
    lrDeceleration : LREAL := 0.0;
    lrJerk : LREAL := 0.0;
    tPowerTimeout : TIME := T#5S;
    tStopTimeout : TIME := T#5S;
    // Initial engineering watchdog; validate against the real web mechanism.
    tWasteRollRunTimeout : TIME := T#30S;
    tPatchFeedRollRunTimeout : TIME := T#30S;
    // Physical Patch vertical sensors: Term19 Input9 UP / Input10 DOWN.
    bUsePatchVerticalFeedback : BOOL := TRUE;
    tPatchVerticalMoveTime : TIME := T#1S;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>