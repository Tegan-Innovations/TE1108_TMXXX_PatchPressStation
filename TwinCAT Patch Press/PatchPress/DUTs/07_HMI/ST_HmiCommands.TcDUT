<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_HmiCommands" Id="{cea0711c-b7bf-4958-9705-69290143acac}">
    <Declaration><![CDATA[TYPE ST_HmiCommands :
STRUCT
    bStart                 : BOOL;
    bStop                  : BOOL;
    bReset                 : BOOL;
    bAcknowledge           : BOOL;
    bManualRequest         : BOOL;
    bIndexerManualEnable   : BOOL;
    bManualIndexForward    : BOOL;
    bManualIndexHome       : BOOL;
    bManualMainDoorUnlock  : BOOL;

    // Main-screen operator/nest light toggle.
    // Physical output: Term 9 EL2809 Ch6 (bNestLight).
    bOperatorLight          : BOOL := TRUE;

    stHeatStakeTemperatureSettings : ST_HeatStakeTemperatureSettings;
    bApplyHeatStakeTemperatureSettings : BOOL;

    // Nest settings command buffer. Every change is persisted automatically.
    aNestEnabled : ARRAY[1..4] OF BOOL := [TRUE, TRUE, TRUE, TRUE];

    // Popup OK acknowledgement.
    bAcknowledgeDisabledNestPartPopup : BOOL;

    uiResetStatisticsNestId: UINT;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>