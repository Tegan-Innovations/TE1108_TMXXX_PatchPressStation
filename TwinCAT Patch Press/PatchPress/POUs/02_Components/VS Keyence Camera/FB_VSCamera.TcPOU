<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_VSCamera" Id="{328e316d-dc5d-43ae-96a6-2d990b1fabfb}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_VSCamera

VAR_INPUT
    // Separate mapped status words; existing camera DUT/layout is preserved.
    udiError0Code : UDINT;
    udiError1Code : UDINT;
    bResetRequest : BOOL;
END_VAR

VAR_OUTPUT
    aInspectionError0 : ARRAY[1..4] OF UDINT;
    aInspectionError1 : ARRAY[1..4] OF UDINT;
    bInspectionErrorLatched : BOOL;
    bRecoveryFailed : BOOL;
    sInspectionDiagnostic : STRING(120);
END_VAR

VAR_IN_OUT
	
	stCameraIO				: ST_VS_Keyence_Camera;

END_VAR

VAR
    // 0 = waiting/rearm; 10 = trigger awaiting ACK; 20 = accepted; 30 = aborted.
    usiTriggerHandshake : USINT;
    bTriggerRequestActive : BOOL;
    nTriggerProgram : UDINT;
    bDrainStaleResult : BOOL;
    sTriggerDiagnostic : STRING(120);
END_VAR

VAR
    stCapturedVisionResults : ST_VisionResults;
    bResultPending : BOOL;
    bResultAccepted : BOOL;
    bResultRead : BOOL;
    bResultCapturedForTrigger : BOOL;
    nResultProgram : UDINT;
    uiCapturedInspection : UINT;
END_VAR

VAR
    bRecoverInspection : BOOL;
    bInspectionFailureForTrigger : BOOL;
    bKnownInspectionError : BOOL;
    bClearError0 : BOOL;
    bClearError1 : BOOL;
    udiRecoveryError0 : UDINT;
    udiRecoveryError1 : UDINT;
    tonInspectionRecovery : TON;
    uiErrorIndex : UINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cyclic" Id="{938491e2-5bd3-452c-8578-e1ddfd9980c1}">
      <Declaration><![CDATA[METHOD Cyclic : BOOL

VAR
	

END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Cyclic := FALSE;
stCameraIO.abErrorClear[1] := FALSE;
stCameraIO.abErrorClear[2] := FALSE;
tonInspectionRecovery(
    IN := (bRecoverInspection OR (usiTriggerHandshake = 35)) AND bTriggerRequestActive,
    PT := T#2S
);

IF bResetRequest THEN
    bRecoverInspection := FALSE;
    bRecoveryFailed := FALSE;
    tonInspectionRecovery(IN := FALSE);
    RETURN;
END_IF

IF usiTriggerHandshake = 35 THEN
    // Never clear an unidentified error. Use the same bounded recovery budget.
    IF NOT stCameraIO.bRunStatus
        OR (stCameraIO.bCurrentProgramNumber <> nTriggerProgram)
        OR tonInspectionRecovery.Q
    THEN
        bRecoveryFailed := TRUE;
        usiTriggerHandshake := 30;
        sTriggerDiagnostic := 'Camera: capture error code unavailable/unsupported - check PLC error-code mapping';
    END_IF
    RETURN;
END_IF

IF bRecoverInspection THEN
    // Stop clearing on mode/program loss, a changed error, or recovery timeout.
    IF NOT stCameraIO.bRunStatus
        OR (stCameraIO.bCurrentProgramNumber <> nResultProgram)
        OR (stCameraIO.abError[1]
            AND (NOT bClearError0 OR (udiError0Code <> udiRecoveryError0)))
        OR (stCameraIO.abError[2]
            AND (NOT bClearError1 OR (udiError1Code <> udiRecoveryError1)))
        OR tonInspectionRecovery.Q
    THEN
        bRecoverInspection := FALSE;
        bRecoveryFailed := TRUE;
        usiTriggerHandshake := 30;
        sTriggerDiagnostic := 'Camera: inspection error recovery failed - intervention required';
    ELSE
        // One bounded clear operation; no reset, retrigger or program override.
        stCameraIO.abErrorClear[1] := bClearError0 AND stCameraIO.abError[1];
        stCameraIO.abErrorClear[2] := bClearError1 AND stCameraIO.abError[2];
        IF stCameraIO.bResultsReady THEN
            stCameraIO.bResultAck := TRUE;
        END_IF
        IF NOT stCameraIO.abError[1] AND NOT stCameraIO.abError[2]
            AND NOT stCameraIO.bResultsReady
            AND NOT stCameraIO.bTriggerAcknowledge
            AND stCameraIO.bTriggerReady
        THEN
            bRecoverInspection := FALSE;
            bResultAccepted := TRUE;
            usiTriggerHandshake := 20;
            sTriggerDiagnostic := 'Camera: recovered - failed inspection ready for PLC consumption';
        END_IF
    END_IF
    RETURN;
END_IF

IF bRecoveryFailed THEN RETURN; END_IF

// Capture payload in the same scan that observes an accepted result.
// The pending snapshot survives a falling raw Result Ready until PLC consumption.
IF stCameraIO.bResultsReady
    AND ((usiTriggerHandshake = 10) OR (usiTriggerHandshake = 20))
    AND NOT bResultCapturedForTrigger
    AND NOT bResultPending
    AND (stCameraIO.bCurrentProgramNumber = nTriggerProgram)
    AND (stCameraIO.bCurrentProgramNumber <= 3)
    AND stCameraIO.bRunStatus
    AND NOT stCameraIO.abError[1]
    AND NOT stCameraIO.abError[2]
THEN
stCapturedVisionResults.sDate 								:= GetDate();

IF stCameraIO.bCurrentProgramNumber = 0 THEN
	IF stCameraIO.bToolJudge[4] THEN
		stCapturedVisionResults.nClickPartPresent[1]		:= 1;
	ELSE stCapturedVisionResults.nClickPartPresent[1]		:= 2;
	END_IF
	IF stCameraIO.bToolJudge[2] THEN
		stCapturedVisionResults.nBottomPatchok				:= 1;
	ELSE stCapturedVisionResults.nBottomPatchok				:= 2;
	END_IF
	IF stCameraIO.bToolJudge[3] THEN
		stCapturedVisionResults.nTopPatchok					:= 1;
	ELSE stCapturedVisionResults.nTopPatchok				:= 2;
	END_IF


ELSIF stCameraIO.bCurrentProgramNumber = 1 THEN
	stCapturedVisionResults.sPatchNumber[1] 				:= GetBatchNumber();

ELSIF stCameraIO.bCurrentProgramNumber = 2 THEN
	stCapturedVisionResults.sDate 							:= GetDate();
	stCapturedVisionResults.sPatchNumber[2] 				:= GetBatchNumber();

	IF stCameraIO.bToolJudge[6] THEN
		stCapturedVisionResults.nClickPartPresent[2]		:= 1;
	ELSE stCapturedVisionResults.nClickPartPresent[2]		:= 2;
	END_IF
	IF stCameraIO.bToolJudge[1] THEN
		stCapturedVisionResults.nBluePartPresent			:= 1;
	ELSE stCapturedVisionResults.nBluePartPresent			:= 2;
	END_IF
ELSIF stCameraIO.bCurrentProgramNumber = 3 THEN
	IF stCameraIO.bToolJudge[1] THEN
		stCapturedVisionResults.nPBUBOK						:= 1;
	ELSE stCapturedVisionResults.nPBUBOK					:= 2;
	END_IF
	IF stCameraIO.bToolJudge[3] THEN
		stCapturedVisionResults.nPBUBMagnetOK				:= 1;
	ELSE stCapturedVisionResults.nPBUBMagnetOK					:= 2;
	END_IF

END_IF


    uiCapturedInspection := UDINT_TO_UINT(stCameraIO.bCurrentProgramNumber) + 1;
    // A transported result may still have an invalid/ambiguous judgment.
    stCapturedVisionResults.aInspectionCompleted[uiCapturedInspection] :=
        stCameraIO.bGeneralPass XOR stCameraIO.bGeneralFail;
    stCapturedVisionResults.aInspectionPassed[uiCapturedInspection] :=
        stCameraIO.bGeneralPass AND NOT stCameraIO.bGeneralFail;
    nResultProgram := stCameraIO.bCurrentProgramNumber;
    bResultPending := TRUE;
    bResultAccepted := (usiTriggerHandshake = 20);
    bResultRead := FALSE;
    bResultCapturedForTrigger := TRUE;
    Cyclic := TRUE;
END_IF

// ACK may be observed after a one-scan Result Ready pulse has already ended.
IF bResultPending
    AND (usiTriggerHandshake = 20)
    AND (stCameraIO.bCurrentProgramNumber = nResultProgram)
    AND stCameraIO.bRunStatus
    AND NOT stCameraIO.abError[1]
    AND NOT stCameraIO.abError[2]
THEN
    bResultAccepted := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetBatchNumber" Id="{04ffd5fb-1fed-4b6a-a133-5e444dfe15b1}">
      <Declaration><![CDATA[METHOD GetBatchNumber : STRING
VAR_INPUT
END_VAR
VAR
	
	asChar					: ARRAY [1..10] OF STRING;
	asReadStrings			: ARRAY [1..2] OF STRING;

END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
asChar[1] 								:= F_ToCHR( stCameraIO.byByteResults[28]);
asChar[2] 								:= F_ToCHR( stCameraIO.byByteResults[29]);
asChar[3] 								:= F_ToCHR( stCameraIO.byByteResults[30]);
asChar[4] 								:= F_ToCHR( stCameraIO.byByteResults[31]);

asReadStrings[1] 						:= 	CONCAT(STR1 := asChar[1], STR2 := CONCAT(STR1 := asChar[2], 
										CONCAT(STR1:= asChar[3], STR2 := asChar[4])));
			
asChar[5] 								:= F_ToCHR( stCameraIO.byByteResults[32]);
asChar[6] 								:= F_ToCHR( stCameraIO.byByteResults[33]);
asChar[7] 								:= F_ToCHR( stCameraIO.byByteResults[34]);
asChar[8] 								:= F_ToCHR( stCameraIO.byByteResults[35]);

asReadStrings[2] 						:= 	CONCAT(STR1 := asChar[5], STR2 := CONCAT(STR1 := asChar[6], 
										CONCAT(STR1:= asChar[7], STR2 := asChar[8])));
							
GetBatchNumber 							:= CONCAT(STR1 := asReadStrings[1], STR2 := asReadStrings[2]);	]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetCurrentProgram" Id="{0d7530fa-7ff4-4ef0-8969-8691a2248813}">
      <Declaration><![CDATA[METHOD GetCurrentProgram : UDINT
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetCurrentProgram    					:= stCameraIO.bCurrentProgramNumber;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetDate" Id="{8af8142e-1b68-481a-947a-21e5a4590817}">
      <Declaration><![CDATA[METHOD GetDate : STRING
VAR_INPUT
END_VAR
VAR
	
	asChar					: ARRAY [1..10] OF STRING;
	asReadStrings			: ARRAY [1..2] OF STRING;

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
asChar[1] 								:= F_ToCHR( stCameraIO.byByteResults[36]);
asChar[2] 								:= F_ToCHR( stCameraIO.byByteResults[37]);
asChar[3] 								:= F_ToCHR( stCameraIO.byByteResults[38]);
asChar[4] 								:= F_ToCHR( stCameraIO.byByteResults[39]);

asReadStrings[1] 						:= 	CONCAT(STR1 := asChar[1], STR2 := CONCAT(STR1 := asChar[2], 
										CONCAT(STR1:= asChar[3], STR2 := asChar[4])));
				
asChar[5] 								:= F_ToCHR( stCameraIO.byByteResults[40]);
asChar[6] 								:= F_ToCHR( stCameraIO.byByteResults[41]);
asChar[7] 								:= F_ToCHR( stCameraIO.byByteResults[42]);
asChar[8] 								:= F_ToCHR( stCameraIO.byByteResults[4]);

asReadStrings[2] 						:= 	CONCAT(STR1 := asChar[5], STR2 := CONCAT(STR1 := asChar[6], 
										CONCAT(STR1:= asChar[7], STR2 := asChar[8])));
				
GetDate									:= CONCAT(STR1 := asReadStrings[1], STR2 := asReadStrings[2]);	]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetResults" Id="{adc0f12e-de38-4d7e-b2cb-7165e465647b}">
      <Declaration><![CDATA[METHOD GetResults : BOOL
VAR_INPUT
	bResetResults				: BOOL;
 
END_VAR
VAR
    stEmptyVisionResults : ST_VisionResults;
    nInspection : INT;
END_VAR
VAR_OUTPUT
	stVisionResults				: ST_VisionResults;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bResetResults THEN
    stCapturedVisionResults := stEmptyVisionResults;
    FOR uiErrorIndex := 1 TO 4 DO
        aInspectionError0[uiErrorIndex] := 0;
        aInspectionError1[uiErrorIndex] := 0;
    END_FOR
    bInspectionErrorLatched := FALSE;
    sInspectionDiagnostic := '';
    bRecoverInspection := FALSE;
    bRecoveryFailed := FALSE;
    bInspectionFailureForTrigger := FALSE;
    tonInspectionRecovery(IN := FALSE);
    bResultPending := FALSE;
    bResultAccepted := FALSE;
    bResultRead := FALSE;
    bResultCapturedForTrigger := FALSE;
    nResultProgram := 0;
END_IF

// Return the snapshot, never re-read live camera data after Result Ready falls.
stVisionResults := stCapturedVisionResults;
GetResults := bResultPending;
IF bResultPending THEN
    bResultRead := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetResultsReady" Id="{9cbb4362-1746-498c-9239-edc22e263276}">
      <Declaration><![CDATA[METHOD PUBLIC GetResultsReady : BOOL
VAR_INPUT
END_VAR
VAR_OUTPUT
	
	ResultsReady				: BOOL;

END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Latched data readiness, not the duration of the raw Result Ready signal.
GetResultsReady :=
    bResultPending
    AND bResultAccepted
    AND (stCameraIO.bCurrentProgramNumber = nResultProgram)
    AND stCameraIO.bRunStatus
    AND NOT stCameraIO.abError[1]
    AND NOT stCameraIO.abError[2];
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsFaulted" Id="{0ac36af5-7e02-445f-b51f-a1f65d3c6e2b}">
      <Declaration><![CDATA[METHOD IsFaulted : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsFaulted := stCameraIO.abError[1] OR stCameraIO.abError[2]; ]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsRunning" Id="{6c695e0b-4665-4f4d-bf38-47bb423f51b7}">
      <Declaration><![CDATA[METHOD IsRunning : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsRunning						:= stCameraIO.bRunStatus;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestChangeProgram" Id="{b507ead6-9cbb-475e-9eb7-dc1f5cd995f7}">
      <Declaration><![CDATA[METHOD RequestChangeProgram : BOOL
VAR_INPUT
	
	nProgramNumber				: UDINT;	
	bEnable						: BOOL;

END_VAR

]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bEnable THEN
	
	IF stCameraIO.bCurrentProgramNumber <> nProgramNumber THEN
	
		stCameraIO.bProgramNumber_out 			:= nProgramNumber;
		stCameraIO.bProgramLoadExecute			:= TRUE;
	
	ELSE stCameraIO.bProgramLoadExecute			:= FALSE;
	END_IF

ELSE stCameraIO.bProgramLoadExecute			:= FALSE;


END_IF


]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestGoToConfig" Id="{70852fe4-8347-4cf1-8aff-87a468052393}">
      <Declaration><![CDATA[METHOD RequestGoToConfig : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stCameraIO.bGoToConfig			:= TRUE;
stCameraIO.bGoToConfig			:= FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestGoToRun" Id="{70e7fe61-5e50-44d7-b012-d85d95e970ad}">
      <Declaration><![CDATA[METHOD RequestGoToRun : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stCameraIO.bGoToRun := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestResultsAck" Id="{0102a543-2a50-470a-96ab-519c460d1ab9}">
      <Declaration><![CDATA[METHOD RequestResultsAck : BOOL
VAR_INPUT
	
	bEnable				: BOOL;

END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// A result left over before any trigger in the new request is stale.
// Drain it without reading/counting it as the new piece's inspection.
bDrainStaleResult :=
    bTriggerRequestActive
    AND (usiTriggerHandshake = 0)
    AND NOT bResultPending
    AND stCameraIO.bResultsReady;

IF bEnable OR bDrainStaleResult THEN
    stCameraIO.bResultAck := TRUE;
    IF bDrainStaleResult THEN
        sTriggerDiagnostic := 'Camera: clearing stale result before new trigger';
    END_IF
ELSIF NOT stCameraIO.bResultsReady THEN
    // Hold ACK until the camera has actually withdrawn Result Ready.
    stCameraIO.bResultAck := FALSE;
END_IF

// Release the software latch only after GetResults delivered the snapshot.
IF bEnable AND bResultPending AND bResultRead THEN
    bResultPending := FALSE;
    bResultAccepted := FALSE;
    bResultRead := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestTrigger" Id="{bee14638-6b9a-45ce-b2ef-ffa8ac3627c8}">
      <Declaration><![CDATA[METHOD RequestTrigger : BOOL

VAR_INPUT
	
	bEnable				:BOOL;

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[RequestTrigger := FALSE;
bTriggerRequestActive := bEnable;

IF bResetRequest THEN
    stCameraIO.bTrigger := FALSE;
    usiTriggerHandshake := 0;
    bRecoverInspection := FALSE;
    bRecoveryFailed := FALSE;
    bInspectionFailureForTrigger := FALSE;
    RETURN;
END_IF

IF NOT bEnable THEN
    bRecoverInspection := FALSE;
    bInspectionFailureForTrigger := FALSE;
    stCameraIO.bTrigger := FALSE;
    usiTriggerHandshake := 0;
    bResultCapturedForTrigger := FALSE;
    sTriggerDiagnostic := 'Camera: no trigger request';
    RETURN;
END_IF

// Only a new, identified tool-evaluation error from our accepted capture
// may become product FAIL. A pre-existing/unknown error is never auto-cleared.
bKnownInspectionError :=
    (stCameraIO.abError[1] OR stCameraIO.abError[2])
    AND (NOT stCameraIO.abError[1]
        OR (udiError0Code = 10130) OR (udiError0Code = 40008))
    AND (NOT stCameraIO.abError[2]
        OR (udiError1Code = 10130) OR (udiError1Code = 40008));

// Error status and assignable error code may be observed in different scans.
// Preserve an acknowledged capture while its numeric error is identified.
IF NOT bRecoverInspection AND NOT bRecoveryFailed
    AND NOT bInspectionFailureForTrigger
    AND ((usiTriggerHandshake = 20)
        OR ((usiTriggerHandshake = 10) AND stCameraIO.bTriggerAcknowledge))
    AND stCameraIO.bRunStatus
    AND (stCameraIO.bCurrentProgramNumber = nTriggerProgram)
    AND (nTriggerProgram <= 3)
    AND NOT bResultRead
    AND (stCameraIO.abError[1] OR stCameraIO.abError[2])
    AND NOT bKnownInspectionError
THEN
    usiTriggerHandshake := 35;
    bResultAccepted := FALSE;
    stCameraIO.bTrigger := FALSE;
    sTriggerDiagnostic := 'Camera: acknowledged capture error - waiting for numeric error code';
END_IF

IF NOT bRecoverInspection AND NOT bRecoveryFailed
    AND NOT bInspectionFailureForTrigger
    AND ((usiTriggerHandshake = 20) OR (usiTriggerHandshake = 35)
        OR ((usiTriggerHandshake = 10) AND stCameraIO.bTriggerAcknowledge))
    AND stCameraIO.bRunStatus
    AND (stCameraIO.bCurrentProgramNumber = nTriggerProgram)
    AND (nTriggerProgram <= 3)
    AND NOT bResultRead
    AND bKnownInspectionError
THEN
    uiCapturedInspection := UDINT_TO_UINT(nTriggerProgram) + 1;
    udiRecoveryError0 := 0;
    udiRecoveryError1 := 0;
    bClearError0 := stCameraIO.abError[1];
    bClearError1 := stCameraIO.abError[2];
    IF bClearError0 THEN udiRecoveryError0 := udiError0Code; END_IF
    IF bClearError1 THEN udiRecoveryError1 := udiError1Code; END_IF
    aInspectionError0[uiCapturedInspection] := udiRecoveryError0;
    aInspectionError1[uiCapturedInspection] := udiRecoveryError1;
    bInspectionErrorLatched := TRUE;
    sInspectionDiagnostic := CONCAT('Vision image ', UINT_TO_STRING(uiCapturedInspection));
    sInspectionDiagnostic := CONCAT(sInspectionDiagnostic, ' / program ');
    sInspectionDiagnostic := CONCAT(sInspectionDiagnostic, UDINT_TO_STRING(nTriggerProgram));
    sInspectionDiagnostic := CONCAT(sInspectionDiagnostic, ': evaluation error - product FAIL');

    // Retain earlier verdicts; never parse OCR/tool bits from an invalid image.
    stCapturedVisionResults.aInspectionCompleted[uiCapturedInspection] := TRUE;
    stCapturedVisionResults.aInspectionPassed[uiCapturedInspection] := FALSE;
    nResultProgram := nTriggerProgram;
    bResultPending := TRUE;
    bResultAccepted := FALSE;
    bResultRead := FALSE;
    bResultCapturedForTrigger := TRUE;
    bInspectionFailureForTrigger := TRUE;
    bRecoverInspection := TRUE;
    usiTriggerHandshake := 40;
END_IF

IF bRecoverInspection OR bRecoveryFailed OR (usiTriggerHandshake = 35) THEN
    stCameraIO.bTrigger := FALSE;
    // An acknowledged capture remains accepted during evaluation-error recovery.
    RequestTrigger := (usiTriggerHandshake = 35) OR bResultCapturedForTrigger;
    RETURN;
END_IF

CASE usiTriggerHandshake OF
    0:
        // Guarantee a low output scan even after an online change or interruption.
        IF stCameraIO.bTrigger THEN
            stCameraIO.bTrigger := FALSE;
            sTriggerDiagnostic := 'Camera: rearming trigger output';
        ELSIF NOT stCameraIO.bRunStatus THEN
            sTriggerDiagnostic := 'Camera: waiting for Run';
        ELSIF stCameraIO.abError[1] OR stCameraIO.abError[2] THEN
            sTriggerDiagnostic := 'Camera: error active - trigger inhibited';
        ELSIF bResultPending THEN
            sTriggerDiagnostic := 'Camera: waiting for PLC to consume captured result';
        ELSIF stCameraIO.bResultsReady OR stCameraIO.bResultAck THEN
            sTriggerDiagnostic := 'Camera: waiting for previous result handshake to clear';
        ELSIF stCameraIO.bProgramLoadExecute THEN
            sTriggerDiagnostic := 'Camera: waiting for program load request to clear';
        ELSIF stCameraIO.bTriggerAcknowledge THEN
            sTriggerDiagnostic := 'Camera: waiting for previous Trigger ACK to clear';
        ELSIF NOT stCameraIO.bTriggerReady THEN
            sTriggerDiagnostic := 'Camera: waiting for Trigger Ready';
        ELSE
            nTriggerProgram := stCameraIO.bCurrentProgramNumber;
            stCameraIO.bTrigger := TRUE;
            usiTriggerHandshake := 10;
            sTriggerDiagnostic := 'Camera: trigger sent - waiting for Trigger ACK';
        END_IF

    10:
        IF NOT stCameraIO.bRunStatus
            OR stCameraIO.abError[1] OR stCameraIO.abError[2]
            OR (stCameraIO.bCurrentProgramNumber <> nTriggerProgram)
        THEN
            stCameraIO.bTrigger := FALSE;
            usiTriggerHandshake := 30;
            bResultAccepted := FALSE;
            sTriggerDiagnostic := 'Camera: trigger aborted by Run/error/program change';
        ELSIF stCameraIO.bTriggerAcknowledge THEN
            stCameraIO.bTrigger := FALSE;
            usiTriggerHandshake := 20;
            RequestTrigger := TRUE;
            sTriggerDiagnostic := 'Camera: trigger accepted - waiting for result';
        ELSE
            // The request is held until the camera acknowledges it.
            stCameraIO.bTrigger := TRUE;
            sTriggerDiagnostic := 'Camera: trigger sent - waiting for Trigger ACK';
        END_IF

    20:
        // A sustained station request must not cause repeated captures.
        stCameraIO.bTrigger := FALSE;
        IF NOT stCameraIO.bRunStatus
            OR stCameraIO.abError[1] OR stCameraIO.abError[2]
            OR (stCameraIO.bCurrentProgramNumber <> nTriggerProgram)
        THEN
            usiTriggerHandshake := 30;
            bResultAccepted := FALSE;
            sTriggerDiagnostic := 'Camera: accepted capture invalidated by Run/error/program change';
        ELSE
            RequestTrigger := TRUE;
            IF bResultPending THEN
                sTriggerDiagnostic := 'Camera: captured result waiting for PLC read';
            ELSIF stCameraIO.bResultsReady THEN
                sTriggerDiagnostic := 'Camera: result available for accepted trigger';
            ELSE
                sTriggerDiagnostic := 'Camera: trigger accepted - waiting for result';
            END_IF
        END_IF

    30:
        // Do not retry an aborted capture until the station rearms its request.
        stCameraIO.bTrigger := FALSE;

    ELSE
        stCameraIO.bTrigger := FALSE;
        usiTriggerHandshake := 0;
        sTriggerDiagnostic := 'Camera: invalid trigger handshake - rearming';
END_CASE
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Reset" Id="{75f82180-9678-4791-a5b0-2123636c0831}">
      <Declaration><![CDATA[METHOD Reset : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
stCameraIO.bReset			:= TRUE;




stCameraIO.bReset			:= FALSE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
