<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_HeatStakeTemperatureControl" Id="{959a892b-dde4-4c09-a046-21eaa4bb5efe}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_HeatStakeTemperatureControl
VAR
    fbPid1 : FB_CTRL_PID;
    fbPid2 : FB_CTRL_PID;

    stPid1Params : ST_CTRL_PID_PARAMS;
    stPid2Params : ST_CTRL_PID_PARAMS;

    tonLowTemperatureFault : TON;
    tonDiscrepancyEnableDelay : TON;
    tonDiscrepancyStableDelay : TON;

    rTc1C : LREAL;
    rTc2C : LREAL;
    rTc3C : LREAL;
    rDifferenceC : LREAL;
    rAverageC : LREAL;

    rPidOut1 : LREAL;
    rPidOut2 : LREAL;

    // Dynamic temperature strategy:
    // HMI setpoint = required Heat Stake BODY temperature (TC3).
    // Heater PID setpoint is derived automatically from that process target.
    rBodySetpointC : LREAL;
    rHeaterWarmupMaxSetpointC : LREAL;
    rHeaterMaintenanceSetpointC : LREAL;
    rRampDownStartC : LREAL;
    rEffectiveHeaterSetpointC : LREAL;
    rHeaterSetpointUpperClampC : LREAL;
    bBodyTemperatureReady : BOOL;
    bHeaterInternalOverTemperature : BOOL;

    bHighTemperatureInternal : BOOL;
    bOverTemperatureInternal : BOOL;
    bDiscrepancyInternal : BOOL;
    bNormalDiscrepancySupervision : BOOL;
    bDiscrepancyStableWindow : BOOL;
    rActiveDiscrepancyLimitC : LREAL;
    bLowTemperatureInternal : BOOL;
    bControlAllowed : BOOL;

    ePidMode1 : E_CTRL_MODE;
    ePidMode2 : E_CTRL_MODE;
END_VAR

VAR CONSTANT
    // Fixed independent TC3 body overtemperature threshold.
    // TwinSAFE must use the same validated threshold.
    cSafeOverTempLimitC : LREAL := 320.0;

    // EL3314 screenshot / CoE Presentation = 1/10 °C.
    cTcScaleCPerDigit : LREAL := 0.1;

    // EL2502 signed/default presentation: 32767 = 100%.
    cPwmFullScale : LREAL := 32767.0;

    // Short enable filter for TC1/TC2 discrepancy supervision.
    cDiscrepancyEnableDelay : TIME := T#10S;

    // Dynamic discrepancy supervision:
    // warm-up uses a relaxed fixed limit, then normal configured supervision
    // is latched after the complete thermal system is stable for 30 s.
    cWarmupDiscrepancyLimitC : LREAL := 80.0;
    cDiscrepancyStableConfirmTime : TIME := T#30S;
    cStableHeadDeltaC : LREAL := 10.0;
    cStableHeaterDeltaC : LREAL := 15.0;

    // Dynamic heater setpoint strategy.
    // These are internal commissioning constants - no additional HMI inputs.
    cWarmupSetpointFactor : LREAL := 1.50;       // Body SP x 1.50
    cMaintenanceSetpointFactor : LREAL := 1.22;  // Body SP x 1.22
    cRampDownDeltaC : LREAL := 20.0;             // Start reducing heater SP at Body SP - 20 C

    // Independent internal cartridge-heater protection.
    // This is NOT the HMI High Limit. HMI Low/High Limits belong to TC3/head.
    cHeaterInternalHighLimitC : LREAL := 380.0;
    cHeaterSetpointMarginC : LREAL := 5.0;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cyclic" Id="{73a8a83a-3b5c-49fb-a066-6fda31dbdc27}">
      <Declaration><![CDATA[METHOD PUBLIC Cyclic
VAR_INPUT
    bEnable                 : BOOL;
    bAutoCycleActive        : BOOL;
    bSafetyOk               : BOOL;
    diTc1Raw                : DINT;
    diTc2Raw                : DINT;
    diTc3Raw                : DINT;
    stSettings              : ST_HeatStakeTemperatureSettings;
END_VAR
VAR_OUTPUT
    uiPwm1Raw               : UINT;
    uiPwm2Raw               : UINT;
    stStatus                : ST_HeatStakeTemperatureStatus;
END_VAR
VAR
    rOut1Limited : LREAL;
    rOut2Limited : LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// Engineering scaling from EL3314-0092.
rTc1C := DINT_TO_LREAL(diTc1Raw) * cTcScaleCPerDigit;
rTc2C := DINT_TO_LREAL(diTc2Raw) * cTcScaleCPerDigit;
rTc3C := DINT_TO_LREAL(diTc3Raw) * cTcScaleCPerDigit;

rAverageC := (rTc1C + rTc2C) * 0.5;
rDifferenceC := ABS(rTc1C - rTc2C);

// ============================================================================
// Dynamic Heat Stake temperature strategy
// ============================================================================
//
// The single HMI setpoint now represents the required BODY temperature (TC3).
// TC1 / TC2 remain the fast inner-loop feedbacks for the two cartridge heaters.
//
// Heater target strategy:
//   Warm-up target      = TC3 / Head process setpoint x 1.50
//   Maintenance target  = TC3 / Head process setpoint x 1.22
//   Ramp-down begins    = TC3 / Head setpoint - 20 C
//
// Example for Head SP = 137 C:
//   Warm-up target      = 205.5 C
//   Maintenance target  = 167.14 C
//   Ramp-down begins    = 117 C
//
// The HMI Low/High limits remain TC3/head PROCESS limits.
// The heater target is independently clamped below the internal 380 C
// cartridge-heater protection ceiling.
rBodySetpointC := stSettings.rSetpointC;
rRampDownStartC := rBodySetpointC - cRampDownDeltaC;

// HMI Low/High Limits are process limits for the Heat Stake BODY (TC3).
// They must not clamp the internal heater setpoint.
rHeaterSetpointUpperClampC :=
    cHeaterInternalHighLimitC - cHeaterSetpointMarginC;

rHeaterWarmupMaxSetpointC :=
    MIN(
        rBodySetpointC * cWarmupSetpointFactor,
        rHeaterSetpointUpperClampC
    );

rHeaterMaintenanceSetpointC :=
    MIN(
        rBodySetpointC * cMaintenanceSetpointFactor,
        rHeaterSetpointUpperClampC
    );

// Ensure the warm-up target can never end up below the maintenance target
// because of a tight configured High Limit.
IF rHeaterWarmupMaxSetpointC < rHeaterMaintenanceSetpointC THEN
    rHeaterWarmupMaxSetpointC := rHeaterMaintenanceSetpointC;
END_IF

// TC3 drives the outer thermal profile.
// Below HeadSP-20C, the heaters use the 1.50 warm-up target.
// Through the final 20C before TC3 reaches setpoint, the heater target is
// linearly reduced toward the 1.22 maintenance target.
// At and above TC3 setpoint, the maintenance target remains active.
IF rTc3C < rRampDownStartC THEN

    rEffectiveHeaterSetpointC := rHeaterWarmupMaxSetpointC;

ELSIF rTc3C < rBodySetpointC THEN

    rEffectiveHeaterSetpointC :=
        rHeaterWarmupMaxSetpointC
        -
        (
            (rTc3C - rRampDownStartC)
            /
            cRampDownDeltaC
        )
        *
        (
            rHeaterWarmupMaxSetpointC
            -
            rHeaterMaintenanceSetpointC
        );

ELSE

    rEffectiveHeaterSetpointC := rHeaterMaintenanceSetpointC;

END_IF

// TC3 is the process-facing temperature because it is mounted in the Heat
// Stake body which physically contacts the patch.
//
// HMI Low Limit / High Limit are therefore HEAD/BODY process limits.
bBodyTemperatureReady :=
    (rTc3C >= stSettings.rLowLimitC)
    AND (rTc3C <= stSettings.rHighLimitC);

bLowTemperatureInternal :=
    rTc3C < stSettings.rLowLimitC;

bHighTemperatureInternal :=
    rTc3C > stSettings.rHighLimitC;

// TC1 / TC2 have a separate fixed internal protection ceiling.
// This does not redefine the HMI process High Limit.
bHeaterInternalOverTemperature :=
    (rTc1C >= cHeaterInternalHighLimitC)
    OR (rTc2C >= cHeaterInternalHighLimitC);

// ============================================================================
// Dynamic TC1 / TC2 discrepancy supervision
// ============================================================================
//
// During warm-up the two cartridge heaters may ramp at different rates.
// A relaxed 80 C difference limit is therefore used initially.
//
// Normal supervision becomes active only after the complete thermal system
// remains close to steady state for 30 s:
//   TC3 >= Head SP - 10 C
//   TC1 >= Maintenance Heater Target - 15 C
//   TC2 >= Maintenance Heater Target - 15 C
//
// Once normal supervision is reached it remains latched until temperature
// control or Safety is removed. A later thermal excursion therefore cannot
// silently return the machine to the relaxed warm-up limit.

tonDiscrepancyEnableDelay(
    IN := bEnable AND bSafetyOk,
    PT := cDiscrepancyEnableDelay
);

bDiscrepancyStableWindow :=
    bEnable
    AND bSafetyOk
    AND (rTc3C >= (rBodySetpointC - cStableHeadDeltaC))
    AND (rTc1C >= (rHeaterMaintenanceSetpointC - cStableHeaterDeltaC))
    AND (rTc2C >= (rHeaterMaintenanceSetpointC - cStableHeaterDeltaC));

tonDiscrepancyStableDelay(
    IN := bDiscrepancyStableWindow
        AND NOT bNormalDiscrepancySupervision,
    PT := cDiscrepancyStableConfirmTime
);

IF NOT bEnable OR NOT bSafetyOk THEN
    bNormalDiscrepancySupervision := FALSE;
ELSIF tonDiscrepancyStableDelay.Q THEN
    bNormalDiscrepancySupervision := TRUE;
END_IF

IF bNormalDiscrepancySupervision THEN
    rActiveDiscrepancyLimitC := stSettings.rMaxTcDifferenceC;
ELSE
    rActiveDiscrepancyLimitC := cWarmupDiscrepancyLimitC;
END_IF

bDiscrepancyInternal :=
    tonDiscrepancyEnableDelay.Q
    AND (rDifferenceC > rActiveDiscrepancyLimitC);

// Independent overtemperature TC3. TwinSAFE SC must supervise this channel
// independently at the same fixed threshold.
bOverTemperatureInternal := rTc3C >= cSafeOverTempLimitC;

// In AutoCycle low temperature is a warning / index inhibit for 5 minutes,
// then escalates to Fault.
tonLowTemperatureFault(
    IN :=
        bAutoCycleActive
        AND bLowTemperatureInternal
        AND NOT bHighTemperatureInternal
        AND NOT bOverTemperatureInternal
        AND NOT bDiscrepancyInternal,
    PT := stSettings.tLowTemperatureTimeout
);

// Beckhoff Controller Toolbox parameters.
// Project PLC task = 10 ms; temperature loop defaults to 100 ms.
stPid1Params.tTaskCycleTime := T#10MS;
stPid1Params.tCtrlCycleTime := stSettings.tControllerCycle;
stPid1Params.fKp := stSettings.rKp;
stPid1Params.tTn := stSettings.tTn;
stPid1Params.tTv := stSettings.tTv;
stPid1Params.tTd := stSettings.tTd;
stPid1Params.fOutMaxLimit := stSettings.rOutputMaxPercent;
stPid1Params.fOutMinLimit := stSettings.rOutputMinPercent;
stPid1Params.bPInTheFeedbackPath := FALSE;
stPid1Params.bDInTheFeedbackPath := TRUE;
stPid1Params.bARWOnIPartOnly := FALSE;

stPid2Params.tTaskCycleTime := T#10MS;
stPid2Params.tCtrlCycleTime := stSettings.tControllerCycle;
stPid2Params.fKp := stSettings.rKp;
stPid2Params.tTn := stSettings.tTn;
stPid2Params.tTv := stSettings.tTv;
stPid2Params.tTd := stSettings.tTd;
stPid2Params.fOutMaxLimit := stSettings.rOutputMaxPercent;
stPid2Params.fOutMinLimit := stSettings.rOutputMinPercent;
stPid2Params.bPInTheFeedbackPath := FALSE;
stPid2Params.bDInTheFeedbackPath := TRUE;
stPid2Params.bARWOnIPartOnly := FALSE;

bControlAllowed :=
    bEnable
    AND bSafetyOk
    AND NOT bHighTemperatureInternal
    AND NOT bOverTemperatureInternal
    AND NOT bDiscrepancyInternal
    AND NOT tonLowTemperatureFault.Q;

// The legacy fixed-output Warm-up Boost has been removed.
// Warm-up is now performed exclusively by the TC3/body-temperature-derived
// heater setpoint profile above. Both PID controllers remain the only source
// of heater output, avoiding overlapping warm-up strategies.
IF bControlAllowed THEN
    ePidMode1 := eCTRL_MODE_ACTIVE;
    ePidMode2 := eCTRL_MODE_ACTIVE;
ELSE
    ePidMode1 := eCTRL_MODE_RESET;
    ePidMode2 := eCTRL_MODE_RESET;
END_IF

fbPid1(
    fSetpointValue := rEffectiveHeaterSetpointC,
    fActualValue := rTc1C,
    fManSyncValue := 0.0,
    bSync := FALSE,
    eMode := ePidMode1,
    bHold := FALSE,
    stParams := stPid1Params
);

fbPid2(
    fSetpointValue := rEffectiveHeaterSetpointC,
    fActualValue := rTc2C,
    fManSyncValue := 0.0,
    bSync := FALSE,
    eMode := ePidMode2,
    bHold := FALSE,
    stParams := stPid2Params
);

IF bControlAllowed AND NOT fbPid1.bError THEN
    rPidOut1 := fbPid1.fOut;
ELSE
    rPidOut1 := 0.0;
END_IF

IF bControlAllowed AND NOT fbPid2.bError THEN
    rPidOut2 := fbPid2.fOut;
ELSE
    rPidOut2 := 0.0;
END_IF

rOut1Limited := LIMIT(0.0, rPidOut1, 100.0);
rOut2Limited := LIMIT(0.0, rPidOut2, 100.0);

uiPwm1Raw := LREAL_TO_UINT((rOut1Limited / 100.0) * cPwmFullScale);
uiPwm2Raw := LREAL_TO_UINT((rOut2Limited / 100.0) * cPwmFullScale);

// Status.
stStatus.rHeater1TemperatureC := rTc1C;
stStatus.rHeater2TemperatureC := rTc2C;
stStatus.rOverTempTemperatureC := rTc3C;
stStatus.rAverageTemperatureC := rAverageC;
stStatus.rTemperatureDifferenceC := rDifferenceC;

stStatus.rHeater1OutputPercent := rOut1Limited;
stStatus.rHeater2OutputPercent := rOut2Limited;
stStatus.uiHeater1PwmRaw := uiPwm1Raw;
stStatus.uiHeater2PwmRaw := uiPwm2Raw;

stStatus.bControlEnabled := bControlAllowed;
stStatus.bHeating := (rOut1Limited > 0.1) OR (rOut2Limited > 0.1);

stStatus.bLowTemperature := bLowTemperatureInternal;
stStatus.bHighTemperature := bHighTemperatureInternal;
stStatus.bTemperatureDiscrepancy := bDiscrepancyInternal;
stStatus.bOverTemperature := bOverTemperatureInternal;
stStatus.bLowTemperatureTimeout := tonLowTemperatureFault.Q;
stStatus.bPid1Fault := fbPid1.bError;
stStatus.bPid2Fault := fbPid2.bError;

stStatus.bFault :=
    bHighTemperatureInternal
    OR bDiscrepancyInternal
    OR bOverTemperatureInternal
    OR tonLowTemperatureFault.Q
    OR fbPid1.bError
    OR fbPid2.bError;

stStatus.bAtTemperature :=
    bBodyTemperatureReady
    AND NOT bHighTemperatureInternal
    AND NOT bHeaterInternalOverTemperature
    AND NOT bDiscrepancyInternal
    AND NOT bOverTemperatureInternal
    AND NOT fbPid1.bError
    AND NOT fbPid2.bError;

stStatus.bIndexTemperatureReady := stStatus.bAtTemperature;

stStatus.rSetpointC := stSettings.rSetpointC;
stStatus.rLowLimitC := stSettings.rLowLimitC;
stStatus.rHighLimitC := stSettings.rHighLimitC;
stStatus.rMaxTcDifferenceC := stSettings.rMaxTcDifferenceC;
stStatus.rSafeOverTempLimitC := cSafeOverTempLimitC;
stStatus.tLowTemperatureElapsed := tonLowTemperatureFault.ET;

IF bOverTemperatureInternal THEN
    stStatus.sDiagnostic := 'Independent overtemperature thermocouple above safe limit';
ELSIF bHighTemperatureInternal THEN
    stStatus.sDiagnostic := 'Heat Stake process temperature above high limit';
ELSIF bDiscrepancyInternal AND bNormalDiscrepancySupervision THEN
    stStatus.sDiagnostic := 'Heat Stake thermocouple discrepancy - normal supervision';
ELSIF bDiscrepancyInternal THEN
    stStatus.sDiagnostic := 'Heat Stake thermocouple discrepancy - warm-up limit exceeded';
ELSIF tonLowTemperatureFault.Q THEN
    stStatus.sDiagnostic := 'Heat Stake low temperature timeout';
ELSIF fbPid1.bError OR fbPid2.bError THEN
    stStatus.sDiagnostic := 'Heat Stake PID controller fault';
ELSIF bHeaterInternalOverTemperature THEN
    stStatus.sDiagnostic := 'Heat Stake internal heater overtemperature';
ELSIF rTc3C < stSettings.rLowLimitC THEN
    stStatus.sDiagnostic := 'Heat Stake body warming up - below Low Limit';
ELSIF rTc3C > stSettings.rHighLimitC THEN
    stStatus.sDiagnostic := 'Heat Stake body above High Limit';
ELSIF stStatus.bAtTemperature THEN
    stStatus.sDiagnostic := 'Heat Stake body temperature ready';
ELSE
    stStatus.sDiagnostic := 'Heat Stake temperature control idle';
END_IF
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>