IF bGood THEN stStatus.aBlocks[19].sState := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),2)); ELSE stStatus.aBlocks[19].sState := 'Unavailable'; END_IF;
35:
IF bGood THEN stStatus.aBlocks[20].sState := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),2)); ELSE stStatus.aBlocks[20].sState := 'Unavailable'; END_IF;
36:
IF bGood THEN stStatus.aBlocks[21].sState := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),2)); ELSE stStatus.aBlocks[21].sState := 'Unavailable'; END_IF;
37:
IF bGood THEN stStatus.aBlocks[22].sState := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),2)); ELSE stStatus.aBlocks[22].sState := 'Unavailable'; END_IF;
38:
IF bGood THEN stStatus.aBlocks[23].sState := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),2)); ELSE stStatus.aBlocks[23].sState := 'Unavailable'; END_IF;
39:
IF bGood THEN stStatus.aBlocks[24].sState := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),2)); ELSE stStatus.aBlocks[24].sState := 'Unavailable'; END_IF;
40:
IF bGood THEN stStatus.aBlocks[1].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[1].sDiagnostic := 'Unavailable'; END_IF;
41:
IF bGood THEN stStatus.aBlocks[2].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[2].sDiagnostic := 'Unavailable'; END_IF;
42:
IF bGood THEN stStatus.aBlocks[3].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[3].sDiagnostic := 'Unavailable'; END_IF;
43:
IF bGood THEN stStatus.aBlocks[4].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[4].sDiagnostic := 'Unavailable'; END_IF;
44:
IF bGood THEN stStatus.aBlocks[5].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[5].sDiagnostic := 'Unavailable'; END_IF;
45:
IF bGood THEN stStatus.aBlocks[6].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[6].sDiagnostic := 'Unavailable'; END_IF;
46:
IF bGood THEN stStatus.aBlocks[7].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[7].sDiagnostic := 'Unavailable'; END_IF;
47:
IF bGood THEN stStatus.aBlocks[8].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[8].sDiagnostic := 'Unavailable'; END_IF;
48:
IF bGood THEN stStatus.aBlocks[9].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[9].sDiagnostic := 'Unavailable'; END_IF;
49:
IF bGood THEN stStatus.aBlocks[10].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[10].sDiagnostic := 'Unavailable'; END_IF;
50:
IF bGood THEN stStatus.aBlocks[11].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[11].sDiagnostic := 'Unavailable'; END_IF;
51:
IF bGood THEN stStatus.aBlocks[12].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[12].sDiagnostic := 'Unavailable'; END_IF;
52:
IF bGood THEN stStatus.aBlocks[13].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[13].sDiagnostic := 'Unavailable'; END_IF;
53:
IF bGood THEN stStatus.aBlocks[14].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[14].sDiagnostic := 'Unavailable'; END_IF;
54:
IF bGood THEN stStatus.aBlocks[15].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[15].sDiagnostic := 'Unavailable'; END_IF;
55:
IF bGood THEN stStatus.aBlocks[16].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[16].sDiagnostic := 'Unavailable'; END_IF;
56:
IF bGood THEN stStatus.aBlocks[17].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[17].sDiagnostic := 'Unavailable'; END_IF;
57:
IF bGood THEN stStatus.aBlocks[18].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[18].sDiagnostic := 'Unavailable'; END_IF;
58:
IF bGood THEN stStatus.aBlocks[19].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[19].sDiagnostic := 'Unavailable'; END_IF;
59:
IF bGood THEN stStatus.aBlocks[20].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[20].sDiagnostic := 'Unavailable'; END_IF;
60:
IF bGood THEN stStatus.aBlocks[21].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[21].sDiagnostic := 'Unavailable'; END_IF;
61:
IF bGood THEN stStatus.aBlocks[22].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[22].sDiagnostic := 'Unavailable'; END_IF;
62:
IF bGood THEN stStatus.aBlocks[23].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[23].sDiagnostic := 'Unavailable'; END_IF;
63:
IF bGood THEN stStatus.aBlocks[24].sDiagnostic := CONCAT('0x', F_EL6910Hex(UDINT_TO_ULINT(udiRaw),4)); ELSE stStatus.aBlocks[24].sDiagnostic := 'Unavailable'; END_IF;
64:
IF bGood AND (aBuffer[0] <= 64) THEN usiCapacity := aBuffer[0]; ELSE usiCapacity := 0; END_IF
bHistorySweepOk := bGood;;
65:
IF bGood THEN usiNewest := aBuffer[0]; ELSE usiNewest := 0; END_IF
bHistorySweepOk := bHistorySweepOk AND bGood;;
66:
IF bSkip THEN
    aHistoryPending[1].sSeverity := '';
    aHistoryPending[1].sTimestamp := '';
    aHistoryPending[1].sMessage := '';
    aHistoryPending[1].sDetail := '';
ELSIF bGood THEN
    aHistoryPending[1] := F_EL6910DecodeMessage(aBuffer,fbRead.cbRead);
ELSE
    bHistorySweepOk := FALSE;
END_IF;
67:
IF bSkip THEN
    aHistoryPending[2].sSeverity := '';
    aHistoryPending[2].sTimestamp := '';
    aHistoryPending[2].sMessage := '';
    aHistoryPending[2].sDetail := '';
ELSIF bGood THEN
    aHistoryPending[2] := F_EL6910DecodeMessage(aBuffer,fbRead.cbRead);
ELSE
    bHistorySweepOk := FALSE;
END_IF;
68:
IF bSkip THEN
    aHistoryPending[3].sSeverity := '';
    aHistoryPending[3].sTimestamp := '';
    aHistoryPending[3].sMessage := '';
    aHistoryPending[3].sDetail := '';
ELSIF bGood THEN
    aHistoryPending[3] := F_EL6910DecodeMessage(aBuffer,fbRead.cbRead);
ELSE
    bHistorySweepOk := FALSE;
END_IF;
69:
IF bSkip THEN
    aHistoryPending[4].sSeverity := '';
    aHistoryPending[4].sTimestamp := '';
    aHistoryPending[4].sMessage := '';
    aHistoryPending[4].sDetail := '';
ELSIF bGood THEN
    aHistoryPending[4] := F_EL6910DecodeMessage(aBuffer,fbRead.cbRead);
ELSE
    bHistorySweepOk := FALSE;
END_IF;
70:
IF bSkip THEN
    aHistoryPending[5].sSeverity := '';
    aHistoryPending[5].sTimestamp := '';
    aHistoryPending[5].sMessage := '';
    aHistoryPending[5].sDetail := '';
ELSIF bGood THEN
    aHistoryPending[5] := F_EL6910DecodeMessage(aBuffer,fbRead.cbRead);
ELSE
    bHistorySweepOk := FALSE;
END_IF;
71:
IF bSkip THEN
    aHistoryPending[6].sSeverity := '';
    aHistoryPending[6].sTimestamp := '';
    aHistoryPending[6].sMessage := '';
    aHistoryPending[6].sDetail := '';
ELSIF bGood THEN
    aHistoryPending[6] := F_EL6910DecodeMessage(aBuffer,fbRead.cbRead);
ELSE
    bHistorySweepOk := FALSE;
END_IF;
72:
IF bSkip THEN
    aHistoryPending[7].sSeverity := '';
    aHistoryPending[7].sTimestamp := '';
    aHistoryPending[7].sMessage := '';
    aHistoryPending[7].sDetail := '';
ELSIF bGood THEN
    aHistoryPending[7] := F_EL6910DecodeMessage(aBuffer,fbRead.cbRead);
ELSE
    bHistorySweepOk := FALSE;
END_IF;
73:
IF bSkip THEN
    aHistoryPending[8].sSeverity := '';
    aHistoryPending[8].sTimestamp := '';
    aHistoryPending[8].sMessage := '';
    aHistoryPending[8].sDetail := '';
ELSIF bGood THEN
    aHistoryPending[8] := F_EL6910DecodeMessage(aBuffer,fbRead.cbRead);
ELSE
    bHistorySweepOk := FALSE;
END_IF;
74:
IF bHistorySweepOk AND bGood AND (aBuffer[0] = usiNewest) THEN
    stStatus.aHistory := aHistoryPending;
    IF usiNewest = 0 THEN stStatus.sHistoryStatus := 'No stored diagnostics';
    ELSE stStatus.sHistoryStatus := 'Latest 8 stored records (historical, not active alarms)'; END_IF
    bHistoryPublished := TRUE;
ELSE
    stStatus.sHistoryStatus := 'History unavailable or changed during read - retrying';
    bHistoryPublished := FALSE;
END_IF;
        END_CASE
        IF NOT bGood AND NOT bSkip THEN
            bSweepHadError := TRUE;
            stStatus.sReaderStatus := CONCAT(CONCAT('Read unavailable at 0x',F_EL6910Hex(WORD_TO_ULINT(wIndex),4)),CONCAT(':',F_EL6910Hex(BYTE_TO_ULINT(bySub),2)));
            stStatus.sReaderStatus := CONCAT(stStatus.sReaderStatus,CONCAT(' / ADS ',UDINT_TO_STRING(fbRead.nErrId)));
        END_IF
    END_IF
    uiJob := uiJob + 1;
    IF uiJob >= 75 THEN
        uiJob := 0;
        bSweepFinished := TRUE;
        IF bEnable THEN
        IF bSweepHadError THEN stStatus.sReaderStatus := 'Partial diagnostics - unavailable/unsupported fields are marked';
        ELSE stStatus.sReaderStatus := 'Read-only CoE diagnostics - last sweep complete'; END_IF
        END_IF
        bSweepHadError := FALSE;
    END_IF
    usiPhase := 0;
END_IF
// Each field is displayed only after its own read succeeds. No inferred safe state.
FOR i := 1 TO 6 DO
    IF (stStatus.aConnections[i].sState = '') OR (stStatus.aConnections[i].sDiagnostic = '')
        OR (stStatus.aConnections[i].sState = 'Unavailable') OR (stStatus.aConnections[i].sDiagnostic = 'Unavailable') THEN
        stStatus.aConnections[i].sQuality := 'Unavailable / pending';
    ELSE stStatus.aConnections[i].sQuality := 'Read'; END_IF
END_FOR
FOR i := 1 TO 24 DO
    IF (stStatus.aBlocks[i].sState = '') OR (stStatus.aBlocks[i].sDiagnostic = '')
        OR (stStatus.aBlocks[i].sState = 'Unavailable') OR (stStatus.aBlocks[i].sDiagnostic = 'Unavailable') THEN
        stStatus.aBlocks[i].sQuality := 'Unavailable / pending';
    ELSE stStatus.aBlocks[i].sQuality := 'Read'; END_IF
END_FOR
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>