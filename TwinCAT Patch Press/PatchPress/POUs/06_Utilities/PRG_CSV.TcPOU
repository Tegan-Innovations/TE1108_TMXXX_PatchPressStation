<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="PRG_CSV" Id="{6490c777-af82-4db6-9a89-0aafd490d054}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_CSV
VAR
    // =====================================================
    // CSV WRITER
    // =====================================================
    fbCSVWriter : FB_CSVWriter;

    // =====================================================
    // CSV CONFIGURATION
    // =====================================================
    sCSVFolderPath : STRING(255) :=
        'C:\Users\Administrator\Desktop\csv';



    // =====================================================
    // CSV RECORD QUEUE
    // =====================================================
    aCSVQueue : ARRAY[0..99] OF ST_CycleDataCSV;

    uiQueueWriteIndex : UINT := 0;
    uiQueueReadIndex  : UINT := 0;
    uiQueueCount      : UINT := 0;

    // =====================================================
    // WRITER CONTROL
    // =====================================================
    stCurrentRecord : ST_CycleDataCSV;

    bWriterExecute : BOOL;
    bWriterBusy    : BOOL;
    bWriterDone    : BOOL;
    bWriterError   : BOOL;

    nWriterErrorId : UDINT;

    nCSVState : INT := 0;
    bRetryWriter : BOOL := FALSE;

    // =====================================================
    // DIAGNOSTICS
    // =====================================================
    udiTotalRecordsWritten : UDINT := 0;
    udiTotalRecordsDropped : UDINT := 0;

    bQueueFull : BOOL;
    bQueueOverflow : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =========================================================
// CSV MANAGER
// =========================================================
// Receives completed cycle records and stores them in
// a FIFO queue.
//
// Records are removed only after successful writing.
//
// States:
//   0  - Idle
//   10 - Start writing
//   20 - Wait for writer completion
//   90 - Writer error
// =========================================================

// =========================================================
// 1. ENQUEUE NEW RECORD
// =========================================================

IF GVL_Persistent.bCSVPendingRecord THEN

    IF uiQueueCount < 100 THEN

        // Copy the pending record into the FIFO.
        aCSVQueue[uiQueueWriteIndex] :=
            GVL_Persistent.stCSVPendingRecord;

        uiQueueWriteIndex := uiQueueWriteIndex + 1;

        IF uiQueueWriteIndex >= 100 THEN
            uiQueueWriteIndex := 0;
        END_IF

        uiQueueCount := uiQueueCount + 1;

        // Release handoff only after successful enqueue.
        GVL_Persistent.bCSVPendingRecord := FALSE;

    ELSE

        // Queue is full: preserve the pending record.
        GVL_Persistent.bCSVQueueOverflow := TRUE;

    END_IF

END_IF

// =========================================================
// 2. QUEUE STATUS
// =========================================================

bQueueFull := (uiQueueCount >= 100);


// =========================================================
// 3. WRITER STATE MACHINE
// =========================================================

// Default: generate a one-scan execution pulse.
bWriterExecute := FALSE;

CASE nCSVState OF

    // -----------------------------------------------------
    // IDLE
    // -----------------------------------------------------
    0:

        IF uiQueueCount > 0 THEN

            // Load the oldest queued record.
            stCurrentRecord :=
                aCSVQueue[uiQueueReadIndex];

            nCSVState := 10;

        END_IF


    // -----------------------------------------------------
    // START WRITER
    // -----------------------------------------------------
    10:

        bWriterExecute := TRUE;

        nCSVState := 20;


    // -----------------------------------------------------
    // WAIT FOR WRITER
    // -----------------------------------------------------
    20:

        IF bWriterDone THEN

            // Remove record only after successful write.
            uiQueueReadIndex := uiQueueReadIndex + 1;

            IF uiQueueReadIndex >= 100 THEN
                uiQueueReadIndex := 0;
            END_IF

            IF uiQueueCount > 0 THEN
                uiQueueCount := uiQueueCount - 1;
            END_IF

            udiTotalRecordsWritten :=
                udiTotalRecordsWritten + 1;

            nCSVState := 0;

        ELSIF bWriterError THEN

            // Keep the current record in the queue.
            nCSVState := 90;

        END_IF


    // -----------------------------------------------------
    // WRITER ERROR
    // -----------------------------------------------------
    90:

        // Manual retry after the underlying issue
        // has been corrected.
        IF bRetryWriter THEN

            bRetryWriter := FALSE;

            nCSVState := 0;

        END_IF


ELSE

    nCSVState := 0;

END_CASE


// =========================================================
// 4. CSV WRITER EXECUTION
// =========================================================

fbCSVWriter(
    bExecute := bWriterExecute,
    stCycleData := stCurrentRecord,
    sFolderPath := sCSVFolderPath
);


// =========================================================
// 5. WRITER STATUS
// =========================================================

bWriterBusy := fbCSVWriter.bBusy;
bWriterDone := fbCSVWriter.bDone;
bWriterError := fbCSVWriter.bError;

nWriterErrorId := fbCSVWriter.nErrorId;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>