    16#0006: F_EL6910MessageTemplate := 'Secondary MC: Stored GLOBAL_Fault with Code 0x%x and Additional Code 0x%x';
    16#0007: F_EL6910MessageTemplate := 'Diag-Message-Overflow: %d messages got lost';
    16#0008: F_EL6910MessageTemplate := 'Primary MC: the CRC of the FRAM Data was wrong (Diag-Code=%d)';
