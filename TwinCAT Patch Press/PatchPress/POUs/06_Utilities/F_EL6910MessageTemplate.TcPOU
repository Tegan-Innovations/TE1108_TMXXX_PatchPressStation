    16#0015: F_EL6910MessageTemplate := 'The login watchdog has been expired';
    16#0016: F_EL6910MessageTemplate := 'The user was logged out before';
    16#0017: F_EL6910MessageTemplate := 'The user has not sufficient access rights';
    16#0018: F_EL6910MessageTemplate := 'The reserved area of the CfgData was not 0';
    16#0019: F_EL6910MessageTemplate := 'The CRC of the CfgData was wrong';
