    wTextId : WORD;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE wTextId OF
    16#0001: F_EL6910MessageTemplate := 'Primary MC: GLOBAL_Fault with Code 0x%x and Additional Code 0x%x';
    16#0002: F_EL6910MessageTemplate := 'Primary MC: GLOBAL_Shutdown with Code 0x%x and Additional Code 0x%x';
