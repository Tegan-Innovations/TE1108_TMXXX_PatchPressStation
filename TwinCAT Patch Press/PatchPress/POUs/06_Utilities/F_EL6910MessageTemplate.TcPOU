  <POU Name="F_EL6910MessageTemplate" Id="{db43890e-391e-4ef4-be3f-438f1c412a79}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_EL6910MessageTemplate : STRING(255)
