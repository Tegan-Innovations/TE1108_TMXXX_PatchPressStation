<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="PRG_HmiCommands" Id="{79ca2d46-ae82-4bc2-94f7-f8309ae52790}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_HmiCommands
VAR
    rtStart : R_TRIG;
    rtReset : R_TRIG;
    rtAck : R_TRIG;

    // Power management - countdown and controlled stop
    bPowerRequestPending : BOOL;
    ePowerRequestPending : E_PLC_Power := E_PLC_Power.Idle;
    tonPowerDelay : TON;
    tPowerDelay : TIME;
    nPowerRemaining : DINT;
    bPowerDelayElapsed : BOOL;

    // Manual Mode request handshake.
    rtManualRequest : R_TRIG;
    bManualRequestLatched : BOOL;

    // Reject chute acknowledgement -> one-scan pulse.
    rtRejectChuteAcknowledge : R_TRIG;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// POWER MANAGEMENT - REQUEST / CANCEL / COUNTDOWN
// =====================================================
CASE GVL_HMI.stCommands.ePowerCmd OF
    E_PLC_Power.Reboot,
    E_PLC_Power.Shutdown:
        IF NOT bPowerRequestPending THEN
            ePowerRequestPending := GVL_HMI.stCommands.ePowerCmd;
            bPowerRequestPending := TRUE;
        END_IF

    E_PLC_Power.Cancel:
        bPowerRequestPending := FALSE;
        ePowerRequestPending := E_PLC_Power.Idle;
END_CASE
GVL_HMI.stCommands.ePowerCmd := E_PLC_Power.Idle;

CASE ePowerRequestPending OF
    E_PLC_Power.Reboot:   tPowerDelay := T#15S;
    E_PLC_Power.Shutdown: tPowerDelay := T#60S;
ELSE
    tPowerDelay := T#0S;
END_CASE

tonPowerDelay(IN := bPowerRequestPending, PT := tPowerDelay);
bPowerDelayElapsed := bPowerRequestPending AND tonPowerDelay.Q;

IF bPowerRequestPending THEN
    nPowerRemaining := TIME_TO_DINT(tPowerDelay - tonPowerDelay.ET);
    IF nPowerRemaining < 0 THEN nPowerRemaining := 0; END_IF
    // Ceiling milliseconds to seconds, so 15, 14, ... 1, 0.
    GVL_HMI.stStatus.iPowerCountdown := DINT_TO_INT((nPowerRemaining + 999) / 1000);
ELSE
    GVL_HMI.stStatus.iPowerCountdown := 0;
END_IF

// OS power execution deliberately NOT enabled in this step.
// The execution must be gated by STOPPED and the machine safe-stop conditions.

rtStart(CLK := GVL_MASTER.stInputs.bStartButton OR GVL_HMI.stCommands.bStart);
rtReset(CLK := GVL_MASTER.stInputs.bResetButton OR GVL_HMI.stCommands.bReset);
rtAck(CLK := GVL_HMI.stCommands.bAcknowledge);

GVL_MASTER.stCommand.bStart := rtStart.Q;
GVL_MASTER.stCommand.bStop :=
    GVL_MASTER.stInputs.bStopButton
    OR GVL_HMI.stCommands.bStop
    OR bPowerRequestPending;
GVL_MASTER.stCommand.bReset := rtReset.Q;
GVL_MASTER.stCommand.bAcknowledge := rtAck.Q;


// ---------------------------------------------------------
// MANUAL MODE REQUEST HANDSHAKE
// ---------------------------------------------------------
// Manual is a request, not a maintained mode command.
//
// A request may be made during Initialising and remain latched until
// ReadyToStart accepts it. Once the machine actually enters Manual,
// the request is consumed and cleared. Leaving Manual because of Stop
// or Fault therefore requires a NEW request before Manual can be entered again.

rtManualRequest(CLK := GVL_HMI.stCommands.bManualRequest);

IF rtManualRequest.Q THEN
    GVL_HMI.stCommands.bManualRequest := FALSE;
    bManualRequestLatched := TRUE;
END_IF

IF GVL_MASTER.stStatus.eMachineState = E_MachineState.Manual THEN
    bManualRequestLatched := FALSE;
END_IF

GVL_MASTER.stCommand.bManualRequest := bManualRequestLatched;


// ---------------------------------------------------------
// GENERAL HMI COMMANDS
// ---------------------------------------------------------

// Main-screen LIGHT toggle -> operator/nest light command.
GVL_MASTER.stCommand.bOperatorLight := GVL_HMI.stCommands.bOperatorLight;


// ---------------------------------------------------------
// MANUAL MODE COMMANDS
// ---------------------------------------------------------
// All Manual-Mode enables/actions are non-retentive outside Manual.
//
// HMI requests are only copied into the machine command image while
// the machine is actually in Manual Mode.
//
// Motion permissives and Vision Manual Enable supervision are handled
// inside FB_IndexedPatchPressMachine. Therefore the HMI is never the
// final authority for actuator movement.

IF GVL_MASTER.stStatus.eMachineState = E_MachineState.Manual THEN

    // =====================================================
    // INDEX MANUAL CONTROLS
    // =====================================================

    GVL_MASTER.stCommand.bIndexerManualEnable :=
        GVL_HMI.stCommands.bIndexerManualEnable;

    GVL_MASTER.stCommand.bManualIndexForward :=
        GVL_HMI.stCommands.bManualIndexForward;

    GVL_MASTER.stCommand.bManualIndexHome :=
        GVL_HMI.stCommands.bManualIndexHome;

    GVL_MASTER.stCommand.bManualMainDoorUnlock :=
        GVL_HMI.stCommands.bManualMainDoorUnlock;


    // =====================================================
    // HEAT STAKE MANUAL CONTROLS
    // =====================================================

    GVL_MASTER.stCommand.bHeatStakeManualEnable :=
        GVL_HMI.stCommands.bHeatStakeManualEnable;

    GVL_MASTER.stCommand.bHeatStakeManualStakePatch :=
        GVL_HMI.stCommands.bHeatStakeManualStakePatch;

    GVL_MASTER.stCommand.bHeatStakeManualUnlock :=
        GVL_HMI.stCommands.bHeatStakeManualUnlock;

    GVL_MASTER.stCommand.bHeatStakeManualLock :=
        GVL_HMI.stCommands.bHeatStakeManualLock;

    GVL_MASTER.stCommand.bHeatStakeManualHeadDown :=
        GVL_HMI.stCommands.bHeatStakeManualHeadDown;

    GVL_MASTER.stCommand.bHeatStakeManualHeadUp :=
        GVL_HMI.stCommands.bHeatStakeManualHeadUp;

    GVL_MASTER.stCommand.bHeatStakeManualSupportUp :=
        GVL_HMI.stCommands.bHeatStakeManualSupportUp;


    // =====================================================
    // VISION MANUAL CONTROLS
    // =====================================================

    // General Vision manual enable
    GVL_MASTER.stCommand.bVisionManualEnable :=
        GVL_HMI.stCommands.bVisionManualEnable;
	// Run complete Vision sequence
	GVL_MASTER.stCommand.bVisionManualRunSequence :=
		GVL_HMI.stCommands.bVisionManualRunSequence;
	
	// Consume momentary request
	GVL_HMI.stCommands.bVisionManualRunSequence := FALSE;
	
	// Vision - Home Position
	GVL_MASTER.stCommand.bVisionManualHomeRequest :=
		GVL_HMI.stCommands.bVisionManualHomeRequest;
	
	// Consume HMI command as a one-scan pulse.
	GVL_HMI.stCommands.bVisionManualHomeRequest := FALSE;

    // Horizontal
    GVL_MASTER.stCommand.bVisionHorizontalBackRequest :=
        GVL_HMI.stCommands.bVisionHorizontalBackRequest;

    GVL_MASTER.stCommand.bVisionHorizontalFrontRequest :=
        GVL_HMI.stCommands.bVisionHorizontalFrontRequest;

    // Vertical
    GVL_MASTER.stCommand.bVisionVerticalUpRequest :=
        GVL_HMI.stCommands.bVisionVerticalUpRequest;

    GVL_MASTER.stCommand.bVisionVerticalIntermediateRequest :=
        GVL_HMI.stCommands.bVisionVerticalIntermediateRequest;

    GVL_MASTER.stCommand.bVisionVerticalFullDownRequest :=
        GVL_HMI.stCommands.bVisionVerticalFullDownRequest;
		
		// Consume momentary HMI requests.
	GVL_HMI.stCommands.bVisionVerticalUpRequest := FALSE;
	GVL_HMI.stCommands.bVisionVerticalIntermediateRequest := FALSE;
	GVL_HMI.stCommands.bVisionVerticalFullDownRequest := FALSE;

    // Gripper
    GVL_MASTER.stCommand.bVisionGripOpenRequest :=
        GVL_HMI.stCommands.bVisionGripOpenRequest;

    GVL_MASTER.stCommand.bVisionGripCloseRequest :=
        GVL_HMI.stCommands.bVisionGripCloseRequest;
		
	// VISION MANUAL - CONSUME GRIP COMMANDS
	
	GVL_HMI.stCommands.bVisionGripOpenRequest := FALSE;
	GVL_HMI.stCommands.bVisionGripCloseRequest := FALSE;

    // Rotation
    GVL_MASTER.stCommand.bVisionRotate0Request :=
        GVL_HMI.stCommands.bVisionRotate0Request;

    GVL_MASTER.stCommand.bVisionRotate180Request :=
        GVL_HMI.stCommands.bVisionRotate180Request;
		
	// Consume momentary rotation commands after transferring them.
	// GVL_MASTER sees TRUE for this PLC scan only.
	
	GVL_HMI.stCommands.bVisionRotate0Request := FALSE;
	GVL_HMI.stCommands.bVisionRotate180Request := FALSE;

    // Support
    GVL_MASTER.stCommand.bVisionSupportExtendRequest :=
        GVL_HMI.stCommands.bVisionSupportExtendRequest;


ELSE

    // =====================================================
    // RESET HMI MANUAL COMMAND BUFFER
    // =====================================================
    // This also guarantees that checkboxes/buttons visually release
    // immediately when Manual Mode is exited.

    // Index
    GVL_HMI.stCommands.bIndexerManualEnable := FALSE;
    GVL_HMI.stCommands.bManualIndexForward := FALSE;
    GVL_HMI.stCommands.bManualIndexHome := FALSE;
    GVL_HMI.stCommands.bManualMainDoorUnlock := FALSE;

    // Heat Stake
    GVL_HMI.stCommands.bHeatStakeManualEnable := FALSE;
    GVL_HMI.stCommands.bHeatStakeManualStakePatch := FALSE;
    GVL_HMI.stCommands.bHeatStakeManualUnlock := FALSE;
    GVL_HMI.stCommands.bHeatStakeManualLock := FALSE;
    GVL_HMI.stCommands.bHeatStakeManualHeadDown := FALSE;
    GVL_HMI.stCommands.bHeatStakeManualHeadUp := FALSE;
    GVL_HMI.stCommands.bHeatStakeManualSupportUp := FALSE;

    // Vision
	GVL_HMI.stCommands.bVisionManualEnable := FALSE;
	GVL_HMI.stCommands.bVisionManualRunSequence := FALSE;
	
	GVL_HMI.stCommands.bVisionHorizontalBackRequest := FALSE;
	GVL_HMI.stCommands.bVisionHorizontalFrontRequest := FALSE;;

    GVL_HMI.stCommands.bVisionHorizontalBackRequest := FALSE;
    GVL_HMI.stCommands.bVisionHorizontalFrontRequest := FALSE;

    GVL_HMI.stCommands.bVisionVerticalUpRequest := FALSE;
    GVL_HMI.stCommands.bVisionVerticalIntermediateRequest := FALSE;
    GVL_HMI.stCommands.bVisionVerticalFullDownRequest := FALSE;

    GVL_HMI.stCommands.bVisionGripOpenRequest := FALSE;
    GVL_HMI.stCommands.bVisionGripCloseRequest := FALSE;

    GVL_HMI.stCommands.bVisionRotate0Request := FALSE;
    GVL_HMI.stCommands.bVisionRotate180Request := FALSE;

    GVL_HMI.stCommands.bVisionSupportExtendRequest := FALSE;
	GVL_HMI.stCommands.bVisionManualHomeRequest := FALSE;
	GVL_MASTER.stCommand.bVisionManualHomeRequest := FALSE;


    // =====================================================
    // RESET PLC MANUAL COMMAND IMAGE
    // =====================================================

    // Index
    GVL_MASTER.stCommand.bIndexerManualEnable := FALSE;
    GVL_MASTER.stCommand.bManualIndexForward := FALSE;
    GVL_MASTER.stCommand.bManualIndexHome := FALSE;
    GVL_MASTER.stCommand.bManualMainDoorUnlock := FALSE;

    // Heat Stake
    GVL_MASTER.stCommand.bHeatStakeManualEnable := FALSE;
    GVL_MASTER.stCommand.bHeatStakeManualStakePatch := FALSE;
    GVL_MASTER.stCommand.bHeatStakeManualUnlock := FALSE;
    GVL_MASTER.stCommand.bHeatStakeManualLock := FALSE;
    GVL_MASTER.stCommand.bHeatStakeManualHeadDown := FALSE;
    GVL_MASTER.stCommand.bHeatStakeManualHeadUp := FALSE;
    GVL_MASTER.stCommand.bHeatStakeManualSupportUp := FALSE;

    // Vision
    GVL_MASTER.stCommand.bVisionManualEnable := FALSE;

    GVL_MASTER.stCommand.bVisionHorizontalBackRequest := FALSE;
    GVL_MASTER.stCommand.bVisionHorizontalFrontRequest := FALSE;

    GVL_MASTER.stCommand.bVisionVerticalUpRequest := FALSE;
    GVL_MASTER.stCommand.bVisionVerticalIntermediateRequest := FALSE;
    GVL_MASTER.stCommand.bVisionVerticalFullDownRequest := FALSE;

    GVL_MASTER.stCommand.bVisionGripOpenRequest := FALSE;
    GVL_MASTER.stCommand.bVisionGripCloseRequest := FALSE;

    GVL_MASTER.stCommand.bVisionRotate0Request := FALSE;
    GVL_MASTER.stCommand.bVisionRotate180Request := FALSE;

    GVL_MASTER.stCommand.bVisionSupportExtendRequest := FALSE;

END_IF


// ---------------------------------------------------------
// DISABLED NEST PART POPUP
// ---------------------------------------------------------

GVL_MASTER.stCommand.bAcknowledgeDisabledNestPartPopup :=
    GVL_HMI.stCommands.bAcknowledgeDisabledNestPartPopup;


// ---------------------------------------------------------
// REJECT CHUTE ACKNOWLEDGE
// ---------------------------------------------------------
// Reject chute acknowledge is edge-consumed.
// This prevents a maintained TRUE from satisfying a future full-chute event.

rtRejectChuteAcknowledge(
    CLK := GVL_HMI.stCommands.bAcknowledgeRejectChuteFull
);

GVL_MASTER.stCommand.bAcknowledgeRejectChuteFull :=
    rtRejectChuteAcknowledge.Q;

IF rtRejectChuteAcknowledge.Q THEN
    GVL_HMI.stCommands.bAcknowledgeRejectChuteFull := FALSE;
END_IF


// ---------------------------------------------------------
// STATISTICS
// ---------------------------------------------------------

GVL_MASTER.stCommand.uiResetStatisticsNestId :=
    GVL_HMI.stCommands.uiResetStatisticsNestId;
	]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>