<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="PRG_Main" Id="{fe8f5db4-2dbe-44c9-ba3e-79c06469fde0}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_Main
VAR
    fbMachine : FB_IndexedPatchPressMachine;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =========================================================
// CLEAR HMI LOGOUT DIAGNOSTICS ON FAULT RESET
// =========================================================

IF GVL_MASTER.stCommand.bReset
    AND (GVL_MASTER.stStatus.eMachineState = E_MachineState.Fault) THEN

    GVL_HMI.bLogoutFaultActive := FALSE;
    GVL_HMI.bHmiLogoutAutoCycle := FALSE;
    GVL_HMI.bHmiLogoutStopped := FALSE;

END_IF


fbMachine.Cyclic(
    stInputs := GVL_MASTER.stInputs,
    stCommand := GVL_MASTER.stCommand,
    stConfig := GVL_Config.stMachine,
    stHeatStakeTemperatureSettings := GVL_Persistent.stHeatStakeTemperatureSettings,
    stHeatStakeProcessSettings := GVL_Persistent.stHeatStakeProcessSettings,
    bPatchDispenseCommissioned := GVL_PatchPress_Interface.bPatchDispenseCommissioned,
    bHeatStakeCommissioned := GVL_PatchPress_Interface.bHeatStakeCommissioned,
    bVisionCommissioned := GVL_PatchPress_Interface.bVisionCommissioned,
    bCoreCommissioningMode := GVL_PatchPress_Interface.bCoreCommissioningMode,
    bLogoutHMI := GVL_HMI.bLogoutRequest,
    stOutputs => GVL_MASTER.stOutputs,
    stStatus => GVL_MASTER.stStatus);
	
	
	// =========================================================
	// HMI LOGOUT REQUEST ACKNOWLEDGEMENT
	// =========================================================
	// The machine has already received the request in this PLC scan.
	// Clear it only after FB_IndexedPatchPressMachine.Cyclic executes.
	
	IF GVL_HMI.bLogoutRequest THEN
		GVL_HMI.bLogoutRequest := FALSE;
	END_IF
	
	
	
	]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>