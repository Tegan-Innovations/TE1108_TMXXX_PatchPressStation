<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_ProcessCycle" Id="{622f2bef-5510-4430-be8a-312a17e95422}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ProcessCycle
VAR
    eStateInternal      : E_CycleState := E_CycleState.Disabled;

    rtCycleTrigger      : R_TRIG;
    tonSequenceTimeout  : TON;

    bStopPending        : BOOL;
    bStartIssued        : BOOL;
    bIndexRequestIssued : BOOL;
    bSequenceTimeoutFaultInternal : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cyclic" Id="{e84fc6ef-4070-40dd-8010-e10d3773e159}">
      <Declaration><![CDATA[METHOD PUBLIC Cyclic
VAR_INPUT
    bEnable                   : BOOL;
    bResetRequest             : BOOL;
    bStopRequest              : BOOL;
    bTwoHandsSafe             : BOOL;
    bSafetyOk                 : BOOL;

    bIndexReady               : BOOL;
    bIndexLocked              : BOOL;
    bIndexBusy                : BOOL;
    bIndexFaulted             : BOOL;
    bStationsIndexPermissive  : BOOL;
    bOperatorIndexPermissive  : BOOL;
    bTemperatureIndexPermissive : BOOL;
    bNestEnableIndexPermissive : BOOL;

    bAllStationsReady         : BOOL;
    bAllStationsComplete      : BOOL;
    bAnyStationFault          : BOOL;

    tSequenceTimeout          : TIME;
END_VAR
VAR_OUTPUT
    bStartStations            : BOOL;
    bStopStations             : BOOL;
    bRequestIndex             : BOOL;

    bCycleActive              : BOOL;
    bCompletePulse            : BOOL;
    bFault                    : BOOL;
    bSequenceTimeoutFault     : BOOL;
    bStopPendingStatus        : BOOL;
    bDisabledNestIndexAttempt : BOOL;

    eState                    : E_CycleState;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// Generic indexed-machine process coordinator.
//
// Commissioning sequence aligned with the validated Silicone Station pattern:
//
//   AutoCycle enabled
//      -> initialise
//      -> wait until stations are Ready and supports are physically down
//      -> wait for a FRESH validated two-hand actuation
//      -> validate index permissives
//      -> request ONE index movement
//      -> wait for index complete
//      -> start Patch Dispense / Heat Stake / Vision in parallel
//      -> each station extends its own support
//      -> 3 s simulated process
//      -> each station retracts its support
//      -> all stations Complete
//      -> CycleComplete
//      -> wait for next two-hand actuation
//
// The index FB itself remains the final authority for movement:
// it requires Safety Motion Permitted, Two-Hand Safe, and all station
// supports physically retracted before energising the index outputs.

bStartStations := FALSE;
bStopStations := FALSE;
bRequestIndex := FALSE;
bCompletePulse := FALSE;
bDisabledNestIndexAttempt := FALSE;

rtCycleTrigger(CLK := bTwoHandsSafe);

// ---------------------------------------------------------
// ENABLE / RESET / STOP HANDLING
// ---------------------------------------------------------

IF bResetRequest THEN
    bStopPending := FALSE;
    bStartIssued := FALSE;
    bIndexRequestIssued := FALSE;
    bSequenceTimeoutFaultInternal := FALSE;

    IF bEnable THEN
        eStateInternal := E_CycleState.Initialising;
    ELSE
        eStateInternal := E_CycleState.Disabled;
    END_IF

ELSIF NOT bEnable THEN
    bStopPending := FALSE;
    bStartIssued := FALSE;
    bIndexRequestIssued := FALSE;
    bSequenceTimeoutFaultInternal := FALSE;
    eStateInternal := E_CycleState.Disabled;

ELSE
    // Enter the ProcessCycle automatically when the machine enters AutoCycle.
    IF eStateInternal = E_CycleState.Disabled THEN
        bStopPending := FALSE;
        bStartIssued := FALSE;
        bIndexRequestIssued := FALSE;
        eStateInternal := E_CycleState.Initialising;
    END_IF

    IF bStopRequest THEN
        bStopPending := TRUE;
    END_IF
END_IF

// ---------------------------------------------------------
// FAULT SUPERVISION
// ---------------------------------------------------------

IF bIndexFaulted
    OR bAnyStationFault
    OR (bEnable AND NOT bSafetyOk)
THEN
    eStateInternal := E_CycleState.Fault;
END_IF

// Do not supervise the idle/waiting states.
tonSequenceTimeout(
    IN := bEnable
        AND (eStateInternal <> E_CycleState.Disabled)
        AND (eStateInternal <> E_CycleState.WaitingForProcessCycleTrigger)
        AND (eStateInternal <> E_CycleState.CycleComplete)
        AND (eStateInternal <> E_CycleState.ControlledStop)
        AND (eStateInternal <> E_CycleState.Fault),
    PT := tSequenceTimeout
);

IF tonSequenceTimeout.Q THEN
    bSequenceTimeoutFaultInternal := TRUE;
    eStateInternal := E_CycleState.Fault;
END_IF

// ---------------------------------------------------------
// PROCESS CYCLE
// ---------------------------------------------------------

CASE eStateInternal OF

    E_CycleState.Disabled:
        // Waiting for machine AutoCycle.

    E_CycleState.Initialising:
        bStartIssued := FALSE;
        bIndexRequestIssued := FALSE;

        // Match the Silicone philosophy:
        // do not arm the operator trigger until the index is stable AND all
        // process tooling is physically in the safe/retracted position.
        IF bSafetyOk
            AND bIndexReady
            AND bIndexLocked
            AND bStationsIndexPermissive
            AND bOperatorIndexPermissive
            AND bTemperatureIndexPermissive
            AND bAllStationsReady
        THEN
            eStateInternal := E_CycleState.WaitingForProcessCycleTrigger;
        END_IF

    E_CycleState.WaitingForProcessCycleTrigger:

        IF bStopPending THEN
            eStateInternal := E_CycleState.ControlledStop;

        // The disabled-nest interlock is reported only after a fresh operator
        // index attempt. The machine stays in this state and does not index.
        ELSIF rtCycleTrigger.Q AND NOT bNestEnableIndexPermissive THEN
            bDisabledNestIndexAttempt := TRUE;

        // Fresh two-hand actuation starts the cycle, exactly as on Silicone.
        ELSIF rtCycleTrigger.Q
            AND bSafetyOk
            AND bIndexReady
            AND bIndexLocked
            AND NOT bIndexBusy
            AND bStationsIndexPermissive
            AND bOperatorIndexPermissive
            AND bAllStationsReady
            AND bNestEnableIndexPermissive
        THEN
            eStateInternal := E_CycleState.ValidatingIndexPermissives;
        END_IF

    E_CycleState.ValidatingIndexPermissives:

        IF bStopPending THEN
            eStateInternal := E_CycleState.ControlledStop;

        ELSIF bSafetyOk
            AND bStationsIndexPermissive
            AND bOperatorIndexPermissive
            AND bTemperatureIndexPermissive
            AND bNestEnableIndexPermissive
            AND bIndexReady
            AND bIndexLocked
            AND NOT bIndexBusy
        THEN
            eStateInternal := E_CycleState.RequestingIndexMove;
        END_IF

    E_CycleState.RequestingIndexMove:
        // One-scan request. FB_IndexTable4 still requires Two-Hand Safe before
        // it energises Coil0/Coil1.
        bRequestIndex := TRUE;
        bIndexRequestIssued := TRUE;
        eStateInternal := E_CycleState.WaitingForIndexStart;

    E_CycleState.WaitingForIndexStart:

        IF bStopPending THEN
            eStateInternal := E_CycleState.ControlledStop;

        ELSIF bIndexBusy THEN
            eStateInternal := E_CycleState.WaitingForIndexComplete;
        END_IF

    E_CycleState.WaitingForIndexComplete:

        IF bStopPending THEN
            eStateInternal := E_CycleState.ControlledStop;

        ELSIF NOT bIndexBusy
            AND bIndexReady
            AND bIndexLocked
        THEN
            bIndexRequestIssued := FALSE;
            eStateInternal := E_CycleState.PreparingProcessStations;
        END_IF

    E_CycleState.PreparingProcessStations:

        // After the index has locked in its new position, ensure all three
        // station objects are ready before issuing process start.
        IF bStopPending THEN
            eStateInternal := E_CycleState.ControlledStop;

        ELSIF bAllStationsReady THEN
            eStateInternal := E_CycleState.StartingProcesses;
        END_IF

    E_CycleState.StartingProcesses:
        bStartStations := TRUE;
        bStartIssued := TRUE;
        eStateInternal := E_CycleState.WaitingForProcessesRunning;

    E_CycleState.WaitingForProcessesRunning:

        IF bStopPending THEN
            bStopStations := TRUE;
            eStateInternal := E_CycleState.ControlledStop;

        // IMPORTANT:
        // If no physical nest at any process station contains a part, all
        // stations are intentionally skipped. In that case
        // bAllStationsReady remains TRUE forever, while
        // bAllStationsComplete is already TRUE.
        //
        // Without this branch the ProcessCycle waits here until the global
        // sequence timeout and sends the machine to Immediate Fault.
        ELSIF bAllStationsComplete THEN
            eStateInternal := E_CycleState.WaitingForProcessesComplete;

        // Normal case: at least one required station has left Ready and
        // entered its process sequence.
        ELSIF NOT bAllStationsReady THEN
            eStateInternal := E_CycleState.WaitingForProcessesComplete;
        END_IF

    E_CycleState.WaitingForProcessesComplete:

        IF bStopPending THEN
            bStopStations := TRUE;
            eStateInternal := E_CycleState.ControlledStop;

        ELSIF bAllStationsComplete
            AND bStationsIndexPermissive
        THEN
            // Complete is accepted only after all three supports have
            // physically returned to their safe/retracted sensors.
            bStartIssued := FALSE;
            eStateInternal := E_CycleState.CycleComplete;
        END_IF

    E_CycleState.CycleComplete:
        bCompletePulse := TRUE;

        IF bStopPending THEN
            eStateInternal := E_CycleState.ControlledStop;
        ELSE
            eStateInternal := E_CycleState.WaitingForProcessCycleTrigger;
        END_IF

    E_CycleState.ControlledStop:
        bStopStations := TRUE;

        // Safe stop is complete only when the index has stopped and every
        // support cylinder is physically retracted.
        IF NOT bIndexBusy
            AND bStationsIndexPermissive
        THEN
            bStopPending := FALSE;
            eStateInternal := E_CycleState.Disabled;
        END_IF

    E_CycleState.Fault:
        bStopStations := TRUE;

ELSE
    eStateInternal := E_CycleState.Fault;

END_CASE

bCycleActive :=
    (eStateInternal <> E_CycleState.Disabled)
    AND (eStateInternal <> E_CycleState.Fault);

bFault := (eStateInternal = E_CycleState.Fault);
bSequenceTimeoutFault := bSequenceTimeoutFaultInternal;
bStopPendingStatus := bStopPending;
eState := eStateInternal;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>