<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_ProcessStation" Id="{a3a0650b-5367-4125-b1aa-1afe6b784288}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ProcessStation
VAR
    ipEquipment      : I_ProcessEquipment;
    bConfigured      : BOOL;

    bStartAccepted   : BOOL;
    bCompleteLatched : BOOL;

    stResultInternal : ST_ProcessResult;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Configure" Id="{1a60dc71-cc2b-487d-8e7a-89a13246021f}">
      <Declaration><![CDATA[METHOD PUBLIC Configure : BOOL
VAR_INPUT
    ipNewEquipment : I_ProcessEquipment;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
ipEquipment := ipNewEquipment;
bConfigured := TRUE;
Configure := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Cyclic" Id="{25254c3e-857e-4fcc-8757-b9778994fc79}">
      <Declaration><![CDATA[METHOD PUBLIC Cyclic
VAR_INPUT
    bEnable             : BOOL;
    bStartRequest       : BOOL;
    bStopRequest        : BOOL;
    bResetRequest       : BOOL;
    bSafetyOk           : BOOL;
    bProcessPermissive  : BOOL;
END_VAR
VAR_OUTPUT
    bReady              : BOOL;
    bBusy               : BOOL;
    bComplete           : BOOL;
    bFault              : BOOL;
    stResult            : ST_ProcessResult;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// Generic process-station wrapper.
//
// This FB contains no machine-specific actuator logic.
// Concrete stations own their pneumatics / motion / process sequence.
// The configured equipment object exposes only the common lifecycle.

bReady := FALSE;
bBusy := FALSE;
bComplete := bCompleteLatched;
bFault := FALSE;

IF NOT bConfigured THEN
    bFault := TRUE;
    RETURN;
END_IF

ipEquipment.Cyclic();

IF bResetRequest THEN
    ipEquipment.RequestReset();
    bStartAccepted := FALSE;
    bCompleteLatched := FALSE;
    stResultInternal.bValid := FALSE;
END_IF

IF bStopRequest OR NOT bEnable OR NOT bSafetyOk THEN
    ipEquipment.RequestStop();
    bStartAccepted := FALSE;
END_IF

bFault := ipEquipment.IsFaulted();

IF bFault THEN
    ipEquipment.RequestStop();

ELSIF bEnable AND bSafetyOk THEN

    bReady := ipEquipment.IsReady() AND bProcessPermissive;
    bBusy := ipEquipment.IsBusy();

    IF bStartRequest
        AND NOT bStartAccepted
        AND bReady
    THEN
        bStartAccepted := ipEquipment.RequestStart();
        bCompleteLatched := FALSE;
        stResultInternal.bValid := FALSE;
    END_IF

    IF NOT bStartRequest THEN
        bStartAccepted := FALSE;
    END_IF

    IF ipEquipment.IsDone() THEN
        stResultInternal := ipEquipment.GetResult();
        bCompleteLatched := TRUE;
    END_IF

END_IF

bComplete := bCompleteLatched;
stResult := stResultInternal;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>