<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_IndexedPatchPressMachine" Id="{cd45b888-3938-49e7-a56e-6a78ef36b4a7}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_IndexedPatchPressMachine
VAR
    fbPatchFeedManager : FB_PatchFeedManager;
    bPatchDriveRunRequest : BOOL;
    bPatchSequenceAirRequest : BOOL;
    bPatchSequenceDownRequest : BOOL;
    bPatchHoldUpAllowed : BOOL;
    bPatchStartAllowed : BOOL;
    bPatchVerticalIndexReady : BOOL;
    bPatchVerticalUpCommandPrevious : BOOL;
    bPatchVerticalDownCommandPrevious : BOOL;
    fbIndex : FB_IndexTable4;
    fbMainDoorLock : FB_MainDoorLock;
    fbNestManager : FB_NestTableManager;
    fbOperatorStation : FB_OperatorStation;
    bOperatorLoadValid : BOOL;
    fbPatchDispense : FB_PatchDispenseStation;
    fbHeatStake : FB_HeatStakeStation;
    fbHeatStakeTemperature : FB_HeatStakeTemperatureControl;
    fbHeatStakePressureRegulator : FB_VeabPressureRegulator;
    fbVision : FB_VisionStation;
    fbVisionManualImages : FB_VisionManualImages;
    aVisionPbupReferenceKnown : ARRAY[1..4] OF BOOL;
    uiVisionPbupNest : UINT;
    uiVisionPbupEditNest : UINT;
    uiVisionImageOwnedNest : UINT;
    eVisionImageOwnedIndex : E_TablePosition;
    bVisionImagePermit : BOOL;
    bVisionImageJogBusy : BOOL;
    bVisionImageOwnedBeforeUpdate : BOOL;
    bVisionImageRecoveryRequired : BOOL;
    bManualImageTriggerCommand : BOOL;
    bManualCameraTransportReady : BOOL;
    bManualImageCameraFailed : BOOL;
    bVisionPbupFitted : BOOL;
    bVisionPbupKnown : BOOL;
    rtVisionPbupAutoBusy : R_TRIG;
    rtVisionPbupAutoDone : R_TRIG;
    tonVisionRotate0Confirm : TON;
    tonVisionRotate180Confirm : TON;
    tVisionRotaryConfirm : TIME := T#1S;
    bVisionRotate0Confirmed : BOOL;
    bVisionRotate180Confirmed : BOOL;
    bVisionRotate0CommandPrevious : BOOL;
    bVisionRotate180CommandPrevious : BOOL;
    bVisionTriggerAccepted : BOOL;
    bVisionRotatingCaptureAccepted : BOOL;
	fbVSCamera : FB_VSCamera;
    fbProcessCycle : FB_ProcessCycle;
    fbCommissioningGuard : FB_PatchPressCommissioningGuard;
    eMachineState : E_MachineState := E_MachineState.PowerUp;
    eInitialisingWaitReason : E_InitialisingWaitReason := E_InitialisingWaitReason.None;
    eStoppingWaitReason : E_StoppingWaitReason := E_StoppingWaitReason.None;
    stOutputsInternal : ST_MachineOutputs;
    stIndexStatus : ST_IndexStatus;
    stMainDoorStatus : ST_MainDoorLockStatus;
    stOperatorStatus : ST_OperatorStationStatus;
    stPatchDispenseStatus : ST_PatchStageStatus;
    stHeatStakeStatus : ST_PatchStageStatus;
    stHeatStakeTemperatureStatus : ST_HeatStakeTemperatureStatus;
    stHeatStakeProcessStatus : ST_HeatStakeProcessStatus;
    stVisionStatus : ST_PatchStageStatus;
    stOperatorNest : ST_Nest;
    stPatchDispenseNest : ST_Nest;
    stHeatStakeNest : ST_Nest;
    stHeatStakePresenceResult : ST_ProcessResult;
    stEmptyHeatStakePresenceResult : ST_ProcessResult;
    stVisionNest : ST_Nest;
	stHistoryNest : ST_Nest;
	stPatchDispenseCycleResult : ST_ProcessResult;
	uiHistoryNestId : UINT := 0;

    bPatchDispenseRequired : BOOL;
    bHeatStakeRequired : BOOL;
    bVisionRequired : BOOL;
	
	bPatchHomeVerticalUpRequest : BOOL := FALSE;
	
	// Patch Dispensing Manual Mode
	bPatchManualEnableAllowed : BOOL;
	bPatchManualSupportAllowed : BOOL;
	bPatchManualVerticalAllowed : BOOL;
	bPatchManualAirAllowed : BOOL;

    // Snapshot taken before the station Update() calls.
    // Required to know which physical parts were actually being processed if
    // Safety is lost, because Update() immediately disables the station when
    // Safety_OK goes FALSE.
    bPatchDispenseProcessingBeforeUpdate 	: BOOL;
    bHeatStakeProcessingBeforeUpdate 		: BOOL;
    bVisionProcessingBeforeUpdate 			: BOOL;
	bHeatStakeHeadDownStarted 				: BOOL;

    // Machine-state transition tracking for one-shot product disposition.
    ePreviousMachineState 					: E_MachineState := E_MachineState.PowerUp;
    stProcessFaultResult 					: ST_ProcessResult;

    bAllRequiredStationsReady 				: BOOL;
    bAllRequiredStationsComplete 			: BOOL;
    bAnyStationInProcess 					: BOOL;
    bCycleResultsStored 					: BOOL;

    stPermissives 							: ST_MachinePermissives;
    tonInitialising 						: TON;
    tonStopping 							: TON;
	tonHeaterDwell 							: TON;

	
	
	bHeaterDwellTimeoutFault 				: BOOL := FALSE;
    bInitialisationTimeoutFault 			: BOOL;
    bStoppingTimeoutFault 					: BOOL;
    bAutoCycleAllowed 						: BOOL;
    sAutoCycleBlockReason 					: STRING(160);
    bIndexMoveAccepted 						: BOOL;
    bDoorLockOutput 						: BOOL;
	bMainDoorUnlockAcknowledged 			: BOOL := FALSE;
	bMainDoorHotLockRequired 				: BOOL := FALSE;
	
    rtManualIndexMove 						: R_TRIG;
	rtReprocessIndexAttempt 				: R_TRIG;
	rtMachineInitialising 					: R_TRIG;

    bProcessStartStations       			: BOOL;
    bProcessStopStations        			: BOOL;
    bProcessRequestIndex        			: BOOL;
    bProcessCycleActive         			: BOOL;
    bProcessCycleCompletePulse  			: BOOL;
    bProcessCycleFault          			: BOOL;
    bProcessCycleTimeoutFault   			: BOOL;
    bProcessStopPending         			: BOOL;
    bProcessAutomaticStopRequest 			: BOOL;
    bAutoCycleStopRequestLatched 			: BOOL;
    eProcessCycleState          			: E_CycleState;
    bDisabledNestIndexAttempt   			: BOOL;

    aNestSnapshot               			: ARRAY[1..4] OF ST_Nest;
    bDisabledNestPartPresent    			: BOOL;
    uiDisabledNestPartNestId    			: UINT;
    bDisabledNestPartPopupRequest 			: BOOL;
    uiDisabledNestPartPopupNestId 			: UINT;
    iNestCheck                  			: INT;

    // Reject chute full supervision / controlled stop.
    tonRejectChuteFull              : TON;
    tonRejectChutePopupReopen       : TON;
    rtRejectChuteAcknowledge        : R_TRIG;
    rtRejectChuteStopRequest        : R_TRIG;
    bRejectChuteFullLatched         : BOOL;
    bRejectChutePopupRequest        : BOOL;
    bRejectChuteStopRequestLatched  : BOOL;
    bRejectChutePopupReopenPending  : BOOL;
	bReprocessPopupAcknowledged 	: BOOL := FALSE;
	bReprocessAcknowledgePending 	: BOOL := FALSE;
	bHeaterDwellRequestLatched 		: BOOL := FALSE;

    // Manual controlled-stop tracking.
    bManualSupportTargetUpAtRejectStop : BOOL;
    bManualRejectStopReady             : BOOL;

    bStation1SupportExtendRequest  	: BOOL;
    bStation1SupportRetractRequest 	: BOOL;
    bStation2SupportExtendRequest  	: BOOL;
    bStation2SupportRetractRequest 	: BOOL;

    bHeatStakeHeadLockRequest 		: BOOL;
    bHeatStakeHeadUnlockRequest 	: BOOL;
    // Monostable valve output state; re-arm descent only after completed HOME.
    bHeatStakeHeadUpRecoveryLatched : BOOL := TRUE;
    bHeatStakeHeadDownHeld : BOOL := FALSE;
    bHeatStakeHeadDownRequest 		: BOOL;
    bHeatStakeHeadUpRequest 		: BOOL;
    rHeatStakePressureCommandBar 	: LREAL;
    iHeatStakePressureRaw 			: INT;
    rHeatStakePressureScaledBar 	: LREAL;
    bHeatStakeContactDwellActive 	: BOOL;
    usiHeatStakeSequenceStep 		: USINT;
	
	rtPatchSupportExtend 			: R_TRIG;
	rtPatchSupportRetract 			: R_TRIG;
	bPatchSupportExtendDesired 		: BOOL := FALSE;
	bPatchManualAllowed 			: BOOL;
	tpPatchAirBlow 					: TP;


    // Heat Stake Manual Mode
    rtHeatStakeManualStakePatch 	: R_TRIG;
    rtHeatStakeManualUnlock     	: R_TRIG;
    rtHeatStakeManualLock       	: R_TRIG;
    rtHeatStakeManualHeadDown   	: R_TRIG;
    rtHeatStakeManualHeadUp     	: R_TRIG;
    rtHeatStakeInitialising     	: R_TRIG;

    tonHeatStakeManualAction     	: TON;
    usiHeatStakeManualActionStep 	: USINT := 0;
    bHeatStakeManualHeadUnlocked 	: BOOL := FALSE;
    bHeatStakeManualStakeCycleActive : BOOL := FALSE;

    bHeatStakeStationHeadDownTimeoutFault 		: BOOL;
    bHeatStakeStationHeadUpTimeoutFault 		: BOOL;
    bHeatStakeStationHeadSensorConflictFault 	: BOOL;
    bHeatStakeManualHeadDownTimeoutFault 		: BOOL;
    bHeatStakeManualHeadUpTimeoutFault 			: BOOL;

    bHeatStakeManualEnableAllowed   : BOOL;
    bHeatStakeManualStakeAllowed    : BOOL;
    bHeatStakeManualUnlockAllowed   : BOOL;
    bHeatStakeManualLockAllowed     : BOOL;
    bHeatStakeManualHeadDownAllowed : BOOL;
    bHeatStakeManualHeadUpAllowed   : BOOL;
    bHeatStakeManualSupportAllowed  : BOOL;
    bHeatStakeManualActionBusy      : BOOL;
	
	// Vision Manual Mode

	tpVisionManualHorizontalBack  	: TP;
	tpVisionManualHorizontalFront 	: TP;
	


	
	rtVisionManualHorizontalBack  	: R_TRIG;
	rtVisionManualHorizontalFront 	: R_TRIG;
	rtVisionManualHome 				: R_TRIG;
	
	// Vision Manual - Vertical Intermediate


	
	bVisionManualVerticalUpActive 			: BOOL;

	bVisionManualVerticalFullDownActive     : BOOL;
	
	bVisionManualRotate0Active   			: BOOL;
	bVisionManualRotate180Active 			: BOOL;

    // Manual Heat Stake tooling-position tracking uses physical sensors.
    bHeatStakeManualHomePosition     		: BOOL;
    bHeatStakeManualOutOfHome        		: BOOL;

    bVisionHorizontalBackRequest  : BOOL;
    bVisionHorizontalFrontRequest : BOOL;
    bVisionVerticalUpRequest      : BOOL;
    bVisionVerticalDownRequest    : BOOL;

    bVisionGripCloseRequest       : BOOL;
    bVisionGripOpenRequest        : BOOL;
    bVisionRotate0Request         : BOOL;
    bVisionRotate180Request       : BOOL;
	
	//CAMERA
	bVisionTriggerRequest			: BOOL;
	bVisionChangeProgramRequest		: BOOL;
	bVisionGetResultsRequest		: BOOL;
	bVisionGetResultsReadyRequest	: BOOL;
	bVisionResetResultsRequest		: BOOL;
	bVisionAcknowledgeResultsRquest	: BOOL;
	nVisionProgramNumber			: UDINT;
	bVisionGetCurrentProgram		: UDINT;
	
	nVisionResults					: ST_VisionResults;
    rtVisionCameraResultsReset : R_TRIG;
	
		
		// Vision Manual Mode
	bVisionManualEnableAllowed          : BOOL;
    bVisionCameraStartBlocked : BOOL; // Live camera error/recovery latch; blocks new starts.
	
	bVisionHorizontalBackAllowed        : BOOL;
	bVisionHorizontalFrontAllowed       : BOOL;
	
	bVisionVerticalUpAllowed            : BOOL;

	bVisionVerticalFullDownAllowed      : BOOL;
	
	bVisionGripOpenAllowed              : BOOL;
	bVisionGripCloseAllowed             : BOOL;
	
	bVisionRotate0Allowed               : BOOL;
	bVisionRotate180Allowed             : BOOL;
	
	bVisionManualRunSequenceAllowed 	: BOOL;
	bVisionManualSequenceActive 		: BOOL;
	bVisionManualHomeAllowed 			: BOOL;
	bVisionManualHomeActive  			: BOOL;

// Already existed:
// bVisionSupportAllowed : BOOL;
    // Fault reset is latched because PRG_Events executes after PRG_Main.
    // The event manager may clear its fault latch on the same Reset scan,
    // therefore the machine must remember the request until the following scan.
    bFaultResetRequested 				: BOOL;
    bAirAndDoorEnable 					: BOOL;
    // Air can only be latched ON by System Initialising.
    // Once ON, it may remain ON through Stopping/Stopped while the main door
    // stays closed. Opening the door, or entering Fault, clears this latch.
    bAirSupplyLatched 					: BOOL;
    // PLC-originated machine faults pulse the TwinSAFE Run/Stop request low.
    // RunRequest is otherwise TRUE so TwinSAFE can execute and return Safety_OK.
    bSafetyDropRequest 					: BOOL;
    tpSafetyRunDrop 					: TP;
    tonLedBlink 						: TON;
    rtLedBlink 							: R_TRIG;
	
	tonHMIAliveOn  						: TON;
	tonHMIAliveOff 						: TON;
	bOutHMI        						: BOOL := TRUE;
	
	
	
    bLedBlinkState : BOOL;
	
	btest								: ARRAY [1..10] OF BOOL;
	ntest								: UDINT;
	
	sHeaterMinimum 						: STRING(32);
	sHeaterCurrent 						: STRING(32);
	
	// =====================================================
	// PATCH DISPENSING - MANUAL VERTICAL
	// =====================================================
    bPatchManualVerticalDownHeld : BOOL; // Volatile target; never replay DOWN after permission loss.
	
	bPatchVerticalUpAllowed   : BOOL;
	bPatchVerticalDownAllowed : BOOL;
	
	tonPatchHomeUpOutputVerify : TON;
	bPatchHomeUpOutputVerified : BOOL := FALSE;
	
    // Per-product volatile confidence/location; existing retained fitted array stays compatible.
    aVisionProductLocation : ARRAY[1..4] OF USINT; // 0 unknown, 1 nest, 2 legacy nest alias, 3 held; PBUP state is separate.
    aVisionPbupSource : ARRAY[1..4] OF USINT;
    aVisionLoadEmptySeen : ARRAY[1..4] OF BOOL;
    aVisionLoadCandidate : ARRAY[1..4] OF BOOL;
    uiVisionLoadObservedNest : UINT;
    tonVisionLoadEmpty : TON;
    tonVisionLoadPair : TON;
    bManualIndexAttempt : BOOL;
    bManualIndexStartAllowed : BOOL;
    bManualIndexWarningActive : BOOL;
    bManualIndexBlockVision : BOOL;
    bManualIndexBlockHeat : BOOL;
    bManualIndexBlockPatch : BOOL;
    bManualIndexBlockOther : BOOL;
    bManualCameraDrainResult : BOOL;
    bManualCameraDiscardedResult : BOOL;
    stManualCameraDiscardedResults : ST_VisionResults;
    bManualCameraRecoveryAllowed : BOOL;
    bManualCameraRecoveryActive : BOOL;
    bManualCameraRecoveryFailed : BOOL;
    bManualCameraCaptureAfterRecovery : BOOL;
    bManualCameraClearError0 : BOOL;
    bManualCameraClearError1 : BOOL;
    usiManualCameraRecoveryStep : USINT;
    udiManualCameraRecoveryImage : UDINT;
    udiManualCameraRecoveryError0 : UDINT;
    udiManualCameraRecoveryError1 : UDINT;
    tonManualCameraRecovery : TON;
    sManualCameraRecoveryMessage : STRING(160);
    bManualCameraResetOnly : BOOL;
    bManualCameraRecoveredPulse : BOOL;
END_VAR
VAR
    bManualCameraAllowed : BOOL;
    bManualCameraOwner : BOOL;
    bManualCameraReset : BOOL;
    bManualCameraConsume : BOOL;
    usiManualCameraStep : USINT;
    udiManualCameraProgram : UDINT;
    udiManualCameraSelection : UDINT;
    stManualCameraResults : ST_VisionResults;
    tonManualCamera : TON;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cyclic" Id="{a779d1da-ccea-489e-9adf-3c1ac0c82903}">
      <Declaration><![CDATA[METHOD PUBLIC Cyclic
VAR_INPUT
    stInputs : ST_MachineInputs;
    stCommand : ST_MachineCommand;
    stConfig : ST_MachineConfig;
    stHeatStakeTemperatureSettings : ST_HeatStakeTemperatureSettings;
    stHeatStakeProcessSettings : ST_HeatStakeProcessSettings;
    bPatchDispenseCommissioned : BOOL;
    bHeatStakeCommissioned : BOOL;
    bVisionCommissioned : BOOL;
    bCoreCommissioningMode : BOOL;
    bLogoutHMI : BOOL;
	
	
	
	
END_VAR
VAR_OUTPUT
    stOutputs : ST_MachineOutputs;
    stStatus : ST_MachineStatus;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[tVisionRotaryConfirm := UDINT_TO_TIME(GVL_Persistent.stVisionProcessSettings.udiRotaryConfirmMs);
ResetCyclicOutputs();

// Shared endpoint interpretation for automatic, HOME, Manual and HMI.
tonVisionRotate0Confirm(IN := bVisionCommissioned AND stInputs.stSafety.bSafetyOk
    AND GVL_Safety.bAirSupplySafe AND NOT stCommand.bReset
    AND stInputs.bRotaryGripperPick0 AND NOT stInputs.bRotaryGripperPlace180
    AND NOT bVisionRotate180CommandPrevious
    AND (bVisionRotate0CommandPrevious OR bVisionRotate0Confirmed), PT := tVisionRotaryConfirm);
tonVisionRotate180Confirm(IN := bVisionCommissioned AND stInputs.stSafety.bSafetyOk
    AND GVL_Safety.bAirSupplySafe AND NOT stCommand.bReset
    AND stInputs.bRotaryGripperPlace180 AND NOT stInputs.bRotaryGripperPick0
    AND NOT bVisionRotate0CommandPrevious, PT := tVisionRotaryConfirm);
bVisionRotate0Confirmed := tonVisionRotate0Confirm.Q;
bVisionRotate180Confirmed := tonVisionRotate180Confirm.Q;


// Air-memory rule:
// - only Initialising may set bAirSupplyLatched TRUE;
// - an open main door always clears it immediately;
// - therefore air can never remain ON with the door open;
// - closing the door again does NOT restore air unless a new Initialising
//   sequence is entered.
IF NOT stInputs.bMainDoorClosed THEN
    bAirSupplyLatched := FALSE;
END_IF


	
	// =====================================================
	// HEATER DWELL TIMEOUT SUPERVISION
	// =====================================================
	// Timer runs only while the machine is in Dwell.
	// Leaving Dwell automatically resets the timer.
	
	tonHeaterDwell(
		IN := (eMachineState = E_MachineState.Dwell),
		PT := stConfig.tHeaterDwellTimeout
	);
	
	// Latch the timeout fault until machine Reset.
	IF tonHeaterDwell.Q THEN
		bHeaterDwellTimeoutFault := TRUE;
	END_IF
	
	// Clear the latched Heater Dwell timeout fault
	// when the operator requests Reset from Fault.
	
	IF stCommand.bReset
		AND (eMachineState = E_MachineState.Fault)
	THEN
		bHeaterDwellTimeoutFault := FALSE;
	END_IF

// One-scan internal request. A PLC machine fault sets this TRUE below;
// TP converts it into a deterministic TwinSAFE Run/Stop drop pulse.
bSafetyDropRequest := FALSE;

// =========================================================
// REJECT CHUTE FULL SUPERVISION
// =========================================================
// The reject chute sensor can pulse briefly during a normal reject.
// Only a continuous TRUE for 2 seconds means CHUTE FULL.
tonRejectChuteFull(
    IN := stInputs.bRejectChutePartPresent,
    PT := T#2S
);

rtRejectChuteAcknowledge(
    CLK := stCommand.bAcknowledgeRejectChuteFull
);

// First confirmed full condition:
// - latch operator intervention;
// - request popup;
// - latch a controlled Stop Request.
IF tonRejectChuteFull.Q
    AND NOT bRejectChuteFullLatched
THEN
    bRejectChuteFullLatched := TRUE;
    bRejectChutePopupRequest := TRUE;
    bRejectChuteStopRequestLatched := TRUE;
END_IF

// Acknowledge is only valid for clearing the interlock when the physical
// sensor is already FALSE.
IF rtRejectChuteAcknowledge.Q
    AND bRejectChuteFullLatched
THEN
    IF NOT stInputs.bRejectChutePartPresent THEN
        bRejectChuteFullLatched := FALSE;
        bRejectChutePopupRequest := FALSE;
        bRejectChutePopupReopenPending := FALSE;
    ELSE
        // Operator acknowledged while still full: close briefly, then reopen.
        bRejectChutePopupRequest := FALSE;
        bRejectChutePopupReopenPending := TRUE;
    END_IF
END_IF

tonRejectChutePopupReopen(
    IN := bRejectChutePopupReopenPending,
    PT := T#500MS
);

IF tonRejectChutePopupReopen.Q THEN
    bRejectChutePopupReopenPending := FALSE;
    IF bRejectChuteFullLatched THEN
        bRejectChutePopupRequest := TRUE;
    END_IF
END_IF

// Capture Manual support target at the instant the controlled stop is first
// requested. If it is already travelling, allow that existing stroke to finish.
rtRejectChuteStopRequest(
    CLK := bRejectChuteStopRequestLatched
);

IF rtRejectChuteStopRequest.Q
    AND (eMachineState = E_MachineState.Manual)
THEN
    bManualSupportTargetUpAtRejectStop :=
        stCommand.bHeatStakeManualSupportUp;
END_IF


// 500 ms operator indication blink, matching the validated Silicone core.
tonLedBlink(IN := NOT tonLedBlink.Q, PT := T#500MS);
rtLedBlink(CLK := tonLedBlink.Q);
IF rtLedBlink.Q THEN
    bLedBlinkState := NOT bLedBlinkState;
END_IF

// Heat Stake temperature preheat/control.
fbHeatStakeTemperature.Cyclic(
    bEnable :=
        (eMachineState = E_MachineState.ReadyToStart)
		OR (eMachineState = E_MachineState.Dwell)
        OR (eMachineState = E_MachineState.AutoCycle)
        OR (
            (eMachineState = E_MachineState.Manual)
            AND (
                stCommand.bHeatStakeManualEnable
                OR bHeatStakeManualStakeCycleActive
            )
        ),
    bAutoCycleActive := (eMachineState = E_MachineState.AutoCycle),
    bSafetyOk := stInputs.stSafety.bSafetyOk,
    diTc1Raw := stInputs.diHeatStakeTc1Raw,
    diTc2Raw := stInputs.diHeatStakeTc2Raw,
    diTc3Raw := stInputs.diHeatStakeTc3Raw,
    stSettings := stHeatStakeTemperatureSettings,
    uiPwm1Raw => stOutputsInternal.uiHeatStakePwm1Raw,
    uiPwm2Raw => stOutputsInternal.uiHeatStakePwm2Raw,
    stStatus => stHeatStakeTemperatureStatus
);


	// =====================================================
	// HEATER LOW TEMPERATURE - DWELL REQUEST
	// =====================================================
	// Latch the request when temperature drops during AutoCycle.
	// The current station processes must finish before entering Dwell.
	
	IF (eMachineState = E_MachineState.AutoCycle)
		AND NOT stHeatStakeTemperatureStatus.bIndexTemperatureReady
		AND NOT stHeatStakeTemperatureStatus.bFault
	THEN
		bHeaterDwellRequestLatched := TRUE;
	END_IF
	
	// =====================================================
	// HEATER DWELL - REQUEST RESET
	// =====================================================
	// Preserve the request while AutoCycle is completing
	// the current production cycle.
	//
	// Clear it if the machine leaves the automatic
	// production sequence through Stop or Fault.
	
	IF (eMachineState = E_MachineState.Stopping)
		OR (eMachineState = E_MachineState.Stopped)
		OR (eMachineState = E_MachineState.Fault)
	THEN
		bHeaterDwellRequestLatched := FALSE;
	END_IF

//Camera
//---------------------------------------------------------------------------------------------------
fbVSCamera(
    stCameraIO := GVL_EtherCAT.stVSKeyenceCamera,
    udiError0Code := GVL_EtherCAT.udiVisionError0Code,
    udiError1Code := GVL_EtherCAT.udiVisionError1Code,
    bResetRequest := stCommand.bReset
);
bVisionGetCurrentProgram := fbVSCamera.GetCurrentProgram();

// Sample the physical edge even when disabled/blocked. Never create an edge on Enable.
rtManualIndexMove(CLK := stInputs.bTwoHandsSafe);
bManualIndexAttempt := rtManualIndexMove.Q AND (eMachineState = E_MachineState.Manual)
    AND stCommand.bIndexerManualEnable AND NOT bRejectChuteStopRequestLatched;

// Manual camera commands are consumed once; camera output ownership remains here.
GVL_HMI.bCameraConnected := (GVL_EtherCAT.wVisionPnState = 0)
    AND (GVL_EtherCAT.wVisionPnDiag = 2)
    AND GVL_EtherCAT.stTerm21_EL6633.stTerminalInfo.bTerminalOperational;
bManualCameraAllowed := (eMachineState = E_MachineState.Manual)
    AND stCommand.bVisionManualEnable AND stInputs.stSafety.bSafetyOk
    AND (GVL_EtherCAT.stVSKeyenceCamera.bRunStatus OR fbVSCamera.IsFaulted()
        OR bManualCameraRecoveryActive OR bVisionCameraStartBlocked
        OR fbVisionManualImages.bPrepared OR (fbVisionManualImages.usiStep = 210)
        OR fbVisionManualImages.bCameraWarning)
    AND NOT stCommand.bStop AND NOT stCommand.bReset
    AND (fbVisionManualImages.bActive
        OR (NOT stCommand.bVisionManualRunSequence AND NOT stCommand.bVisionManualHomeRequest))
    AND stInputs.bMainDoorClosed AND GVL_Safety.bAirSupplySafe
    AND bVisionCommissioned AND NOT stInputs.bEventFault
    AND NOT stInputs.bEventCycleStopRequest AND NOT bRejectChuteStopRequestLatched
    AND stInputs.bIndexReady AND stInputs.bIndexLocked AND NOT stIndexStatus.bBusy
    AND (stInputs.eIndexPosition <> E_TablePosition.Unknown)
    AND (NOT fbVision.IsBusy() OR fbVisionManualImages.bActive)
    AND NOT fbVisionManualImages.bFault
    AND NOT bVisionManualSequenceActive AND NOT bVisionManualHomeActive;
GVL_HMI.bCameraResetAllowed := (eMachineState = E_MachineState.Manual)
    AND stCommand.bVisionManualEnable AND stInputs.stSafety.bSafetyOk
    AND stInputs.bMainDoorClosed AND GVL_Safety.bAirSupplySafe AND GVL_HMI.bCameraConnected
    AND NOT stCommand.bStop AND NOT stCommand.bReset AND NOT stInputs.bEventFault
    AND NOT stInputs.bEventCycleStopRequest AND NOT bRejectChuteStopRequestLatched
    AND stInputs.bIndexReady AND stInputs.bIndexLocked AND NOT stIndexStatus.bBusy
    AND (stInputs.eIndexPosition <> E_TablePosition.Unknown)
    AND NOT bVisionManualSequenceActive AND NOT bVisionManualHomeActive
    AND (usiManualCameraStep = 0) AND NOT bManualCameraRecoveryActive
    AND NOT fbVisionManualImages.bBusy AND NOT bVisionImageJogBusy
    AND NOT stInputs.bTwoHandsSafe AND NOT stIndexStatus.bTwoHandRequired;
bManualCameraOwner := (bManualCameraAllowed
    AND (GVL_HMI.udiCameraManualImageSelection >= 1) AND (GVL_HMI.udiCameraManualImageSelection <= 4))
    OR (GVL_HMI.bCameraReset AND GVL_HMI.bCameraResetAllowed)
    OR (bManualCameraRecoveryActive AND (eMachineState = E_MachineState.Manual)
        AND stInputs.stSafety.bSafetyOk AND stInputs.bMainDoorClosed AND GVL_Safety.bAirSupplySafe
        AND GVL_HMI.bCameraConnected AND NOT stCommand.bStop AND NOT stCommand.bReset
        AND NOT stInputs.bEventFault AND NOT stInputs.bEventCycleStopRequest
        AND NOT bRejectChuteStopRequestLatched);
bManualImageTriggerCommand := GVL_HMI.bCameraManualTrigger;
bManualImageCameraFailed := FALSE;
bManualCameraRecoveredPulse := FALSE;
bManualCameraReset := FALSE;
bManualCameraConsume := FALSE;
tonManualCamera(IN := (usiManualCameraStep <> 0), PT := T#10S);
// An explicit operator click may recover camera errors. No reset/GoToRun/motion.
// A click at an already prepared position requests ONE capture after recovery.
// At HOME without a prepared image it recovers only; Prepare is still required.
bManualCameraRecoveryAllowed := bManualCameraOwner
    AND (bVisionCameraStartBlocked OR fbVisionManualImages.bCameraWarning)
    AND GVL_HMI.bCameraConnected AND (usiManualCameraStep = 0)
    AND NOT bManualCameraRecoveryActive AND NOT fbVisionManualImages.bFault
    AND NOT fbVisionManualImages.bBusy AND NOT bVisionImageJogBusy
    AND (fbVisionManualImages.bPrepared OR stVisionStatus.bHome)
    AND NOT stInputs.bTwoHandsSafe AND NOT stIndexStatus.bTwoHandRequired;
IF (bManualImageTriggerCommand AND bManualCameraRecoveryAllowed)
    OR (GVL_HMI.bCameraReset AND GVL_HMI.bCameraResetAllowed) THEN
    bManualCameraResetOnly := GVL_HMI.bCameraReset;
    bManualCameraRecoveryActive := TRUE;
    bManualCameraRecoveryFailed := FALSE;
    usiManualCameraRecoveryStep := 1;
    udiManualCameraRecoveryImage := GVL_HMI.udiCameraManualImageSelection;
    IF bManualCameraResetOnly THEN
        udiManualCameraRecoveryImage := GVL_EtherCAT.stVSKeyenceCamera.bCurrentProgramNumber + 1;
    END_IF
    bManualCameraCaptureAfterRecovery := NOT bManualCameraResetOnly AND fbVisionManualImages.bPrepared
        AND (fbVisionManualImages.udiPreparedImage = udiManualCameraRecoveryImage)
        AND bVisionPbupKnown;
    bManualCameraClearError0 := GVL_EtherCAT.stVSKeyenceCamera.abError[1];
    bManualCameraClearError1 := GVL_EtherCAT.stVSKeyenceCamera.abError[2];
    udiManualCameraRecoveryError0 := GVL_EtherCAT.udiVisionError0Code;
    udiManualCameraRecoveryError1 := GVL_EtherCAT.udiVisionError1Code;
    // Discard only the old software camera transaction. Live error feedback stays visible.
    bManualCameraReset := TRUE;
END_IF
tonManualCameraRecovery(IN := bManualCameraRecoveryActive, PT := T#3S);
IF bManualCameraRecoveryActive THEN
    bManualImageTriggerCommand := FALSE;
    IF NOT bManualCameraOwner OR NOT GVL_HMI.bCameraConnected
        OR (NOT bManualCameraResetOnly AND (GVL_HMI.udiCameraManualImageSelection <> udiManualCameraRecoveryImage))
        OR bVisionImageJogBusy OR stCommand.bStop OR stCommand.bReset
        OR (bManualCameraCaptureAfterRecovery AND NOT fbVisionManualImages.bPrepared) THEN
        bManualCameraRecoveryActive := FALSE;
        bManualCameraCaptureAfterRecovery := FALSE;
        bManualCameraRecoveryFailed := TRUE;
        sManualCameraRecoveryMessage := 'Camera recovery cancelled; no capture sent';
    ELSIF tonManualCameraRecovery.Q THEN
        bManualCameraRecoveryActive := FALSE;
        bManualCameraCaptureAfterRecovery := FALSE;
        bManualCameraRecoveryFailed := TRUE;
        sManualCameraRecoveryMessage := 'Camera recovery timeout; check camera, then retry';
    ELSIF (GVL_EtherCAT.stVSKeyenceCamera.abError[1]
            AND (NOT bManualCameraClearError0 OR (GVL_EtherCAT.udiVisionError0Code <> udiManualCameraRecoveryError0)))
        OR (GVL_EtherCAT.stVSKeyenceCamera.abError[2]
            AND (NOT bManualCameraClearError1 OR (GVL_EtherCAT.udiVisionError1Code <> udiManualCameraRecoveryError1))) THEN
        bManualCameraRecoveryActive := FALSE;
        bManualCameraCaptureAfterRecovery := FALSE;
        bManualCameraRecoveryFailed := TRUE;
        sManualCameraRecoveryMessage := 'Camera error changed; inspect camera before retry';
    ELSIF usiManualCameraRecoveryStep = 1 THEN
        sManualCameraRecoveryMessage := 'Camera: requesting error clear';
        IF NOT GVL_EtherCAT.stVSKeyenceCamera.abError[1]
            AND NOT GVL_EtherCAT.stVSKeyenceCamera.abError[2] THEN
            usiManualCameraRecoveryStep := 2;
        END_IF
    ELSE
        sManualCameraRecoveryMessage := 'Camera: waiting for RUN / clean handshake';
        IF GVL_EtherCAT.stVSKeyenceCamera.bRunStatus
            AND GVL_EtherCAT.stVSKeyenceCamera.bTriggerReady
            AND NOT GVL_EtherCAT.stVSKeyenceCamera.bTriggerAcknowledge
            AND NOT GVL_EtherCAT.stVSKeyenceCamera.bResultsReady
            AND NOT GVL_EtherCAT.stVSKeyenceCamera.bResultAck
            AND NOT GVL_EtherCAT.stVSKeyenceCamera.bProgramLoadExecute
            AND (GVL_EtherCAT.stVSKeyenceCamera.bCurrentProgramNumber = udiManualCameraRecoveryImage - 1) THEN
            bManualCameraRecoveryActive := FALSE;
            bManualCameraRecoveryFailed := FALSE;
            bManualCameraRecoveredPulse := TRUE;
            bManualImageTriggerCommand := bManualCameraCaptureAfterRecovery;
            bManualCameraCaptureAfterRecovery := FALSE;
            sManualCameraRecoveryMessage := 'Camera recovered; prepare if no position is reserved';
        END_IF
    END_IF
END_IF

GVL_HMI.bCameraReset := FALSE; // Accepted or rejected once, never queued.
IF NOT bManualCameraRecoveryActive THEN bManualCameraResetOnly := FALSE; END_IF
IF NOT bManualCameraOwner THEN
    IF usiManualCameraStep <> 0 THEN bManualCameraReset := TRUE; END_IF
    usiManualCameraStep := 0;
    GVL_HMI.bCameraManualPass := FALSE;
    GVL_HMI.bCameraManualFail := FALSE;
    GVL_HMI.sCameraManualMessage := 'Select an image in enabled Vision Manual mode';
ELSE
    IF (udiManualCameraSelection <> GVL_HMI.udiCameraManualImageSelection) AND (usiManualCameraStep = 0) THEN
        udiManualCameraSelection := GVL_HMI.udiCameraManualImageSelection;
        GVL_HMI.bCameraManualPass := FALSE;
        GVL_HMI.bCameraManualFail := FALSE;
    END_IF
    IF fbVisionManualImages.bActive AND fbVisionManualImages.bCaptureRequest
        AND (usiManualCameraStep = 0)
        AND GVL_HMI.bCameraConnected AND GVL_EtherCAT.stVSKeyenceCamera.bRunStatus
        AND NOT fbVSCamera.IsFaulted() THEN
        udiManualCameraProgram := fbVisionManualImages.udiPreparedImage - 1;
        usiManualCameraStep := 10;
        bManualCameraReset := TRUE;
        GVL_HMI.bCameraManualPass := FALSE;
        GVL_HMI.bCameraManualFail := FALSE;
        GVL_HMI.sCameraManualMessage := 'Loading selected program';
    END_IF
    IF usiManualCameraStep <> 0 THEN
        IF fbVisionManualImages.bCameraWarning
            OR NOT GVL_HMI.bCameraConnected OR NOT GVL_EtherCAT.stVSKeyenceCamera.bRunStatus
            OR fbVSCamera.IsFaulted() OR fbVSCamera.bRecoveryFailed OR tonManualCamera.Q THEN
            usiManualCameraStep := 0;
            bManualCameraReset := TRUE;
            bManualImageCameraFailed := TRUE;
            GVL_HMI.sCameraManualMessage := 'Capture aborted: connection, Run, camera error or timeout';
        ELSIF (usiManualCameraStep = 10)
            AND (GVL_EtherCAT.stVSKeyenceCamera.bCurrentProgramNumber = udiManualCameraProgram)
            AND NOT GVL_EtherCAT.stVSKeyenceCamera.bProgramLoadExecute THEN
            usiManualCameraStep := 20;
            GVL_HMI.sCameraManualMessage := 'Waiting for capture';
        ELSIF (usiManualCameraStep = 30)
            AND NOT GVL_EtherCAT.stVSKeyenceCamera.bResultsReady
            AND NOT GVL_EtherCAT.stVSKeyenceCamera.bTriggerAcknowledge THEN
            usiManualCameraStep := 0;
        END_IF
    END_IF
END_IF
GVL_HMI.bCameraManualTrigger := FALSE;
IF bManualCameraOwner THEN
    IF (usiManualCameraStep = 0) AND bManualCameraResetOnly THEN
        udiManualCameraProgram := udiManualCameraRecoveryImage - 1;
    ELSIF (usiManualCameraStep = 0) AND (GVL_HMI.udiCameraManualImageSelection >= 1)
        AND (GVL_HMI.udiCameraManualImageSelection <= 4) THEN
        udiManualCameraProgram := GVL_HMI.udiCameraManualImageSelection - 1;
    END_IF
END_IF

// Reset the accumulated payload before sampling any result in the new cycle.
rtVisionCameraResultsReset(CLK := (stVisionStatus.eState = E_PatchStationState.Processing));
IF bManualCameraReset OR bVisionResetResultsRequest OR rtVisionCameraResultsReset.Q THEN
    fbVSCamera.GetResults(stVisionResults => nVisionResults, bResetResults := TRUE);
END_IF

// Apply previous-scan station commands, then sample ACK/result in this scan.
// Close an unacknowledged moving-picture request at the physical 180 end sensor.
IF (bManualCameraOwner AND (usiManualCameraStep = 0))
    OR (NOT bManualCameraOwner AND NOT bVisionTriggerRequest) THEN
    bVisionRotatingCaptureAccepted := FALSE;
END_IF
bVisionTriggerAccepted := fbVSCamera.RequestTrigger(
    bEnable := (bManualCameraOwner AND (usiManualCameraStep = 20)
        AND ((udiManualCameraProgram <> 1) OR NOT fbVisionManualImages.bMovingCapture
            OR NOT stInputs.bRotaryGripperPlace180 OR bVisionRotatingCaptureAccepted
            OR GVL_EtherCAT.stVSKeyenceCamera.bTriggerAcknowledge))
        OR (NOT bManualCameraOwner AND bVisionTriggerRequest
        AND ((GVL_EtherCAT.stVSKeyenceCamera.bCurrentProgramNumber <> 1)
            OR NOT stInputs.bRotaryGripperPlace180
            OR bVisionRotatingCaptureAccepted
            OR GVL_EtherCAT.stVSKeyenceCamera.bTriggerAcknowledge)));
IF bVisionTriggerAccepted AND (GVL_EtherCAT.stVSKeyenceCamera.bCurrentProgramNumber = 1) THEN
    bVisionRotatingCaptureAccepted := TRUE;
END_IF
IF bManualCameraOwner THEN
    fbVSCamera.RequestChangeProgram(bEnable := NOT bManualCameraResetOnly, nProgramNumber := udiManualCameraProgram);
ELSE
    fbVSCamera.RequestChangeProgram(bEnable := bVisionChangeProgramRequest, nProgramNumber := nVisionProgramNumber);
END_IF
fbVSCamera.Cyclic();
// A pre-existing camera error must be visible before a new station attempt.
bVisionCameraStartBlocked := fbVSCamera.IsFaulted() OR fbVSCamera.bRecoveryFailed;
bVisionGetResultsReadyRequest := fbVSCamera.GetResultsReady();
IF bManualCameraOwner AND (usiManualCameraStep = 20) AND bVisionGetResultsReadyRequest THEN
    bManualCameraConsume := fbVSCamera.GetResults(stVisionResults => stManualCameraResults, bResetResults := FALSE);
    IF bManualCameraConsume THEN
        GVL_HMI.bCameraManualPass := stManualCameraResults.aInspectionCompleted[udiManualCameraProgram + 1]
            AND stManualCameraResults.aInspectionPassed[udiManualCameraProgram + 1];
        GVL_HMI.bCameraManualFail := stManualCameraResults.aInspectionCompleted[udiManualCameraProgram + 1]
            AND NOT stManualCameraResults.aInspectionPassed[udiManualCameraProgram + 1];
        GVL_HMI.udiCameraManualCaptureCount := GVL_HMI.udiCameraManualCaptureCount + 1;
        GVL_HMI.sCameraManualMessage := 'Capture complete';
        usiManualCameraStep := 30;
    END_IF
END_IF
GVL_HMI.bCameraManualAllowed := bManualCameraAllowed;
GVL_HMI.bCameraManualBusy := bManualCameraRecoveryActive OR (usiManualCameraStep <> 0)
    OR (bManualCameraOwner AND GVL_HMI.bCameraConnected AND GVL_EtherCAT.stVSKeyenceCamera.bRunStatus
        AND (GVL_EtherCAT.stVSKeyenceCamera.bCurrentProgramNumber <> udiManualCameraProgram));
bManualCameraTransportReady := bManualCameraOwner AND GVL_HMI.bCameraConnected
    AND GVL_EtherCAT.stVSKeyenceCamera.bRunStatus AND NOT fbVSCamera.IsFaulted()
    AND NOT fbVSCamera.bRecoveryFailed AND NOT GVL_HMI.bCameraManualBusy
    AND (GVL_EtherCAT.stVSKeyenceCamera.bCurrentProgramNumber = udiManualCameraProgram)
    AND GVL_EtherCAT.stVSKeyenceCamera.bTriggerReady
    AND NOT GVL_EtherCAT.stVSKeyenceCamera.bTriggerAcknowledge
    AND NOT GVL_EtherCAT.stVSKeyenceCamera.bResultsReady
    AND NOT GVL_EtherCAT.stVSKeyenceCamera.bResultAck
    AND NOT bManualCameraRecoveryActive;


IF NOT bManualCameraOwner AND bVisionGetResultsRequest
    AND NOT bVisionResetResultsRequest
    AND NOT rtVisionCameraResultsReset.Q THEN
    fbVSCamera.GetResults(stVisionResults => nVisionResults, bResetResults := FALSE);
END_IF

bManualCameraDrainResult := FALSE;
IF bManualCameraOwner AND (usiManualCameraStep = 0)
    AND NOT fbVisionManualImages.bBusy AND NOT fbVisionManualImages.bCaptureRequest
    AND NOT fbVSCamera.IsFaulted() AND NOT fbVSCamera.bRecoveryFailed THEN
    bManualCameraDiscardedResult := fbVSCamera.GetResults(
        stVisionResults => stManualCameraDiscardedResults, bResetResults := FALSE);
    bManualCameraDrainResult := GVL_EtherCAT.stVSKeyenceCamera.bResultsReady
        OR bManualCameraDiscardedResult;
END_IF

// Copy the latched payload before acknowledging/releasing it.
IF bManualCameraDrainResult OR (bManualCameraOwner AND (usiManualCameraStep = 30))
    OR (NOT bManualCameraOwner AND bVisionAcknowledgeResultsRquest
        AND bVisionGetResultsRequest
        AND NOT bVisionResetResultsRequest
        AND NOT rtVisionCameraResultsReset.Q) THEN
    fbVSCamera.RequestResultsAck(bEnable := TRUE);
ELSE
    fbVSCamera.RequestResultsAck(bEnable := FALSE);
END_IF
// Explicit operator recovery is the only manual owner of these clear outputs.
// FB_VSCamera.Cyclic defaults them FALSE each scan; never clear a new/different error.
IF bManualCameraRecoveryActive AND (usiManualCameraRecoveryStep = 1) THEN
    GVL_EtherCAT.stVSKeyenceCamera.abErrorClear[1] := bManualCameraClearError0
        AND GVL_EtherCAT.stVSKeyenceCamera.abError[1];
    GVL_EtherCAT.stVSKeyenceCamera.abErrorClear[2] := bManualCameraClearError1
        AND GVL_EtherCAT.stVSKeyenceCamera.abError[2];
END_IF
IF bManualCameraTransportReady THEN bManualCameraRecoveryFailed := FALSE; END_IF
GVL_MASTER.bManualCameraRecoveryFailed := bManualCameraRecoveryFailed;
//---------------------------------------------------------------------------------------------------

// Patch feeding owns its axis commands; it does not own physical safety outputs.
// Stopping withdraws M1 control. FB_PatchFeedAxis retains power for its own
// controlled halt; do not start a previously idle M1 simply by entering Stopping.
fbPatchFeedManager.Cyclic(
    bDrivePermit := bPatchDispenseCommissioned AND stInputs.bMainDoorClosed
        AND GVL_Safety.bAirSupplySafe AND NOT stInputs.bEventFault
        AND ((eMachineState = E_MachineState.AutoCycle)
            OR ((eMachineState = E_MachineState.Manual)
                AND (stCommand.bPatchManualEnable OR fbPatchDispense.IsBusy()))),
    bDriveRunRequest := bPatchDriveRunRequest,
    bPermit := bPatchDispenseCommissioned
        AND ((eMachineState = E_MachineState.AutoCycle)
            OR ((eMachineState = E_MachineState.Manual) AND stCommand.bPatchManualEnable))
        AND stInputs.bMainDoorClosed AND GVL_Safety.bAirSupplySafe
        AND NOT stCommand.bStop AND NOT stInputs.bEventFault
        AND NOT stInputs.bEventCycleStopRequest
        AND NOT bRejectChuteStopRequestLatched AND NOT bAutoCycleStopRequestLatched,
    bSafetyOk := stInputs.stSafety.bMotionSafetyPermitted,
    bReset := stCommand.bReset,
    bMiddleDown := stInputs.bMiddleRockerDown,
    bMiddleUp := stInputs.bMiddleRockerUp,
    bTopDown := stInputs.bTopRockerDown,
    bTopUp := stInputs.bTopRockerUp,
    bPatchFeedStart := stInputs.bBottomRockerUp, // Term19 Input14
    bPatchFeedStop := stInputs.bBottomRockerDown, // Term19 Input13
    stSettings := GVL_Motion.stPatchFeedSettings,
    stDriveMotor := GVL_Motion.AxisDriveMotor,
    stPatchFeedRoll := GVL_Motion.AxisPatchFeedRollMotor,
    stWasteRoll := GVL_Motion.AxisWasteRollMotor
);
GVL_Motion.stPatchFeedStatus := fbPatchFeedManager.stStatus;

// Start-only load policy: two components, or an empty nest when configured.
bOperatorLoadValid :=
    (stInputs.bLoadingStationEaglePresent AND stInputs.bLoadingStationPbupPresent)
    OR (NOT stInputs.bLoadingStationEaglePresent AND NOT stInputs.bLoadingStationPbupPresent
        AND stConfig.bAllowEmptyNestIndex);
fbNestManager.Cyclic(
    bIndexStable := stInputs.bIndexReady AND stInputs.bIndexLocked AND NOT stIndexStatus.bBusy,
    eIndexPosition := stInputs.eIndexPosition,
    eOperatorPosition := stConfig.eOperatorPosition,
    bPartPresent := stInputs.bLoadingStationEaglePresent,
    bPbupPresent := stInputs.bLoadingStationPbupPresent,
    bOperatorReloadPermitted := (eMachineState = E_MachineState.AutoCycle)
        AND ((stOperatorStatus.eState = E_OperatorExchangeState.WaitingForPartLoading)
            OR (stOperatorStatus.eState = E_OperatorExchangeState.ExchangeComplete)),
    aNestEnabled := stConfig.aNestEnabled
);

// =====================================================
// PRODUCTION STATISTICS RESET
// =====================================================
// Reset only the accumulated production counters for
// the selected physical nest.
//
// Test History, current nest data and process results
// are deliberately preserved.

IF (stCommand.uiResetStatisticsNestId >= 1)
    AND (stCommand.uiResetStatisticsNestId <= 4)
THEN

    fbNestManager.ResetNestStatistics(
        uiNestId := stCommand.uiResetStatisticsNestId
    );

END_IF


stOperatorNest := fbNestManager.GetNestAtPosition(stConfig.eOperatorPosition);
stPatchDispenseNest := fbNestManager.GetNestAtPosition(stConfig.ePatchDispensePosition);
stHeatStakeNest := fbNestManager.GetNestAtPosition(stConfig.eHeatStakePosition);
stVisionNest := fbNestManager.GetNestAtPosition(stConfig.eVisionPosition);

// Publish the actual nest currently occupying each process station.
//
// The station nest structures above are already resolved by the
// FB_NestTableManager and are confirmed online to contain the correct nId.
// Use those resolved values directly instead of performing a second
// GetNestIdAtPosition() lookup.
stStatus.uiPatchDispenseNestId := stPatchDispenseNest.nId;
stStatus.uiHeatStakeNestId := stHeatStakeNest.nId;
stStatus.uiVisionNestId := stVisionNest.nId;

aNestSnapshot := fbNestManager.GetAllNests();

bDisabledNestPartPresent := FALSE;
uiDisabledNestPartNestId := 0;

FOR iNestCheck := 1 TO 4 DO
    IF (NOT stConfig.aNestEnabled[iNestCheck])
        AND (aNestSnapshot[iNestCheck].bPartPresent OR aNestSnapshot[iNestCheck].bPbupPresent)
    THEN
        bDisabledNestPartPresent := TRUE;

        IF uiDisabledNestPartNestId = 0 THEN
            uiDisabledNestPartNestId := INT_TO_UINT(iNestCheck);
        END_IF
    END_IF
END_FOR

// A process is required only when:
// - the physical nest contains a part;
// - this stage is still Waiting;
// - every upstream process required for product validity has passed.
//
// This gives deterministic recovery after faults and prevents a failed product
// from being processed by downstream stations.
bPatchDispenseRequired :=
    stPatchDispenseNest.bPartPresent
    AND stPatchDispenseNest.bLoadSetComplete
    AND (stPatchDispenseNest.ePatchDispenseStage = E_NestStageStatus.Waiting);

bHeatStakeRequired :=
    stHeatStakeNest.bPartPresent
    AND stHeatStakeNest.bLoadSetComplete
    AND (stHeatStakeNest.eDisposition <> E_PartDisposition.Reprocess)
    AND (stHeatStakeNest.ePatchDispenseStage = E_NestStageStatus.Complete)
    AND (stHeatStakeNest.eHeatStakeStage = E_NestStageStatus.Waiting);

bVisionRequired :=
    stVisionNest.bPartPresent
    AND stVisionNest.bLoadSetComplete
    AND (stVisionNest.eDisposition <> E_PartDisposition.Reprocess)
    AND (stVisionNest.ePatchDispenseStage = E_NestStageStatus.Complete)
    AND (stVisionNest.eHeatStakeStage = E_NestStageStatus.Complete)
    AND (stVisionNest.eVisionStage = E_NestStageStatus.Waiting);

// Capture active-process state BEFORE station Update(). On Safety loss the
// station FB deliberately goes Disabled in the same scan, so querying IsBusy()
// after Update() would lose the information needed to reject the affected part.
bPatchDispenseProcessingBeforeUpdate := fbPatchDispense.IsBusy();
bHeatStakeProcessingBeforeUpdate := fbHeatStake.IsBusy();
bVisionProcessingBeforeUpdate := fbVision.IsBusy()
    AND NOT fbVisionManualImages.bActive AND NOT bVisionImageOwnedBeforeUpdate;

fbOperatorStation.Cyclic(bAutomaticActive := (eMachineState = E_MachineState.AutoCycle), bIndexStable := stInputs.bIndexReady AND stInputs.bIndexLocked AND NOT stIndexStatus.bBusy, stOperatorNest := stOperatorNest, bPartPresent := stInputs.bLoadingStationEaglePresent,
    bPbupPresent := stInputs.bLoadingStationPbupPresent, bTwoHandsSafe := stInputs.bTwoHandsSafe,
    bResetRequest := stCommand.bReset, bRejectChutePartPresent := stInputs.bRejectChutePartPresent, bRequireRejectConfirm := stConfig.bRequireRejectConfirm
        OR (stOperatorNest.stHeatStakeResult.bValid
            AND (stOperatorNest.stHeatStakeResult.udiAlertCode = GVL_MASTER.udiHeatStakePatchMissingAlertCode)), bAllowEmptyNestIndex := stConfig.bAllowEmptyNestIndex);
stOperatorStatus := fbOperatorStation.GetStatus();

// Acknowledge only this physical nest's warning on the operator's accepted reject edge.
// Reset, stop, fault, sensor recovery and mere part removal do not clear it.
IF stOperatorStatus.bRejectEdgeAccepted
    AND stInputs.bIndexReady AND stInputs.bIndexLocked AND NOT stIndexStatus.bBusy
    AND (stInputs.eIndexPosition <> E_TablePosition.Unknown)
    AND (stOperatorNest.nId >= 1) AND (stOperatorNest.nId <= 4)
    AND stOperatorNest.stHeatStakeResult.bValid
    AND (stOperatorNest.stHeatStakeResult.udiAlertCode = GVL_MASTER.udiHeatStakePatchMissingAlertCode)
THEN
    stHeatStakePresenceResult := stOperatorNest.stHeatStakeResult;
    stHeatStakePresenceResult.udiAlertCode := 0;
    fbNestManager.StoreHeatStakeResultAtPosition(
        ePosition := stConfig.eOperatorPosition,
        stResult := stHeatStakePresenceResult);
END_IF

bPatchStartAllowed := stInputs.bIndexReady AND stInputs.bIndexLocked
    AND NOT stIndexStatus.bBusy AND NOT stCommand.bStop AND NOT stCommand.bReset
    AND NOT stCommand.bManualIndexForward AND NOT stInputs.bEventFault
    AND NOT stInputs.bEventCycleStopRequest AND NOT bRejectChuteStopRequestLatched
    AND NOT bAutoCycleStopRequestLatched AND NOT bProcessRequestIndex
    AND NOT bPatchManualVerticalDownHeld
// TEMP_NO_PATCH_NEST_SUPPORT: original code retained for restoration.
//     AND NOT stCommand.bPatchVerticalUpRequest AND NOT stCommand.bPatchVerticalDownRequest
//     AND NOT stCommand.bPatchSupportExtendRequest AND NOT stCommand.bPatchSupportRetractRequest;
    AND NOT stCommand.bPatchVerticalUpRequest AND NOT stCommand.bPatchVerticalDownRequest;

// Apply the ProcessCycle commands generated on the previous scan.
IF stCommand.bReset OR bProcessCycleCompletePulse THEN
    fbPatchDispense.RequestReset();
    fbHeatStake.RequestReset();
    fbVision.RequestReset();
END_IF

IF (bProcessStopStations OR (eMachineState = E_MachineState.Stopping)
        OR ((eMachineState = E_MachineState.Manual)
            AND (stCommand.bStop OR NOT stCommand.bPatchManualEnable OR bRejectChuteStopRequestLatched)))
    AND fbPatchDispense.IsBusy() THEN
    fbPatchDispense.RequestStop();
END_IF

IF bProcessStopStations THEN
    fbHeatStake.RequestStop();
    fbVision.RequestStop();
END_IF

// Do not apply a previous-scan automatic start after camera RUN is lost.
IF NOT GVL_EtherCAT.stVSKeyenceCamera.bRunStatus THEN
    bProcessStartStations := FALSE;
END_IF

IF bProcessStartStations THEN
    bCycleResultsStored := FALSE;

    IF bPatchDispenseRequired THEN
        IF bPatchStartAllowed THEN fbPatchDispense.RequestStart(); END_IF
    ELSE
        fbNestManager.MarkPatchDispenseNotTestedAtPosition(stConfig.ePatchDispensePosition);
    END_IF

    IF bHeatStakeRequired THEN
        // Product crosscheck at admission, before any Heat Stake sequence is requested.
        IF NOT stInputs.bHeatStakeEaglePresent THEN
            IF (eMachineState = E_MachineState.AutoCycle)
                AND stInputs.stSafety.bSafetyOk
                AND stInputs.bIndexReady AND stInputs.bIndexLocked AND NOT stIndexStatus.bBusy
                AND (stInputs.eIndexPosition <> E_TablePosition.Unknown)
                AND (stHeatStakeNest.nId >= 1) AND (stHeatStakeNest.nId <= 4)
                AND NOT fbHeatStake.IsBusy()
            THEN
                stHeatStakePresenceResult := stEmptyHeatStakePresenceResult;
                stHeatStakePresenceResult.bValid := TRUE;
                stHeatStakePresenceResult.bPassed := FALSE;
                stHeatStakePresenceResult.eCode := E_ProcessResultCode.Fail;
                stHeatStakePresenceResult.udiAlertCode := GVL_MASTER.udiHeatStakePatchMissingAlertCode;
                stHeatStakePresenceResult.sDetail := 'Patch not detected at Heat Stake - Heat FAIL / Vision NOT TESTED';
                fbNestManager.StoreHeatStakeResultAtPosition(
                    ePosition := stConfig.eHeatStakePosition,
                    stResult := stHeatStakePresenceResult);
                // Reclassify immediately so completion/fault handling cannot overwrite this FAIL.
                stHeatStakeNest := fbNestManager.GetNestAtPosition(stConfig.eHeatStakePosition);
                bHeatStakeRequired := FALSE;
            END_IF
        ELSE
            fbHeatStake.RequestStart();
        END_IF
    ELSE
        // Keep this product FAIL across cycle restarts until its reject is confirmed.
        IF NOT (stHeatStakeNest.stHeatStakeResult.bValid
            AND (stHeatStakeNest.stHeatStakeResult.udiAlertCode = GVL_MASTER.udiHeatStakePatchMissingAlertCode)) THEN
            fbNestManager.MarkHeatStakeNotTestedAtPosition(stConfig.eHeatStakePosition);
        END_IF
    END_IF

    IF bVisionRequired THEN
        fbVision.RequestStart();
    ELSE
        fbNestManager.MarkVisionNotTestedAtPosition(stConfig.eVisionPosition);
    END_IF
END_IF

bPatchManualAllowed :=
    (eMachineState = E_MachineState.Manual)
    AND stCommand.bPatchManualEnable
    AND stInputs.stSafety.bSafetyOk
    AND GVL_Safety.bAirSupplySafe
    AND NOT bRejectChuteStopRequestLatched
    AND bPatchDispenseCommissioned;

// Station 1 nest support removed; legacy support commands have no execution path.

// Detect machine Initialising entry.
// HOME requests are issued once per Initialising sequence.

rtMachineInitialising(
    CLK := (eMachineState = E_MachineState.Initialising)
);

IF rtMachineInitialising.Q THEN
    fbPatchDispense.Home();

    // FUTURE IMPLEMENTATION:
    // fbHeatStake.Home();
    // fbVision.Home();
END_IF

fbPatchDispense.Update(stProcessSettings := GVL_Persistent.stPatchProcessSettings,
    bRunSequenceRequest := stCommand.bPatchManualRunSequence,
    bFeedOnlyRequest := stCommand.bPatchDispenseRequest,
    bStartPermitted := bPatchStartAllowed,
    bHoldUpRequired := bPatchDispenseCommissioned
        AND ((eMachineState = E_MachineState.AutoCycle)
            OR ((eMachineState = E_MachineState.Manual)
                AND (NOT bPatchManualVerticalDownHeld OR stCommand.bIndexerManualEnable OR stIndexStatus.bBusy))
            OR ((eMachineState = E_MachineState.Stopping) AND stIndexStatus.bBusy)),
    bPatchOpticalLeft := stInputs.bPatchOpticalLeft,
    bPatchOpticalRight := stInputs.bPatchOpticalRight,
    // Dispense requires physical UP/DOWN feedback.
    bUseVerticalFeedback := TRUE,
    tVerticalMoveTime := GVL_Motion.stPatchFeedSettings.tPatchVerticalMoveTime,
    bVerticalUpCommand := bPatchVerticalUpCommandPrevious,
    bVerticalDownCommand := bPatchVerticalDownCommandPrevious,
    bVerticalIndexReady => bPatchVerticalIndexReady,
    bVerticalUp := stInputs.bMembraneTransferRetracted,
    bVerticalDown := stInputs.bMembraneTransferExtended,
    bDriveStandstill := GVL_Motion.AxisDriveMotor.bStandstill,
    bDriveBusy := fbPatchFeedManager.stStatus.bDriveBusy,
    bDriveMoving := GVL_Motion.AxisDriveMotor.bMoving,
    bDriveFault := GVL_Motion.AxisDriveMotor.bError,
    bDriveRunRequest => bPatchDriveRunRequest,
    bAirBlowRequest => bPatchSequenceAirRequest,
    bVerticalDownRequest => bPatchSequenceDownRequest,
    bEnable :=
        (
            (eMachineState = E_MachineState.Initialising)
            AND GVL_Safety.bAirSupplySafe
        )
        OR (eMachineState = E_MachineState.ReadyToStart)
        OR (eMachineState = E_MachineState.AutoCycle)
        OR (
            (eMachineState = E_MachineState.Manual)
            AND stCommand.bPatchManualEnable
            AND stInputs.stSafety.bSafetyOk
            AND GVL_Safety.bAirSupplySafe
            AND NOT bRejectChuteStopRequestLatched
            AND bPatchDispenseCommissioned
        ),

    bManualMode :=
        (eMachineState = E_MachineState.Manual),

    // Removed support: compatibility-only pins are ignored by the station FB.
    bManualSupportExtendDesired := FALSE,

    bCommissioned := bPatchDispenseCommissioned,

    bSafetyOk :=
        stInputs.stSafety.bSafetyOk
        AND GVL_Safety.bAirSupplySafe,

    bHomingAllowed :=
        (eMachineState = E_MachineState.Initialising)
        AND GVL_Safety.bAirSupplySafe
        AND stInputs.stSafety.bSafetyOk,

    bSupervisionEnable :=
        (eMachineState = E_MachineState.ReadyToStart)
        OR (eMachineState = E_MachineState.AutoCycle)
        OR (eMachineState = E_MachineState.Manual),

    bReset := stCommand.bReset,

    bSupportRetracted := FALSE,
    bSupportExtended := FALSE,

    tSupportTimeout := T#5S,

    stStatus => stPatchDispenseStatus,

    bVerticalUpRequest =>
        bPatchHomeVerticalUpRequest
);
GVL_HMI.stCommands.bPatchManualRunSequence := FALSE;
GVL_HMI.stCommands.bPatchDispenseRequest := FALSE;
// =====================================================
// PATCH DISPENSING - MANUAL VERTICAL
// =====================================================
// HMI commands remain one-scan requests. Maintain the selected valve direction.
// A lost permission cancels DOWN; a fresh request is required to descend again.
IF NOT bPatchManualAllowed OR NOT stInputs.bMainDoorClosed
    OR stCommand.bStop OR stCommand.bReset OR stInputs.bEventFault
    OR stInputs.bEventCycleStopRequest OR stPatchDispenseStatus.bFault
    OR fbPatchDispense.IsBusy() OR stIndexStatus.bBusy
    OR stCommand.bIndexerManualEnable OR stCommand.bManualIndexForward
    OR bProcessRequestIndex THEN
    bPatchManualVerticalDownHeld := FALSE;
ELSIF stCommand.bPatchVerticalUpRequest AND NOT stCommand.bPatchVerticalDownRequest THEN
    bPatchManualVerticalDownHeld := FALSE;
ELSIF stCommand.bPatchVerticalDownRequest AND NOT stCommand.bPatchVerticalUpRequest THEN
    bPatchManualVerticalDownHeld := TRUE;
END_IF



fbHeatStake.Update(
    bEnable :=
        (eMachineState = E_MachineState.Initialising 
			AND GVL_Safety.bAirSupplySafe)
        OR (eMachineState = E_MachineState.ReadyToStart)
        OR (eMachineState = E_MachineState.AutoCycle)
        OR (eMachineState = E_MachineState.Manual),
    bCommissioned := bHeatStakeCommissioned,
    bSafetyOk := stInputs.stSafety.bSafetyOk,
    bSupervisionEnable := (eMachineState = E_MachineState.ReadyToStart)
        OR (eMachineState = E_MachineState.AutoCycle)
        OR (eMachineState = E_MachineState.Manual),
    bManualMode := (eMachineState = E_MachineState.Manual),
    bReset := stCommand.bReset,
    bSupportRetracted := stInputs.bStation2SupportRetracted,
    bSupportExtended := stInputs.bStation2SupportExtended,
    bHeadUpSensor := stInputs.bHeatStakeHeadUp,
    bHeadDownSensor := stInputs.bHeatStakeHeadDown,
    tSupportTimeout := stConfig.tStationSupportTimeout,
    tHeadMoveTimeout := stConfig.tHeatStakeHeadMoveTimeout,
    stProcessSettings := stHeatStakeProcessSettings,
    stStatus => stHeatStakeStatus,
    bSupportExtendRequest => bStation2SupportExtendRequest,
    bSupportRetractRequest => bStation2SupportRetractRequest,
    bHeadLockRequest => bHeatStakeHeadLockRequest,
    bHeadUnlockRequest => bHeatStakeHeadUnlockRequest,
    bHeadDownRequest => bHeatStakeHeadDownRequest,
    bHeadUpRequest => bHeatStakeHeadUpRequest,
    rPressureCommandBar => rHeatStakePressureCommandBar,
    bContactDwellActive => bHeatStakeContactDwellActive,
    usiSequenceStep => usiHeatStakeSequenceStep,
    bHeadDownTimeoutFault => bHeatStakeStationHeadDownTimeoutFault,
	bHeadDownStarted => bHeatStakeHeadDownStarted,
    bHeadUpTimeoutFault => bHeatStakeStationHeadUpTimeoutFault,
    bHeadSensorConflictFault => bHeatStakeStationHeadSensorConflictFault
);

// -------------------------------------------------------------------------
// Heat Stake Manual Mode
// -------------------------------------------------------------------------
rtHeatStakeManualStakePatch(CLK := stCommand.bHeatStakeManualStakePatch);
rtHeatStakeManualUnlock(CLK := stCommand.bHeatStakeManualUnlock);
rtHeatStakeManualLock(CLK := stCommand.bHeatStakeManualLock);
rtHeatStakeManualHeadDown(CLK := stCommand.bHeatStakeManualHeadDown);
rtHeatStakeManualHeadUp(CLK := stCommand.bHeatStakeManualHeadUp);
rtHeatStakeInitialising(CLK := (eMachineState = E_MachineState.Initialising));

IF stCommand.bReset THEN
    bHeatStakeManualHeadDownTimeoutFault := FALSE;
    bHeatStakeManualHeadUpTimeoutFault := FALSE;
END_IF

// System Initialising establishes the known Heat Stake home condition once:
IF rtHeatStakeInitialising.Q THEN
    usiHeatStakeManualActionStep := 100;
    tonHeatStakeManualAction(IN := FALSE);
END_IF

bHeatStakeManualActionBusy := (usiHeatStakeManualActionStep <> 0);

// Manual tooling HOME is based on real feedback.
bHeatStakeManualHomePosition :=
    stInputs.bStation2SupportRetracted
    AND stInputs.bHeatStakeHeadUp
    AND NOT stInputs.bHeatStakeHeadDown
    AND NOT bHeatStakeManualHeadUnlocked
    AND NOT bHeatStakeManualActionBusy;

bHeatStakeManualOutOfHome :=
    (eMachineState = E_MachineState.Manual)
    AND NOT bHeatStakeManualHomePosition;

bHeatStakeManualEnableAllowed :=
    (eMachineState = E_MachineState.Manual)
    AND NOT bRejectChuteStopRequestLatched
    AND stInputs.stSafety.bSafetyOk
    AND NOT fbHeatStake.IsBusy()
    AND NOT bHeatStakeManualActionBusy;

bHeatStakeManualUnlockAllowed :=
    NOT stIndexStatus.bBusy AND NOT stIndexStatus.bTwoHandRequired
    AND NOT stInputs.bTwoHandsSafe AND NOT bManualCameraRecoveryActive
    AND (
    (eMachineState = E_MachineState.Manual)
    AND stCommand.bHeatStakeManualEnable
    AND NOT bRejectChuteStopRequestLatched
    AND stInputs.stSafety.bSafetyOk
    AND NOT fbHeatStake.IsBusy()
    AND NOT bHeatStakeManualActionBusy
    AND NOT bHeatStakeManualHeadUnlocked);

bHeatStakeManualLockAllowed :=
    NOT stIndexStatus.bBusy AND NOT stIndexStatus.bTwoHandRequired
    AND NOT stInputs.bTwoHandsSafe AND NOT bManualCameraRecoveryActive
    AND (
    (eMachineState = E_MachineState.Manual)
    AND stCommand.bHeatStakeManualEnable
    AND NOT bRejectChuteStopRequestLatched
    AND stInputs.stSafety.bSafetyOk
    AND NOT fbHeatStake.IsBusy()
    AND NOT bHeatStakeManualActionBusy
    AND bHeatStakeManualHeadUnlocked);

bHeatStakeManualHeadDownAllowed :=
    NOT stIndexStatus.bBusy AND NOT stIndexStatus.bTwoHandRequired
    AND NOT stInputs.bTwoHandsSafe AND NOT bManualCameraRecoveryActive
    AND (
    (eMachineState = E_MachineState.Manual)
    AND stCommand.bHeatStakeManualEnable
    AND NOT bRejectChuteStopRequestLatched
    AND stInputs.stSafety.bSafetyOk
    AND NOT fbHeatStake.IsBusy()
    AND NOT bHeatStakeManualActionBusy
    AND bHeatStakeManualHeadUnlocked
    AND stInputs.bHeatStakeHeadUp
    AND NOT stInputs.bHeatStakeHeadDown
    // Product protection also applies to a manual DOWN request with a loaded nest.
    AND (NOT stHeatStakeNest.bPartPresent OR stInputs.bHeatStakeEaglePresent)
    AND NOT (stHeatStakeNest.stHeatStakeResult.bValid
        AND (stHeatStakeNest.stHeatStakeResult.udiAlertCode = GVL_MASTER.udiHeatStakePatchMissingAlertCode)));

bHeatStakeManualHeadUpAllowed :=
    NOT stIndexStatus.bBusy AND NOT stIndexStatus.bTwoHandRequired
    AND NOT stInputs.bTwoHandsSafe AND NOT bManualCameraRecoveryActive
    AND (
    (eMachineState = E_MachineState.Manual)
    AND stCommand.bHeatStakeManualEnable
    AND NOT bRejectChuteStopRequestLatched
    AND stInputs.stSafety.bSafetyOk
    AND NOT fbHeatStake.IsBusy()
    AND NOT bHeatStakeManualActionBusy
    AND bHeatStakeManualHeadUnlocked
    AND NOT stInputs.bHeatStakeHeadUp);

bHeatStakeManualSupportAllowed :=
    NOT stIndexStatus.bBusy AND NOT stIndexStatus.bTwoHandRequired
    AND NOT stInputs.bTwoHandsSafe AND NOT bManualCameraRecoveryActive
    AND (
    (eMachineState = E_MachineState.Manual)
    AND stCommand.bHeatStakeManualEnable
    AND stInputs.stSafety.bSafetyOk
    AND NOT fbHeatStake.IsBusy()
    AND NOT bHeatStakeManualActionBusy);
	
	
	
// =====================================================
// PATCH DISPENSING MANUAL MODE - PERMISSIVES
// =====================================================

// General Patch manual enable.
bPatchManualEnableAllowed :=
    (eMachineState = E_MachineState.Manual)
    AND stInputs.stSafety.bSafetyOk
    AND GVL_Safety.bAirSupplySafe
    AND NOT bRejectChuteStopRequestLatched
    AND bPatchDispenseCommissioned;

bPatchManualSupportAllowed :=
    bPatchManualEnableAllowed
    AND stCommand.bPatchManualEnable;
	
	
// =====================================================
// PATCH DISPENSING - MANUAL VERTICAL PERMISSIVES
// =====================================================
bPatchVerticalUpAllowed :=
    bPatchManualEnableAllowed
    AND stCommand.bPatchManualEnable
    AND NOT stCommand.bPatchVerticalDownRequest;

bPatchVerticalDownAllowed :=
    bPatchManualEnableAllowed
    AND stCommand.bPatchManualEnable
    AND NOT stCommand.bPatchVerticalUpRequest;
	

tpPatchAirBlow(
    IN := stCommand.bPatchAirBlowRequest
          AND bPatchManualEnableAllowed
          AND stCommand.bPatchManualEnable AND NOT fbPatchDispense.IsBusy(),
    PT := stconfig.tpPatchAirBlowTimer
);

// TODO: Add physical position and mechanical clearance
// interlocks when Patch Vertical sensors are installed.
// =====================================================
// VISION MANUAL MODE - PERMISSIVES
// =====================================================
// The HMI IsEnabled properties are only operator guidance.
// These PLC permissives are the authority for all Vision manual movement.
//
// Vision Manual Enable itself may only be selected in Manual Mode with
// Safety OK and while no reject-chute controlled stop is active.
bVisionManualEnableAllowed :=
    (eMachineState = E_MachineState.Manual)
    AND stInputs.stSafety.bSafetyOk
    AND NOT bRejectChuteStopRequestLatched
    AND (GVL_EtherCAT.stVSKeyenceCamera.bRunStatus OR bVisionCameraStartBlocked
        OR bManualCameraRecoveryActive OR fbVisionManualImages.bPrepared
        OR (fbVisionManualImages.usiStep = 210) OR fbVisionManualImages.bCameraWarning);
// Run Sequence keeps its separate NOT bVisionCameraStartBlocked admission.
// Manual image recovery must remain operable while the camera reports an error.

// Every individual Vision movement requires the general Vision Enable.
bVisionHorizontalBackAllowed :=
    NOT stIndexStatus.bBusy AND NOT stIndexStatus.bTwoHandRequired
    AND NOT stInputs.bTwoHandsSafe AND NOT bManualCameraRecoveryActive
    AND (
    bVisionManualEnableAllowed
    AND stCommand.bVisionManualEnable
    AND stInputs.bVerticalMiniSlideRetracted);

bVisionHorizontalFrontAllowed :=
    NOT stIndexStatus.bBusy AND NOT stIndexStatus.bTwoHandRequired
    AND NOT stInputs.bTwoHandsSafe AND NOT bManualCameraRecoveryActive
    AND (
    bVisionManualEnableAllowed
    AND stCommand.bVisionManualEnable
    AND stInputs.bVerticalMiniSlideRetracted);

// Full UP is always the recovery direction once Vision manual control is enabled.
bVisionVerticalUpAllowed :=
    NOT stIndexStatus.bBusy AND NOT stIndexStatus.bTwoHandRequired
    AND NOT stInputs.bTwoHandsSafe AND NOT bManualCameraRecoveryActive
    AND (
    bVisionManualEnableAllowed
    AND stCommand.bVisionManualEnable);



// Full DOWN is the pick-side movement.
bVisionVerticalFullDownAllowed :=
    NOT stIndexStatus.bBusy AND NOT stIndexStatus.bTwoHandRequired
    AND NOT stInputs.bTwoHandsSafe AND NOT bManualCameraRecoveryActive
    AND (
    bVisionManualEnableAllowed AND stCommand.bVisionManualEnable
    AND ((stInputs.bHorizontalMiniSlideExtended AND NOT stInputs.bHorizontalMiniSlideRetracted)
        OR (stInputs.bHorizontalMiniSlideRetracted AND NOT stInputs.bHorizontalMiniSlideExtended)));

bVisionGripOpenAllowed :=
    NOT stIndexStatus.bBusy AND NOT stIndexStatus.bTwoHandRequired
    AND NOT stInputs.bTwoHandsSafe AND NOT bManualCameraRecoveryActive
    AND (
    bVisionManualEnableAllowed
    AND stCommand.bVisionManualEnable);

bVisionGripCloseAllowed :=
    NOT stIndexStatus.bBusy AND NOT stIndexStatus.bTwoHandRequired
    AND NOT stInputs.bTwoHandsSafe AND NOT bManualCameraRecoveryActive
    AND (
    bVisionManualEnableAllowed
    AND stCommand.bVisionManualEnable);

bVisionRotate0Allowed :=
    NOT stIndexStatus.bBusy AND NOT stIndexStatus.bTwoHandRequired
    AND NOT stInputs.bTwoHandsSafe AND NOT bManualCameraRecoveryActive
    AND (
    bVisionManualEnableAllowed
    AND stCommand.bVisionManualEnable
    AND stInputs.bVerticalMiniSlideRetracted);

bVisionRotate180Allowed :=
    NOT stIndexStatus.bBusy AND NOT stIndexStatus.bTwoHandRequired
    AND NOT stInputs.bTwoHandsSafe AND NOT bManualCameraRecoveryActive
    AND (
    bVisionManualEnableAllowed
    AND stCommand.bVisionManualEnable
    AND stInputs.bVerticalMiniSlideRetracted);

// Do not use fbVision.IsBusy() here: moving away from the automatic home
// position may make the Vision FB report Busy and would prevent recovery.

	
// RUN SEQUENCE:
// Only allowed from the complete Vision HOME position.
bVisionManualRunSequenceAllowed :=
    NOT stIndexStatus.bBusy AND NOT stIndexStatus.bTwoHandRequired
    AND NOT stInputs.bTwoHandsSafe AND NOT bManualCameraRecoveryActive
    AND (
    NOT fbVisionManualImages.bActive AND NOT fbVisionManualImages.bFault
    AND bVisionManualEnableAllowed
    AND NOT bVisionCameraStartBlocked
    AND stCommand.bVisionManualEnable
    AND stInputs.bHorizontalMiniSlideExtended
    AND stInputs.bVerticalMiniSlideRetracted
    AND stInputs.bRotaryGripperOpened
    AND bVisionRotate0Confirmed
    AND NOT (stVisionNest.stHeatStakeResult.bValid
        AND (stVisionNest.stHeatStakeResult.udiAlertCode = GVL_MASTER.udiHeatStakePatchMissingAlertCode)));
	
	
	// =====================================================
	// VISION MANUAL MODE - HOME PERMISSIVE
	// =====================================================
	
	bVisionManualHomeAllowed :=
    NOT stIndexStatus.bBusy AND NOT stIndexStatus.bTwoHandRequired
    AND NOT stInputs.bTwoHandsSafe AND NOT bManualCameraRecoveryActive
    AND (
        NOT fbVisionManualImages.bActive AND NOT fbVisionManualImages.bFault
		AND bVisionManualEnableAllowed
        AND NOT bVisionCameraStartBlocked
		AND stCommand.bVisionManualEnable
		AND NOT bVisionManualSequenceActive
		AND NOT bVisionManualHomeActive);	

	// =====================================================
	// VISION MANUAL MODE - RUN SEQUENCE REQUEST
	// =====================================================
	
	// Capture the one-scan HMI Run Sequence request.
	IF stCommand.bVisionManualRunSequence
		AND bVisionManualRunSequenceAllowed
		AND NOT bVisionManualSequenceActive
	THEN
		bVisionManualSequenceActive := TRUE;
	END_IF;
	
	
	// Cancel sequence ownership if Manual Mode is left
	// or Vision Manual Enable is removed.
	IF (eMachineState <> E_MachineState.Manual)
		OR NOT bVisionManualEnableAllowed
		OR NOT stCommand.bVisionManualEnable
	THEN
		bVisionManualSequenceActive := FALSE;
	END_IF;
	
	// =====================================================
	// VISION MANUAL MODE - HOME REQUEST
	// =====================================================
	
	// Capture the one-scan HMI Home Position request.
	IF stCommand.bVisionManualHomeRequest
		AND bVisionManualHomeAllowed
		AND NOT bVisionManualHomeActive
	THEN
		bVisionManualHomeActive := TRUE;
	END_IF;
	
	// Cancel Home ownership if Manual Mode is left
	// or Vision Manual Enable is removed.
	IF (eMachineState <> E_MachineState.Manual)
		OR NOT bVisionManualEnableAllowed
		OR NOT stCommand.bVisionManualEnable
	THEN
		bVisionManualHomeActive := FALSE;
	END_IF;

// Manual Mode Stake Pacth allowed permissive
bHeatStakeManualStakeAllowed :=
    NOT stIndexStatus.bBusy AND NOT stIndexStatus.bTwoHandRequired
    AND NOT stInputs.bTwoHandsSafe AND NOT bManualCameraRecoveryActive
    AND (
    (eMachineState = E_MachineState.Manual)
    AND NOT bRejectChuteStopRequestLatched
    AND stCommand.bHeatStakeManualEnable
    AND stInputs.stSafety.bSafetyOk
    AND stHeatStakeTemperatureStatus.bIndexTemperatureReady
    AND fbHeatStake.IsReady()
    AND NOT fbHeatStake.IsBusy()
    AND bHeatStakeManualHomePosition
    AND stInputs.bHeatStakeEaglePresent
    AND NOT (stHeatStakeNest.stHeatStakeResult.bValid
    AND (stHeatStakeNest.stHeatStakeResult.udiAlertCode = GVL_MASTER.udiHeatStakePatchMissingAlertCode))
    AND NOT stIndexStatus.bBusy);
	

// Stake Patch reuses the validated automatic station sequence.
IF rtHeatStakeManualStakePatch.Q AND bHeatStakeManualStakeAllowed THEN
    IF fbHeatStake.RequestStart() THEN
        bHeatStakeManualStakeCycleActive := TRUE;
    END_IF
END_IF

// Return Complete -> Ready automatically after a manual validated cycle.
IF (eMachineState = E_MachineState.Manual)
    AND bHeatStakeManualStakeCycleActive
    AND fbHeatStake.IsDone()
THEN
    fbHeatStake.RequestReset();
    bHeatStakeManualStakeCycleActive := FALSE;
END_IF

// Accept full-course manual actions.
IF rtHeatStakeManualUnlock.Q AND bHeatStakeManualUnlockAllowed THEN
    usiHeatStakeManualActionStep := 10;
    tonHeatStakeManualAction(IN := FALSE);

ELSIF rtHeatStakeManualLock.Q AND bHeatStakeManualLockAllowed THEN
    usiHeatStakeManualActionStep := 20;
    tonHeatStakeManualAction(IN := FALSE);

ELSIF rtHeatStakeManualHeadDown.Q AND bHeatStakeManualHeadDownAllowed THEN
    usiHeatStakeManualActionStep := 30;
    tonHeatStakeManualAction(IN := FALSE);

ELSIF rtHeatStakeManualHeadUp.Q AND bHeatStakeManualHeadUpAllowed THEN
    usiHeatStakeManualActionStep := 40;
    tonHeatStakeManualAction(IN := FALSE);
END_IF

CASE usiHeatStakeManualActionStep OF
    10: // Unlock
        bHeatStakeHeadUnlockRequest := TRUE;
        tonHeatStakeManualAction(IN := TRUE, PT := T#1S);
        IF tonHeatStakeManualAction.Q THEN
            tonHeatStakeManualAction(IN := FALSE);
            bHeatStakeManualHeadUnlocked := TRUE;
            usiHeatStakeManualActionStep := 0;
        END_IF

    20: // Lock
        bHeatStakeHeadLockRequest := TRUE;
        tonHeatStakeManualAction(IN := TRUE, PT := T#1S);
        IF tonHeatStakeManualAction.Q THEN
            tonHeatStakeManualAction(IN := FALSE);
            bHeatStakeManualHeadUnlocked := FALSE;
            usiHeatStakeManualActionStep := 0;
        END_IF

    30: // Head DOWN - real sensor feedback
        bHeatStakeHeadDownRequest := NOT stInputs.bHeatStakeHeadDown;
        rHeatStakePressureCommandBar := stHeatStakeProcessSettings.rDownPressureBar;
        tonHeatStakeManualAction(IN := NOT stInputs.bHeatStakeHeadDown, PT := stConfig.tHeatStakeHeadMoveTimeout);
        IF stInputs.bHeatStakeHeadDown THEN
            tonHeatStakeManualAction(IN := FALSE);
            usiHeatStakeManualActionStep := 0;
        ELSIF tonHeatStakeManualAction.Q THEN
            tonHeatStakeManualAction(IN := FALSE);
            bHeatStakeManualHeadDownTimeoutFault := TRUE;
            usiHeatStakeManualActionStep := 0;
        END_IF

    40: // Head UP - real sensor feedback
        bHeatStakeHeadUpRequest := NOT stInputs.bHeatStakeHeadUp;
        tonHeatStakeManualAction(IN := NOT stInputs.bHeatStakeHeadUp, PT := stConfig.tHeatStakeHeadMoveTimeout);
        IF stInputs.bHeatStakeHeadUp THEN
            tonHeatStakeManualAction(IN := FALSE);
            usiHeatStakeManualActionStep := 0;
        ELSIF tonHeatStakeManualAction.Q THEN
            tonHeatStakeManualAction(IN := FALSE);
            bHeatStakeManualHeadUpTimeoutFault := TRUE;
            usiHeatStakeManualActionStep := 0;
        END_IF

   100: // Initialising: wait for pneumatic supply, then Unlock
    // Do not start any Heat Stake recovery timer until TwinSAFE confirms
    // that pneumatic pressure is physically available.
    IF GVL_Safety.bAirSupplySafe THEN

        bHeatStakeHeadUnlockRequest := TRUE;

        tonHeatStakeManualAction(
            IN := TRUE,
            PT := T#1S
        );

        IF tonHeatStakeManualAction.Q THEN
            tonHeatStakeManualAction(IN := FALSE);

            bHeatStakeManualHeadUnlocked := TRUE;
            usiHeatStakeManualActionStep := 110;
        END_IF

    ELSE
        tonHeatStakeManualAction(IN := FALSE);
    END_IF

	
	110: // Initialising: Head UP - physical feedback required
		// Keep the head unlocked for the complete UP movement.
		IF GVL_Safety.bAirSupplySafe THEN
	
			bHeatStakeHeadUnlockRequest := TRUE;
			bHeatStakeHeadUpRequest := NOT stInputs.bHeatStakeHeadUp;
	
			tonHeatStakeManualAction(
				IN := NOT stInputs.bHeatStakeHeadUp,
				PT := stConfig.tHeatStakeHeadMoveTimeout
			);
	
			IF stInputs.bHeatStakeHeadUp THEN
	
				tonHeatStakeManualAction(IN := FALSE);
				bHeatStakeHeadUpRequest := FALSE;
	
				usiHeatStakeManualActionStep := 120;
	
			ELSIF tonHeatStakeManualAction.Q THEN
	
				tonHeatStakeManualAction(IN := FALSE);
				bHeatStakeManualHeadUpTimeoutFault := TRUE;
	
				usiHeatStakeManualActionStep := 0;
	
			END_IF
	
		ELSE
			// Air disappeared during recovery.
			// Freeze the movement timeout instead of generating a false
			// Head UP timeout while pneumatic movement is impossible.
			bHeatStakeHeadUpRequest := FALSE;
			tonHeatStakeManualAction(IN := FALSE);
		END_IF
	
    120: // Initialising: Lock
        bHeatStakeHeadLockRequest := TRUE;
        tonHeatStakeManualAction(IN := TRUE, PT := T#1S);
        IF tonHeatStakeManualAction.Q THEN
            tonHeatStakeManualAction(IN := FALSE);
            bHeatStakeManualHeadUnlocked := FALSE;
            usiHeatStakeManualActionStep := 130;
        END_IF

    130: // Initialising: Support DOWN
        bStation2SupportRetractRequest := NOT stInputs.bStation2SupportRetracted;
        IF stInputs.bStation2SupportRetracted THEN
            usiHeatStakeManualActionStep := 0;
        END_IF
END_CASE

// Manual UNLOCK is a maintained valve command, not only the 1 s action pulse.
// Leave automatic Stake Patch, homing and fault/recovery ownership unchanged.
IF (eMachineState = E_MachineState.Manual)
    AND NOT bHeatStakeManualStakeCycleActive
    AND NOT fbHeatStake.IsBusy() THEN
    bHeatStakeHeadUnlockRequest :=
        (bHeatStakeHeadUnlockRequest OR bHeatStakeManualHeadUnlocked)
        AND NOT bHeatStakeHeadLockRequest;
END_IF

// Support toggle: ON = UP/Extend, OFF = DOWN/Retract.
// Heat Stake Enable is also required for normal manual support control.
//
// Reject-chute controlled stop:
// if the support was already travelling when the stop request arrived,
// complete that captured target stroke. Do not accept a new target.
IF (eMachineState = E_MachineState.Manual)
    AND bRejectChuteStopRequestLatched
THEN
    IF bManualSupportTargetUpAtRejectStop THEN
        bStation2SupportExtendRequest := NOT stInputs.bStation2SupportExtended;
        bStation2SupportRetractRequest := FALSE;
    ELSE
        bStation2SupportRetractRequest := NOT stInputs.bStation2SupportRetracted;
        bStation2SupportExtendRequest := FALSE;
    END_IF

ELSIF bHeatStakeManualSupportAllowed THEN
    IF stCommand.bHeatStakeManualSupportUp THEN
        bStation2SupportExtendRequest := NOT stInputs.bStation2SupportExtended;
        bStation2SupportRetractRequest := FALSE;
    ELSE
        bStation2SupportRetractRequest := NOT stInputs.bStation2SupportRetracted;
        bStation2SupportExtendRequest := FALSE;
    END_IF
END_IF

// Leaving Manual cancels manual action execution.
// Initialising retains only its dedicated home sequence.
IF (eMachineState <> E_MachineState.Manual)
    AND (eMachineState <> E_MachineState.Initialising)
THEN
    IF usiHeatStakeManualActionStep < 100 THEN
        usiHeatStakeManualActionStep := 0;
        tonHeatStakeManualAction(IN := FALSE);
    END_IF
    bHeatStakeManualStakeCycleActive := FALSE;
END_IF

stHeatStakeProcessStatus.tContactTimeSet 		:= stHeatStakeProcessSettings.tContactTime;
stHeatStakeProcessStatus.rContactTimeSetSeconds := TIME_TO_LREAL(stHeatStakeProcessSettings.tContactTime) / 1000.0;
stHeatStakeProcessStatus.rPressureSetpointBar 	:= stHeatStakeProcessSettings.rDownPressureBar;
stHeatStakeProcessStatus.bHeadLockCommand 		:= bHeatStakeHeadLockRequest;
stHeatStakeProcessStatus.bHeadUnlockCommand 	:= bHeatStakeHeadUnlockRequest;
stHeatStakeProcessStatus.bHeadDownCommand 		:= bHeatStakeHeadDownRequest;
stHeatStakeProcessStatus.bHeadUpCommand 		:= bHeatStakeHeadUpRequest;
stHeatStakeProcessStatus.bContactDwellActive 	:= bHeatStakeContactDwellActive;
stHeatStakeProcessStatus.usiSequenceStep 		:= usiHeatStakeSequenceStep;

// =====================================================
// VISION MANUAL MODE - EXECUTE HOME
// =====================================================

// Generate a single pulse when Home ownership becomes active.
rtVisionManualHome(
    CLK := bVisionManualHomeActive
);

// Request the existing FB_VisionStation controlled homing sequence once.
IF (eMachineState = E_MachineState.Manual)
    AND rtVisionManualHome.Q
THEN
    fbVision.RequestStop();
END_IF;
// =====================================================
// VISION MANUAL MODE - EXECUTE RUN SEQUENCE
// =====================================================

// Start the validated FB_VisionStation sequence.
IF (eMachineState = E_MachineState.Manual)
    AND bVisionManualSequenceActive
    AND NOT fbVision.IsBusy()
    AND NOT fbVision.IsDone()
    AND NOT fbVision.IsFaulted()
    AND NOT (stVisionNest.stHeatStakeResult.bValid
        AND (stVisionNest.stHeatStakeResult.udiAlertCode = GVL_MASTER.udiHeatStakePatchMissingAlertCode))
THEN
    fbVision.RequestStart();
END_IF;


fbVision.Update(stProcessSettings := GVL_Persistent.stVisionProcessSettings,
    // During System Initialising, do not start the Vision homing sequence until
    // TwinSAFE confirms that pneumatic pressure is available. This prevents the
    // station's 5 s tooling-movement timer from expiring while the MS6 / air
    // supply is still being established.
	bEnable :=
		((eMachineState = E_MachineState.Initialising) AND GVL_Safety.bAirSupplySafe)
		OR 	(eMachineState = E_MachineState.ReadyToStart)
		OR 	(eMachineState = E_MachineState.AutoCycle)
		OR 	(
			( eMachineState = E_MachineState.Manual)
			AND ( bVisionManualSequenceActive
			OR bVisionManualHomeActive )
			),
		
    bCommissioned 		:= 	bVisionCommissioned,
    bSafetyOk 			:= 	stInputs.stSafety.bSafetyOk,
    bSupervisionEnable 	:= 	(eMachineState = E_MachineState.ReadyToStart) OR
							(eMachineState = E_MachineState.AutoCycle) OR
        					(eMachineState = E_MachineState.Manual),
							
    bReset := stCommand.bReset,

    bSupportRetracted 	:= FALSE, // Removed hardware; ignored by Vision FB.

    bSupportExtended 	:= FALSE, // Removed hardware; ignored by Vision FB.

    // Mechanical orientation is reversed relative to cylinder naming:
    // EXTENDED = slide BACK (home), RETRACTED = slide FRONT.
    bHorizontalBack 		:= stInputs.bHorizontalMiniSlideExtended,
    bHorizontalFront 		:= stInputs.bHorizontalMiniSlideRetracted,
    bVerticalUp 			:= stInputs.bVerticalMiniSlideRetracted,
    bVerticalDown 			:= stInputs.bVerticalMiniSlideExtended,

    bLimitOff 				:= FALSE, // Removed hardware; ignored by Vision FB.

    bLimitOn 				:= FALSE, // Removed hardware; ignored by Vision FB.
    bGripOpened 			:= stInputs.bRotaryGripperOpened,
    bGripClosed 			:= stInputs.bRotaryGripperClosed,
    bRotate0 				:= bVisionRotate0Confirmed,
    bRotate180 				:= bVisionRotate180Confirmed,
    bRotate0Raw 			:= stInputs.bRotaryGripperPick0,
    bRotate180Raw 			:= stInputs.bRotaryGripperPlace180,
    bCameraTriggerAccepted 	:= bVisionTriggerAccepted,
	
    tSupportTimeout 		:= stConfig.tStationSupportTimeout,
	nCurrentProgramNumber	:= bVisionGetCurrentProgram,
	nVisionCameraResults	:= nVisionResults,
	bResultsReady			:= bVisionGetResultsReadyRequest,

    stStatus 				=> stVisionStatus,

    bHorizontalBackRequest 	=> bVisionHorizontalBackRequest,
    bHorizontalFrontRequest => bVisionHorizontalFrontRequest,
    bVerticalUpRequest 		=> bVisionVerticalUpRequest,
    bVerticalDownRequest 	=> bVisionVerticalDownRequest,

    bGripCloseRequest 		=> bVisionGripCloseRequest,
    bGripOpenRequest 		=> bVisionGripOpenRequest,
    bRotate0Request 		=> bVisionRotate0Request,
    bRotate180Request 		=> bVisionRotate180Request,
	//camera
	bTriggerRequest					=>		bVisionTriggerRequest,
	bChangeProgramRequest			=>		bVisionChangeProgramRequest,
	bGetResultsRequest				=>		bVisionGetResultsRequest,
	bRequestResetResults			=>		bVisionResetResultsRequest,
	bAcknowledgeResults				=> 		bVisionAcknowledgeResultsRquest,
	nProgramNumber					=>		nVisionProgramNumber
);

// Manual image position owner. The automatic station keeps its public contract;
// the following mux arbitrates its requests with the separate manual Vision FB.
bVisionImageOwnedBeforeUpdate := fbVisionManualImages.bActive;
bVisionImageJogBusy := stCommand.bVisionHorizontalBackRequest
    OR stCommand.bVisionHorizontalFrontRequest OR stCommand.bVisionVerticalUpRequest
    OR stCommand.bVisionVerticalFullDownRequest OR stCommand.bVisionGripOpenRequest
    OR stCommand.bVisionGripCloseRequest OR stCommand.bVisionRotate0Request
    OR stCommand.bVisionRotate180Request OR tpVisionManualHorizontalBack.Q
    OR tpVisionManualHorizontalFront.Q OR bVisionManualVerticalUpActive
    OR bVisionManualVerticalFullDownActive OR bVisionManualRotate0Active
    OR bVisionManualRotate180Active;
uiVisionPbupNest := 0;
IF (stInputs.eIndexPosition = E_TablePosition.Unknown) AND NOT stIndexStatus.bBusy THEN
    aVisionPbupReferenceKnown[1] := FALSE;
    aVisionProductLocation[1] := 0;
    aVisionPbupSource[1] := 0;
    aVisionLoadEmptySeen[1] := FALSE;
    aVisionLoadCandidate[1] := FALSE;
    aVisionPbupReferenceKnown[2] := FALSE;
    aVisionProductLocation[2] := 0;
    aVisionPbupSource[2] := 0;
    aVisionLoadEmptySeen[2] := FALSE;
    aVisionLoadCandidate[2] := FALSE;
    aVisionPbupReferenceKnown[3] := FALSE;
    aVisionProductLocation[3] := 0;
    aVisionPbupSource[3] := 0;
    aVisionLoadEmptySeen[3] := FALSE;
    aVisionLoadCandidate[3] := FALSE;
    aVisionPbupReferenceKnown[4] := FALSE;
    aVisionProductLocation[4] := 0;
    aVisionPbupSource[4] := 0;
    aVisionLoadEmptySeen[4] := FALSE;
    aVisionLoadCandidate[4] := FALSE;
END_IF
IF stInputs.bIndexReady AND stInputs.bIndexLocked AND NOT stIndexStatus.bBusy
    AND (stInputs.eIndexPosition <> E_TablePosition.Unknown)
    AND (stVisionNest.nId >= 1) AND (stVisionNest.nId <= 4) THEN
    uiVisionPbupNest := stVisionNest.nId;
END_IF

// Assembly confidence and pickup location belong to the physical product.
// 0=unknown, 1=single nest, 2=legacy alias for nest, 3=held by tooling.
IF (stOperatorNest.nId >= 1) AND (stOperatorNest.nId <= 4)
    AND stInputs.bIndexReady AND stInputs.bIndexLocked AND NOT stIndexStatus.bBusy
    AND (stInputs.eIndexPosition <> E_TablePosition.Unknown) THEN
    IF uiVisionLoadObservedNest <> stOperatorNest.nId THEN
        IF (uiVisionLoadObservedNest >= 1) AND (uiVisionLoadObservedNest <= 4) THEN
            aVisionLoadCandidate[uiVisionLoadObservedNest] := FALSE;
            aVisionLoadEmptySeen[uiVisionLoadObservedNest] := FALSE;
        END_IF
        tonVisionLoadEmpty(IN := FALSE);
        tonVisionLoadPair(IN := FALSE);
        uiVisionLoadObservedNest := stOperatorNest.nId;
    END_IF
    tonVisionLoadEmpty(IN := NOT stInputs.bLoadingStationEaglePresent
        AND NOT stInputs.bLoadingStationPbupPresent, PT := T#200MS);
    tonVisionLoadPair(IN := aVisionLoadCandidate[stOperatorNest.nId]
        AND stInputs.bLoadingStationEaglePresent AND stInputs.bLoadingStationPbupPresent,
        PT := T#200MS);
    IF tonVisionLoadEmpty.Q THEN
        aVisionLoadEmptySeen[stOperatorNest.nId] := TRUE;
        aVisionLoadCandidate[stOperatorNest.nId] := FALSE;
        aVisionPbupReferenceKnown[stOperatorNest.nId] := FALSE;
        aVisionProductLocation[stOperatorNest.nId] := 0;
        aVisionPbupSource[stOperatorNest.nId] := 0;
    END_IF
    IF aVisionLoadEmptySeen[stOperatorNest.nId]
        AND (stInputs.bLoadingStationEaglePresent OR stInputs.bLoadingStationPbupPresent) THEN
        aVisionLoadCandidate[stOperatorNest.nId] := TRUE;
        aVisionLoadEmptySeen[stOperatorNest.nId] := FALSE;
    END_IF
    IF stOperatorNest.bPartLoadedPulse OR stOperatorNest.bPartRemovedPulse THEN
        aVisionPbupReferenceKnown[stOperatorNest.nId] := FALSE;
        aVisionProductLocation[stOperatorNest.nId] := 0;
        aVisionPbupSource[stOperatorNest.nId] := 0;
        IF stOperatorNest.bPartRemovedPulse THEN
            aVisionLoadCandidate[stOperatorNest.nId] := FALSE;
        END_IF
        IF GVL_Persistent.aVisionPbupFitted[stOperatorNest.nId] THEN
            GVL_Persistent.aVisionPbupFitted[stOperatorNest.nId] := FALSE;
            GVL_HMI.bVisionPbupSaveRequest := TRUE;
        END_IF
    END_IF
    IF tonVisionLoadPair.Q AND aVisionLoadCandidate[stOperatorNest.nId] THEN
        aVisionPbupReferenceKnown[stOperatorNest.nId] := TRUE;
        aVisionProductLocation[stOperatorNest.nId] := 1;
        aVisionPbupSource[stOperatorNest.nId] := 1; // Qualified new paired load.
        aVisionLoadCandidate[stOperatorNest.nId] := FALSE;
        GVL_Persistent.aVisionPbupFitted[stOperatorNest.nId] := FALSE;
        GVL_HMI.bVisionPbupSaveRequest := TRUE;
    END_IF
ELSE
    IF (uiVisionLoadObservedNest >= 1) AND (uiVisionLoadObservedNest <= 4) THEN
        aVisionLoadCandidate[uiVisionLoadObservedNest] := FALSE;
        aVisionLoadEmptySeen[uiVisionLoadObservedNest] := FALSE;
    END_IF
    tonVisionLoadEmpty(IN := FALSE);
    tonVisionLoadPair(IN := FALSE);
    uiVisionLoadObservedNest := 0;
END_IF

// Automatic/full manual cycles invalidate confidence at start and establish fitted
// only after a completed cycle. An aborted assembly remains unknown.
rtVisionPbupAutoBusy(CLK := fbVision.IsBusy() AND NOT bVisionImageOwnedBeforeUpdate);
rtVisionPbupAutoDone(CLK := fbVision.IsDone());
IF (uiVisionPbupNest >= 1) AND (uiVisionPbupNest <= 4) THEN
    IF rtVisionPbupAutoBusy.Q THEN
        aVisionPbupReferenceKnown[uiVisionPbupNest] := FALSE;
        aVisionProductLocation[uiVisionPbupNest] := 0;
        aVisionPbupSource[uiVisionPbupNest] := 0;
    END_IF
    IF rtVisionPbupAutoDone.Q THEN
        GVL_Persistent.aVisionPbupFitted[uiVisionPbupNest] := TRUE;
        aVisionPbupReferenceKnown[uiVisionPbupNest] := TRUE;
        aVisionProductLocation[uiVisionPbupNest] := 1;
        aVisionPbupSource[uiVisionPbupNest] := 3;
        GVL_HMI.bVisionPbupFittedEdit := TRUE;
    END_IF
    bVisionPbupFitted := GVL_Persistent.aVisionPbupFitted[uiVisionPbupNest];
    bVisionPbupKnown := aVisionPbupReferenceKnown[uiVisionPbupNest];
    // An old fitted boolean cannot establish a newly unknown pickup location.
    IF aVisionProductLocation[uiVisionPbupNest] = 0 THEN
        aVisionPbupReferenceKnown[uiVisionPbupNest] := FALSE;
        bVisionPbupKnown := FALSE;
    END_IF
ELSE
    bVisionPbupFitted := FALSE;
    bVisionPbupKnown := FALSE;
END_IF

// Checkbox edit buffer is refreshed on nest change and PLC assembly completion.
// A separate confirmation accepts an unchanged FALSE or TRUE value after restart.
IF uiVisionPbupEditNest <> uiVisionPbupNest THEN
    uiVisionPbupEditNest := uiVisionPbupNest;
    GVL_HMI.bVisionPbupFittedEdit := bVisionPbupFitted;

END_IF
GVL_HMI.bVisionPbupEditAllowed := bManualCameraAllowed
    AND NOT bVisionImageOwnedBeforeUpdate AND NOT fbVisionManualImages.bFault
    AND (usiManualCameraStep = 0) AND NOT bVisionImageJogBusy
    AND NOT stCommand.bManualIndexForward AND NOT stCommand.bStop AND NOT stCommand.bReset
    AND (uiVisionPbupNest >= 1) AND (uiVisionPbupNest <= 4)
    AND stVisionStatus.bHome AND stVisionNest.bPartPresent
    AND NOT bManualCameraRecoveryActive;
IF GVL_HMI.bVisionPbupConfirm THEN
    IF GVL_HMI.bVisionPbupEditAllowed THEN
        GVL_Persistent.aVisionPbupFitted[uiVisionPbupNest] := GVL_HMI.bVisionPbupFittedEdit;
        aVisionPbupReferenceKnown[uiVisionPbupNest] := TRUE;
        bVisionPbupFitted := GVL_HMI.bVisionPbupFittedEdit;
        bVisionPbupKnown := TRUE;
        aVisionPbupSource[uiVisionPbupNest] := 2; // Explicit operator confirmation.
        aVisionProductLocation[uiVisionPbupNest] := 1; // The part is in the single nest.
        GVL_HMI.bVisionPbupSaveRequest := TRUE;
    ELSE
        GVL_HMI.bVisionPbupFittedEdit := bVisionPbupFitted;
    END_IF
END_IF
GVL_HMI.bVisionPbupConfirm := FALSE;

bVisionImagePermit := bManualCameraAllowed AND bVisionManualEnableAllowed
    AND NOT fbVision.IsFaulted()
    AND (GVL_HMI.bCameraConnected OR (bVisionImageOwnedBeforeUpdate
        AND (fbVisionManualImages.bPrepared OR (fbVisionManualImages.usiStep = 210))))
    AND (bVisionImageOwnedBeforeUpdate OR NOT bVisionImageJogBusy)
    AND ((uiVisionPbupNest >= 1) AND (uiVisionPbupNest <= 4))
    AND stVisionNest.bPartPresent
    AND (bVisionImageOwnedBeforeUpdate
        OR (NOT bManualCameraRecoveryActive AND NOT stCommand.bManualIndexForward AND NOT stInputs.bTwoHandsSafe
            AND NOT stIndexStatus.bTwoHandRequired AND (fbIndex.GetState() = E_IndexState.Idle)));
IF NOT bVisionImageOwnedBeforeUpdate AND (uiVisionPbupNest >= 1) AND (uiVisionPbupNest <= 4) THEN
    bVisionImagePermit := bVisionImagePermit
        AND ((aVisionProductLocation[uiVisionPbupNest] = 1) OR (aVisionProductLocation[uiVisionPbupNest] = 2));
END_IF
IF NOT bVisionPbupFitted AND (GVL_HMI.udiCameraManualImageSelection <> 1) THEN
    bVisionImagePermit := bVisionImagePermit AND stVisionNest.bLoadSetComplete;
END_IF
IF bVisionImageOwnedBeforeUpdate THEN
    bVisionImagePermit := bVisionImagePermit
        AND (uiVisionPbupNest = uiVisionImageOwnedNest)
        AND (stInputs.eIndexPosition = eVisionImageOwnedIndex);
END_IF

// Retired compatibility symbols: no location selection exists on this machine.
GVL_HMI.bVisionPickupFrontEdit := FALSE;
GVL_HMI.bVisionPickupFrontApplied := FALSE;
fbVisionManualImages(
    bPermit := bVisionImagePermit,
    bReset := stCommand.bReset,
    bPrepare := GVL_HMI.bVisionImagePrepare AND GVL_HMI.bCameraConnected
        AND GVL_EtherCAT.stVSKeyenceCamera.bRunStatus,
    bRelease := GVL_HMI.bVisionImageRelease,
    bTrigger := bManualImageTriggerCommand,
    udiSelection := GVL_HMI.udiCameraManualImageSelection,
    bFitted := bVisionPbupFitted,
    bPickAtFront := FALSE, // Retired compatibility input; pickup derives from PBUP fitted state.
    bReferenceKnown := bVisionPbupKnown,
    bHorizontalBack := stInputs.bHorizontalMiniSlideExtended,
    bHorizontalFront := stInputs.bHorizontalMiniSlideRetracted,
    bVerticalUp := stInputs.bVerticalMiniSlideRetracted,
    bVerticalDown := stInputs.bVerticalMiniSlideExtended,
    bGripOpen := stInputs.bRotaryGripperOpened,
    bGripClosed := stInputs.bRotaryGripperClosed,
    bRotate0 := bVisionRotate0Confirmed,
    bRotate180 := bVisionRotate180Confirmed,
    bRotate0Raw := stInputs.bRotaryGripperPick0,
    bRotate180Raw := stInputs.bRotaryGripperPlace180,
    bCameraReady := bManualCameraTransportReady,
    bCameraAccepted := bVisionTriggerAccepted AND (usiManualCameraStep <> 0),
    bCameraComplete := bManualCameraConsume,
    bCameraFailed := bManualImageCameraFailed,
    bCameraReset := bManualCameraRecoveredPulse,
    bCameraBusy := (usiManualCameraStep <> 0),
    tMovingTriggerDelay := UDINT_TO_TIME(GVL_Persistent.stVisionProcessSettings.udiMovingTriggerDelayMs)
);
GVL_HMI.bVisionImagePrepare := FALSE;
GVL_HMI.bVisionImageRelease := FALSE;
IF fbVisionManualImages.bActive AND NOT bVisionImageOwnedBeforeUpdate THEN
    uiVisionImageOwnedNest := uiVisionPbupNest;
    eVisionImageOwnedIndex := stInputs.eIndexPosition;
END_IF
IF fbVisionManualImages.bReferenceLostPulse THEN
    IF NOT stVisionStatus.bHome THEN bVisionImageRecoveryRequired := TRUE; END_IF
    IF (uiVisionImageOwnedNest >= 1) AND (uiVisionImageOwnedNest <= 4) THEN
        aVisionPbupReferenceKnown[uiVisionImageOwnedNest] := FALSE;
        aVisionProductLocation[uiVisionImageOwnedNest] := 0;
        aVisionPbupSource[uiVisionImageOwnedNest] := 0;
    END_IF
    bVisionPbupKnown := FALSE;
END_IF
IF stVisionStatus.bHome AND NOT fbVisionManualImages.bActive AND NOT fbVisionManualImages.bFault THEN
    bVisionImageRecoveryRequired := FALSE;
END_IF
IF fbVisionManualImages.bFittedPulse AND (uiVisionImageOwnedNest >= 1) AND (uiVisionImageOwnedNest <= 4) THEN
    GVL_Persistent.aVisionPbupFitted[uiVisionImageOwnedNest] := TRUE;
    aVisionPbupReferenceKnown[uiVisionImageOwnedNest] := TRUE;
    aVisionPbupSource[uiVisionImageOwnedNest] := 3;
    bVisionPbupFitted := TRUE;
    bVisionPbupKnown := TRUE;
    GVL_HMI.bVisionPbupFittedEdit := TRUE;
    GVL_HMI.bVisionPbupSaveRequest := TRUE;
END_IF

IF (uiVisionImageOwnedNest >= 1) AND (uiVisionImageOwnedNest <= 4) AND fbVisionManualImages.bActive THEN
    IF fbVisionManualImages.bPartHeld THEN
        aVisionProductLocation[uiVisionImageOwnedNest] := 3;
    ELSIF fbVisionManualImages.bPrepared THEN
        aVisionProductLocation[uiVisionImageOwnedNest] := 1; // Images 1/4 both leave the part in its nest.
    END_IF
END_IF

IF fbVisionManualImages.bActive OR bVisionImageOwnedBeforeUpdate OR fbVisionManualImages.bFault THEN
    bVisionHorizontalBackRequest := fbVisionManualImages.bHorizontalBackRequest;
    bVisionHorizontalFrontRequest := fbVisionManualImages.bHorizontalFrontRequest;
    bVisionVerticalUpRequest := fbVisionManualImages.bVerticalUpRequest;
    bVisionVerticalDownRequest := fbVisionManualImages.bVerticalDownRequest;
    bVisionGripOpenRequest := fbVisionManualImages.bGripOpenRequest;
    bVisionGripCloseRequest := fbVisionManualImages.bGripCloseRequest;
    bVisionRotate0Request := fbVisionManualImages.bRotate0Request;
    bVisionRotate180Request := fbVisionManualImages.bRotate180Request;
END_IF

GVL_HMI.bVisionImagePrepared := fbVisionManualImages.bPrepared;
GVL_HMI.bVisionImage1Allowed := bVisionPbupKnown AND NOT bVisionPbupFitted;
IF NOT GVL_HMI.bVisionImage1Allowed AND (GVL_HMI.udiCameraManualImageSelection = 1) THEN
    GVL_HMI.udiCameraManualImageSelection := 0;
END_IF
GVL_HMI.bVisionPbupFittedApplied := bVisionPbupFitted;
GVL_HMI.bVisionPbupReferenceKnown := bVisionPbupKnown;
GVL_HMI.uiVisionPbupNest := uiVisionPbupNest;
GVL_HMI.bVisionImagePrepareAllowed := bVisionImagePermit AND bVisionPbupKnown
    AND NOT fbVisionManualImages.bBusy AND NOT fbVisionManualImages.bFault
    AND (usiManualCameraStep = 0)
    AND (fbVisionManualImages.bActive OR stVisionStatus.bHome)
    AND NOT GVL_HMI.bCameraManualBusy AND GVL_HMI.bCameraConnected
    AND GVL_EtherCAT.stVSKeyenceCamera.bRunStatus
    AND (GVL_HMI.udiCameraManualImageSelection >= 1) AND (GVL_HMI.udiCameraManualImageSelection <= 4)
    AND ((GVL_HMI.udiCameraManualImageSelection <> 1) OR NOT bVisionPbupFitted);
GVL_HMI.bVisionImageReleaseAllowed := fbVisionManualImages.bPrepared
    AND NOT fbVisionManualImages.bPartHeld AND (usiManualCameraStep = 0);
GVL_HMI.bCameraManualReady := bManualCameraTransportReady AND fbVisionManualImages.bPrepared
    AND (GVL_HMI.udiCameraManualImageSelection = fbVisionManualImages.udiPreparedImage)
    AND bVisionPbupKnown AND ((GVL_HMI.udiCameraManualImageSelection <> 1) OR NOT bVisionPbupFitted);
GVL_HMI.bCameraManualReady := GVL_HMI.bCameraManualReady
    OR (bManualCameraRecoveryAllowed AND NOT bManualCameraRecoveryActive);
GVL_HMI.bCameraManualBusy := GVL_HMI.bCameraManualBusy OR fbVisionManualImages.bBusy;
IF fbVisionManualImages.bActive OR fbVisionManualImages.bFault
    OR ((eMachineState = E_MachineState.Manual) AND stCommand.bVisionManualEnable) THEN
    GVL_HMI.sCameraManualMessage := fbVisionManualImages.sMessage;
END_IF
// One actionable reason. Prepared geometry is independent of camera transport.
IF (eMachineState = E_MachineState.Manual) AND stCommand.bVisionManualEnable THEN
    IF NOT stInputs.stSafety.bSafetyOk THEN
        GVL_HMI.sCameraManualMessage := 'Vision blocked: safety not ready';
    ELSIF NOT stInputs.bMainDoorClosed OR NOT GVL_Safety.bAirSupplySafe THEN
        GVL_HMI.sCameraManualMessage := 'Vision blocked: close door / restore air';
    ELSIF bManualCameraRecoveryActive OR bManualCameraRecoveryFailed THEN
        GVL_HMI.sCameraManualMessage := sManualCameraRecoveryMessage;
    ELSIF fbVisionManualImages.bCameraWarning AND fbVisionManualImages.bBusy THEN
        GVL_HMI.sCameraManualMessage := fbVisionManualImages.sMessage;
    ELSIF bVisionCameraStartBlocked THEN
        GVL_HMI.sCameraManualMessage := 'Camera error - use Camera Reset or retry Trigger';
    ELSIF NOT GVL_HMI.bCameraConnected OR NOT GVL_EtherCAT.stVSKeyenceCamera.bRunStatus THEN
        GVL_HMI.sCameraManualMessage := 'Camera not connected / not in RUN';
    ELSIF stIndexStatus.bBusy OR stIndexStatus.bTwoHandRequired
        OR (stInputs.bTwoHandsSafe AND NOT fbVisionManualImages.bActive)
        OR NOT stInputs.bIndexReady OR NOT stInputs.bIndexLocked
        OR (stInputs.eIndexPosition = E_TablePosition.Unknown) THEN
        GVL_HMI.sCameraManualMessage := 'Wait for locked index; release two-hand';
    ELSIF bRejectChuteStopRequestLatched OR stCommand.bStop OR stCommand.bReset THEN
        GVL_HMI.sCameraManualMessage := 'Vision blocked: Stop/Reset active';
    ELSIF NOT stVisionNest.bPartPresent THEN
        GVL_HMI.sCameraManualMessage := 'No tracked product at Vision';
    ELSIF fbVisionManualImages.bFault OR fbVisionManualImages.bBusy THEN
        GVL_HMI.sCameraManualMessage := fbVisionManualImages.sMessage;
    ELSIF bVisionImageJogBusy OR bVisionManualSequenceActive OR bVisionManualHomeActive THEN
        GVL_HMI.sCameraManualMessage := 'Finish Vision jog / HOME / sequence first';
    ELSIF fbVisionManualImages.bCameraWarning THEN
        GVL_HMI.sCameraManualMessage := fbVisionManualImages.sMessage;
    ELSIF NOT bVisionPbupKnown THEN
        GVL_HMI.sCameraManualMessage := 'Confirm PBUP fitted state for this nest';
    ELSIF (GVL_HMI.udiCameraManualImageSelection < 1) OR (GVL_HMI.udiCameraManualImageSelection > 4) THEN
        GVL_HMI.sCameraManualMessage := 'Select an image';
    ELSIF (GVL_HMI.udiCameraManualImageSelection <> 1) AND NOT bVisionPbupFitted
        AND NOT stVisionNest.bLoadSetComplete THEN
        GVL_HMI.sCameraManualMessage := 'Mounting requires a complete paired load';
    ELSIF NOT fbVisionManualImages.bActive AND NOT stVisionStatus.bHome THEN
        GVL_HMI.sCameraManualMessage := 'Return Vision tooling HOME before Prepare';
    ELSIF bManualCameraDrainResult THEN
        GVL_HMI.sCameraManualMessage := 'Camera: clearing previous result handshake';
    ELSIF GVL_HMI.bCameraManualBusy THEN
        GVL_HMI.sCameraManualMessage := 'Camera: loading program / capture in progress';
    ELSIF fbVisionManualImages.bPrepared
        AND (GVL_HMI.udiCameraManualImageSelection = fbVisionManualImages.udiPreparedImage) THEN
        IF bManualCameraTransportReady THEN
            GVL_HMI.sCameraManualMessage := 'Position ready - press Camera Trigger';
        ELSE
            GVL_HMI.sCameraManualMessage := 'Position ready - waiting for camera handshake';
        END_IF
    ELSE
        GVL_HMI.sCameraManualMessage := 'Press Prepare Position for the selected image';
    END_IF
END_IF
GVL_HMI.sVisionPbupStatus := CONCAT('Nest ', UINT_TO_STRING(uiVisionPbupNest));
IF (uiVisionPbupNest < 1) OR (uiVisionPbupNest > 4) THEN
    GVL_HMI.sVisionPbupStatus := 'Wait for a known, locked index position';
ELSIF NOT stVisionNest.bPartPresent THEN
    GVL_HMI.sVisionPbupStatus := CONCAT(GVL_HMI.sVisionPbupStatus, ': no tracked part; load at operator station');
ELSIF NOT bVisionPbupKnown THEN
    GVL_HMI.sVisionPbupStatus := CONCAT(GVL_HMI.sVisionPbupStatus, ': confirm saved PBUP state');
ELSIF bVisionPbupFitted THEN
    GVL_HMI.sVisionPbupStatus := CONCAT(GVL_HMI.sVisionPbupStatus, ': PBUP fitted');
ELSE
    GVL_HMI.sVisionPbupStatus := CONCAT(GVL_HMI.sVisionPbupStatus, ': PBUP not fitted');
END_IF
IF stVisionNest.bPartPresent AND bVisionPbupKnown AND (uiVisionPbupNest >= 1) AND (uiVisionPbupNest <= 4) THEN
    IF aVisionPbupSource[uiVisionPbupNest] = 1 THEN
        GVL_HMI.sVisionPbupStatus := CONCAT(GVL_HMI.sVisionPbupStatus, ' / new paired load');
    ELSIF aVisionPbupSource[uiVisionPbupNest] = 2 THEN
        GVL_HMI.sVisionPbupStatus := CONCAT(GVL_HMI.sVisionPbupStatus, ' / operator confirmed');
    ELSE
        GVL_HMI.sVisionPbupStatus := CONCAT(GVL_HMI.sVisionPbupStatus, ' / mounting completed');
    END_IF
END_IF


// Native event grid is the single engineer-feedback presentation on this tab.
GVL_MASTER.bVisionManualCameraWarning := (eMachineState = E_MachineState.Manual)
    AND fbVisionManualImages.bCameraWarning;
GVL_MASTER.bVisionManualGridActive := (eMachineState = E_MachineState.Manual)
    AND stCommand.bVisionManualEnable;
GVL_MASTER.bVisionManualGridWarning := GVL_MASTER.bVisionManualGridActive
    AND NOT GVL_HMI.bCameraManualReady AND NOT GVL_HMI.bCameraManualBusy
    AND NOT fbVisionManualImages.bFault AND NOT fbVisionManualImages.bCameraWarning
    AND NOT bVisionCameraStartBlocked AND NOT bManualCameraRecoveryFailed;

// =====================================================
// VISION MANUAL MODE - HOME COMPLETION
// =====================================================

// Release Home ownership once FB_VisionStation has
// completed the controlled homing sequence and is Ready.
IF (eMachineState = E_MachineState.Manual)
    AND bVisionManualHomeActive
    AND fbVision.IsReady()
THEN
    bVisionManualHomeActive := FALSE;
END_IF;

// Release Home ownership if Vision enters Fault.
IF (eMachineState = E_MachineState.Manual)
    AND bVisionManualHomeActive
    AND fbVision.IsFaulted()
THEN
    bVisionManualHomeActive := FALSE;
END_IF;

// =====================================================
// VISION MANUAL MODE - RUN SEQUENCE COMPLETION
// =====================================================

// Complete manual Run Sequence.
// Return FB_VisionStation from Done to Ready.
IF (eMachineState = E_MachineState.Manual)
    AND bVisionManualSequenceActive
    AND fbVision.IsDone()
THEN
    fbVision.RequestReset();
    bVisionManualSequenceActive := FALSE;
END_IF;


// Abort manual Run Sequence ownership if Vision faults.
// The station fault remains available for the normal
// machine fault / diagnostic handling.
IF (eMachineState = E_MachineState.Manual)
    AND bVisionManualSequenceActive
    AND fbVision.IsFaulted()
THEN
    bVisionManualSequenceActive := FALSE;
END_IF;
// =====================================================
// VISION MANUAL MODE - OUTPUT OVERRIDE
// =====================================================
// Applied AFTER fbVision.Update() because FB_VisionStation owns these
// requests during Initialising / ReadyToStart / AutoCycle.
//
// Manual movement is accepted only when:
//   Manual Mode + Safety OK + Vision Manual Enable + movement permissive.
//
// Opposite requests are mutually interlocked here in the PLC.

// If Vision manual control is not enabled/allowed, do not permit any manual
// Vision motion request to survive into the physical output image.
IF (eMachineState = E_MachineState.Manual)
    AND NOT bVisionManualSequenceActive
    AND NOT bVisionManualHomeActive
    AND NOT fbVisionManualImages.bActive AND NOT bVisionImageOwnedBeforeUpdate
    AND NOT fbVisionManualImages.bFault
THEN

    // Start from a safe manual command image every scan.
    bVisionHorizontalBackRequest := FALSE;
    bVisionHorizontalFrontRequest := FALSE;
    bVisionVerticalUpRequest := FALSE;
    bVisionVerticalDownRequest := FALSE;

    bVisionGripCloseRequest := FALSE;
    bVisionGripOpenRequest := FALSE;
    bVisionRotate0Request := FALSE;
    bVisionRotate180Request := FALSE;



    // =====================================================
    // VISION MANUAL - COMMAND EDGES
    // =====================================================

    // Horizontal - KEEP EXACTLY AS VALIDATED
    rtVisionManualHorizontalBack(
        CLK := stCommand.bVisionHorizontalBackRequest
    );

    rtVisionManualHorizontalFront(
        CLK := stCommand.bVisionHorizontalFrontRequest
    );

//     // Vertical
//     rtVisionManualVerticalUp(
//         CLK := stCommand.bVisionVerticalUpRequest
//     );
// 
//     );
// 
//     rtVisionManualVerticalFullDown(
//         CLK := stCommand.bVisionVerticalFullDownRequest
//     );
// 
// 	rtVisionManualGripOpen(
// 		CLK := stCommand.bVisionGripOpenRequest
// 	);
// 	
// 	rtVisionManualGripClose(
// 		CLK := stCommand.bVisionGripCloseRequest
// 	);

    IF bVisionManualEnableAllowed
        AND stCommand.bVisionManualEnable
    THEN


        // =====================================================
        // VISION MANUAL - HORIZONTAL
        // =====================================================
        // KEEP EXACTLY AS VALIDATED.
        //
        // BACK = HOME

        tpVisionManualHorizontalBack(
            IN :=
                rtVisionManualHorizontalBack.Q
                AND bVisionHorizontalBackAllowed,
            PT := T#1S
        );

        // FRONT
        tpVisionManualHorizontalFront(
            IN :=
                rtVisionManualHorizontalFront.Q
                AND bVisionHorizontalFrontAllowed,
            PT := T#1S
        );

	

        // Never command both directions simultaneously.
        IF tpVisionManualHorizontalBack.Q
            AND NOT tpVisionManualHorizontalFront.Q
        THEN

            bVisionHorizontalBackRequest := TRUE;
            bVisionHorizontalFrontRequest := FALSE;

        ELSIF tpVisionManualHorizontalFront.Q
            AND NOT tpVisionManualHorizontalBack.Q
        THEN

            bVisionHorizontalFrontRequest := TRUE;
            bVisionHorizontalBackRequest := FALSE;

        END_IF;

		// =====================================================
		// VISION MANUAL - VERTICAL
		// =====================================================
		//
		// UP:
		//     Vertical UP until UP feedback.
		//
		// INTERMEDIATE:
		//     3. Drive Vertical DOWN.
		//     4. Stop command when cylinder leaves UP.
		//
		// FULL DOWN:
		//     3. Drive Vertical DOWN.
		//     4. Stop at full DOWN feedback.
		//
		// HMI commands are one-scan requests.
		// No timer is used.
		
		
		// -----------------------------------------------------
		// ACCEPT NEW TARGET
		// -----------------------------------------------------
		
        IF stCommand.bVisionVerticalUpRequest AND bVisionVerticalUpAllowed THEN
            bVisionManualVerticalUpActive := TRUE;
            bVisionManualVerticalFullDownActive := FALSE;
        ELSIF stCommand.bVisionVerticalFullDownRequest AND bVisionVerticalFullDownAllowed THEN
            bVisionManualVerticalUpActive := FALSE;
            bVisionManualVerticalFullDownActive := TRUE;
        END_IF
        IF bVisionManualVerticalUpActive THEN
            bVisionVerticalDownRequest := FALSE;
            bVisionVerticalUpRequest := NOT stInputs.bVerticalMiniSlideRetracted;
            IF stInputs.bVerticalMiniSlideRetracted THEN
                bVisionVerticalUpRequest := FALSE;
                bVisionManualVerticalUpActive := FALSE;
            END_IF
        ELSIF bVisionManualVerticalFullDownActive THEN
            bVisionVerticalUpRequest := FALSE;
            bVisionVerticalDownRequest := NOT stInputs.bVerticalMiniSlideExtended;
            IF stInputs.bVerticalMiniSlideExtended THEN
                bVisionVerticalDownRequest := FALSE;
                bVisionManualVerticalFullDownActive := FALSE;
            END_IF
        END_IF

		// =====================================================
		// VISION MANUAL - GRIP
		// =====================================================
		// Momentary command.
		// HMI request is converted to a one-scan PLC pulse in
		// PRG_HmiCommands.
		//
		// No timer is required.
		// OPEN and CLOSE are mutually exclusive.
		
		IF stCommand.bVisionGripOpenRequest
			AND NOT stCommand.bVisionGripCloseRequest
			AND bVisionGripOpenAllowed
		THEN
		
			bVisionGripOpenRequest := TRUE;
			bVisionGripCloseRequest := FALSE;
		
		ELSIF stCommand.bVisionGripCloseRequest
			AND NOT stCommand.bVisionGripOpenRequest
			AND bVisionGripCloseAllowed
		THEN
		
			bVisionGripOpenRequest := FALSE;
			bVisionGripCloseRequest := TRUE;
		
		ELSE
		
			bVisionGripOpenRequest := FALSE;
			bVisionGripCloseRequest := FALSE;
		
		END_IF


		// =====================================================
		// VISION MANUAL - ROTATION
		// =====================================================
		// HMI command is a one-scan request.
		// PLC keeps the output active until position feedback.
		// No timer is required.
		
		// Start 0Â°
		IF stCommand.bVisionRotate0Request
			AND bVisionRotate0Allowed
			AND NOT bVisionManualRotate180Active
		THEN
			bVisionManualRotate0Active := TRUE;
		END_IF
		
		// Start 180Â°
		IF stCommand.bVisionRotate180Request
			AND bVisionRotate180Allowed
			AND NOT bVisionManualRotate0Active
		THEN
			bVisionManualRotate180Active := TRUE;
		END_IF
		
		// Execute movement
		IF bVisionManualRotate0Active THEN
		
			bVisionRotate0Request := TRUE;
			bVisionRotate180Request := FALSE;
		
			IF bVisionRotate0Confirmed THEN
				bVisionRotate0Request := FALSE;
				bVisionManualRotate0Active := FALSE;
			END_IF
		
		ELSIF bVisionManualRotate180Active THEN
		
			bVisionRotate0Request := FALSE;
			bVisionRotate180Request := TRUE;
		
			IF bVisionRotate180Confirmed THEN
				bVisionRotate180Request := FALSE;
				bVisionManualRotate180Active := FALSE;
			END_IF
		
		ELSE
		
			bVisionRotate0Request := FALSE;
			bVisionRotate180Request := FALSE;
		
		END_IF


	ELSE
	
		// Vision Manual Enable removed:
		// cancel unfinished manual movements.

		bVisionManualVerticalUpActive := FALSE;
		bVisionManualVerticalFullDownActive := FALSE;
		bVisionManualRotate0Active := FALSE;
		bVisionManualRotate180Active := FALSE;
	
	END_IF

ELSE

    // Leaving Manual also cancels unfinished manual sequences.
    bVisionManualVerticalUpActive := FALSE;

    bVisionManualVerticalFullDownActive := FALSE;

    bVisionManualRotate0Active := FALSE;
    bVisionManualRotate180Active := FALSE;

END_IF

stVisionStatus.bFault := stVisionStatus.bFault OR fbVisionManualImages.bFault;
IF fbVisionManualImages.bActive OR fbVisionManualImages.bFault THEN
    stVisionStatus.sDiagnostic := fbVisionManualImages.sMessage;
END_IF

// Current station/nest status for HMI.
stPatchDispenseStatus.bPartPresent := bPatchDispenseRequired;
stHeatStakeStatus.bPartPresent := bHeatStakeRequired;
stVisionStatus.bPartPresent := bVisionRequired;

// Homing is an internal machine-initialisation activity, not an automatic
// process cycle. Keep FB_VisionStation.IsBusy() unchanged for controlled-stop
// logic, but do not publish Vision as Busy to the operator while the machine is
// in System Initialising.
IF eMachineState = E_MachineState.Initialising THEN
    stVisionStatus.bBusy := FALSE;
END_IF

// Manual indication follows current HOME feedback, independently of the station FB state.
// Individual manual movements are owned by the machine and can leave the station FB idle.
IF eMachineState = E_MachineState.Manual THEN
    stVisionStatus.bBusy :=
        NOT stVisionStatus.bHome
        OR bVisionManualSequenceActive
        OR bVisionManualHomeActive
        OR fbVisionManualImages.bActive;

    stVisionStatus.bReady :=
        stVisionStatus.bHome
        AND NOT stVisionStatus.bBusy
        AND bVisionManualEnableAllowed
        AND stCommand.bVisionManualEnable
        AND NOT fbVision.IsFaulted() AND NOT fbVisionManualImages.bFault;
END_IF

// "Ready" on the Heat Stake HMI is an operational indication, not an
// Initialising indication.
//
// FB_HeatStakeStation is intentionally enabled during System Initialising so
// it can establish/check its safe initial position. Its internal IsReady()
// state is still allowed to become TRUE there, because machine Initialising
// may depend on it. Only the published HMI Ready indication is gated.
//
// Show Ready only in states where an engineer/operator can actually use the
// station.
stHeatStakeStatus.bReady :=
    stHeatStakeStatus.bReady
    AND (
        (eMachineState = E_MachineState.ReadyToStart)
        OR (eMachineState = E_MachineState.AutoCycle)
        OR (eMachineState = E_MachineState.Manual)
    );

IF NOT bPatchDispenseRequired THEN
    stPatchDispenseStatus.eResultStatus := E_StationResultStatus.NotTested;
ELSIF stPatchDispenseNest.stPatchDispenseResult.bValid THEN
    IF stPatchDispenseNest.stPatchDispenseResult.bPassed THEN
        stPatchDispenseStatus.eResultStatus := E_StationResultStatus.Pass;
    ELSE
        stPatchDispenseStatus.eResultStatus := E_StationResultStatus.Fail;
    END_IF
ELSE
    stPatchDispenseStatus.eResultStatus := E_StationResultStatus.NotTested;
END_IF

IF stHeatStakeNest.stHeatStakeResult.bValid
    AND (stHeatStakeNest.stHeatStakeResult.udiAlertCode = GVL_MASTER.udiHeatStakePatchMissingAlertCode) THEN
    stHeatStakeStatus.eResultStatus := E_StationResultStatus.Fail;
ELSIF NOT bHeatStakeRequired THEN
    stHeatStakeStatus.eResultStatus := E_StationResultStatus.NotTested;
ELSIF stHeatStakeNest.stHeatStakeResult.bValid THEN
    IF stHeatStakeNest.stHeatStakeResult.bPassed THEN
        stHeatStakeStatus.eResultStatus := E_StationResultStatus.Pass;
    ELSE
        stHeatStakeStatus.eResultStatus := E_StationResultStatus.Fail;
    END_IF
ELSE
    stHeatStakeStatus.eResultStatus := E_StationResultStatus.NotTested;
END_IF

IF NOT bVisionRequired THEN
    stVisionStatus.eResultStatus := E_StationResultStatus.NotTested;
ELSIF stVisionNest.stVisionResult.bValid THEN
    IF stVisionNest.stVisionResult.bPassed THEN
        stVisionStatus.eResultStatus := E_StationResultStatus.Pass;
    ELSE
        stVisionStatus.eResultStatus := E_StationResultStatus.Fail;
    END_IF
ELSE
    stVisionStatus.eResultStatus := E_StationResultStatus.NotTested;
END_IF

bAllRequiredStationsReady :=
    ((NOT bPatchDispenseRequired) OR fbPatchDispense.IsReady())
    AND ((NOT bHeatStakeRequired) OR fbHeatStake.IsReady())
    AND ((NOT bVisionRequired) OR fbVision.IsReady());

bAllRequiredStationsComplete :=
    ((NOT bPatchDispenseRequired) OR fbPatchDispense.IsDone())
    AND ((NOT bHeatStakeRequired) OR fbHeatStake.IsDone())
    AND ((NOT bVisionRequired) OR fbVision.IsDone());

// TRUE from support extension through the simulated process and support
// retraction of at least one active station.
bAnyStationInProcess :=
    fbPatchDispense.IsBusy()
    OR fbHeatStake.IsBusy()
    OR fbVision.IsBusy();

IF (eProcessCycleState = E_CycleState.WaitingForProcessesComplete)
    AND bAllRequiredStationsComplete
    AND NOT bCycleResultsStored
THEN

	IF bPatchDispenseRequired THEN
	
		// Capture the station result once.
		stPatchDispenseCycleResult := fbPatchDispense.GetResult();
	
		// Store the Patch Dispense result in the physical nest.
		fbNestManager.StorePatchDispenseResultAtPosition(
			ePosition := stConfig.ePatchDispensePosition,
			stResult := stPatchDispenseCycleResult
		);
	
		// -----------------------------------------------------
		// PATCH DISPENSE FAILED
		// -----------------------------------------------------
		// Patch failure is not a definitive product Reject.
		// The part must return to the operator for reprocessing.
		IF stPatchDispenseCycleResult.bValid
			AND NOT stPatchDispenseCycleResult.bPassed
		THEN
	
			fbNestManager.MarkReprocessAtPosition(
				ePosition := stConfig.ePatchDispensePosition
			);
	
		END_IF
	
	END_IF

    IF bHeatStakeRequired THEN
        fbNestManager.StoreHeatStakeResultAtPosition(
            ePosition := stConfig.eHeatStakePosition,
            stResult := fbHeatStake.GetResult()
        );
    END_IF

    IF bVisionRequired THEN
        fbNestManager.StoreVisionResultAtPosition(
            ePosition := stConfig.eVisionPosition,
            stResult := fbVision.GetResult()
        );
    END_IF
	
// =====================================================
// FINALISE PRODUCT RESULT
// =====================================================

// Read the Vision nest before finalisation.
// Reprocess parts must never be converted into a final Reject.
stHistoryNest :=
    fbNestManager.GetNestAtPosition(
        stConfig.eVisionPosition
    );

IF (stHistoryNest.eDisposition <> E_PartDisposition.Reprocess)
    AND fbNestManager.FinaliseResultAtPosition(
        ePosition := stConfig.eVisionPosition
    )
THEN

    // Read the finalised nest immediately.
    // At this point the final result and statistics are already valid.
    stHistoryNest :=
        fbNestManager.GetNestAtPosition(
            stConfig.eVisionPosition
        );

    uiHistoryNestId := stHistoryNest.nId;


    // =================================================
    // TEST HISTORY
    // =================================================

    IF stHistoryNest.bPartPresent
        AND stHistoryNest.stResult.bValid
    THEN

        // ---------------------------------------------
        // GENERAL RESULT
        // ---------------------------------------------

        GVL_Persistent.astTestHistory[
            GVL_Persistent.uiTestHistoryWriteIndex
        ].uiNestId := uiHistoryNestId;

        GVL_Persistent.astTestHistory[
            GVL_Persistent.uiTestHistoryWriteIndex
        ].eResult := stHistoryNest.eDisposition;


        // ---------------------------------------------
        // PATCH DISPENSE
        // ---------------------------------------------

        GVL_Persistent.astTestHistory[
            GVL_Persistent.uiTestHistoryWriteIndex
        ].bPatchDispenseValid :=
            stHistoryNest.stPatchDispenseResult.bValid;

        GVL_Persistent.astTestHistory[
            GVL_Persistent.uiTestHistoryWriteIndex
        ].bPatchDispensePass :=
            stHistoryNest.stPatchDispenseResult.bPassed;


        // ---------------------------------------------
        // HEAT STAKE
        // ---------------------------------------------

        GVL_Persistent.astTestHistory[
            GVL_Persistent.uiTestHistoryWriteIndex
        ].bHeatStakeValid :=
            stHistoryNest.stHeatStakeResult.bValid;

        GVL_Persistent.astTestHistory[
            GVL_Persistent.uiTestHistoryWriteIndex
        ].bHeatStakePass :=
            stHistoryNest.stHeatStakeResult.bPassed;


        // ---------------------------------------------
        // VISION
        // ---------------------------------------------

        GVL_Persistent.astTestHistory[
            GVL_Persistent.uiTestHistoryWriteIndex
        ].bVisionValid :=
            stHistoryNest.stVisionResult.bValid;

        GVL_Persistent.astTestHistory[
            GVL_Persistent.uiTestHistoryWriteIndex
        ].bVisionPass :=
            stHistoryNest.stVisionResult.bPassed;
		
		// Store individual Vision inspection results
		// for persistent history and future CSV integration.
		
		GVL_Persistent.astTestHistory[
			GVL_Persistent.uiTestHistoryWriteIndex
		].stVisionInspectionResults :=
			stHistoryNest.stVisionResult.CameraResults;


        // ---------------------------------------------
        // DATE / TIME
        // ---------------------------------------------

        GVL_Persistent.astTestHistory[
            GVL_Persistent.uiTestHistoryWriteIndex
        ].sDate := GVL_MASTER.sSystemDate;

        GVL_Persistent.astTestHistory[
            GVL_Persistent.uiTestHistoryWriteIndex
        ].sTime := GVL_MASTER.sSystemTime;


        // ---------------------------------------------
        // FINAL RESULT TEXT
        // ---------------------------------------------

        IF stHistoryNest.stResult.bPassed THEN

            GVL_Persistent.astTestHistory[
                GVL_Persistent.uiTestHistoryWriteIndex
            ].sResult := 'PASS';

        ELSE

            GVL_Persistent.astTestHistory[
                GVL_Persistent.uiTestHistoryWriteIndex
            ].sResult := 'FAIL';

        END_IF;


        // ---------------------------------------------
        // PATCH DISPENSE RESULT TEXT
        // ---------------------------------------------

        IF NOT stHistoryNest.stPatchDispenseResult.bValid THEN

            GVL_Persistent.astTestHistory[
                GVL_Persistent.uiTestHistoryWriteIndex
            ].sPatchDispenseResult := 'NOT TESTED';

        ELSIF stHistoryNest.stPatchDispenseResult.bPassed THEN

            GVL_Persistent.astTestHistory[
                GVL_Persistent.uiTestHistoryWriteIndex
            ].sPatchDispenseResult := 'PASS';

        ELSE

            GVL_Persistent.astTestHistory[
                GVL_Persistent.uiTestHistoryWriteIndex
            ].sPatchDispenseResult := 'FAIL';

        END_IF;


        // ---------------------------------------------
        // HEAT STAKE RESULT TEXT
        // ---------------------------------------------

        IF NOT stHistoryNest.stHeatStakeResult.bValid THEN

            GVL_Persistent.astTestHistory[
                GVL_Persistent.uiTestHistoryWriteIndex
            ].sHeatStakeResult := 'NOT TESTED';

        ELSIF stHistoryNest.stHeatStakeResult.bPassed THEN

            GVL_Persistent.astTestHistory[
                GVL_Persistent.uiTestHistoryWriteIndex
            ].sHeatStakeResult := 'PASS';

        ELSE

            GVL_Persistent.astTestHistory[
                GVL_Persistent.uiTestHistoryWriteIndex
            ].sHeatStakeResult := 'FAIL';

        END_IF;


        // ---------------------------------------------
        // VISION RESULT TEXT
        // ---------------------------------------------

        IF NOT stHistoryNest.stVisionResult.bValid THEN

            GVL_Persistent.astTestHistory[
                GVL_Persistent.uiTestHistoryWriteIndex
            ].sVisionResult := 'NOT TESTED';

        ELSIF stHistoryNest.stVisionResult.bPassed THEN

            GVL_Persistent.astTestHistory[
                GVL_Persistent.uiTestHistoryWriteIndex
            ].sVisionResult := 'PASS';

        ELSE

            GVL_Persistent.astTestHistory[
                GVL_Persistent.uiTestHistoryWriteIndex
            ].sVisionResult := 'FAIL';

        END_IF;


		// =====================================================
		// CSV - CAPTURE FINAL PRODUCT RESULT
		// =====================================================
		// Capture the final validated Test History record.
		// REPROCESS is excluded by the existing finalisation.
		// =====================================================
		
		IF NOT GVL_Persistent.bCSVPendingRecord THEN
		
			GVL_Persistent.stCSVPendingRecord.uiNestId :=
				GVL_Persistent.astTestHistory[
					GVL_Persistent.uiTestHistoryWriteIndex
				].uiNestId;
		
			GVL_Persistent.stCSVPendingRecord.sGeneralResult :=
				GVL_Persistent.astTestHistory[
					GVL_Persistent.uiTestHistoryWriteIndex
				].sResult;
		
			GVL_Persistent.stCSVPendingRecord.sPatchDispenseResult :=
				GVL_Persistent.astTestHistory[
					GVL_Persistent.uiTestHistoryWriteIndex
				].sPatchDispenseResult;
		
			GVL_Persistent.stCSVPendingRecord.sHeatStakeResult :=
				GVL_Persistent.astTestHistory[
					GVL_Persistent.uiTestHistoryWriteIndex
				].sHeatStakeResult;
		
			GVL_Persistent.stCSVPendingRecord.sVisionResult :=
				GVL_Persistent.astTestHistory[
					GVL_Persistent.uiTestHistoryWriteIndex
				].sVisionResult;
		
			GVL_Persistent.stCSVPendingRecord.sDate :=
				GVL_Persistent.astTestHistory[
					GVL_Persistent.uiTestHistoryWriteIndex
				].sDate;
		
			GVL_Persistent.stCSVPendingRecord.sTime :=
				GVL_Persistent.astTestHistory[
					GVL_Persistent.uiTestHistoryWriteIndex
				].sTime;
		
			GVL_Persistent.bCSVPendingRecord := TRUE;
		
		ELSE
		
			// Previous record has not yet been consumed.
			GVL_Persistent.udiCSVRecordsDropped :=
				GVL_Persistent.udiCSVRecordsDropped + 1;
		
			GVL_Persistent.bCSVQueueOverflow := TRUE;
		
		END_IF
		
		// ---------------------------------------------
        // ADVANCE HISTORY BUFFER
        // ---------------------------------------------

        IF GVL_Persistent.uiTestHistoryCount < 2001 THEN

            GVL_Persistent.uiTestHistoryCount :=
                GVL_Persistent.uiTestHistoryCount + 1;

        END_IF;

        IF GVL_Persistent.uiTestHistoryWriteIndex < 2000 THEN

            GVL_Persistent.uiTestHistoryWriteIndex :=
                GVL_Persistent.uiTestHistoryWriteIndex + 1;

        ELSE

            GVL_Persistent.uiTestHistoryWriteIndex := 0;

        END_IF;

    END_IF;

END_IF;

// Prevent this cycle result from being stored/finalised again.
bCycleResultsStored := TRUE;


END_IF

// =====================================================
// REPROCESS POPUP - OPERATOR STATION
// =====================================================
// 
// Activate Reprocess requirement when a Reprocess
// part is present at the Operator Station.
IF (stOperatorNest.ePosition = E_TablePosition.Position1)
    AND (stOperatorNest.eDisposition = E_PartDisposition.Reprocess)
    AND stOperatorNest.bPartPresent
THEN
    bReprocessAcknowledgePending := TRUE;
END_IF

// Reset acknowledgement memory only when there is
// no active Reprocess acknowledgement pending
// and the operator nest is empty.
IF NOT stOperatorNest.bPartPresent
    AND NOT bReprocessAcknowledgePending
THEN
    bReprocessPopupAcknowledged := FALSE;
END_IF

// Acknowledge the current Reprocess part.
IF GVL_HMI.stCommands.bReprocessPopupAcknowledge THEN
    bReprocessPopupAcknowledged := TRUE;
    bReprocessAcknowledgePending := FALSE;
    GVL_HMI.stCommands.bReprocessPopupAcknowledge := FALSE;
END_IF

// // Require acknowledgement only for an unacknowledged
// // Reprocess part physically present at the Operator Station.
// IF (stOperatorNest.ePosition = E_TablePosition.Position1)
//     AND (stOperatorNest.eDisposition = E_PartDisposition.Reprocess)
//     AND stOperatorNest.bPartPresent
//     AND NOT bReprocessPopupAcknowledged
// THEN
//     bReprocessAcknowledgePending := TRUE;
// END_IF

// Popup remains requested until acknowledged,
// // even if the part is physically removed.
// GVL_HMI.stStatus.bReprocessPopupRequest :=
//     bReprocessAcknowledgePending;
// Reprocess popup request.
// Keep the PLC interlock independent from popup visibility.

rtReprocessIndexAttempt(
    CLK := stInputs.bTwoHandsSafe
);

// Generate a new FALSE -> TRUE transition when the
// operator attempts to index with Reprocess pending.
IF NOT bReprocessAcknowledgePending THEN

    GVL_HMI.stStatus.bReprocessPopupRequest := FALSE;

ELSIF rtReprocessIndexAttempt.Q THEN

    GVL_HMI.stStatus.bReprocessPopupRequest := FALSE;

ELSE

    GVL_HMI.stStatus.bReprocessPopupRequest := TRUE;

END_IF
// Request popup only for an unacknowledged Reprocess part
// physically present at the Operator Station.
// GVL_HMI.stStatus.bReprocessPopupRequest :=
//     (stOperatorNest.ePosition = E_TablePosition.Position1)
//     AND (stOperatorNest.eDisposition = E_PartDisposition.Reprocess)
//     AND stOperatorNest.bPartPresent
//     AND NOT bReprocessPopupAcknowledged;

// Clear an old processed record only after operator disposition is complete.
// A newly loaded part is not cleared because its load edge has already reset
// stResult.bValid to FALSE in FB_NestTableManager.
IF stOperatorStatus.bExchangeComplete
    AND (
        stOperatorNest.stResult.bValid
        OR (stOperatorNest.eDisposition = E_PartDisposition.Reprocess)
    )
    AND NOT stInputs.bLoadingStationEaglePresent
    AND NOT stInputs.bLoadingStationPbupPresent
THEN

    fbNestManager.ClearOperatorNest(
        stConfig.eOperatorPosition
    );

END_IF




stOutputsInternal.bStation1SupportExtend := FALSE; // Removed Station 1 nest support.
stOutputsInternal.bStation1SupportRetract := FALSE; // Reserved compatibility output.
stOutputsInternal.bStation2SupportExtend := bStation2SupportExtendRequest;
stOutputsInternal.bStation2SupportRetract := bStation2SupportRetractRequest;
stOutputsInternal.bStation3SupportExtend := FALSE; // Removed hardware.
stOutputsInternal.bStation3SupportRetract := FALSE; // Removed hardware.
stOutputsInternal.bVisionHorizontalBack := bVisionHorizontalBackRequest;
stOutputsInternal.bVisionHorizontalFront := bVisionHorizontalFrontRequest;
stOutputsInternal.bVisionVerticalUp := bVisionVerticalUpRequest;
stOutputsInternal.bVisionVerticalDown := bVisionVerticalDownRequest;
stOutputsInternal.bVisionLimitOff := FALSE; // Removed hardware.
stOutputsInternal.bVisionLimitOn := FALSE; // Removed hardware.
stOutputsInternal.bVisionGripClose := bVisionGripCloseRequest;
stOutputsInternal.bVisionGripOpen := bVisionGripOpenRequest;
stOutputsInternal.bVisionRotate0 := bVisionRotate0Request;
stOutputsInternal.bVisionRotate180 := bVisionRotate180Request;
stOutputsInternal.bHeatStakeHeadLock := bHeatStakeHeadLockRequest;
stOutputsInternal.bHeatStakeHeadUnlock := bHeatStakeHeadUnlockRequest;
stOutputsInternal.bHeatStakeHeadDown := bHeatStakeHeadDownRequest;
stOutputsInternal.bHeatStakeHeadUp := bHeatStakeHeadUpRequest;
stPermissives.bAirSupplyReady := GVL_Safety.bAirSupplySafe;


// Patch actuator ownership: HOME/sequence, individual Manual actions, then index hold-UP.
bPatchHoldUpAllowed := bPatchDispenseCommissioned AND stInputs.stSafety.bSafetyOk
    AND stInputs.bMainDoorClosed AND GVL_Safety.bAirSupplySafe
    AND ((eMachineState = E_MachineState.AutoCycle)
        OR ((eMachineState = E_MachineState.Manual)
            AND NOT bPatchManualVerticalDownHeld AND NOT stPatchDispenseStatus.bFault)
        OR ((eMachineState = E_MachineState.Stopping) AND stIndexStatus.bBusy));
stOutputsInternal.bPatchVerticalUp := FALSE;
stOutputsInternal.bPatchVerticalDown := FALSE;
stOutputsInternal.bPatchDispenserAir := FALSE;
IF stInputs.stSafety.bSafetyOk AND stInputs.bMainDoorClosed
    AND GVL_Safety.bAirSupplySafe AND bPatchDispenseCommissioned THEN
    IF fbPatchDispense.IsBusy() OR (eMachineState = E_MachineState.Initialising) THEN
        stOutputsInternal.bPatchVerticalDown := bPatchSequenceDownRequest;
        stOutputsInternal.bPatchVerticalUp := bPatchHomeVerticalUpRequest
            AND NOT bPatchSequenceDownRequest;
        stOutputsInternal.bPatchDispenserAir := bPatchSequenceAirRequest;
    ELSIF bPatchManualAllowed THEN
        stOutputsInternal.bPatchVerticalDown := bPatchManualVerticalDownHeld
            AND NOT stCommand.bIndexerManualEnable;
        stOutputsInternal.bPatchVerticalUp := bPatchHoldUpAllowed
            AND NOT stOutputsInternal.bPatchVerticalDown;
        stOutputsInternal.bPatchDispenserAir := tpPatchAirBlow.Q;
    ELSE
        stOutputsInternal.bPatchVerticalUp := bPatchHoldUpAllowed;
    END_IF
END_IF

// Same criterion used by the validated Silicone Station:
// the machine waits until the door supervisor confirms automatic readiness.
stPermissives.bDoorInitialisationReady :=
    NOT fbMainDoorLock.IsFaulted()
    AND fbMainDoorLock.IsReadyForAutomatic();
stPermissives.bIndexInitialisationReady := NOT fbIndex.IsFaulted();
// Heat Stake is the only fitted nest support. Require its real retracted
// feedback and reject contradictory feedback. Patch transfer vertical and
// all other index permissives remain separate below.
stPermissives.bStationsHome :=
    stInputs.bStation2SupportRetracted
    AND NOT stInputs.bStation2SupportExtended;

stPermissives.bInitialisationAllowed := stInputs.stSafety.bSafetyOk
    AND stPermissives.bAirSupplyReady
    AND stPermissives.bDoorInitialisationReady
    AND stPermissives.bIndexInitialisationReady;

stPermissives.bSafetyIndexPermissive := stInputs.stSafety.bMotionSafetyPermitted;

stPermissives.bOperatorIndexPermissive :=
    stOperatorStatus.bIndexPermissive
    AND bOperatorLoadValid
    AND NOT bReprocessAcknowledgePending;

stPermissives.bStationsIndexPermissive := stPermissives.bStationsHome
    AND bPatchVerticalIndexReady
    AND (GVL_Motion.stPatchFeedSettings.bUsePatchVerticalFeedback
        OR stOutputsInternal.bPatchVerticalUp)
    AND NOT fbPatchDispense.IsBusy() AND NOT fbPatchFeedManager.stStatus.bDriveBusy
    AND NOT bPatchManualVerticalDownHeld
    AND NOT stOutputsInternal.bPatchVerticalDown
    AND NOT fbVisionManualImages.bActive AND NOT bVisionImageRecoveryRequired
    AND ((eMachineState <> E_MachineState.Manual)
        OR (stVisionStatus.bHome AND bHeatStakeManualHomePosition AND NOT fbVisionManualImages.bFault
            AND NOT bVisionImageJogBusy AND NOT bVisionManualHomeActive AND NOT bVisionManualSequenceActive
            AND NOT bManualCameraRecoveryActive));
// IMPORTANT:
// The operator exchange permissive is a START permissive only.
// Once the table starts moving, FB_OperatorStation intentionally leaves
// ExchangeComplete and bOperatorIndexPermissive becomes FALSE.
// Therefore it must NOT be part of the continuous movement permissive passed
// to FB_IndexTable4, otherwise the index faults immediately with
// MovementPermissiveLost as soon as motion begins.
//
// ProcessCycle still checks bOperatorIndexPermissive BEFORE RequestMove().
stPermissives.bIndexMoveAllowed :=
    stPermissives.bSafetyIndexPermissive
    AND stPermissives.bStationsIndexPermissive;
	
fbCommissioningGuard.Cyclic(bDispenseCommissioned := bPatchDispenseCommissioned, 
bHeatStakeCommissioned := bHeatStakeCommissioned, 
bVisionCommissioned := bVisionCommissioned,
bCoreCommissioningMode := bCoreCommissioningMode, 
bCoreReady := ((eMachineState = E_MachineState.ReadyToStart) 
				OR (eMachineState = E_MachineState.Dwell)
				OR (eMachineState = E_MachineState.AutoCycle)), 
bAutoCycleAllowed => bAutoCycleAllowed, 
sBlockReason => sAutoCycleBlockReason);

// Camera RUN is an independent automatic-operation requirement.
// Commissioning mode must not bypass this camera prerequisite.
IF NOT GVL_EtherCAT.stVSKeyenceCamera.bRunStatus THEN
    bAutoCycleAllowed := FALSE;
    sAutoCycleBlockReason := 'Vision camera not in RUN - select RUN in VS Creator';
ELSIF bVisionCameraStartBlocked THEN
    bAutoCycleAllowed := FALSE;
    sAutoCycleBlockReason := 'Vision camera error - follow camera recovery procedure before Start';
END_IF

stPermissives.bAutoCycleAllowed := bAutoCycleAllowed;

fbProcessCycle.Cyclic(
    bEnable := (eMachineState = E_MachineState.AutoCycle),
    bResetRequest := stCommand.bReset,
    bStopRequest :=
        stCommand.bStop
        OR stInputs.bEventCycleStopRequest
        OR bRejectChuteStopRequestLatched
        OR NOT GVL_EtherCAT.stVSKeyenceCamera.bRunStatus,
    bTwoHandsSafe := stInputs.bTwoHandsSafe,
    bSafetyOk := stInputs.stSafety.bSafetyOk,
    bIndexReady := stInputs.bIndexReady,
    bIndexLocked := stInputs.bIndexLocked,
    bIndexBusy := stIndexStatus.bBusy,
    bIndexFaulted := fbIndex.IsFaulted(),
	bHeaterDwellPending := bHeaterDwellRequestLatched,
    bStationsIndexPermissive := stPermissives.bStationsIndexPermissive,
    bOperatorIndexPermissive := stPermissives.bOperatorIndexPermissive,
    bTemperatureIndexPermissive := stHeatStakeTemperatureStatus.bIndexTemperatureReady,
    bNestEnableIndexPermissive := NOT bDisabledNestPartPresent,
    bAllStationsReady := bAllRequiredStationsReady,
    bAllStationsComplete := bAllRequiredStationsComplete,
    bAnyStationFault :=
        fbPatchDispense.IsFaulted()
        OR fbHeatStake.IsFaulted()
        OR fbVision.IsFaulted(),
    tSequenceTimeout := T#2M,
    bStartStations => bProcessStartStations,
    bStopStations => bProcessStopStations,
    bRequestIndex => bProcessRequestIndex,
    bCycleActive => bProcessCycleActive,
    bCompletePulse => bProcessCycleCompletePulse,
    bFault => bProcessCycleFault,
    bSequenceTimeoutFault => bProcessCycleTimeoutFault,
    bStopPendingStatus => bProcessStopPending,
    bAutomaticStopRequest => bProcessAutomaticStopRequest,
    bDisabledNestIndexAttempt => bDisabledNestIndexAttempt,
    eState => eProcessCycleState
);

// Stop Request is latched immediately so the operator request is never lost,
// even when an automatic station process is still running.
//
// Sources:
// - physical/HMI Stop command;
// - existing Events-cycle Stop Request;
// - 2-minute automatic inactivity request from FB_ProcessCycle.
//
// The existing Events/DataGrid logic is intentionally untouched, so the
// operator Stop Request indication continues to appear immediately as before.
IF (eMachineState = E_MachineState.AutoCycle)
    AND (
        stCommand.bStop
        OR stInputs.bEventCycleStopRequest
        OR bProcessAutomaticStopRequest
        OR bRejectChuteStopRequestLatched
        OR NOT GVL_EtherCAT.stVSKeyenceCamera.bRunStatus
    )
THEN
    bAutoCycleStopRequestLatched := TRUE;
END_IF

IF bDisabledNestIndexAttempt AND bDisabledNestPartPresent THEN
    bDisabledNestPartPopupRequest := TRUE;
    uiDisabledNestPartPopupNestId := uiDisabledNestPartNestId;
END_IF

// Popup OK only closes the request. If the part is still present, the next
// fresh index attempt requests the popup again.
IF stCommand.bAcknowledgeDisabledNestPartPopup THEN
    bDisabledNestPartPopupRequest := FALSE;
END_IF

// Block only a NEW automatic index request; preserve in-progress motion permissives.
IF bProcessRequestIndex AND GVL_EtherCAT.stVSKeyenceCamera.bRunStatus
    AND bOperatorLoadValid AND stPermissives.bOperatorIndexPermissive
    AND stInputs.bTwoHandsSafe AND stInputs.bIndexReady AND stInputs.bIndexLocked
    AND NOT stIndexStatus.bBusy AND (stInputs.eIndexPosition <> E_TablePosition.Unknown) THEN
    bIndexMoveAccepted := fbIndex.RequestMove();
END_IF



// =========================================================
// HMI HEARTBEAT MONITORING
// =========================================================
tonHMIAliveOn(
    IN := GVL_HMI.bHMIAlive,
    PT := T#2S
);

tonHMIAliveOff(
    IN := NOT GVL_HMI.bHMIAlive,
    PT := T#2S
);

bOutHMI := tonHMIAliveOn.Q OR tonHMIAliveOff.Q;


// =========================================================
// HMI UNAVAILABLE - STOPPED MESSAGE
// =========================================================

// Show the HMI unavailable message only while
// the machine is Stopped and heartbeat is missing.
GVL_HMI.bHmiLogoutStopped := bOutHMI AND (eMachineState = E_MachineState.Stopped);

// =========================================================
// HMI CONNECTION LOSS - SAFETY DROP REQUEST
// =========================================================
// A confirmed heartbeat timeout during an active machine
// state requests a TwinSAFE Run/Stop drop.
//
// Stopped and Stopping do not generate a new fault.

IF bOutHMI AND (
    (eMachineState = E_MachineState.Initialising)
    OR (eMachineState = E_MachineState.ReadyToStart)
    OR (eMachineState = E_MachineState.AutoCycle)
    OR (eMachineState = E_MachineState.Manual)
	OR (eMachineState = E_MachineState.Dwell)
) THEN
    bSafetyDropRequest := TRUE;
    // Preserve the trip reason through the existing HMI event/reset path.
    GVL_HMI.bHmiLogoutAutoCycle := TRUE;
END_IF

// =========================================================
// UNEXPECTED HMI LOGOUT
// =========================================================
// Logout is permitted in Stopped and Stopping.
// During operation, logout causes a machine Fault.
// Do not request a TwinSAFE run drop for a user-session event.

IF bLogoutHMI AND (
    (eMachineState = E_MachineState.Initialising)
    OR (eMachineState = E_MachineState.ReadyToStart)
    OR (eMachineState = E_MachineState.AutoCycle)
    OR (eMachineState = E_MachineState.Manual)
	OR (eMachineState = E_MachineState.Dwell)
) THEN
    GVL_HMI.bLogoutFaultActive := TRUE;
    bSafetyDropRequest := TRUE;
	GVL_HMI.bHmiLogoutAutoCycle := TRUE;
	GVL_HMI.bHmiLogoutStopped := FALSE;
END_IF

// TwinSAFE safety loss always places the machine in Fault, but it must NOT
// generate a PLC Run/Stop drop request. RunRequest must return TRUE so
// TwinSAFE can execute again and restore Safety_OK after the safety condition
// has recovered.
IF NOT stInputs.stSafety.bSafetyOk THEN
    eMachineState := E_MachineState.Fault;
END_IF

// PLC-originated immediate faults request a controlled TwinSAFE run drop.
// stInputs.bEventFault is the aggregate of active Events with bFault = TRUE.
// Re-check after component cyclic execution so a fault detected in this scan
// drops TwinSAFE immediately rather than waiting for the following PLC scan.
// Existing event/process-cycle faults are allowed during Initialising so the
// machine can restore pneumatic tooling to HOME.
IF (
        stInputs.bEventFault
        AND (eMachineState <> E_MachineState.Initialising)
    )
    OR fbIndex.IsFaulted()
    OR fbMainDoorLock.IsFaulted()
    OR (
        bProcessCycleFault
        AND (eMachineState <> E_MachineState.Initialising)
    )
    OR stHeatStakeTemperatureStatus.bFault
    OR bInitialisationTimeoutFault
    OR bStoppingTimeoutFault
THEN
    bSafetyDropRequest := TRUE;
    eMachineState := E_MachineState.Fault;
END_IF



CASE eMachineState OF
E_MachineState.PowerUp:
    bAutoCycleStopRequestLatched := FALSE;

    // Same lifecycle used by the validated Silicone Station core:
    // always enter a controlled stop before waiting for Reset.
    tonInitialising(IN := FALSE);
    tonStopping(IN := FALSE);
    eMachineState := E_MachineState.Stopping;

E_MachineState.Stopping:
    // Preserve an already-established pneumatic supply while stopping, but
    // never create a new air request here.
    //
    // Typical Stop path:
    // Ready/Auto/Manual (air latched) -> Stopping -> Stopped
    // Air remains ON while the door stays closed.
    //
    // Fault recovery / PowerUp path:
    // latch is FALSE -> Stopping remains depressurised.
    stOutputsInternal.bAirSupplyEnable :=
        bAirSupplyLatched AND stInputs.bMainDoorClosed;

    tonInitialising(IN := FALSE);
    tonStopping(IN := stIndexStatus.bBusy OR fbPatchFeedManager.stStatus.bBusy, PT := stConfig.tStoppingTimeout);
    bStoppingTimeoutFault := tonStopping.Q;
    IF bStoppingTimeoutFault THEN
        bSafetyDropRequest := TRUE;
        eMachineState := E_MachineState.Fault;
	// The removed Station 1 support no longer gates completion of Stopping.
	ELSIF NOT stIndexStatus.bBusy
        AND NOT fbPatchFeedManager.stStatus.bBusy
	THEN
		eMachineState := E_MachineState.Stopped;
	END_IF

E_MachineState.Stopped:
    bAutoCycleStopRequestLatched := FALSE;

    // Stopped never turns the air ON by itself.
    // It only preserves air that was previously latched by Initialising.
    // As soon as the main door opens, the global door-open rule clears the
    // latch and the ASU drops. Closing the door again does not restore it.
    stOutputsInternal.bAirSupplyEnable :=
        bAirSupplyLatched AND stInputs.bMainDoorClosed;

    tonInitialising(IN := FALSE);
    tonStopping(IN := FALSE);

    // The controlled Stop Request remains latched until Stopped is reached.
    // It is released only after the reject chute interlock was correctly
    // cleared by EMPTY + fresh Acknowledge.
    IF NOT bRejectChuteFullLatched THEN
        bRejectChuteStopRequestLatched := FALSE;
    END_IF

    IF stCommand.bReset
        AND stInputs.stSafety.bSafetyOk
        AND NOT bRejectChuteFullLatched
    THEN
        // Same recovery used by the Silicone Station: clear any stale
        // door-supervisor fault/state before automatic locking starts.
        fbMainDoorLock.Initialise();
        eMachineState := E_MachineState.Initialising;
    END_IF

E_MachineState.Initialising:
    // Only Initialising may establish the pneumatic-supply latch.
    IF stInputs.bMainDoorClosed THEN
        bAirSupplyLatched := TRUE;
    END_IF

    stOutputsInternal.bAirSupplyEnable := bAirSupplyLatched AND stInputs.bMainDoorClosed;
    tonStopping(IN := FALSE);

    // All commissioned stations must complete their HOME sequences.
    tonInitialising(
        IN := NOT (
            stPermissives.bInitialisationAllowed
            AND (usiHeatStakeManualActionStep = 0)
            AND stInputs.bHeatStakeHeadUp
            AND NOT stInputs.bHeatStakeHeadDown
            AND NOT bHeatStakeManualHeadUpTimeoutFault
            AND NOT bHeatStakeManualHeadDownTimeoutFault
            AND NOT bHeatStakeStationHeadSensorConflictFault
            AND ((NOT bVisionCommissioned) OR fbVision.IsReady())
            AND ((NOT bPatchDispenseCommissioned) OR fbPatchDispense.IsHome())
        ),
        PT := stConfig.tInitialiseTimeout
    );

    bInitialisationTimeoutFault := tonInitialising.Q;

    IF bInitialisationTimeoutFault THEN
        bSafetyDropRequest := TRUE;
        eMachineState := E_MachineState.Fault;
    ELSIF stPermissives.bInitialisationAllowed
        AND (usiHeatStakeManualActionStep = 0)
        AND stInputs.bHeatStakeHeadUp
        AND NOT stInputs.bHeatStakeHeadDown
        AND NOT bHeatStakeManualHeadUpTimeoutFault
        AND NOT bHeatStakeManualHeadDownTimeoutFault
        AND NOT bHeatStakeStationHeadSensorConflictFault
        //AND ((NOT bVisionCommissioned) OR fbVision.IsReady())
        AND ((NOT bPatchDispenseCommissioned) OR fbPatchDispense.IsHome())
    THEN
        tonInitialising(IN := FALSE);
        eMachineState := E_MachineState.ReadyToStart;
    END_IF

E_MachineState.ReadyToStart:
    stOutputsInternal.bAirSupplyEnable :=
        bAirSupplyLatched AND stInputs.bMainDoorClosed;

    IF bRejectChuteStopRequestLatched THEN
        eMachineState := E_MachineState.Stopping;

    ELSIF stCommand.bStop THEN
        eMachineState := E_MachineState.Stopping;

    ELSIF stCommand.bManualRequest
        AND stInputs.stSafety.bSafetyOk
        AND NOT stIndexStatus.bBusy
        AND NOT fbIndex.IsFaulted()
    THEN
        eMachineState := E_MachineState.Manual;
    ELSIF stCommand.bStart AND bAutoCycleAllowed AND fbMainDoorLock.IsReadyForAutomatic() THEN
		  IF stHeatStakeTemperatureStatus.bIndexTemperatureReady THEN
				// Heater is ready: start automatic operation.
				eMachineState := E_MachineState.AutoCycle;
			ELSE
				// Heater is below the operating temperature:
				// wait in Dwell before starting automatic operation.
				eMachineState := E_MachineState.Dwell;
			END_IF
	END_IF
	
	
E_MachineState.Dwell:

    // Keep pneumatic supply enabled while waiting for heater temperature.
    stOutputsInternal.bAirSupplyEnable :=
        bAirSupplyLatched AND stInputs.bMainDoorClosed;

    // Stop has priority over temperature recovery.
    IF bRejectChuteStopRequestLatched
        OR stCommand.bStop
        OR stInputs.bEventCycleStopRequest
        OR NOT GVL_EtherCAT.stVSKeyenceCamera.bRunStatus
    THEN
        eMachineState := E_MachineState.Stopping;

    ELSIF stHeatStakeTemperatureStatus.bIndexTemperatureReady
        AND bAutoCycleAllowed
        AND fbMainDoorLock.IsReadyForAutomatic()
        AND stInputs.stSafety.bSafetyOk
    THEN
        // Automatically resume AutoCycle when the heater is ready.
        eMachineState := E_MachineState.AutoCycle;
    END_IF
	

E_MachineState.AutoCycle:
    stOutputsInternal.bAirSupplyEnable :=
        bAirSupplyLatched AND stInputs.bMainDoorClosed;
		
		// =====================================================
		// HEATER DWELL - CONTROLLED TRANSITION
		// =====================================================
		// Wait until the current production cycle has finished,
		// all stations are idle and the index is stationary.
		
		IF bHeaterDwellRequestLatched
			AND NOT bAutoCycleStopRequestLatched
			AND (eProcessCycleState = E_CycleState.WaitingForProcessCycleTrigger)
			AND NOT bAnyStationInProcess
			AND NOT stIndexStatus.bBusy
			AND stInputs.bIndexReady
			AND stInputs.bIndexLocked
			AND stPermissives.bStationsIndexPermissive
			AND NOT bProcessStartStations
			AND NOT bProcessRequestIndex
		THEN
			bHeaterDwellRequestLatched := FALSE;
			eMachineState := E_MachineState.Dwell;
		END_IF

    // Stop Request is controlled, but ONLY an active process at one of the
    // three process stations is allowed to delay leaving AutoCycle.
    //
    // Heat Stake warm-up / temperature control is NOT a process and must not
    // hold the machine in AutoCycle after Stop Request.
    //
    // Likewise, the ProcessCycle coordinator state and index busy state do not
    // block the AutoCycle -> Stopping transition:
    // - ProcessCycle is disabled as soon as AutoCycle is left;
    // - if the index is already moving, the normal Stopping state waits for
    //   stIndexStatus.bBusy to clear before entering Stopped.
    //
    // Therefore the only controlled-stop hold condition here is:
    //     fbPatchDispense.IsBusy()
    //     OR fbHeatStake.IsBusy()
    //     OR fbVision.IsBusy()
    IF bAutoCycleStopRequestLatched
        AND NOT bAnyStationInProcess
    THEN
        bAutoCycleStopRequestLatched := FALSE;
        eMachineState := E_MachineState.Stopping;
    END_IF

E_MachineState.Manual:
    stOutputsInternal.bAirSupplyEnable :=
        bAirSupplyLatched AND stInputs.bMainDoorClosed;

    // Reject chute full = controlled stop in Manual Mode.
    // No new manual actions are accepted. Existing actions complete first.
    bManualRejectStopReady :=
        NOT bHeatStakeManualActionBusy
        AND NOT bHeatStakeManualStakeCycleActive
        AND NOT fbPatchDispense.IsBusy()
        AND NOT fbHeatStake.IsBusy()
        AND NOT fbVision.IsBusy()
        AND NOT stIndexStatus.bBusy
        AND (
            (bManualSupportTargetUpAtRejectStop
                AND stInputs.bStation2SupportExtended)
            OR
            ((NOT bManualSupportTargetUpAtRejectStop)
                AND stInputs.bStation2SupportRetracted)
        );

    IF bRejectChuteStopRequestLatched THEN
        IF bManualRejectStopReady THEN
            eMachineState := E_MachineState.Stopping;
        END_IF

    // Existing operator Stop behaviour remains unchanged.
    ELSIF stCommand.bStop OR stInputs.bEventCycleStopRequest THEN
        eMachineState := E_MachineState.Stopping;
    END_IF

E_MachineState.Fault:
    bAutoCycleStopRequestLatched := FALSE;

    // Immediate Fault always removes the pneumatic-supply memory.
    // Therefore Fault -> Reset -> Stopping -> Stopped remains depressurised
    // until a NEW System Initialising sequence explicitly turns air back on.
    bAirSupplyLatched := FALSE;
    stOutputsInternal.bAirSupplyEnable := FALSE;

    tonInitialising(IN := FALSE);
    tonStopping(IN := FALSE);

    // Latch Reset. PRG_Events runs after PRG_Main and may only clear
    // GVL_MASTER.bMachineFault later in this PLC scan. Without this latch,
    // a one-scan Reset pulse is lost before the machine can leave Fault.
    IF stCommand.bReset AND NOT bOutHMI THEN
        bFaultResetRequested := TRUE;
        bInitialisationTimeoutFault := FALSE;
        bStoppingTimeoutFault := FALSE;
        fbIndex.Reset();
    END_IF
	
		// Do not retain a pending Reset while HMI is unavailable.
	IF bOutHMI THEN
		bFaultResetRequested := FALSE;
	END_IF

    // Leave Fault only after Safety and the event system have both recovered.
    IF bFaultResetRequested
        AND stInputs.stSafety.bSafetyOk
        AND NOT stInputs.bEventFault
        AND NOT fbIndex.IsFaulted()
        AND NOT fbMainDoorLock.IsFaulted()
    THEN
        bFaultResetRequested := FALSE;
        eMachineState := E_MachineState.Stopping;
    END_IF
END_CASE

// Do not queue a rejected start behind HOME or a reserved image position.
// The raw two-hand edge was already sampled before Vision admission this scan.
bManualIndexBlockVision := NOT stVisionStatus.bHome
    OR fbVisionManualImages.bActive OR bVisionImageOwnedBeforeUpdate
    OR bVisionImageJogBusy OR bVisionManualHomeActive OR bVisionManualSequenceActive
    OR bVisionImageRecoveryRequired OR fbVisionManualImages.bFault OR bManualCameraRecoveryActive;
bManualIndexBlockHeat := NOT bHeatStakeManualHomePosition OR fbHeatStake.IsBusy();
bManualIndexBlockPatch := NOT bPatchVerticalIndexReady
    OR NOT (GVL_Motion.stPatchFeedSettings.bUsePatchVerticalFeedback OR stOutputsInternal.bPatchVerticalUp)
    OR fbPatchDispense.IsBusy() OR fbPatchFeedManager.stStatus.bDriveBusy
    OR bPatchManualVerticalDownHeld OR stOutputsInternal.bPatchVerticalDown;
bManualIndexBlockOther := NOT stInputs.stSafety.bMotionSafetyPermitted
    OR NOT stInputs.bMainDoorClosed OR NOT GVL_Safety.bAirSupplySafe
    OR bRejectChuteStopRequestLatched OR stCommand.bStop OR stCommand.bReset
    OR NOT stInputs.bIndexReady OR NOT stInputs.bIndexLocked
    OR (stInputs.eIndexPosition = E_TablePosition.Unknown)
    OR (fbIndex.GetState() <> E_IndexState.Idle) OR stIndexStatus.bTwoHandRequired;
bManualIndexStartAllowed := NOT bManualIndexBlockVision AND NOT bManualIndexBlockHeat
    AND NOT bManualIndexBlockPatch AND NOT bManualIndexBlockOther
    AND stPermissives.bIndexMoveAllowed;
IF bManualIndexAttempt THEN
    IF bManualIndexStartAllowed THEN
        bIndexMoveAccepted := fbIndex.RequestManualMove();
    ELSE
        bManualIndexWarningActive := TRUE;
    END_IF
END_IF
IF (eMachineState <> E_MachineState.Manual) OR bManualIndexStartAllowed THEN
    bManualIndexWarningActive := FALSE;
END_IF
GVL_MASTER.bManualIndexBlockVision := bManualIndexWarningActive AND bManualIndexBlockVision;
GVL_MASTER.bManualIndexBlockHeat := bManualIndexWarningActive AND bManualIndexBlockHeat;
GVL_MASTER.bManualIndexBlockPatch := bManualIndexWarningActive AND bManualIndexBlockPatch;
GVL_MASTER.bManualIndexBlockOther := bManualIndexWarningActive AND bManualIndexBlockOther;
IF NOT stVisionStatus.bHome THEN
    GVL_MASTER.sManualIndexVisionReason := 'Index blocked: Vision not HOME';
ELSIF bVisionImageJogBusy OR bVisionManualHomeActive OR bVisionManualSequenceActive THEN
    GVL_MASTER.sManualIndexVisionReason := 'Index blocked: Vision manual action active';
ELSIF bManualCameraRecoveryActive THEN
    GVL_MASTER.sManualIndexVisionReason := 'Index blocked: camera recovery in progress';
ELSIF fbVisionManualImages.bActive OR bVisionImageOwnedBeforeUpdate THEN
    GVL_MASTER.sManualIndexVisionReason := 'Index blocked: Vision position reserved';
ELSE
    GVL_MASTER.sManualIndexVisionReason := 'Index blocked: Vision recovery required';
END_IF
IF NOT stInputs.stSafety.bMotionSafetyPermitted THEN
    GVL_MASTER.sManualIndexOtherReason := 'Index blocked: motion safety not ready';
ELSIF NOT stInputs.bMainDoorClosed OR NOT GVL_Safety.bAirSupplySafe THEN
    GVL_MASTER.sManualIndexOtherReason := 'Index blocked: door or air not ready';
ELSIF bRejectChuteStopRequestLatched OR stCommand.bStop OR stCommand.bReset THEN
    GVL_MASTER.sManualIndexOtherReason := 'Index blocked: Stop/Reset request active';
ELSIF stInputs.eIndexPosition = E_TablePosition.Unknown THEN
    GVL_MASTER.sManualIndexOtherReason := 'Index blocked: position unknown';
ELSE
    GVL_MASTER.sManualIndexOtherReason := 'Index blocked: table not locked/idle or request pending';
END_IF

fbIndex.Cyclic(bEnable := (eMachineState <> E_MachineState.PowerUp) AND (eMachineState <> E_MachineState.Fault), bReset := stCommand.bReset, bAutomaticMode := (eMachineState = E_MachineState.AutoCycle), bManualMode := (eMachineState = E_MachineState.Manual), bMovePermissive := stPermissives.bIndexMoveAllowed, bSafetyMotionPermitted := stInputs.stSafety.bMotionSafetyPermitted, bTwoHandsSafe := stInputs.bTwoHandsSafe, bStationsHome := stPermissives.bStationsHome, bProcessToolingRetracted := stPermissives.bStationsIndexPermissive, bTableReady := stInputs.bIndexReady, bTableLocked := stInputs.bIndexLocked, bCompletedSensor := stInputs.bIndexCompletedSensor, bSupportExtended := TRUE, bSupportRetracted := TRUE, eCurrentPosition := stInputs.eIndexPosition, tRotateDelay := stConfig.tIndexRotateDelay, tStopDelay := stConfig.tIndexStopDelay, tSupportTimeout := stConfig.tIndexSupportTimeout, tMovementTimeout := stConfig.tIndexTimeout, tTwoHandHold := stConfig.tTwoHandHold, tTwoHandRecoveryTimeout := stConfig.tTwoHandRecoveryTimeout, bRotatePortA => stOutputsInternal.bIndexRotatePortA, bStopPortB => stOutputsInternal.bIndexStopPortB, bSupportExtendRequest => stOutputsInternal.bIndexSupportExtend, bSupportRetractRequest => stOutputsInternal.bIndexSupportRetract);
stIndexStatus := fbIndex.GetStatus();



///////////////////////////////////////////////////////////////////


// Use the state after the machine CASE transitions in this scan.
// Stopped -> Initialising must not drop an existing hot-door lock request.
// Same strategy as the validated Silicone Station.
// Door locking is requested independently from door feedback while the
// machine is in an active state that requires the door secured.
bAirAndDoorEnable :=
    (eMachineState = E_MachineState.Initialising)
    OR (eMachineState = E_MachineState.ReadyToStart)
    OR (eMachineState = E_MachineState.AutoCycle)
    OR (eMachineState = E_MachineState.Manual)
	OR (eMachineState = E_MachineState.Dwell);

 // =====================================================
 // MAIN DOOR - HOT TEMPERATURE PROTECTION
 // =====================================================

 // Reset acknowledgement when leaving Stopped.
 IF eMachineState <> E_MachineState.Stopped THEN
     bMainDoorUnlockAcknowledged := FALSE;

 // Accept acknowledgement only in Stopped.
 ELSIF GVL_HMI.stCommands.bManualMainDoorUnlock THEN
     bMainDoorUnlockAcknowledged := TRUE;
 END_IF;

 // Consume HMI command.
 GVL_HMI.stCommands.bManualMainDoorUnlock := FALSE;

 // Keep door locked in Stopped while heaters are hot,
 // until operator acknowledges.
 bMainDoorHotLockRequired :=
     (eMachineState = E_MachineState.Stopped)
     AND NOT bMainDoorUnlockAcknowledged
     // TC3 is head/body feedback; TC1/TC2 cartridge temperatures do not set this demand.
     // Equality requires acknowledgement; an unordered/NaN value is not considered cool.
     AND NOT (stHeatStakeTemperatureStatus.rOverTempTemperatureC <
         GVL_Config.rMainDoorHotTemperatureLimitC);

 // =====================================================
 // MAIN DOOR SUPERVISION
 // =====================================================

 fbMainDoorLock.Cyclic(
     // Supervise the same lock demand sent to TwinSAFE, including hot-door retention.
     // Retain an existing lock through the entry scan: feeder stop permissions
     // take effect next scan. Never create a new lock demand on PowerUp/recovery.
     bEnableAutomatic := bAirAndDoorEnable
         OR ((eMachineState = E_MachineState.Stopping)
             AND (((ePreviousMachineState <> E_MachineState.Stopping)
                     AND stMainDoorStatus.bLockRequest)
                 OR fbPatchFeedManager.stStatus.bBusy))
         OR bMainDoorHotLockRequired,
     bManualEnable := FALSE,
     bManualLockRequest := FALSE,
     bManualUnlockRequest := FALSE,

     bStopRequest :=
         (eMachineState = E_MachineState.Fault)
         OR ((eMachineState = E_MachineState.Stopping)
             AND (ePreviousMachineState = E_MachineState.Stopping)
             AND NOT fbPatchFeedManager.stStatus.bBusy)
         OR (
             (eMachineState = E_MachineState.Stopped)
             AND NOT bMainDoorHotLockRequired
         ),

     bResetRequest := stCommand.bReset,
     bDoorClosed := stInputs.bMainDoorClosed,
     bDoorLocked := stInputs.bMainDoorLocked,
     bIndexBusy := stIndexStatus.bBusy,
     bProcessSafePosition := NOT fbPatchFeedManager.stStatus.bBusy,
     tLockTimeout := stConfig.tDoorLockTimeout,
     tUnlockTimeout := stConfig.tDoorUnlockTimeout,
     bDoorUnsafe := stInputs.bMainDoorUnsafe,
     bLockOutput => bDoorLockOutput
 );

 stMainDoorStatus := fbMainDoorLock.GetStatus();

 // =====================================================
 // PHYSICAL DOOR LOCK REQUEST
 // =====================================================

 stOutputsInternal.bMainDoorLockRequest :=
     bAirAndDoorEnable
     OR ((eMachineState = E_MachineState.Stopping)
             AND (((ePreviousMachineState <> E_MachineState.Stopping)
                     AND stMainDoorStatus.bLockRequest)
                 OR fbPatchFeedManager.stStatus.bBusy))
     OR bMainDoorHotLockRequired;

	///////////////////////////////

// Re-check after component cyclic execution so a fault detected in this scan
// drops TwinSAFE immediately rather than waiting for the following PLC scan.
// Existing event/process-cycle faults are allowed during Initialising so the
// machine can restore pneumatic tooling to HOME.
IF (
        stInputs.bEventFault
        AND (eMachineState <> E_MachineState.Initialising)
    )
    OR fbIndex.IsFaulted()
    OR fbMainDoorLock.IsFaulted()
    OR (
        bProcessCycleFault
        AND (eMachineState <> E_MachineState.Initialising)
    )
    OR stHeatStakeTemperatureStatus.bFault
    OR bInitialisationTimeoutFault
    OR bStoppingTimeoutFault
	OR bHeaterDwellTimeoutFault
THEN
    bSafetyDropRequest := TRUE;
    eMachineState := E_MachineState.Fault;
END_IF

// =========================================================
// PRODUCT DISPOSITION ON MACHINE FAULT DURING PROCESS
// =========================================================
// A product whose active process is interrupted by a machine
// Fault can no longer continue as a valid production part.
//
// Rules:
// - A completed upstream process remains Complete.
// - The process interrupted by the Fault becomes Fail.
// - Downstream processes become NotTested.
// - The affected product must never reach the operator with
//   an undefined final disposition.
//
// Products that were only waiting for their next process and
// were not actively being processed are preserved and may
// continue normally after machine recovery.

IF (eMachineState = E_MachineState.Fault)
    AND (ePreviousMachineState = E_MachineState.AutoCycle)
THEN

    stProcessFaultResult.bValid := TRUE;
    stProcessFaultResult.bPassed := FALSE;
    stProcessFaultResult.eCode := E_ProcessResultCode.Aborted;
    stProcessFaultResult.udiFaultCode := 0;
    stProcessFaultResult.udiAlertCode := 0;


    // =====================================================
	// PATCH DISPENSE INCOMPLETE / INTERRUPTED
	// =====================================================
	// If a part is physically at Patch Dispense and its Patch
	// process was still required when AutoCycle entered Fault,
	// the part must be removed for Reprocess.
	//
	// This also covers a Fault occurring before the Patch
	// station actually became Busy.
	//
	// A Patch already completed successfully is preserved because
	// bPatchDispenseRequired will already be FALSE.
	
	IF stPatchDispenseNest.bPartPresent
		AND bPatchDispenseRequired
	THEN
	
		// Record why the Patch process did not complete.
		stProcessFaultResult.bValid := TRUE;
		stProcessFaultResult.bPassed := FALSE;
		stProcessFaultResult.eCode := E_ProcessResultCode.Aborted;
		stProcessFaultResult.udiFaultCode := 0;
		stProcessFaultResult.udiAlertCode := 0;
		stProcessFaultResult.sDetail :=
			'Patch Dispense incomplete - part requires reprocess';
	
		fbNestManager.StorePatchDispenseResultAtPosition(
			ePosition := stConfig.ePatchDispensePosition,
			stResult := stProcessFaultResult
		);
	
		// IMPORTANT:
		// Do not finalise as FAIL/Reject.
		// Do not count Good/Bad.
		// Do not create a Data History result.
		fbNestManager.MarkReprocessAtPosition(
			ePosition := stConfig.ePatchDispensePosition
		);
	
	END_IF

   	// =====================================================
	// HEAT STAKE INTERRUPTED
	// =====================================================
	// Before head-down: Reprocess.
	// After head-down: Reject.
	// Preserve the completed Patch Dispense result.
	
	IF stHeatStakeNest.bPartPresent
		AND bHeatStakeRequired
	THEN
	
		stProcessFaultResult.bValid := TRUE;
		stProcessFaultResult.bPassed := FALSE;
		stProcessFaultResult.eCode := E_ProcessResultCode.Aborted;
		stProcessFaultResult.udiFaultCode := 0;
		stProcessFaultResult.udiAlertCode := 0;
	
		IF bHeatStakeHeadDownStarted THEN
	
			// Physical process started: Reject.
			stProcessFaultResult.sDetail :=
				'Heat Stake interrupted after head-down - Reject';
	
			fbNestManager.StoreHeatStakeResultAtPosition(
				ePosition := stConfig.eHeatStakePosition,
				stResult := stProcessFaultResult
			);
	
			fbNestManager.MarkVisionNotTestedAtPosition(
				stConfig.eHeatStakePosition
			);
	
			fbNestManager.FinaliseResultAtPosition(
				stConfig.eHeatStakePosition
			);
	
		ELSE
	
			// Physical process not started: Reprocess.
			stProcessFaultResult.sDetail :=
				'Heat Stake interrupted before head-down - Reprocess';
	
			fbNestManager.StoreHeatStakeResultAtPosition(
				ePosition := stConfig.eHeatStakePosition,
				stResult := stProcessFaultResult
			);
	
			fbNestManager.MarkReprocessAtPosition(
				ePosition := stConfig.eHeatStakePosition
			);
	
		END_IF
	
	END_IF

    // =====================================================
    // VISION INTERRUPTED
    // =====================================================
    // Patch and Heat Stake results are preserved.
    // Vision becomes Fail.

    IF stVisionNest.bPartPresent
        AND NOT (stVisionNest.stHeatStakeResult.bValid
            AND (stVisionNest.stHeatStakeResult.udiAlertCode = GVL_MASTER.udiHeatStakePatchMissingAlertCode))
        AND (
            bVisionProcessingBeforeUpdate
            OR (bProcessStartStations AND bVisionRequired)
        )
    THEN

        stProcessFaultResult.sDetail :=
            'Vision aborted by machine fault during process';

        fbNestManager.StoreVisionResultAtPosition(
            ePosition := stConfig.eVisionPosition,
            stResult := stProcessFaultResult
        );

        fbNestManager.FinaliseResultAtPosition(
            stConfig.eVisionPosition
        );

    END_IF

END_IF

// Validated Silicone-station handshake:
// - Run/Stop is normally TRUE so TwinSAFE is running and can return Safety_OK.
// - A PLC-originated immediate fault pulses Run/Stop FALSE for 500 ms.
// - It then returns TRUE automatically, even while the machine remains in Fault,
//   allowing TwinSAFE to recover and Safety_OK to become TRUE for operator Reset.
tpSafetyRunDrop(
    IN := bSafetyDropRequest,
    PT := T#500MS
);

stOutputsInternal.bSafetyRunRequest := NOT tpSafetyRunDrop.Q;

stOutputsInternal.bSafetyResetRequest := stCommand.bReset AND NOT stInputs.stSafety.bSafetyOk;
stOutputsInternal.bSafetyErrorAcknowledgementRequest := stOutputsInternal.bSafetyResetRequest;
// =========================================================
// OPERATOR LIGHTS - SILICONE STATION BEHAVIOUR
// =========================================================
// Start flashes only while ReadyToStart.
stOutputsInternal.bLedStart :=
    (eMachineState = E_MachineState.ReadyToStart)
    AND bLedBlinkState;

// Reset flashes while operator Reset is expected.
stOutputsInternal.bLedReset :=
    (
        (eMachineState = E_MachineState.PowerUp)
        OR (eMachineState = E_MachineState.Fault)
        OR (eMachineState = E_MachineState.Stopped)
    )
    AND bLedBlinkState;

// -------------------------------------------------------------------------
// Operator PASS / FAIL result lights
// -------------------------------------------------------------------------
// Customer-agreed behaviour:
// - both lights are OFF by default;
// - machine Fault must NEVER use the FAIL/result light;
// - lights are used only in AutoCycle;
// - a valid PASS/FAIL result must exist at the operator nest;
// - the physical part must still be present at the loading/operator nest;
// - immediately after the operator removes the part, both lights turn OFF.
//
// Result-record clearing can occur later as part of the normal operator/reject
// workflow. The physical presence condition intentionally makes the lamp go
// dark immediately on part removal, independent of when the nest result is
// finally cleared.
IF (eMachineState = E_MachineState.AutoCycle)
    AND stOperatorNest.stResult.bValid
    AND stInputs.bLoadingStationEaglePresent
THEN
    stOutputsInternal.bLedPass := stOperatorNest.stResult.bPassed;
    stOutputsInternal.bLedFail := NOT stOperatorNest.stResult.bPassed;
ELSE
    stOutputsInternal.bLedPass := FALSE;
    stOutputsInternal.bLedFail := FALSE;
END_IF

// Lighting:
// - Internal machine light remains ON continuously for now.
//   A future revision may interlock this light with the main-door state.
// - Operator/nest light is controlled by the Main-screen LIGHT toggle.
stOutputsInternal.bInternalLight := TRUE;
stOutputsInternal.bNestLight := stCommand.bOperatorLight;
// -------------------------------------------------------------------------
// Heat Stake HMI status - Manual Mode tooling position
// -------------------------------------------------------------------------
// Keep the station FB free of Manual Mode oscillation, but present BUSY to the
// engineer whenever the tooling is not in its complete home position.
//
// This deliberately does NOT feed back into the individual recovery-button
// permissives. Otherwise, for example, extending the support would make Busy
// TRUE and disable the same toggle needed to retract it again.
IF eMachineState = E_MachineState.Manual THEN
    stHeatStakeStatus.bBusy :=
        fbHeatStake.IsBusy()
        OR (usiHeatStakeManualActionStep <> 0)
        OR NOT (
            stInputs.bStation2SupportRetracted
            AND stInputs.bHeatStakeHeadUp
            AND NOT stInputs.bHeatStakeHeadDown
            AND NOT bHeatStakeManualHeadUnlocked
        );

    // A station that is manually out of HOME is not operationally Ready.
    stHeatStakeStatus.bReady :=
        stHeatStakeStatus.bReady
        AND NOT stHeatStakeStatus.bBusy;
END_IF

// Single-solenoid head valve: retain the requested direction between legacy pulses.
// Reservoir air and maintained valve power are required for physical fault retraction.
IF NOT stInputs.stSafety.bSafetyOk
    OR NOT stInputs.stSafety.bProcessSafetyPermitted
    OR NOT GVL_Safety.bAirSupplySafe
    OR (eMachineState = E_MachineState.Fault) THEN
    bHeatStakeHeadUpRecoveryLatched := TRUE;
    bHeatStakeHeadDownHeld := FALSE;
ELSIF (ePreviousMachineState = E_MachineState.Initialising)
    AND (eMachineState = E_MachineState.ReadyToStart)
    AND stInputs.bHeatStakeHeadUp
    AND NOT stInputs.bHeatStakeHeadDown THEN
    // Reset/safety recovery alone must never re-arm descent.
    bHeatStakeHeadUpRecoveryLatched := FALSE;
    bHeatStakeHeadDownHeld := FALSE;
END_IF

IF bHeatStakeHeadUpRecoveryLatched OR bHeatStakeHeadUpRequest THEN
    bHeatStakeHeadDownHeld := FALSE; // UP wins conflicting requests.
ELSIF bHeatStakeHeadDownRequest THEN
    bHeatStakeHeadDownHeld := TRUE;
END_IF

stOutputsInternal.bHeatStakeHeadDown := bHeatStakeHeadDownHeld
    AND NOT bHeatStakeHeadUpRecoveryLatched;
stOutputsInternal.bHeatStakeHeadUp := NOT stOutputsInternal.bHeatStakeHeadDown;

// Maintain Down Pressure for the complete retained DOWN command, including
// the manual hold after DOWN feedback ends the movement action.
// Evaluate after final direction/recovery arbitration so UP removes pressure
// in the same scan. Keep the regulator's existing limits and scaling.
rHeatStakePressureCommandBar := stHeatStakeProcessSettings.rDownPressureBar;
fbHeatStakePressureRegulator.Cyclic(
    bEnable := stOutputsInternal.bHeatStakeHeadDown,
    rSetpointBar := rHeatStakePressureCommandBar,
    rCommandBar => rHeatStakePressureScaledBar,
    iOutputRaw => iHeatStakePressureRaw
);
stOutputsInternal.iHeatStakePressureRaw := iHeatStakePressureRaw;
stHeatStakeProcessStatus.rPressureCommandBar := rHeatStakePressureScaledBar;
stHeatStakeProcessStatus.iPressureOutputRaw := iHeatStakePressureRaw;

stOutputs := stOutputsInternal;
stStatus.eMachineState := eMachineState;
stStatus.eProcessCycleState := eProcessCycleState;
stStatus.eIndexState := fbIndex.GetState();
stStatus.stIndexStatus := stIndexStatus;
stStatus.stMainDoorLock := stMainDoorStatus;
stStatus.eInitialisingWaitReason := eInitialisingWaitReason;
stStatus.eStoppingWaitReason := eStoppingWaitReason;
stStatus.eOperatorExchangeState := fbOperatorStation.GetState();
stStatus.eOperatorInstruction := fbOperatorStation.GetInstruction();
stStatus.stOperatorStation := stOperatorStatus;
stStatus.stPatchDispense := stPatchDispenseStatus;
stStatus.stHeatStake := stHeatStakeStatus;
stStatus.stHeatStakeTemperature := stHeatStakeTemperatureStatus;
stStatus.stHeatStakeProcess := stHeatStakeProcessStatus;
stStatus.bHeatStakeManualEnableAllowed := bHeatStakeManualEnableAllowed;
stStatus.bHeatStakeManualStakeAllowed := bHeatStakeManualStakeAllowed;
stStatus.bHeatStakeManualUnlockAllowed := bHeatStakeManualUnlockAllowed;
stStatus.bHeatStakeManualLockAllowed := bHeatStakeManualLockAllowed;
stStatus.bHeatStakeManualHeadDownAllowed := bHeatStakeManualHeadDownAllowed;
stStatus.bHeatStakeManualHeadUpAllowed := bHeatStakeManualHeadUpAllowed;
stStatus.bHeatStakeManualSupportAllowed := bHeatStakeManualSupportAllowed;
stStatus.bHeatStakeManualActionBusy := bHeatStakeManualActionBusy;
stStatus.bHeatStakeManualHeadUnlocked := bHeatStakeManualHeadUnlocked;
stStatus.stVision := stVisionStatus;
// Manual image presentation uses its actual owner, not the disabled automatic FB.
// Physical HOME and all automatic result/stage semantics remain unchanged.
IF (eMachineState = E_MachineState.Manual) AND stCommand.bVisionManualEnable
    AND NOT bVisionManualSequenceActive AND NOT bVisionManualHomeActive THEN
    stStatus.stVision.bBusy := GVL_HMI.bCameraManualBusy;
    stStatus.stVision.bFault := stVisionStatus.bFault OR fbVisionManualImages.bFault;
    // Station HOME is ready before Prepare; capture readiness remains a separate status.
    stStatus.stVision.bReady := (stVisionStatus.bHome OR fbVisionManualImages.bPrepared)
        AND stVisionStatus.bCommissioned AND stInputs.stSafety.bSafetyOk
        AND GVL_Safety.bAirSupplySafe AND NOT GVL_HMI.bCameraManualBusy
        AND NOT stStatus.stVision.bFault;
    stStatus.stVision.sDiagnostic := GVL_HMI.sCameraManualMessage;
END_IF
stStatus.bReady := (eMachineState = E_MachineState.ReadyToStart);
stStatus.bBusy := (eMachineState = E_MachineState.AutoCycle) OR stIndexStatus.bBusy;
stStatus.bFaulted := (eMachineState = E_MachineState.Fault);
stStatus.bInitialisationTimeoutFault := bInitialisationTimeoutFault;
stStatus.bStoppingTimeoutFault := bStoppingTimeoutFault;
stStatus.bProcessCycleTimeoutFault := bProcessCycleTimeoutFault;
stStatus.bSafetyStopRequested := tpSafetyRunDrop.Q;
stStatus.bSafetyRunRequested := stOutputsInternal.bSafetyRunRequest;
stStatus.bEventFault := stInputs.bEventFault;
stStatus.bCycleStopRequested := stInputs.bEventCycleStopRequest;
stStatus.bIndexPermissive := stPermissives.bIndexMoveAllowed;
stStatus.bEnableSetting := (eMachineState = E_MachineState.Stopped);
stStatus.bAllStationsCommissioned := bPatchDispenseCommissioned AND bHeatStakeCommissioned AND bVisionCommissioned;
stStatus.bAutoCycleAllowed := bAutoCycleAllowed;
stStatus.bDisabledNestPartIndexBlocked := bDisabledNestPartPresent;
stStatus.bDisabledNestPartPopupRequest := bDisabledNestPartPopupRequest;
stStatus.uiDisabledNestPartPopupNestId := uiDisabledNestPartPopupNestId;
stStatus.bRejectChuteFullLatched := bRejectChuteFullLatched;
stStatus.bRejectChutePopupRequest := bRejectChutePopupRequest;
stStatus.bRejectChuteStopRequest := bRejectChuteStopRequestLatched;
stStatus.bRejectChuteResetBlocked := bRejectChuteFullLatched;
stStatus.bHeatStakeHeadUp := stInputs.bHeatStakeHeadUp;
stStatus.bHeatStakeHeadDown := stInputs.bHeatStakeHeadDown;
stStatus.bHeatStakeHeadDownTimeoutFault := bHeatStakeStationHeadDownTimeoutFault OR bHeatStakeManualHeadDownTimeoutFault;
stStatus.bHeatStakeHeadUpTimeoutFault := bHeatStakeStationHeadUpTimeoutFault OR bHeatStakeManualHeadUpTimeoutFault;
stStatus.bHeatStakeHeadSensorConflictFault := bHeatStakeStationHeadSensorConflictFault OR (stInputs.bHeatStakeHeadUp AND stInputs.bHeatStakeHeadDown);
stStatus.stPermissives := stPermissives;
// Refresh published records after same-scan admission/reject updates.
aNestSnapshot := fbNestManager.GetAllNests();
stStatus.aNest := aNestSnapshot;
stStatus.aNestStatistics := fbNestManager.GetAllNestStatistics();
stStatus.sAutoCycleBlockReason := sAutoCycleBlockReason;
stStatus.sOperatorMessage := stOperatorStatus.sMessage;
stStatus.bHeaterDwellTimeoutFault := bHeaterDwellTimeoutFault;


// =====================================================
// VISION MANUAL MODE - HMI STATUS
// =====================================================
stStatus.bVisionManualEnableAllowed := bVisionManualEnableAllowed;
IF fbVisionManualImages.bActive OR fbVisionManualImages.bFault THEN
    bVisionHorizontalBackAllowed := FALSE;
    bVisionHorizontalFrontAllowed := FALSE;
    bVisionVerticalUpAllowed := FALSE;
    bVisionVerticalFullDownAllowed := FALSE;
    bVisionGripOpenAllowed := FALSE;
    bVisionGripCloseAllowed := FALSE;
    bVisionRotate0Allowed := FALSE;
    bVisionRotate180Allowed := FALSE;
END_IF
stStatus.bVisionManualRunSequenceAllowed :=bVisionManualRunSequenceAllowed;

stStatus.bVisionManualHomeAllowed := bVisionManualHomeAllowed;

// Vision physical HOME position.
stStatus.bVisionHome :=
    stInputs.bHorizontalMiniSlideExtended
    AND NOT stInputs.bHorizontalMiniSlideRetracted
    AND stInputs.bVerticalMiniSlideRetracted
    AND NOT stInputs.bVerticalMiniSlideExtended
    AND stInputs.bRotaryGripperOpened
    AND NOT stInputs.bRotaryGripperClosed
    AND bVisionRotate0Confirmed
    AND NOT bVisionRotate180Confirmed;
	


stStatus.bVisionHorizontalBackAllowed := bVisionHorizontalBackAllowed;
stStatus.bVisionHorizontalFrontAllowed := bVisionHorizontalFrontAllowed;

stStatus.bVisionVerticalUpAllowed := bVisionVerticalUpAllowed;
stStatus.bVisionVerticalIntermediateAllowed := FALSE; // Retired compatibility field.
stStatus.bVisionVerticalFullDownAllowed := bVisionVerticalFullDownAllowed;

stStatus.bVisionGripOpenAllowed := bVisionGripOpenAllowed;
stStatus.bVisionGripCloseAllowed := bVisionGripCloseAllowed;

stStatus.bVisionRotate0Allowed := bVisionRotate0Allowed;
stStatus.bVisionRotate180Allowed := bVisionRotate180Allowed;

stStatus.bVisionSupportAllowed := FALSE; // Retired compatibility field.

// Physical feedback for HMI LEDs.
stStatus.bVisionHorizontalBack := stInputs.bHorizontalMiniSlideExtended;
stStatus.bVisionHorizontalFront := stInputs.bHorizontalMiniSlideRetracted;

stStatus.bVisionVerticalUp := stInputs.bVerticalMiniSlideRetracted;
stStatus.bVisionVerticalDown := stInputs.bVerticalMiniSlideExtended;

stStatus.bVisionGripOpen := stInputs.bRotaryGripperOpened;
stStatus.bVisionGripClosed := stInputs.bRotaryGripperClosed;

stStatus.bVisionRotate0 := bVisionRotate0Confirmed;
stStatus.bVisionRotate180 := bVisionRotate180Confirmed;

stStatus.bVisionSupportExtended := FALSE; // Retired compatibility field.
stStatus.bVisionSupportRetracted := FALSE; // Retired compatibility field.

CASE eMachineState OF
    E_MachineState.PowerUp:
        stStatus.sMachineMessage := 'System power up';

    E_MachineState.Initialising:
        stStatus.sMachineMessage := 'System initialising';

    E_MachineState.ReadyToStart:
        IF stHeatStakeTemperatureStatus.bLowTemperature THEN
            stStatus.sMachineMessage := 'Heat Stake preheating';
        ELSIF bAutoCycleAllowed THEN
            stStatus.sMachineMessage := 'System ready to start';
        ELSE
            stStatus.sMachineMessage := sAutoCycleBlockReason;
        END_IF
    E_MachineState.Dwell:

		
// Convert live temperature values to text.
sHeaterMinimum := LREAL_TO_STRING(
    GVL_MASTER.stStatus.stHeatStakeTemperature.rLowLimitC
);

sHeaterCurrent := LREAL_TO_STRING(
    GVL_MASTER.stStatus.stHeatStakeTemperature.rOverTempTemperatureC
);

        stStatus.sMachineMessage := 
			CONCAT(CONCAT(CONCAT(CONCAT(' Heater Temp below Limit: ',sHeaterMinimum),' Â°C | Current Temp: '),sHeaterCurrent),' Â°C ') ;

    E_MachineState.AutoCycle:
        // Operator message priority:
        //
        // 1. While any process station is active, show one generic process
        //    message rather than the operator-exchange text.
        // 2. Failed/passed-part removal and reject instructions retain
        //    priority once processing is finished.
        // 3. When the cycle has returned to the normal index-wait state,
        //    explicitly tell the operator the machine is ready to index.
        // 4. Fall back to the current OperatorStation message.

        IF stHeatStakeTemperatureStatus.bLowTemperature
            AND NOT stHeatStakeTemperatureStatus.bFault
        THEN
            stStatus.sMachineMessage := 'Heat Stake warming up - index inhibited';

        ELSIF bAnyStationInProcess THEN
            stStatus.sMachineMessage := 'In process';

        ELSIF
            (stOperatorStatus.eState = E_OperatorExchangeState.WaitingForPartRemoval)
            OR (stOperatorStatus.eState = E_OperatorExchangeState.WaitingForRejectConfirmation)
        THEN
            stStatus.sMachineMessage := stOperatorStatus.sMessage;

        ELSIF eProcessCycleState = E_CycleState.WaitingForProcessCycleTrigger THEN
            stStatus.sMachineMessage := 'Ready for index - press touch buttons';

        ELSIF LEN(stOperatorStatus.sMessage) > 0 THEN
            stStatus.sMachineMessage := stOperatorStatus.sMessage;

        ELSE
            stStatus.sMachineMessage := 'System auto cycle';
        END_IF

    E_MachineState.Manual:
        stStatus.sMachineMessage := 'Manual mode';

    E_MachineState.Stopping:
        stStatus.sMachineMessage := 'Stopping';

    E_MachineState.Stopped:
        stStatus.sMachineMessage := 'Cycle stopped';

    E_MachineState.Fault:
        stStatus.sMachineMessage := 'Immediate fault';
END_CASE

IF bRejectChuteFullLatched
    AND (eMachineState <> E_MachineState.Fault)
THEN
    stStatus.sMachineMessage :=
        'Reject chute full - empty chute and press Acknowledge';
END_IF

// Must be the final machine-state assignment in Cyclic.
// Used on the next scan to detect one-shot transitions into Fault.
ePreviousMachineState := eMachineState;

// Track FINAL published outputs, after all machine fault/output overrides.
bPatchVerticalUpCommandPrevious := stOutputs.bPatchVerticalUp;
bPatchVerticalDownCommandPrevious := stOutputs.bPatchVerticalDown;

// Track final commands after all fault/output overrides.
bVisionRotate0CommandPrevious := stOutputs.bVisionRotate0;
bVisionRotate180CommandPrevious := stOutputs.bVisionRotate180;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetCyclicOutputs" Id="{2afcae24-43c4-4871-871e-9348e38cf5c0}">
      <Declaration><![CDATA[METHOD PRIVATE ResetCyclicOutputs]]></Declaration>
      <Implementation>
        <ST><![CDATA[stOutputsInternal.bSafetyRunRequest := FALSE;
stOutputsInternal.bSafetyResetRequest := FALSE;
stOutputsInternal.bSafetyErrorAcknowledgementRequest := FALSE;
stOutputsInternal.bAirSupplyEnable := FALSE;
stOutputsInternal.bMainDoorLockRequest := FALSE;
stOutputsInternal.bIndexRotatePortA := FALSE;
stOutputsInternal.bIndexStopPortB := FALSE;
stOutputsInternal.bIndexSupportExtend := FALSE;
stOutputsInternal.bIndexSupportRetract := FALSE;
stOutputsInternal.bStation1SupportExtend := FALSE;
stOutputsInternal.bStation1SupportRetract := FALSE;
stOutputsInternal.bStation2SupportExtend := FALSE;
stOutputsInternal.bStation2SupportRetract := FALSE;
stOutputsInternal.bStation3SupportExtend := FALSE;
stOutputsInternal.bStation3SupportRetract := FALSE;
stOutputsInternal.bVisionHorizontalBack := FALSE;
stOutputsInternal.bVisionHorizontalFront := FALSE;
stOutputsInternal.bVisionVerticalUp := FALSE;
stOutputsInternal.bVisionVerticalDown := FALSE;
stOutputsInternal.bVisionLimitOff := FALSE;
stOutputsInternal.bVisionLimitOn := FALSE;
stOutputsInternal.bVisionGripClose := FALSE;
stOutputsInternal.bVisionGripOpen := FALSE;
stOutputsInternal.bVisionRotate0 := FALSE;
stOutputsInternal.bVisionRotate180 := FALSE;
stOutputsInternal.bHeatStakeHeadLock := FALSE;
stOutputsInternal.bHeatStakeHeadUnlock := FALSE;
stOutputsInternal.bHeatStakeHeadDown := FALSE;
stOutputsInternal.bHeatStakeHeadUp := FALSE;
stOutputsInternal.iHeatStakePressureRaw := 0;
stOutputsInternal.bLedStart := FALSE;
stOutputsInternal.bLedReset := FALSE;
stOutputsInternal.bLedPass := FALSE;
stOutputsInternal.bLedFail := FALSE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>