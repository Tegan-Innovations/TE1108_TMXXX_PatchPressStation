<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_HeatStakeStation" Id="{e93afcff-621a-4aaf-8801-de4cf646d351}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_HeatStakeStation IMPLEMENTS I_ProcessEquipment
VAR
    // Simulation result selector for commissioning / software test.
    // FALSE = simulated process PASS (default)
    // TRUE  = simulated process FAIL
    bSimulatedFail             : BOOL := FALSE;

    // Simulates a MACHINE/STATION fault, independently from simulated
    // product PASS/FAIL above. Reset will only recover after this is FALSE.
    bSimulatedFault            : BOOL := FALSE;

    bEnableInternal           : BOOL;
    bCommissionedInternal     : BOOL;
    bSafetyOkInternal         : BOOL;
    bSupervisionEnableInternal : BOOL;
    bManualModeInternal        : BOOL;
    bSupportRetractedInternal : BOOL;
    bSupportExtendedInternal  : BOOL;
    bHeadUpSensorInternal     : BOOL;
    bHeadDownSensorInternal   : BOOL;

    eStateInternal      : E_PatchStationState := E_PatchStationState.Disabled;
    usiStepInternal     : USINT := 0;
    bHomeInternal       : BOOL;
    bReadyInternal      : BOOL;
    bBusyInternal       : BOOL;
    bCompleteInternal   : BOOL;
    bFaultInternal      : BOOL;
    sDiagnosticInternal : STRING(120);

    bSupportExtendRequestInternal  : BOOL;
    bSupportRetractRequestInternal : BOOL;
    bStopRequestInternal           : BOOL;

    eSupportFaultInternal : E_SupportCylinderFault := E_SupportCylinderFault.None;

    tonSupportExtendTimeout  : TON;
    tonSupportRetractTimeout : TON;
    tSupportMoveTimeout      : TIME := T#5S;

    tonHeadSequence    : TON;
    tonContactDwell    : TON;
    tonHeadDownTimeout : TON;
    tonHeadUpTimeout   : TON;

    // Lock / unlock remain pulse-driven; head movement is sensor-driven.
    tUnlockDelay     : TIME := T#1S;
    tLockDelay       : TIME := T#1S;
    tHeadMoveTimeoutInternal : TIME := T#3S;

    // Latched until RequestReset().
    bHeadDownTimeoutFaultInternal : BOOL;
    bHeadUpTimeoutFaultInternal : BOOL;
    bHeadSensorConflictFaultInternal : BOOL;

    stProcessSettingsInternal : ST_HeatStakeProcessSettings;

    bHeadLockRequestInternal : BOOL;
    bHeadUnlockRequestInternal : BOOL;
    bHeadDownRequestInternal : BOOL;
    bHeadUpRequestInternal : BOOL;
    rPressureCommandBarInternal : LREAL := 0.03;
    bContactDwellActiveInternal : BOOL;

    stResultInternal : ST_ProcessResult;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cyclic" Id="{5212063e-92cf-40af-8593-ab83d9d6bff4}">
      <Declaration><![CDATA[METHOD PUBLIC Cyclic
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Real Heat Stake process: support UP -> unlock -> DOWN -> dwell -> UP -> lock -> support DOWN.

bSupportExtendRequestInternal := FALSE;
bSupportRetractRequestInternal := FALSE;
bHeadLockRequestInternal := FALSE;
bHeadUnlockRequestInternal := FALSE;
bHeadDownRequestInternal := FALSE;
bHeadUpRequestInternal := FALSE;
rPressureCommandBarInternal := 0.03;
bContactDwellActiveInternal := FALSE;
bFaultInternal := FALSE;

IF bEnableInternal AND bSimulatedFault THEN
    tonHeadSequence(IN := FALSE);
    tonContactDwell(IN := FALSE);
    eStateInternal := E_PatchStationState.Fault;
    usiStepInternal := 0;
    bFaultInternal := TRUE;
    eSupportFaultInternal := E_SupportCylinderFault.None;
    stResultInternal.bValid := FALSE;
    stResultInternal.bPassed := FALSE;
    stResultInternal.eCode := E_ProcessResultCode.None;
    stResultInternal.udiFaultCode := 0;
    stResultInternal.udiAlertCode := 0;
    stResultInternal.sDetail := '';
    sDiagnosticInternal := 'Heat stake: simulated station fault';
END_IF

IF NOT bFaultInternal
    AND bSupervisionEnableInternal
    AND bSafetyOkInternal
    AND bSupportRetractedInternal
    AND bSupportExtendedInternal
THEN
    eStateInternal := E_PatchStationState.Fault;
    usiStepInternal := 0;
    bFaultInternal := TRUE;
    eSupportFaultInternal := E_SupportCylinderFault.ContradictorySensors;
    stResultInternal.bValid := TRUE;
    stResultInternal.bPassed := FALSE;
    stResultInternal.eCode := E_ProcessResultCode.Fail;
    stResultInternal.udiFaultCode := 3;
    stResultInternal.sDetail := 'Heat stake: contradictory support sensors';
    sDiagnosticInternal := 'Heat stake: contradictory support sensors';
END_IF

// Head sensors are mutually exclusive.
IF NOT bFaultInternal
    AND bEnableInternal
    AND bSafetyOkInternal
    AND bHeadUpSensorInternal
    AND bHeadDownSensorInternal
THEN
    eStateInternal := E_PatchStationState.Fault;
    usiStepInternal := 0;
    bFaultInternal := TRUE;
    bHeadSensorConflictFaultInternal := TRUE;
    stResultInternal.bValid := TRUE;
    stResultInternal.bPassed := FALSE;
    stResultInternal.eCode := E_ProcessResultCode.Fail;
    stResultInternal.udiFaultCode := 6;
    stResultInternal.udiAlertCode := 0;
    stResultInternal.sDetail := 'Heat stake: head position sensor conflict';
    sDiagnosticInternal := 'Heat stake: head UP/DOWN sensors both active';
END_IF

IF bFaultInternal THEN
    bHeadUnlockRequestInternal := TRUE;
    bHeadUpRequestInternal := TRUE;
    bSupportRetractRequestInternal := NOT bSupportRetractedInternal;

ELSIF bStopRequestInternal THEN
    CASE usiStepInternal OF
        80:
            bHeadUnlockRequestInternal := TRUE;
            tonHeadSequence(IN := TRUE, PT := tUnlockDelay);
            sDiagnosticInternal := 'Heat stake: stop - unlocking head';
            IF tonHeadSequence.Q THEN
                tonHeadSequence(IN := FALSE);
                usiStepInternal := 81;
            END_IF

        81:
            bHeadUnlockRequestInternal := TRUE;
            bHeadUpRequestInternal := NOT bHeadUpSensorInternal;
            sDiagnosticInternal := 'Heat stake: stop - raising head';
            IF bHeadUpSensorInternal THEN
                usiStepInternal := 82;
            END_IF

        82:
            bHeadLockRequestInternal := TRUE;
            tonHeadSequence(IN := TRUE, PT := tLockDelay);
            sDiagnosticInternal := 'Heat stake: stop - locking head';
            IF tonHeadSequence.Q THEN
                tonHeadSequence(IN := FALSE);
                usiStepInternal := 83;
            END_IF

        83:
            bHeadLockRequestInternal := TRUE;
            bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
            sDiagnosticInternal := 'Heat stake: stop - retracting support';
            IF bSupportRetractedInternal THEN
                bStopRequestInternal := FALSE;
                usiStepInternal := 0;
                IF bEnableInternal AND bCommissionedInternal AND bSafetyOkInternal THEN
                    eStateInternal := E_PatchStationState.Ready;
                ELSE
                    eStateInternal := E_PatchStationState.Disabled;
                END_IF
            END_IF

        ELSE
            usiStepInternal := 80;
    END_CASE

ELSIF NOT bCommissionedInternal THEN
    eStateInternal := E_PatchStationState.Disabled;
    usiStepInternal := 0;
    sDiagnosticInternal := 'Heat stake: station disabled - no actuator commands';

ELSIF NOT bSafetyOkInternal THEN
    eStateInternal := E_PatchStationState.Disabled;
    usiStepInternal := 0;
    sDiagnosticInternal := 'Heat stake: disabled by Safety';

ELSIF NOT bEnableInternal THEN
    // Machine is outside an active Heat Stake state (for example Stopped).
    //
    // IMPORTANT:
    // Do not run an automatic head-homing sequence here. RequestStop already
    // performs the controlled unlock -> UP -> lock -> support retract sequence
    // while the machine is transitioning through Stopping.
    //
    // Previously this branch restarted its homing steps every time it reached
    // Disabled/step 0, producing a continuous LOCK -> UNLOCK -> UP -> LOCK loop
    // while the machine remained Stopped.
    //
    // All head outputs were cleared at the start of Cyclic(), so keeping them
    // untouched here leaves Coil 2/3/4/5 de-energised in Stopped.
    tonHeadSequence(IN := FALSE);
    tonContactDwell(IN := FALSE);
    tonHeadDownTimeout(IN := FALSE);
    tonHeadUpTimeout(IN := FALSE);
    tonSupportExtendTimeout(IN := FALSE);
    tonSupportRetractTimeout(IN := FALSE);

    bSupportExtendRequestInternal := FALSE;
    bSupportRetractRequestInternal := FALSE;

    eStateInternal := E_PatchStationState.Disabled;
    usiStepInternal := 0;

    bHomeInternal := FALSE;
    bReadyInternal := FALSE;
    bBusyInternal := FALSE;
    bCompleteInternal := FALSE;

    sDiagnosticInternal := 'Heat stake: disabled - no actuator commands';

ELSE
    CASE eStateInternal OF
        E_PatchStationState.Disabled,
        E_PatchStationState.Homing:
            // No automatic mechanical homing in ReadyToStart.
            // Without dedicated Heat Head position feedback, commanding
            // unlock/up/lock here causes unwanted motion every time the
            // station is enabled. The mechanical sequence starts only from
            // RequestStart(), which is only issued when Heat Stake processing
            // is actually required for the part at this station.
            tonHeadSequence(IN := FALSE);
            tonContactDwell(IN := FALSE);
            usiStepInternal := 0;
            eStateInternal := E_PatchStationState.Ready;
            sDiagnosticInternal := 'Heat stake: ready - no actuator commands';

        E_PatchStationState.Ready:
            tonHeadSequence(IN := FALSE);
            tonContactDwell(IN := FALSE);
            sDiagnosticInternal := 'Heat stake: ready - waiting for process';

            // In automatic/ready operation the station expects the support
            // cylinder retracted while idle. In Manual Mode the engineer is
            // intentionally allowed to extend the support, so do NOT bounce
            // Ready -> Homing -> Ready just because the support is extended.
            //
            // That old transition made IsBusy() alternate because Homing is
            // classified as Busy, which caused the Busy LED and HMI button
            // permissives to flicker.
            IF NOT bSupportRetractedInternal
                AND NOT bManualModeInternal
            THEN
                eStateInternal := E_PatchStationState.Homing;
                usiStepInternal := 4;
            END_IF

        E_PatchStationState.Processing:
            CASE usiStepInternal OF
                10:
                    bHeadLockRequestInternal := TRUE;
                    bSupportExtendRequestInternal := NOT bSupportExtendedInternal;
                    sDiagnosticInternal := 'Heat stake: support up';
                    IF bSupportExtendedInternal THEN
                        usiStepInternal := 20;
                    END_IF

                20:
                    rPressureCommandBarInternal := stProcessSettingsInternal.rDownPressureBar;
                    bHeadUnlockRequestInternal := TRUE;
                    tonHeadSequence(IN := TRUE, PT := tUnlockDelay);
                    sDiagnosticInternal := 'Heat stake: unlock head';
                    IF tonHeadSequence.Q THEN
                        tonHeadSequence(IN := FALSE);
                        usiStepInternal := 30;
                    END_IF

                30:
                    rPressureCommandBarInternal := stProcessSettingsInternal.rDownPressureBar;
                    bHeadUnlockRequestInternal := TRUE;
                    bHeadDownRequestInternal := NOT bHeadDownSensorInternal;
                    sDiagnosticInternal := 'Heat stake: head down - waiting for DOWN feedback';
                    IF bHeadDownSensorInternal THEN
                        usiStepInternal := 40;
                    END_IF

                40:
                    rPressureCommandBarInternal := stProcessSettingsInternal.rDownPressureBar;
                    bHeadUnlockRequestInternal := TRUE;
                    bHeadDownRequestInternal := TRUE;
                    bContactDwellActiveInternal := TRUE;
                    tonContactDwell(IN := TRUE, PT := stProcessSettingsInternal.tContactTime);
                    sDiagnosticInternal := 'Heat stake: contact dwell';
                    IF tonContactDwell.Q THEN
                        tonContactDwell(IN := FALSE);
                        usiStepInternal := 50;
                    END_IF

                50:
                    bHeadUnlockRequestInternal := TRUE;
                    bHeadUpRequestInternal := NOT bHeadUpSensorInternal;
                    sDiagnosticInternal := 'Heat stake: head up - waiting for UP feedback';
                    IF bHeadUpSensorInternal THEN
                        usiStepInternal := 60;
                    END_IF

                60:
                    bHeadLockRequestInternal := TRUE;
                    tonHeadSequence(IN := TRUE, PT := tLockDelay);
                    sDiagnosticInternal := 'Heat stake: lock head';
                    IF tonHeadSequence.Q THEN
                        tonHeadSequence(IN := FALSE);
                        usiStepInternal := 70;
                    END_IF

                70:
                    // Lock pulse was completed in step 60. Do not hold the
                    // lock solenoid energised while retracting the support.
                    bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
                    sDiagnosticInternal := 'Heat stake: support down';

                    IF bSupportRetractedInternal THEN
                        stResultInternal.bValid := TRUE;
                        stResultInternal.udiFaultCode := 0;
                        stResultInternal.udiAlertCode := 0;

                        IF bSimulatedFail THEN
                            stResultInternal.bPassed := FALSE;
                            stResultInternal.eCode := E_ProcessResultCode.Fail;
                            stResultInternal.sDetail := 'Heat stake result forced FAIL';
                        ELSE
                            stResultInternal.bPassed := TRUE;
                            stResultInternal.eCode := E_ProcessResultCode.Pass;
                            stResultInternal.sDetail := 'Heat stake process completed';
                        END_IF

                        eStateInternal := E_PatchStationState.Complete;
                        usiStepInternal := 0;
                    END_IF

                ELSE
                    usiStepInternal := 50;
            END_CASE

        E_PatchStationState.Complete:
            sDiagnosticInternal := 'Heat stake: complete - no actuator commands';

        E_PatchStationState.Fault:
            bHeadUnlockRequestInternal := TRUE;
            bHeadUpRequestInternal := TRUE;
            bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
            sDiagnosticInternal := 'Heat stake: fault';

        ELSE
            eStateInternal := E_PatchStationState.Fault;
    END_CASE
END_IF

// Head movement supervision.
tonHeadDownTimeout(
    IN := bEnableInternal
        AND bSafetyOkInternal
        AND bHeadDownRequestInternal
        AND NOT bHeadDownSensorInternal
        AND (eStateInternal <> E_PatchStationState.Fault),
    PT := tHeadMoveTimeoutInternal
);

tonHeadUpTimeout(
    IN := bEnableInternal
        AND bSafetyOkInternal
        AND bHeadUpRequestInternal
        AND NOT bHeadUpSensorInternal
        AND (eStateInternal <> E_PatchStationState.Fault),
    PT := tHeadMoveTimeoutInternal
);

IF tonHeadDownTimeout.Q THEN
    bHeadDownRequestInternal := FALSE;
    bHeadUpRequestInternal := FALSE;
    bHeadDownTimeoutFaultInternal := TRUE;
    eStateInternal := E_PatchStationState.Fault;
    usiStepInternal := 0;
    stResultInternal.bValid := TRUE;
    stResultInternal.bPassed := FALSE;
    stResultInternal.eCode := E_ProcessResultCode.Fail;
    stResultInternal.udiFaultCode := 4;
    stResultInternal.udiAlertCode := 0;
    stResultInternal.sDetail := 'Heat stake: head DOWN feedback timeout';
    sDiagnosticInternal := 'Heat stake: head DOWN feedback timeout';
ELSIF tonHeadUpTimeout.Q THEN
    bHeadDownRequestInternal := FALSE;
    bHeadUpRequestInternal := FALSE;
    bHeadUpTimeoutFaultInternal := TRUE;
    eStateInternal := E_PatchStationState.Fault;
    usiStepInternal := 0;
    stResultInternal.bValid := TRUE;
    stResultInternal.bPassed := FALSE;
    stResultInternal.eCode := E_ProcessResultCode.Fail;
    stResultInternal.udiFaultCode := 5;
    stResultInternal.udiAlertCode := 0;
    stResultInternal.sDetail := 'Heat stake: head UP feedback timeout';
    sDiagnosticInternal := 'Heat stake: head UP feedback timeout';
END_IF

tonSupportExtendTimeout(
    IN := bSupervisionEnableInternal
        AND bSafetyOkInternal
        AND bSupportExtendRequestInternal
        AND NOT bSupportExtendedInternal
        AND (eStateInternal <> E_PatchStationState.Fault),
    PT := tSupportMoveTimeout
);

tonSupportRetractTimeout(
    IN := bSupervisionEnableInternal
        AND bSafetyOkInternal
        AND bSupportRetractRequestInternal
        AND NOT bSupportRetractedInternal
        AND (eStateInternal <> E_PatchStationState.Fault),
    PT := tSupportMoveTimeout
);

IF tonSupportExtendTimeout.Q THEN
    bSupportExtendRequestInternal := FALSE;
    bSupportRetractRequestInternal := FALSE;
    eSupportFaultInternal := E_SupportCylinderFault.ExtendTimeout;
    eStateInternal := E_PatchStationState.Fault;
    usiStepInternal := 0;

    stResultInternal.bValid := TRUE;
    stResultInternal.bPassed := FALSE;
    stResultInternal.eCode := E_ProcessResultCode.Fail;
    stResultInternal.udiFaultCode := 1;
    stResultInternal.udiAlertCode := 0;
    stResultInternal.sDetail := 'Heat stake: support UP feedback timeout';
    sDiagnosticInternal := 'Heat stake: support UP feedback timeout';

ELSIF tonSupportRetractTimeout.Q THEN
    bSupportExtendRequestInternal := FALSE;
    bSupportRetractRequestInternal := FALSE;
    eSupportFaultInternal := E_SupportCylinderFault.RetractTimeout;
    eStateInternal := E_PatchStationState.Fault;
    usiStepInternal := 0;

    stResultInternal.bValid := TRUE;
    stResultInternal.bPassed := FALSE;
    stResultInternal.eCode := E_ProcessResultCode.Fail;
    stResultInternal.udiFaultCode := 2;
    stResultInternal.udiAlertCode := 0;
    stResultInternal.sDetail := 'Heat stake: support DOWN feedback timeout';
    sDiagnosticInternal := 'Heat stake: support DOWN feedback timeout';
END_IF

bHomeInternal := bSupportRetractedInternal
    AND bHeadUpSensorInternal
    AND NOT bHeadDownSensorInternal
    AND ((eStateInternal = E_PatchStationState.Ready)
        OR (eStateInternal = E_PatchStationState.Disabled)
        OR (eStateInternal = E_PatchStationState.Complete));

bReadyInternal := (eStateInternal = E_PatchStationState.Ready)
    AND bSupportRetractedInternal
    AND bHeadUpSensorInternal
    AND NOT bHeadDownSensorInternal;

bBusyInternal := (eStateInternal = E_PatchStationState.Processing)
    OR (eStateInternal = E_PatchStationState.Homing)
    OR bStopRequestInternal;

bCompleteInternal := (eStateInternal = E_PatchStationState.Complete);
bFaultInternal := (eStateInternal = E_PatchStationState.Fault);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetResult" Id="{169aee37-74da-4136-ac97-f30695e0953b}">
      <Declaration><![CDATA[METHOD PUBLIC GetResult : ST_ProcessResult
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetResult := stResultInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialise" Id="{ba207c87-1d15-4678-90ba-22191708ce52}">
      <Declaration><![CDATA[METHOD PUBLIC Initialise]]></Declaration>
      <Implementation>
        <ST><![CDATA[
tonHeadSequence(IN := FALSE);
tonContactDwell(IN := FALSE);
tonSupportExtendTimeout(IN := FALSE);
tonSupportRetractTimeout(IN := FALSE);
eSupportFaultInternal := E_SupportCylinderFault.None;
eStateInternal := E_PatchStationState.Disabled;
usiStepInternal := 0;
bHomeInternal := FALSE;
bReadyInternal := FALSE;
bBusyInternal := FALSE;
bCompleteInternal := FALSE;
bFaultInternal := FALSE;
bSupportExtendRequestInternal := FALSE;
bSupportRetractRequestInternal := FALSE;
bHeadLockRequestInternal := FALSE;
bHeadUnlockRequestInternal := FALSE;
bHeadDownRequestInternal := FALSE;
bHeadUpRequestInternal := FALSE;
rPressureCommandBarInternal := 0.03;
bContactDwellActiveInternal := FALSE;
bStopRequestInternal := FALSE;
sDiagnosticInternal := '';

stResultInternal.bValid := FALSE;
stResultInternal.bPassed := FALSE;
stResultInternal.eCode := E_ProcessResultCode.None;
stResultInternal.udiFaultCode := 0;
stResultInternal.udiAlertCode := 0;
stResultInternal.sDetail := '';
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsBusy" Id="{f7687ad1-26c7-414c-ab1c-cad26f9fec8d}">
      <Declaration><![CDATA[METHOD PUBLIC IsBusy : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsBusy := bBusyInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsDone" Id="{114dfd1d-c3f2-4966-8082-61bb615cf88f}">
      <Declaration><![CDATA[METHOD PUBLIC IsDone : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsDone := bCompleteInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsFaulted" Id="{dfef0261-ebcd-463f-8d95-c78e97bb84d6}">
      <Declaration><![CDATA[METHOD PUBLIC IsFaulted : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsFaulted := bFaultInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsReady" Id="{ef443c19-9526-454d-a8e7-7b8ec902c34d}">
      <Declaration><![CDATA[METHOD PUBLIC IsReady : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsReady := bReadyInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestReset" Id="{8f872cb6-d465-4bec-88a2-18db9f419223}">
      <Declaration><![CDATA[METHOD PUBLIC RequestReset
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
tonHeadSequence(IN := FALSE);
tonContactDwell(IN := FALSE);
tonHeadDownTimeout(IN := FALSE);
tonHeadUpTimeout(IN := FALSE);
tonSupportExtendTimeout(IN := FALSE);
tonSupportRetractTimeout(IN := FALSE);
eSupportFaultInternal := E_SupportCylinderFault.None;
bHeadDownTimeoutFaultInternal := FALSE;
bHeadUpTimeoutFaultInternal := FALSE;
bHeadSensorConflictFaultInternal := FALSE;
bStopRequestInternal := FALSE;

stResultInternal.bValid := FALSE;
stResultInternal.bPassed := FALSE;
stResultInternal.eCode := E_ProcessResultCode.None;
stResultInternal.udiFaultCode := 0;
stResultInternal.udiAlertCode := 0;
stResultInternal.sDetail := '';

// Reset only clears station state. It must not move the Heat Stake head.
IF bEnableInternal AND bCommissionedInternal AND bSafetyOkInternal THEN
    eStateInternal := E_PatchStationState.Ready;
ELSE
    eStateInternal := E_PatchStationState.Disabled;
END_IF

usiStepInternal := 0;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestStart" Id="{b5ee05b2-70fd-48e7-8772-3e644930a1c6}">
      <Declaration><![CDATA[METHOD PUBLIC RequestStart : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
RequestStart := FALSE;

IF bEnableInternal
    AND bCommissionedInternal
    AND bSafetyOkInternal
    AND bReadyInternal
    AND bSupportRetractedInternal
    AND bHeadUpSensorInternal
    AND NOT bHeadDownSensorInternal
THEN
    stResultInternal.bValid := FALSE;
    stResultInternal.bPassed := FALSE;
    stResultInternal.eCode := E_ProcessResultCode.None;
    stResultInternal.sDetail := '';

    eStateInternal := E_PatchStationState.Processing;
    usiStepInternal := 10;
    RequestStart := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestStop" Id="{2bdee7da-54d8-421e-9537-a8a734905ff2}">
      <Declaration><![CDATA[METHOD PUBLIC RequestStop
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF
    (eStateInternal = E_PatchStationState.Processing)
    OR bHeadUnlockRequestInternal
    OR bHeadDownRequestInternal
    OR bHeadUpRequestInternal
THEN
    // Interrupted active Heat Stake process: recover head UP and lock once.
    bStopRequestInternal := TRUE;
    usiStepInternal := 80;
ELSE
    // No active Heat Stake process -> Stopping/Stopped must not actuate the head.
    bStopRequestInternal := FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="Update" Id="{f1cd8897-c7c8-4dec-8bf2-642ea84c5630}">
      <Declaration><![CDATA[METHOD PUBLIC Update
VAR_INPUT
    bEnable           : BOOL;
    bCommissioned     : BOOL;
    bSafetyOk         : BOOL;
    bSupervisionEnable : BOOL;
    bManualMode       : BOOL;
    bReset            : BOOL;
    bSupportRetracted : BOOL;
    bSupportExtended  : BOOL;
    bHeadUpSensor     : BOOL;
    bHeadDownSensor   : BOOL;
    tSupportTimeout   : TIME;
    tHeadMoveTimeout  : TIME;
    stProcessSettings : ST_HeatStakeProcessSettings;
END_VAR
VAR_OUTPUT
    stStatus               : ST_PatchStageStatus;
    bSupportExtendRequest  : BOOL;
    bSupportRetractRequest : BOOL;
    bHeadLockRequest       : BOOL;
    bHeadUnlockRequest     : BOOL;
    bHeadDownRequest       : BOOL;
    bHeadUpRequest         : BOOL;
    rPressureCommandBar    : LREAL;
    bContactDwellActive    : BOOL;
    usiSequenceStep        : USINT;
    bHeadDownTimeoutFault  : BOOL;
    bHeadUpTimeoutFault    : BOOL;
    bHeadSensorConflictFault : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
bEnableInternal := bEnable;
bCommissionedInternal := bCommissioned;
bSafetyOkInternal := bSafetyOk;
bSupervisionEnableInternal := bSupervisionEnable;
bManualModeInternal := bManualMode;
bSupportRetractedInternal := bSupportRetracted;
bSupportExtendedInternal := bSupportExtended;
bHeadUpSensorInternal := bHeadUpSensor;
bHeadDownSensorInternal := bHeadDownSensor;
tSupportMoveTimeout := tSupportTimeout;
tHeadMoveTimeoutInternal := tHeadMoveTimeout;
stProcessSettingsInternal := stProcessSettings;

IF bReset THEN
    RequestReset();
END_IF

Cyclic();

stStatus.eState := eStateInternal;
stStatus.bCommissioned := bCommissionedInternal;
stStatus.bHome := bHomeInternal;
stStatus.bReady := bReadyInternal;
stStatus.bBusy := bBusyInternal;
stStatus.bComplete := bCompleteInternal;
stStatus.bFault := bFaultInternal;
stStatus.eSupportFault := eSupportFaultInternal;
stStatus.sDiagnostic := sDiagnosticInternal;

bSupportExtendRequest := bSupportExtendRequestInternal;
bSupportRetractRequest := bSupportRetractRequestInternal;
bHeadLockRequest := bHeadLockRequestInternal;
bHeadUnlockRequest := bHeadUnlockRequestInternal;
bHeadDownRequest := bHeadDownRequestInternal;
bHeadUpRequest := bHeadUpRequestInternal;
rPressureCommandBar := rPressureCommandBarInternal;
bContactDwellActive := bContactDwellActiveInternal;
usiSequenceStep := usiStepInternal;
bHeadDownTimeoutFault := bHeadDownTimeoutFaultInternal;
bHeadUpTimeoutFault := bHeadUpTimeoutFaultInternal;
bHeadSensorConflictFault := bHeadSensorConflictFaultInternal;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>