<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_PatchDispenseStation" Id="{307a15f9-be92-4a17-837f-7db7d76c6090}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PatchDispenseStation IMPLEMENTS I_ProcessEquipment
VAR
	bHomeRequestInternal   				: BOOL := FALSE;
	bHomeConfirmedInternal 				: BOOL := FALSE;
	bHomePulseStartedInternal   		: BOOL := FALSE;
	bHomePulseCompletedInternal 		: BOOL := FALSE;
	tpHomeSupportRetract        		: TP;
	bHomePulseResetPendingInternal 		: BOOL := FALSE;
	bVerticalUpRequestInternal : BOOL := FALSE;
    // Simulation result selector for commissioning / software test.
    // FALSE = simulated process PASS (default)
    // TRUE  = simulated process FAIL
    bSimulatedFail             			: BOOL := FALSE;

    // Simulates a MACHINE/STATION fault, independently from simulated
    // product PASS/FAIL above. Reset will only recover after this is FALSE.
    bSimulatedFault            			: BOOL := FALSE;

    bEnableInternal           			: BOOL;
	bManualModeInternal 				: BOOL;
	bManualSupportExtendDesiredInternal : BOOL;
    bCommissionedInternal     			: BOOL;
    bSafetyOkInternal         			: BOOL;
    bSupervisionEnableInternal 			: BOOL;
    bSupportRetractedInternal 			: BOOL;
    bSupportExtendedInternal  			: BOOL;
	bHomingAllowedInternal 				: BOOL;
	
    eStateInternal      				: E_PatchStationState := E_PatchStationState.Disabled;
    usiStepInternal     				: USINT := 0;
    bHomeInternal       				: BOOL;
    bReadyInternal      				: BOOL;
    bBusyInternal       				: BOOL;
    bCompleteInternal   				: BOOL;
    bFaultInternal      				: BOOL;
    sDiagnosticInternal 				: STRING(120);
    bSupportExtendRequestInternal  		: BOOL;
    bSupportRetractRequestInternal 		: BOOL;
    bStopRequestInternal           		: BOOL;
	
    eSupportFaultInternal 				: E_SupportCylinderFault := E_SupportCylinderFault.None;
    tonSupportExtendTimeout  			: TON;
    tonSupportRetractTimeout 			: TON;
	
    tSupportMoveTimeout      			: TIME := T#5S;
    tonProcessSimulation 				: TON;
    tProcessSimulation   				: TIME := T#3S;
    stResultInternal 					: ST_ProcessResult;
	
		// HOME sequence control
	usiHomeStepInternal : USINT := 0;
	bHomeExecutionAllowedInternal : BOOL := FALSE;
	
	// HOME timers
	tonHomeSupportRetract : TON;
	tonHomeVerticalUp : TON;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cyclic" Id="{63a17042-276a-418e-8bb1-2373e80987fa}">
      <Declaration><![CDATA[METHOD PUBLIC Cyclic
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Temporary commissioning sequence:
// Ready/retracted -> extend -> 3 s simulated process -> retract -> Complete.

bSupportExtendRequestInternal := FALSE;
bSupportRetractRequestInternal := FALSE;
bFaultInternal := FALSE;
bVerticalUpRequestInternal := FALSE;


// ---------------------------------------------------------
// PATCH DISPENSING HOME - permission and timer reset
// ---------------------------------------------------------
// HOME runs only during Initialising with Safety and air available.
// TON timers reset immediately if the sequence is interrupted.
// Step 0: idle; 10: retract pulse; 20: sensor confirmation;
// 30: vertical UP pulse; 40: complete.

bHomeExecutionAllowedInternal := bHomeRequestInternal AND bSafetyOkInternal
    AND bHomingAllowedInternal AND bEnableInternal AND bCommissionedInternal
    AND NOT bManualModeInternal AND NOT bStopRequestInternal
    AND (eStateInternal <> E_PatchStationState.Fault) AND NOT bSimulatedFault;

IF bHomeRequestInternal AND NOT bHomeExecutionAllowedInternal THEN
    usiHomeStepInternal := 0;
    bHomeConfirmedInternal := FALSE;
END_IF

// Both timers are called on every PLC scan, including when disabled.
tonHomeSupportRetract(IN := bHomeExecutionAllowedInternal AND (usiHomeStepInternal = 10), PT := T#300MS);
tonHomeVerticalUp(IN := bHomeExecutionAllowedInternal AND (usiHomeStepInternal = 30)
    AND bSupportRetractedInternal AND NOT bSupportExtendedInternal, PT := T#1S);

// Explicit station-fault simulation for alarm/fault-flow testing.
// This is intentionally different from bSimulatedFail:
//   bSimulatedFail  -> bad PRODUCT, machine keeps running.
//   bSimulatedFault -> station MACHINE fault, machine goes to Fault.
IF bEnableInternal
    AND bSimulatedFault
THEN
    tonProcessSimulation(IN := FALSE);
    eStateInternal := E_PatchStationState.Fault;
    usiStepInternal := 0;
    bFaultInternal := TRUE;
    eSupportFaultInternal := E_SupportCylinderFault.None;
    stResultInternal.bValid := FALSE;
    stResultInternal.bPassed := FALSE;
    stResultInternal.eCode := E_ProcessResultCode.None;
    stResultInternal.udiFaultCode := 0;
    stResultInternal.udiAlertCode := 0;
    stResultInternal.sDetail := '';
    sDiagnosticInternal := 'Patch dispense: simulated station fault';
END_IF

// Sensor plausibility check.
// Both end-position sensors TRUE at the same time is not a valid pneumatic
// state and must block the cycle/index.
IF NOT bFaultInternal
    AND bSupervisionEnableInternal
    AND bSafetyOkInternal
    AND bSupportRetractedInternal
    AND bSupportExtendedInternal
THEN
    tonProcessSimulation(IN := FALSE);
    eStateInternal := E_PatchStationState.Fault;
    usiStepInternal := 0;
    bFaultInternal := TRUE;
    eSupportFaultInternal := E_SupportCylinderFault.ContradictorySensors;
    stResultInternal.bValid := TRUE;
    stResultInternal.bPassed := FALSE;
    stResultInternal.eCode := E_ProcessResultCode.Fail;
    stResultInternal.udiFaultCode := 3;
    stResultInternal.sDetail := 'Patch dispense: contradictory support sensors';
    sDiagnosticInternal := 'Patch dispense: contradictory support sensors';
END_IF

IF bFaultInternal THEN
    // Keep outputs de-energised.

ELSIF NOT bSafetyOkInternal THEN
    tonProcessSimulation(IN := FALSE);
    eStateInternal := E_PatchStationState.Disabled;
    usiStepInternal := 0;
    sDiagnosticInternal := 'Patch: disabled by Safety';

ELSIF bStopRequestInternal AND bManualModeInternal THEN
    tonProcessSimulation(IN := FALSE);
    eStateInternal := E_PatchStationState.Disabled;
    usiStepInternal := 0;
    bStopRequestInternal := FALSE;
    sDiagnosticInternal := 'Patch: manual stop';


// ELSIF bStopRequestInternal AND NOT bHomingAllowedInternal THEN
//     tonProcessSimulation(IN := FALSE);
//     eStateInternal := E_PatchStationState.Disabled;
//     usiStepInternal := 0;
//     bStopRequestInternal := FALSE;
//     sDiagnosticInternal := 'Patch: stop - movement inhibited';

ELSIF bStopRequestInternal THEN
    tonProcessSimulation(IN := FALSE);
    eStateInternal := E_PatchStationState.Homing;
    usiStepInternal := 30;
    bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
    sDiagnosticInternal := 'Patch dispense: stop requested - retracting support';

    IF bSupportRetractedInternal THEN
        bStopRequestInternal := FALSE;
        usiStepInternal := 0;
        IF bEnableInternal AND bCommissionedInternal AND bSafetyOkInternal THEN
            eStateInternal := E_PatchStationState.Ready;
        ELSE
            eStateInternal := E_PatchStationState.Disabled;
        END_IF
    END_IF

ELSIF NOT bCommissionedInternal THEN
    tonProcessSimulation(IN := FALSE);
    eStateInternal := E_PatchStationState.Disabled;
    usiStepInternal := 0;
    sDiagnosticInternal := 'Patch dispense: station disabled';

ELSIF NOT bSafetyOkInternal THEN
    tonProcessSimulation(IN := FALSE);
    eStateInternal := E_PatchStationState.Disabled;
    usiStepInternal := 0;
    sDiagnosticInternal := 'Patch dispense: disabled by Safety';
	
	ELSIF bManualModeInternal THEN
    tonProcessSimulation(IN := FALSE);
    usiStepInternal := 0;

    IF bEnableInternal
        AND bSafetyOkInternal
        AND bCommissionedInternal
        AND NOT bStopRequestInternal
    THEN
        eStateInternal := E_PatchStationState.Ready;

        IF bManualSupportExtendDesiredInternal THEN
            bSupportExtendRequestInternal :=
                NOT bSupportExtendedInternal;
            bSupportRetractRequestInternal := FALSE;
            sDiagnosticInternal := 'Patch: manual support extend';
        ELSE
            bSupportExtendRequestInternal := FALSE;
            bSupportRetractRequestInternal :=
                NOT bSupportRetractedInternal;
            sDiagnosticInternal := 'Patch: manual support retract';
        END_IF
    ELSE
        eStateInternal := E_PatchStationState.Disabled;
        sDiagnosticInternal := 'Patch: manual movement disabled';
    END_IF

ELSIF NOT bEnableInternal THEN
    tonProcessSimulation(IN := FALSE);
    usiStepInternal := 0;

    eStateInternal := E_PatchStationState.Disabled;
    sDiagnosticInternal := 'Patch dispense: disabled';

ELSE
	




    CASE eStateInternal OF

        E_PatchStationState.Disabled,
        E_PatchStationState.Homing:
            tonProcessSimulation(IN := FALSE);
			
			// During an explicit HOME request, the mandatory retract
			// pulse must finish before the station becomes Ready.
			//
			// FUTURE IMPLEMENTATION:
			// Add all remaining actuator HOME feedbacks here.

			IF bSupportRetractedInternal
				AND NOT bSupportExtendedInternal
				AND (NOT bHomeRequestInternal OR bHomeConfirmedInternal)
			THEN
                eStateInternal := E_PatchStationState.Ready;
                usiStepInternal := 0;
                sDiagnosticInternal := 'Patch dispense: ready';
			ELSE
				eStateInternal := E_PatchStationState.Homing;
				usiStepInternal := 30;
			
				// Explicit HOME requests use the mandatory 300 ms
				// retract pulse managed by tpHomeSupportRetract.
				//
				// Do not hold the bistable valve coil energised
				// while waiting for the support HOME feedback.
				//
				// FUTURE IMPLEMENTATION:
				// Additional actuator feedbacks must also be checked
				// before confirming the complete station HOME.
			
				IF NOT bHomeRequestInternal THEN
					// Preserve existing recovery behaviour outside
					// the explicit HOME sequence.
					bSupportRetractRequestInternal := TRUE;
				END_IF
			
				sDiagnosticInternal := 'Patch dispense: retracting support to home';
			END_IF

        E_PatchStationState.Ready:
            tonProcessSimulation(IN := FALSE);
            sDiagnosticInternal := 'Patch dispense: ready - waiting for cycle start';

            IF NOT bSupportRetractedInternal THEN
                eStateInternal := E_PatchStationState.Homing;
                usiStepInternal := 30;
            END_IF

        E_PatchStationState.Processing:
            CASE usiStepInternal OF

                10:
                    tonProcessSimulation(IN := FALSE);
                    bSupportExtendRequestInternal := NOT bSupportExtendedInternal;
                    sDiagnosticInternal := 'Patch dispense: extending support';

                    IF bSupportExtendedInternal THEN
                        usiStepInternal := 20;
                    END_IF

                20:
                    bSupportExtendRequestInternal := TRUE;
                    tonProcessSimulation(IN := TRUE, PT := tProcessSimulation);
                    sDiagnosticInternal := 'Patch dispense: simulated process - 3 s';

                    IF tonProcessSimulation.Q THEN
                        tonProcessSimulation(IN := FALSE);
                        usiStepInternal := 30;
                    END_IF

                30:
                    tonProcessSimulation(IN := FALSE);
                    bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
                    sDiagnosticInternal := 'Patch dispense: retracting support';

                    IF bSupportRetractedInternal THEN
                        stResultInternal.bValid := TRUE;
                        stResultInternal.udiFaultCode := 0;
                        stResultInternal.udiAlertCode := 0;

                        // Simulated process result. This is a PROCESS result,
                        // not a machine/component fault.
                        IF bSimulatedFail THEN
                            stResultInternal.bPassed := FALSE;
                            stResultInternal.eCode := E_ProcessResultCode.Fail;
                            stResultInternal.sDetail := 'Patch dispense simulated process failed';
                        ELSE
                            stResultInternal.bPassed := TRUE;
                            stResultInternal.eCode := E_ProcessResultCode.Pass;
                            stResultInternal.sDetail := 'Patch dispense simulated process passed';
                        END_IF

                        eStateInternal := E_PatchStationState.Complete;
                        usiStepInternal := 0;
                    END_IF

                ELSE
                    usiStepInternal := 30;
            END_CASE

        E_PatchStationState.Complete:
            tonProcessSimulation(IN := FALSE);
            sDiagnosticInternal := 'Patch dispense: complete - support retracted';

        E_PatchStationState.Fault:
            tonProcessSimulation(IN := FALSE);
            bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
            sDiagnosticInternal := 'Patch dispense: fault';

        ELSE
            eStateInternal := E_PatchStationState.Fault;

    END_CASE
END_IF



// ---------------------------------------------------------
// Support-cylinder feedback supervision
// ---------------------------------------------------------
// A commanded movement must reach the corresponding end-position sensor
// within tSupportMoveTimeout, but ONLY while cylinder supervision is enabled.
//
// Supervision is intentionally active only in:
//   ReadyToStart
//   AutoCycle
//   Manual
//
// It is disabled during Fault / Stopping / Stopped / Initialising so the
// machine can restore air and recover a cylinder that stopped between sensors
// without immediately re-triggering the same feedback alarm.

tonSupportExtendTimeout(
    IN := bSupervisionEnableInternal
        AND bSafetyOkInternal
        AND bSupportExtendRequestInternal
        AND NOT bSupportExtendedInternal
        AND (eStateInternal <> E_PatchStationState.Fault),
    PT := tSupportMoveTimeout
);

tonSupportRetractTimeout(
    IN := bSupervisionEnableInternal
        AND bSafetyOkInternal
        AND bSupportRetractRequestInternal
        AND NOT bSupportRetractedInternal
        AND (eStateInternal <> E_PatchStationState.Fault),
    PT := tSupportMoveTimeout
);

IF tonSupportExtendTimeout.Q THEN
    bSupportExtendRequestInternal := FALSE;
    bSupportRetractRequestInternal := FALSE;
    eSupportFaultInternal := E_SupportCylinderFault.ExtendTimeout;
    eStateInternal := E_PatchStationState.Fault;
    usiStepInternal := 0;

    stResultInternal.bValid := TRUE;
    stResultInternal.bPassed := FALSE;
    stResultInternal.eCode := E_ProcessResultCode.Fail;
    stResultInternal.udiFaultCode := 1;
    stResultInternal.udiAlertCode := 0;
    stResultInternal.sDetail := 'Patch dispense: support UP feedback timeout';

    sDiagnosticInternal := 'Patch dispense: support UP feedback timeout';

ELSIF tonSupportRetractTimeout.Q THEN
    bSupportExtendRequestInternal := FALSE;
    bSupportRetractRequestInternal := FALSE;
    eSupportFaultInternal := E_SupportCylinderFault.RetractTimeout;
    eStateInternal := E_PatchStationState.Fault;
    usiStepInternal := 0;

    stResultInternal.bValid := TRUE;
    stResultInternal.bPassed := FALSE;
    stResultInternal.eCode := E_ProcessResultCode.Fail;
    stResultInternal.udiFaultCode := 2;
    stResultInternal.udiAlertCode := 0;
    stResultInternal.sDetail := 'Patch dispense: support DOWN feedback timeout';

    sDiagnosticInternal := 'Patch dispense: support DOWN feedback timeout';
END_IF


// ---------------------------------------------------------
// PATCH DISPENSING HOME - output priority and sequence
// ---------------------------------------------------------
// The support valve is bistable: always send a 300 ms retract pulse.
// Confirm support DOWN using both sensors before moving vertical UP.
// Vertical UP has no position sensor; its 1 s pulse is time-confirmed only.
// HOME takes ownership of support commands during Initialising.

IF NOT bSupportRetractedInternal OR bSupportExtendedInternal
    OR (eStateInternal = E_PatchStationState.Fault) OR NOT bSafetyOkInternal THEN
    bHomeConfirmedInternal := FALSE;
END_IF

IF bHomeRequestInternal THEN
    bSupportExtendRequestInternal := FALSE;
    bSupportRetractRequestInternal := FALSE;

    IF bHomeExecutionAllowedInternal THEN
        CASE usiHomeStepInternal OF
            0: // Start a new HOME attempt.
                usiHomeStepInternal := 10;
                sDiagnosticInternal := 'Patch HOME: support retract pulse';

            10: // Bistable support DOWN valve: 300 ms pulse.
                bSupportRetractRequestInternal := NOT tonHomeSupportRetract.Q;
                IF tonHomeSupportRetract.Q THEN
                    usiHomeStepInternal := 20;
                END_IF

            20: // Wait for valid support DOWN feedback.
                sDiagnosticInternal := 'Patch HOME: waiting for support DOWN';
                IF bSupportRetractedInternal AND NOT bSupportExtendedInternal THEN
                    usiHomeStepInternal := 30;
                END_IF

            30: // Vertical UP: continuous 1 s command, without sensor feedback.
                sDiagnosticInternal := 'Patch HOME: vertical UP';
                bVerticalUpRequestInternal := NOT tonHomeVerticalUp.Q;
                IF NOT bSupportRetractedInternal OR bSupportExtendedInternal THEN
                    bVerticalUpRequestInternal := FALSE;
                    usiHomeStepInternal := 0;
                    bHomeConfirmedInternal := FALSE;
                ELSIF tonHomeVerticalUp.Q THEN
                    bVerticalUpRequestInternal := FALSE;
                    usiHomeStepInternal := 40;
                END_IF

            40: // All available HOME checks completed.
                bHomeConfirmedInternal := TRUE;
                bHomeRequestInternal := FALSE;
                usiHomeStepInternal := 0;
                sDiagnosticInternal := 'Patch HOME: completed';

            ELSE
                usiHomeStepInternal := 0;
        END_CASE
    END_IF
END_IF

// ---------------------------------------------------------
// Final station output safety interlock
// ---------------------------------------------------------
// Applies to HOME, Manual and AutoCycle; TwinSAFE remains authoritative.
IF NOT bSafetyOkInternal OR (eStateInternal = E_PatchStationState.Fault) THEN
    bSupportExtendRequestInternal := FALSE;
    bSupportRetractRequestInternal := FALSE;
    bVerticalUpRequestInternal := FALSE;
END_IF

// ---------------------------------------------------------
// Station HOME and process status
// ---------------------------------------------------------
// Vertical HOME is confirmed by the completed pulse, not a position sensor.
bHomeInternal :=
    bHomeConfirmedInternal
    AND bSupportRetractedInternal
    AND NOT bSupportExtendedInternal
    AND (eStateInternal <> E_PatchStationState.Fault);
bReadyInternal := (eStateInternal = E_PatchStationState.Ready) AND bSupportRetractedInternal;
bBusyInternal := (eStateInternal = E_PatchStationState.Processing)
    OR ((eStateInternal = E_PatchStationState.Homing) AND NOT bSupportRetractedInternal)
    OR bHomeRequestInternal;
bCompleteInternal := (eStateInternal = E_PatchStationState.Complete);
bFaultInternal := (eStateInternal = E_PatchStationState.Fault);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetResult" Id="{b33b0890-9093-422a-9f77-c58a31b7a42d}">
      <Declaration><![CDATA[METHOD PUBLIC GetResult : ST_ProcessResult
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetResult := stResultInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Home" Id="{a98cb97a-e8d1-4d1a-aebd-f94068da51f6}">
      <Declaration><![CDATA[METHOD PUBLIC Home
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Request a new Patch Dispensing HOME sequence.
// The sequence is executed in Cyclic() during Initialising.
//
// Step 10: Support DOWN - mandatory 300 ms valve pulse.
// Step 20: Wait for support retracted feedback.
// Step 30: Vertical UP - 1 second pulse.
// Step 40: Confirm HOME completion.
//
// A new request always restarts the complete HOME sequence,
// even when the support is already retracted.

bHomeRequestInternal := TRUE;
bHomeConfirmedInternal := FALSE;
bHomeInternal := FALSE;

// Reset HOME sequence.
usiHomeStepInternal := 0;
bHomeExecutionAllowedInternal := FALSE;

// Clear movement requests.
bVerticalUpRequestInternal := FALSE;

// Reset legacy HOME pulse flags.
bHomePulseStartedInternal := FALSE;
bHomePulseCompletedInternal := FALSE;
bHomePulseResetPendingInternal := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialise" Id="{743255a3-43ef-4139-b99e-67a8da015efe}">
      <Declaration><![CDATA[METHOD PUBLIC Initialise]]></Declaration>
      <Implementation>
        <ST><![CDATA[
tonProcessSimulation(IN := FALSE);
tonSupportExtendTimeout(IN := FALSE);
tonSupportRetractTimeout(IN := FALSE);
eSupportFaultInternal := E_SupportCylinderFault.None;
eStateInternal := E_PatchStationState.Disabled;
usiStepInternal := 0;
bHomeInternal := FALSE;
bReadyInternal := FALSE;
bBusyInternal := FALSE;
bCompleteInternal := FALSE;
bFaultInternal := FALSE;
bSupportExtendRequestInternal := FALSE;
bSupportRetractRequestInternal := FALSE;
bStopRequestInternal := FALSE;
sDiagnosticInternal := '';

stResultInternal.bValid := FALSE;
stResultInternal.bPassed := FALSE;
stResultInternal.eCode := E_ProcessResultCode.None;
stResultInternal.udiFaultCode := 0;
stResultInternal.udiAlertCode := 0;
stResultInternal.sDetail := '';
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsBusy" Id="{6871d8d9-5930-4615-b534-4b63e1df8d23}">
      <Declaration><![CDATA[METHOD PUBLIC IsBusy : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsBusy := bBusyInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsDone" Id="{1191cf58-408d-41d1-a829-9111eee2f26c}">
      <Declaration><![CDATA[METHOD PUBLIC IsDone : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsDone := bCompleteInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsFaulted" Id="{bd6f3c62-386f-4e4e-8bc8-cb049b9869e5}">
      <Declaration><![CDATA[METHOD PUBLIC IsFaulted : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsFaulted := bFaultInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsHome" Id="{8f750aa1-e0db-4cfc-b383-81a631f39cb6}">
      <Declaration><![CDATA[METHOD IsHome : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// TRUE only after the requested HOME sequence is completed
// and the available support feedbacks are valid.
//
// FUTURE IMPLEMENTATION:
// Include all remaining station HOME feedbacks.

IsHome :=
    bHomeConfirmedInternal
    AND bSupportRetractedInternal
    AND NOT bSupportExtendedInternal
    AND NOT bFaultInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsReady" Id="{b47de1d3-46cd-40ee-afff-fef3adf2adda}">
      <Declaration><![CDATA[METHOD PUBLIC IsReady : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsReady := bReadyInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestReset" Id="{f3acbf00-1e76-4916-95e1-b6d9656859e8}">
      <Declaration><![CDATA[METHOD PUBLIC RequestReset
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
tonProcessSimulation(IN := FALSE);
tonSupportExtendTimeout(IN := FALSE);
tonSupportRetractTimeout(IN := FALSE);
eSupportFaultInternal := E_SupportCylinderFault.None;
bStopRequestInternal := FALSE;

stResultInternal.bValid := FALSE;
stResultInternal.bPassed := FALSE;
stResultInternal.eCode := E_ProcessResultCode.None;
stResultInternal.udiFaultCode := 0;
stResultInternal.udiAlertCode := 0;
stResultInternal.sDetail := '';

IF bEnableInternal AND bCommissionedInternal AND bSafetyOkInternal THEN
    IF bSupportRetractedInternal THEN
        eStateInternal := E_PatchStationState.Ready;
        usiStepInternal := 0;
    ELSE
        eStateInternal := E_PatchStationState.Homing;
        usiStepInternal := 30;
    END_IF
ELSE
    eStateInternal := E_PatchStationState.Disabled;
    usiStepInternal := 0;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestStart" Id="{25c812e0-7d98-48f5-a51a-d7b75e60a3d0}">
      <Declaration><![CDATA[METHOD PUBLIC RequestStart : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
RequestStart := FALSE;

IF bEnableInternal
    AND bCommissionedInternal
    AND bSafetyOkInternal
    AND bReadyInternal
    AND bSupportRetractedInternal
THEN
    stResultInternal.bValid := FALSE;
    stResultInternal.bPassed := FALSE;
    stResultInternal.eCode := E_ProcessResultCode.None;
    stResultInternal.sDetail := '';

    eStateInternal := E_PatchStationState.Processing;
    usiStepInternal := 10;
    RequestStart := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestStop" Id="{18d6d99c-699b-4344-b667-37fee902e851}">
      <Declaration><![CDATA[METHOD PUBLIC RequestStop
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[bStopRequestInternal := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Update" Id="{f6ee0503-c772-4ebc-a880-089dbece365c}">
      <Declaration><![CDATA[METHOD PUBLIC Update
VAR_INPUT
    bEnable           : BOOL;
    bCommissioned     : BOOL;
    bSafetyOk         : BOOL;
    bSupervisionEnable : BOOL;
    bReset            : BOOL;
    bSupportRetracted : BOOL;
    bSupportExtended  : BOOL;
    tSupportTimeout   : TIME;
	bManualMode 		: BOOL;
	bManualSupportExtendDesired : BOOL;
	bHomingAllowed : BOOL;
END_VAR
VAR_OUTPUT
    stStatus               : ST_PatchStageStatus;
    bSupportExtendRequest  : BOOL;
    bSupportRetractRequest : BOOL;
	bVerticalUpRequest 		: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
bEnableInternal := bEnable;
bManualModeInternal := bManualMode;
bManualSupportExtendDesiredInternal := bManualSupportExtendDesired;
bCommissionedInternal := bCommissioned;
bSafetyOkInternal := bSafetyOk;
bHomingAllowedInternal := bHomingAllowed;
bSupervisionEnableInternal := bSupervisionEnable;
bSupportRetractedInternal := bSupportRetracted;
bSupportExtendedInternal := bSupportExtended;
tSupportMoveTimeout := tSupportTimeout;

IF bReset THEN
    RequestReset();
END_IF

Cyclic();

stStatus.eState := eStateInternal;
stStatus.bCommissioned := bCommissionedInternal;
stStatus.bHome := bHomeInternal;
stStatus.bReady := bReadyInternal;
stStatus.bBusy := bBusyInternal;
stStatus.bComplete := bCompleteInternal;
stStatus.bFault := bFaultInternal;
stStatus.eSupportFault := eSupportFaultInternal;
stStatus.sDiagnostic := sDiagnosticInternal;

bSupportExtendRequest := bSupportExtendRequestInternal;
bSupportRetractRequest := bSupportRetractRequestInternal;
bVerticalUpRequest := bVerticalUpRequestInternal;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>