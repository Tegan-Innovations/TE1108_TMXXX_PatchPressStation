<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_PatchDispenseStation" Id="{307a15f9-be92-4a17-837f-7db7d76c6090}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PatchDispenseStation IMPLEMENTS I_ProcessEquipment
VAR
	bHomeRequestInternal   				: BOOL := FALSE;
	bHomeConfirmedInternal 				: BOOL := FALSE;
	bHomePulseStartedInternal   		: BOOL := FALSE;
	bHomePulseCompletedInternal 		: BOOL := FALSE;
	tpHomeSupportRetract        		: TP;
	bHomePulseResetPendingInternal 		: BOOL := FALSE;
	bVerticalUpRequestInternal : BOOL := FALSE;
    // Simulation result selector for commissioning / software test.
    // FALSE = simulated process PASS (default)
    // TRUE  = simulated process FAIL
    bSimulatedFail             			: BOOL := FALSE;

    // Simulates a MACHINE/STATION fault, independently from simulated
    // product PASS/FAIL above. Reset will only recover after this is FALSE.
    bSimulatedFault            			: BOOL := FALSE;

    bEnableInternal           			: BOOL;
	bManualModeInternal 				: BOOL;
	bManualSupportExtendDesiredInternal : BOOL;
    bCommissionedInternal     			: BOOL;
    bSafetyOkInternal         			: BOOL;
    bSupervisionEnableInternal 			: BOOL;
    bSupportRetractedInternal 			: BOOL;
    bSupportExtendedInternal  			: BOOL;
	bHomingAllowedInternal 				: BOOL;
	
    eStateInternal      				: E_PatchStationState := E_PatchStationState.Disabled;
    usiStepInternal     				: USINT := 0;
    bHomeInternal       				: BOOL;
    bReadyInternal      				: BOOL;
    bBusyInternal       				: BOOL;
    bCompleteInternal   				: BOOL;
    bFaultInternal      				: BOOL;
    sDiagnosticInternal 				: STRING(120);
    bSupportExtendRequestInternal  		: BOOL;
    bSupportRetractRequestInternal 		: BOOL;
    bStopRequestInternal           		: BOOL;
	
    eSupportFaultInternal 				: E_SupportCylinderFault := E_SupportCylinderFault.None;
    tonSupportExtendTimeout  			: TON;
    tonSupportRetractTimeout 			: TON;
	
    tSupportMoveTimeout      			: TIME := T#5S;
    tonProcessSimulation 				: TON;
    tProcessSimulation   				: TIME := T#3S;
    stResultInternal 					: ST_ProcessResult;
	
		// HOME sequence control
	usiHomeStepInternal : USINT := 0;
	bHomeExecutionAllowedInternal : BOOL := FALSE;
	
	// HOME timers
	tonHomeSupportRetract : TON;
	tonHomeVerticalUp : TON;
    bVerticalDownRequestInternal : BOOL;
    bDriveRunRequestInternal : BOOL;
    bAirBlowRequestInternal : BOOL;
    bFeedOnlyInternal : BOOL;
    bPatchDetectedInternal : BOOL;
    bDriveMotionSeenInternal : BOOL;
    bPatchOpticalLeftInternal : BOOL;
    bPatchOpticalRightInternal : BOOL;
    bPatchLeftSeenInternal : BOOL;
    bPatchRightSeenInternal : BOOL;
    bVerticalUpInternal : BOOL;
    bVerticalDownInternal : BOOL;
    bDriveStandstillInternal : BOOL;
    bDriveBusyInternal : BOOL;
    bDriveMovingInternal : BOOL;
    bDriveFaultInternal : BOOL;
    bStartPermittedInternal : BOOL;
    bHoldUpRequiredInternal : BOOL;
    rtFullSequence : R_TRIG;
    rtFeedOnly : R_TRIG;
    stProcessSettingsInternal : ST_PatchProcessSettings;
    tonAirBlowDelay : TON;
    tonDriveStopDelay : TON;
    tonFeed : TON;
    tonRelease : TON;
    tonVertical : TON;
    bUseVerticalFeedbackInternal : BOOL := FALSE;
    tVerticalMoveTimeInternal : TIME := T#1S;
    bVerticalUpCommandInternal : BOOL;
    bVerticalDownCommandInternal : BOOL;
    usiVerticalEstimatedPosition : USINT; // 0 unknown, 1 timed UP, 2 timed DOWN
    bVerticalUpReadyInternal : BOOL;
    bVerticalDownReadyInternal : BOOL;
    bVerticalIndexReadyInternal : BOOL;
    tonVerticalTimedUp : TON;
    tonVerticalTimedDown : TON;
    bPatchRightOffSeenInternal : BOOL; // Fresh OFF then ON required for each feed.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cyclic" Id="{63a17042-276a-418e-8bb1-2373e80987fa}">
      <Declaration><![CDATA[METHOD PUBLIC Cyclic
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Real dispense: support UP -> feed -> M1 stopped -> vertical DOWN -> release -> UP -> support DOWN.
bSupportExtendRequestInternal := FALSE;
bSupportRetractRequestInternal := FALSE;
bVerticalUpRequestInternal := FALSE;
bVerticalDownRequestInternal := FALSE;
bDriveRunRequestInternal := FALSE;
bAirBlowRequestInternal := FALSE;

// TEMPORARY COMMISSIONING: physical inputs remain raw; readiness can be time-estimated.
// Previous-scan FINAL valve outputs include HOME, sequence, manual pulses and index hold-UP.
tonVerticalTimedUp(IN := NOT bUseVerticalFeedbackInternal AND bSafetyOkInternal
    AND bCommissionedInternal AND (eStateInternal <> E_PatchStationState.Fault)
    AND bVerticalUpCommandInternal AND NOT bVerticalDownCommandInternal,
    PT := tVerticalMoveTimeInternal);
tonVerticalTimedDown(IN := NOT bUseVerticalFeedbackInternal AND bSafetyOkInternal
    AND bCommissionedInternal AND (eStateInternal <> E_PatchStationState.Fault)
    AND bVerticalDownCommandInternal AND NOT bVerticalUpCommandInternal,
    PT := tVerticalMoveTimeInternal);
IF NOT bSafetyOkInternal OR NOT bCommissionedInternal
    OR (eStateInternal = E_PatchStationState.Fault) OR bUseVerticalFeedbackInternal THEN
    usiVerticalEstimatedPosition := 0;
ELSIF bVerticalUpCommandInternal AND bVerticalDownCommandInternal THEN
    usiVerticalEstimatedPosition := 0;
ELSIF bVerticalUpCommandInternal THEN
    IF usiVerticalEstimatedPosition = 2 THEN usiVerticalEstimatedPosition := 0; END_IF
    IF tonVerticalTimedUp.Q THEN usiVerticalEstimatedPosition := 1; END_IF
ELSIF bVerticalDownCommandInternal THEN
    IF usiVerticalEstimatedPosition = 1 THEN usiVerticalEstimatedPosition := 0; END_IF
    IF tonVerticalTimedDown.Q THEN usiVerticalEstimatedPosition := 2; END_IF
END_IF
IF bUseVerticalFeedbackInternal THEN
    bVerticalUpReadyInternal := bVerticalUpInternal;
    bVerticalDownReadyInternal := bVerticalDownInternal;
    bVerticalIndexReadyInternal := bVerticalUpInternal AND NOT bVerticalDownInternal;
ELSE
    bVerticalUpReadyInternal := (usiVerticalEstimatedPosition = 1);
    bVerticalDownReadyInternal := (usiVerticalEstimatedPosition = 2);
    // An old estimate alone cannot permit index or nest raising: hold UP for a full travel time.
    bVerticalIndexReadyInternal := bVerticalUpReadyInternal AND tonVerticalTimedUp.Q
        AND bVerticalUpCommandInternal AND NOT bVerticalDownCommandInternal;
END_IF

bHomeExecutionAllowedInternal := bHomeRequestInternal AND bSafetyOkInternal
    AND bHomingAllowedInternal AND bEnableInternal AND bCommissionedInternal
    AND NOT bManualModeInternal AND NOT bStopRequestInternal
    AND (eStateInternal <> E_PatchStationState.Fault);
IF NOT bHomeExecutionAllowedInternal THEN usiHomeStepInternal := 0; END_IF

tonHomeSupportRetract(IN := bHomeExecutionAllowedInternal AND (usiHomeStepInternal = 10), PT := T#300MS);
tonHomeVerticalUp(IN := bHomeExecutionAllowedInternal AND (usiHomeStepInternal = 30)
    AND NOT bVerticalUpReadyInternal, PT := tSupportMoveTimeout);
// Vacuum starts on the rising edge AFTER the first real RIGHT falling edge.
// RIGHT must first be seen ON in this feed; an initial OFF does not arm vacuum.
IF NOT bSafetyOkInternal OR NOT bEnableInternal OR NOT bCommissionedInternal
    OR bStopRequestInternal OR bHomeRequestInternal
    OR (eStateInternal <> E_PatchStationState.Processing) OR (usiStepInternal <> 20) THEN
    bPatchRightOffSeenInternal := FALSE;
ELSIF bPatchRightSeenInternal AND NOT bPatchOpticalRightInternal THEN
    bPatchRightOffSeenInternal := TRUE;
END_IF
// Retained legacy timer/settings member is no longer used to start the Venturi.
tonAirBlowDelay(IN := FALSE);
// Both sensors OFF after the qualified RIGHT pulse starts the existing run-on.
// Step 23 latches timing; later sensor changes do not restart it.
tonDriveStopDelay(IN := bSafetyOkInternal AND bEnableInternal AND bCommissionedInternal
    AND NOT bStopRequestInternal AND NOT bHomeRequestInternal
    AND (eStateInternal = E_PatchStationState.Processing)
    AND ((usiStepInternal = 23)
        OR ((usiStepInternal = 21) AND bPatchDetectedInternal AND bPatchRightSeenInternal
            AND (bDriveMotionSeenInternal OR bDriveMovingInternal)
            AND NOT bPatchOpticalLeftInternal AND NOT bPatchOpticalRightInternal)),
    PT := UDINT_TO_TIME(stProcessSettingsInternal.udiDriveStopDelayMs));
tonFeed(IN := bSafetyOkInternal AND (eStateInternal = E_PatchStationState.Processing)
    AND ((usiStepInternal = 20) OR (usiStepInternal = 21) OR (usiStepInternal = 23)), PT := T#30S);
tonRelease(IN := bSafetyOkInternal AND (eStateInternal = E_PatchStationState.Processing)
    AND (usiStepInternal = 50), PT := UDINT_TO_TIME(stProcessSettingsInternal.udiReleaseMs));
tonVertical(IN := bSafetyOkInternal AND
    (((eStateInternal = E_PatchStationState.Processing) AND
      (((usiStepInternal = 40) AND NOT bVerticalDownReadyInternal)
       OR ((usiStepInternal = 60) AND NOT bVerticalUpReadyInternal)))
     OR (bStopRequestInternal AND (usiStepInternal = 100) AND NOT bVerticalUpReadyInternal)
     OR ((eStateInternal = E_PatchStationState.Homing) AND NOT bHomeRequestInternal
         AND NOT bStopRequestInternal AND NOT bVerticalUpReadyInternal)
     OR (bHoldUpRequiredInternal AND (eStateInternal <> E_PatchStationState.Processing)
         AND NOT bHomeRequestInternal AND NOT bStopRequestInternal AND NOT bVerticalUpReadyInternal)),
    PT := tSupportMoveTimeout);

IF bSafetyOkInternal THEN
IF bEnableInternal AND bSimulatedFault THEN
    eStateInternal := E_PatchStationState.Fault;
    sDiagnosticInternal := 'Patch: simulated station fault';
ELSIF bSafetyOkInternal AND (bEnableInternal OR bStopRequestInternal)
    AND bVerticalUpReadyInternal AND bVerticalDownReadyInternal THEN
    eStateInternal := E_PatchStationState.Fault;
    stResultInternal.udiFaultCode := 4;
    sDiagnosticInternal := 'Patch: vertical sensor conflict';
ELSIF bSupervisionEnableInternal AND bSafetyOkInternal
    AND bSupportRetractedInternal AND bSupportExtendedInternal THEN
    eStateInternal := E_PatchStationState.Fault;
    eSupportFaultInternal := E_SupportCylinderFault.ContradictorySensors;
    sDiagnosticInternal := 'Patch: support sensor conflict';
ELSIF (eStateInternal = E_PatchStationState.Processing) AND NOT bFeedOnlyInternal
    AND ((usiStepInternal = 20) OR (usiStepInternal = 21) OR (usiStepInternal = 23) OR (usiStepInternal = 22) OR (usiStepInternal = 30))
    AND (NOT bVerticalUpReadyInternal OR bVerticalDownReadyInternal) THEN
    eStateInternal := E_PatchStationState.Fault;
    stResultInternal.udiFaultCode := 8;
    sDiagnosticInternal := 'Patch: vertical UP feedback lost during feed';
ELSIF (eStateInternal = E_PatchStationState.Processing) AND NOT bFeedOnlyInternal
    AND (usiStepInternal <> 10) AND (usiStepInternal <> 30)
    AND (NOT bSupportExtendedInternal OR bSupportRetractedInternal) THEN
    eStateInternal := E_PatchStationState.Fault;
    stResultInternal.udiFaultCode := 9;
    sDiagnosticInternal := 'Patch: nest UP feedback lost during dispense';
ELSIF (eStateInternal = E_PatchStationState.Processing) AND (usiStepInternal = 50)
    AND (NOT bVerticalDownReadyInternal OR bVerticalUpReadyInternal) THEN
    eStateInternal := E_PatchStationState.Fault;
    stResultInternal.udiFaultCode := 10;
    sDiagnosticInternal := 'Patch: vertical DOWN feedback lost during dwell';
ELSIF tonFeed.Q THEN
    eStateInternal := E_PatchStationState.Fault;
    stResultInternal.udiFaultCode := 6;
    sDiagnosticInternal := 'Patch: optical patch detection/end timeout';
ELSIF tonVertical.Q OR tonHomeVerticalUp.Q THEN
    eStateInternal := E_PatchStationState.Fault;
    stResultInternal.udiFaultCode := 5;
    sDiagnosticInternal := 'Patch: vertical position feedback timeout';
ELSIF bDriveFaultInternal AND (eStateInternal = E_PatchStationState.Processing) THEN
    eStateInternal := E_PatchStationState.Fault;
    stResultInternal.udiFaultCode := 7;
    sDiagnosticInternal := 'Patch: M1 drive fault';
END_IF

END_IF // Safety loss is handled before feedback-based process supervision.

IF eStateInternal = E_PatchStationState.Fault THEN
    stResultInternal.bValid := FALSE;
    stResultInternal.bPassed := FALSE;
    stResultInternal.eCode := E_ProcessResultCode.None;

ELSIF NOT bSafetyOkInternal OR NOT bCommissionedInternal THEN
    eStateInternal := E_PatchStationState.Disabled;
    usiStepInternal := 0;
    bPatchDetectedInternal := FALSE;
    bPatchLeftSeenInternal := FALSE;
    bPatchRightSeenInternal := FALSE;
    bDriveMotionSeenInternal := FALSE;
    bHomeConfirmedInternal := FALSE;
    stResultInternal.bValid := FALSE;
    sDiagnosticInternal := 'Patch: disabled by safety or commissioning';

ELSIF bStopRequestInternal THEN
    // Controlled recovery: stop M1 before vertical UP; only then retract the nest.
    eStateInternal := E_PatchStationState.Homing;
    stResultInternal.bValid := FALSE;
    bPatchDetectedInternal := FALSE;
    bPatchLeftSeenInternal := FALSE;
    bPatchRightSeenInternal := FALSE;
    IF usiStepInternal < 90 THEN usiStepInternal := 90; END_IF
    CASE usiStepInternal OF
        90:
            sDiagnosticInternal := 'Patch: stopping M1';
            IF bDriveStandstillInternal AND NOT bDriveBusyInternal THEN usiStepInternal := 100; END_IF
        100:
            bVerticalUpRequestInternal := TRUE;
            sDiagnosticInternal := 'Patch: stop recovery vertical UP';
            IF bVerticalIndexReadyInternal THEN usiStepInternal := 110; END_IF
        110:
            bVerticalUpRequestInternal := TRUE;
            bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
            sDiagnosticInternal := 'Patch: stop recovery support DOWN';
            IF bSupportRetractedInternal AND NOT bSupportExtendedInternal THEN
                bStopRequestInternal := FALSE;
                bFeedOnlyInternal := FALSE;
                usiStepInternal := 0;
                eStateInternal := E_PatchStationState.Disabled;
            END_IF
    END_CASE

ELSIF bHomeRequestInternal THEN
    eStateInternal := E_PatchStationState.Homing;
    IF bHomeExecutionAllowedInternal THEN
        CASE usiHomeStepInternal OF
            0: usiHomeStepInternal := 10;
            10:
                bSupportRetractRequestInternal := NOT tonHomeSupportRetract.Q;
                sDiagnosticInternal := 'Patch HOME: support DOWN pulse';
                IF tonHomeSupportRetract.Q THEN usiHomeStepInternal := 20; END_IF
            20:
                sDiagnosticInternal := 'Patch HOME: waiting support DOWN';
                IF bSupportRetractedInternal AND NOT bSupportExtendedInternal THEN usiHomeStepInternal := 30; END_IF
            30:
                bVerticalUpRequestInternal := TRUE;
                sDiagnosticInternal := 'Patch HOME: waiting vertical UP';
                IF bVerticalUpReadyInternal AND NOT bVerticalDownReadyInternal THEN
                    bHomeConfirmedInternal := TRUE;
                    bHomeRequestInternal := FALSE;
                    usiHomeStepInternal := 0;
                    eStateInternal := E_PatchStationState.Ready;
                END_IF
        END_CASE
    END_IF

ELSIF NOT bEnableInternal THEN
    eStateInternal := E_PatchStationState.Disabled;
    usiStepInternal := 0;
    bPatchDetectedInternal := FALSE;
    bPatchLeftSeenInternal := FALSE;
    bPatchRightSeenInternal := FALSE;
    stResultInternal.bValid := FALSE;
    sDiagnosticInternal := 'Patch: disabled';

ELSIF eStateInternal = E_PatchStationState.Processing THEN
    IF bDriveMovingInternal THEN bDriveMotionSeenInternal := TRUE; END_IF
    // Qualify each sensor independently during the current feed only.
    IF (usiStepInternal = 20) OR (usiStepInternal = 21) THEN
        IF bPatchOpticalLeftInternal THEN bPatchLeftSeenInternal := TRUE; END_IF
        IF bPatchOpticalRightInternal THEN bPatchRightSeenInternal := TRUE; END_IF
    END_IF
    CASE usiStepInternal OF
        10:
            bVerticalUpRequestInternal := TRUE;
            bSupportExtendRequestInternal := bVerticalIndexReadyInternal
                AND NOT bSupportExtendedInternal;
            sDiagnosticInternal := 'Patch: raising nest';
            IF bSupportExtendedInternal AND NOT bSupportRetractedInternal
                AND bVerticalIndexReadyInternal THEN usiStepInternal := 20; END_IF
        20:
            bDriveRunRequestInternal := TRUE;
            sDiagnosticInternal := 'Patch: M1 waiting RIGHT falling then rising edge';
            IF bPatchRightOffSeenInternal AND bPatchOpticalRightInternal THEN
                bPatchDetectedInternal := TRUE;
                bAirBlowRequestInternal := NOT bFeedOnlyInternal;
                usiStepInternal := 21;
            END_IF
        21:
            bDriveRunRequestInternal := TRUE;
            bAirBlowRequestInternal := NOT bFeedOnlyInternal;
            sDiagnosticInternal := 'Patch: vacuum ON - waiting both optical OFF';
            IF bPatchDetectedInternal AND bDriveMotionSeenInternal
                AND bPatchRightSeenInternal
                AND NOT bPatchOpticalLeftInternal AND NOT bPatchOpticalRightInternal THEN
                IF tonDriveStopDelay.Q THEN
                    bDriveRunRequestInternal := FALSE;
                    usiStepInternal := 22;
                ELSE
                    usiStepInternal := 23;
                END_IF
            END_IF
        23:
            bDriveRunRequestInternal := TRUE;
            bAirBlowRequestInternal := NOT bFeedOnlyInternal;
            sDiagnosticInternal := 'Patch: M1 extra feed after both optical OFF';
            IF tonDriveStopDelay.Q THEN
                bDriveRunRequestInternal := FALSE;
                usiStepInternal := 22;
            END_IF
        22:
            bAirBlowRequestInternal := NOT bFeedOnlyInternal;
            sDiagnosticInternal := 'Patch: waiting M1 standstill';
            IF bDriveStandstillInternal AND NOT bDriveBusyInternal THEN
                IF bFeedOnlyInternal THEN
                    eStateInternal := E_PatchStationState.Complete;
                    usiStepInternal := 0;
                    stResultInternal.bValid := FALSE; // Feed-only never certifies a product dispense.
                ELSE
                    usiStepInternal := 40;
                END_IF
            END_IF
        40:
            bVerticalDownRequestInternal := TRUE;
            bAirBlowRequestInternal := TRUE;
            sDiagnosticInternal := 'Patch: vertical DOWN';
            IF bVerticalDownReadyInternal AND NOT bVerticalUpReadyInternal THEN
                bAirBlowRequestInternal := FALSE;
                usiStepInternal := 50;
            END_IF
        50:
            // Bistable valve retains DOWN; do not energise UP during the release dwell.
            bVerticalDownRequestInternal := FALSE;
            sDiagnosticInternal := 'Patch: release dwell';
            IF tonRelease.Q THEN usiStepInternal := 60; END_IF
        60:
            bVerticalUpRequestInternal := TRUE;
            sDiagnosticInternal := 'Patch: vertical UP';
            IF bVerticalUpReadyInternal AND NOT bVerticalDownReadyInternal THEN usiStepInternal := 30; END_IF
        30:
            bVerticalUpRequestInternal := TRUE;
            bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
            sDiagnosticInternal := 'Patch: lowering nest';
            IF bSupportRetractedInternal AND NOT bSupportExtendedInternal THEN
                // Manual dispense has returned to its confirmed idle position.
                // Restore HOME cleared during DOWN so the HMI can show Ready again.
                IF bManualModeInternal THEN bHomeConfirmedInternal := TRUE; END_IF
                stResultInternal.bValid := TRUE;
                stResultInternal.bPassed := NOT bSimulatedFail;
                stResultInternal.udiFaultCode := 0;
                stResultInternal.udiAlertCode := 0;
                IF bSimulatedFail THEN
                    stResultInternal.eCode := E_ProcessResultCode.Fail;
                    stResultInternal.sDetail := 'Patch dispense: commissioning fail selector';
                ELSE
                    stResultInternal.eCode := E_ProcessResultCode.Pass;
                    stResultInternal.sDetail := 'Patch dispense sequence completed';
                END_IF
                eStateInternal := E_PatchStationState.Complete;
                usiStepInternal := 0;
            END_IF
        ELSE
            eStateInternal := E_PatchStationState.Fault;
            sDiagnosticInternal := 'Patch: invalid process step';
    END_CASE
    // Preserve an already-required index hold-UP during motor-only dispensing.
    IF bFeedOnlyInternal AND bHoldUpRequiredInternal THEN bVerticalUpRequestInternal := TRUE; END_IF
    // Keep the raised nest in position throughout the full dispense.
    IF NOT bFeedOnlyInternal AND NOT bVerticalDownRequestInternal AND (usiStepInternal <> 50)
        AND (eStateInternal = E_PatchStationState.Processing) THEN
        bVerticalUpRequestInternal := TRUE;
    END_IF
    IF NOT bFeedOnlyInternal AND (usiStepInternal <> 30) AND (usiStepInternal <> 10)
        AND (eStateInternal = E_PatchStationState.Processing) THEN
        bSupportExtendRequestInternal := NOT bSupportExtendedInternal;
    END_IF

ELSE
    IF bManualModeInternal THEN
        IF bManualSupportExtendDesiredInternal THEN
            bSupportExtendRequestInternal := NOT bSupportExtendedInternal;
        ELSE
            bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
        END_IF
        IF eStateInternal <> E_PatchStationState.Complete THEN eStateInternal := E_PatchStationState.Ready; END_IF
    ELSIF (eStateInternal <> E_PatchStationState.Complete) THEN
        IF bSupportRetractedInternal AND NOT bSupportExtendedInternal
            AND bVerticalUpReadyInternal AND NOT bVerticalDownReadyInternal THEN
            eStateInternal := E_PatchStationState.Ready;
        ELSE
            eStateInternal := E_PatchStationState.Homing;
            // Restore vertical clearance before retracting support.
            bVerticalUpRequestInternal := TRUE;
            IF bVerticalUpReadyInternal AND NOT bVerticalDownReadyInternal THEN
                bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
            END_IF
        END_IF
    END_IF
    sDiagnosticInternal := 'Patch: idle';
END_IF

tonSupportExtendTimeout(IN := (bSupervisionEnableInternal OR bStopRequestInternal)
    AND bSafetyOkInternal AND bSupportExtendRequestInternal AND NOT bSupportExtendedInternal,
    PT := tSupportMoveTimeout);
tonSupportRetractTimeout(IN := (bSupervisionEnableInternal OR bStopRequestInternal OR bHomeRequestInternal)
    AND bSafetyOkInternal AND NOT bSupportRetractedInternal
    AND (bSupportRetractRequestInternal OR (bHomeExecutionAllowedInternal AND (usiHomeStepInternal = 20))),
    PT := tSupportMoveTimeout);
IF tonSupportExtendTimeout.Q OR tonSupportRetractTimeout.Q THEN
    eStateInternal := E_PatchStationState.Fault;
    IF tonSupportExtendTimeout.Q THEN
        eSupportFaultInternal := E_SupportCylinderFault.ExtendTimeout;
        sDiagnosticInternal := 'Patch: support UP feedback timeout';
    ELSE
        eSupportFaultInternal := E_SupportCylinderFault.RetractTimeout;
        sDiagnosticInternal := 'Patch: support DOWN feedback timeout';
    END_IF
END_IF

bFaultInternal := (eStateInternal = E_PatchStationState.Fault);
IF bFaultInternal THEN
    bSupportExtendRequestInternal := FALSE;
    bSupportRetractRequestInternal := FALSE;
    bVerticalUpRequestInternal := FALSE;
    bVerticalDownRequestInternal := FALSE;
    bDriveRunRequestInternal := FALSE;
    bAirBlowRequestInternal := FALSE;
    stResultInternal.bValid := FALSE;
END_IF
IF NOT bVerticalUpReadyInternal OR bVerticalDownReadyInternal OR bFaultInternal THEN bHomeConfirmedInternal := FALSE; END_IF
bHomeInternal := bHomeConfirmedInternal AND bSupportRetractedInternal
    AND NOT bSupportExtendedInternal AND bVerticalUpReadyInternal AND NOT bVerticalDownReadyInternal AND NOT bFaultInternal;
bReadyInternal := bEnableInternal AND bSafetyOkInternal AND bCommissionedInternal
    AND ((eStateInternal = E_PatchStationState.Ready) OR (bManualModeInternal AND (eStateInternal = E_PatchStationState.Complete)))
    AND bSupportRetractedInternal AND NOT bSupportExtendedInternal
    AND (NOT bUseVerticalFeedbackInternal OR (bVerticalUpReadyInternal AND NOT bVerticalDownReadyInternal))
    AND bDriveStandstillInternal AND NOT bDriveBusyInternal AND NOT bDriveFaultInternal;
bBusyInternal := (eStateInternal = E_PatchStationState.Processing) OR bStopRequestInternal
    OR (eStateInternal = E_PatchStationState.Homing) OR bHomeRequestInternal;
bCompleteInternal := (eStateInternal = E_PatchStationState.Complete);
]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetResult" Id="{b33b0890-9093-422a-9f77-c58a31b7a42d}">
      <Declaration><![CDATA[METHOD PUBLIC GetResult : ST_ProcessResult
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetResult := stResultInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Home" Id="{a98cb97a-e8d1-4d1a-aebd-f94068da51f6}">
      <Declaration><![CDATA[METHOD PUBLIC Home
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[usiVerticalEstimatedPosition := 0;
bVerticalIndexReadyInternal := FALSE;
tonVerticalTimedUp(IN := FALSE);
tonVerticalTimedDown(IN := FALSE);
bDriveRunRequestInternal := FALSE;
bAirBlowRequestInternal := FALSE;
bVerticalDownRequestInternal := FALSE;
bFeedOnlyInternal := FALSE;
bPatchDetectedInternal := FALSE;
bPatchLeftSeenInternal := FALSE;
bPatchRightSeenInternal := FALSE;
bDriveMotionSeenInternal := FALSE;
tonFeed(IN := FALSE);
tonRelease(IN := FALSE);
tonVertical(IN := FALSE);
// Request a new Patch Dispensing HOME sequence.
// The sequence is executed in Cyclic() during Initialising.
//
// Step 10: Support DOWN - mandatory 300 ms valve pulse.
// Step 20: Wait for support retracted feedback.
// Step 30: Vertical UP - confirm Term19 Input9, with bounded timeout.
// Step 40: Confirm HOME completion.
//
// A new request always restarts the complete HOME sequence,
// even when the support is already retracted.

bHomeRequestInternal := TRUE;
bHomeConfirmedInternal := FALSE;
bHomeInternal := FALSE;

// Reset HOME sequence.
usiHomeStepInternal := 0;
bHomeExecutionAllowedInternal := FALSE;

// Clear movement requests.
bVerticalUpRequestInternal := FALSE;

// Reset legacy HOME pulse flags.
bHomePulseStartedInternal := FALSE;
bHomePulseCompletedInternal := FALSE;
bHomePulseResetPendingInternal := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialise" Id="{743255a3-43ef-4139-b99e-67a8da015efe}">
      <Declaration><![CDATA[METHOD PUBLIC Initialise]]></Declaration>
      <Implementation>
        <ST><![CDATA[usiVerticalEstimatedPosition := 0;
bVerticalIndexReadyInternal := FALSE;
tonVerticalTimedUp(IN := FALSE);
tonVerticalTimedDown(IN := FALSE);
bDriveRunRequestInternal := FALSE;
bAirBlowRequestInternal := FALSE;
bVerticalDownRequestInternal := FALSE;
bFeedOnlyInternal := FALSE;
bPatchDetectedInternal := FALSE;
bPatchLeftSeenInternal := FALSE;
bPatchRightSeenInternal := FALSE;
bDriveMotionSeenInternal := FALSE;
tonFeed(IN := FALSE);
tonRelease(IN := FALSE);
tonVertical(IN := FALSE);

tonProcessSimulation(IN := FALSE);
tonSupportExtendTimeout(IN := FALSE);
tonSupportRetractTimeout(IN := FALSE);
eSupportFaultInternal := E_SupportCylinderFault.None;
eStateInternal := E_PatchStationState.Disabled;
usiStepInternal := 0;
bHomeInternal := FALSE;
bReadyInternal := FALSE;
bBusyInternal := FALSE;
bCompleteInternal := FALSE;
bFaultInternal := FALSE;
bSupportExtendRequestInternal := FALSE;
bSupportRetractRequestInternal := FALSE;
bStopRequestInternal := FALSE;
sDiagnosticInternal := '';

stResultInternal.bValid := FALSE;
stResultInternal.bPassed := FALSE;
stResultInternal.eCode := E_ProcessResultCode.None;
stResultInternal.udiFaultCode := 0;
stResultInternal.udiAlertCode := 0;
stResultInternal.sDetail := '';
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsBusy" Id="{6871d8d9-5930-4615-b534-4b63e1df8d23}">
      <Declaration><![CDATA[METHOD PUBLIC IsBusy : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsBusy := bBusyInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsDone" Id="{1191cf58-408d-41d1-a829-9111eee2f26c}">
      <Declaration><![CDATA[METHOD PUBLIC IsDone : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsDone := bCompleteInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsFaulted" Id="{bd6f3c62-386f-4e4e-8bc8-cb049b9869e5}">
      <Declaration><![CDATA[METHOD PUBLIC IsFaulted : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsFaulted := bFaultInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsHome" Id="{8f750aa1-e0db-4cfc-b383-81a631f39cb6}">
      <Declaration><![CDATA[METHOD IsHome : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// TRUE only after the requested HOME sequence is completed
// and the available support feedbacks are valid.
//
// FUTURE IMPLEMENTATION:
// Include all remaining station HOME feedbacks.

IsHome :=
    bHomeConfirmedInternal
    AND bSupportRetractedInternal
    AND NOT bSupportExtendedInternal
    AND NOT bFaultInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsReady" Id="{b47de1d3-46cd-40ee-afff-fef3adf2adda}">
      <Declaration><![CDATA[METHOD PUBLIC IsReady : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsReady := bReadyInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestReset" Id="{f3acbf00-1e76-4916-95e1-b6d9656859e8}">
      <Declaration><![CDATA[METHOD PUBLIC RequestReset
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[usiVerticalEstimatedPosition := 0;
bVerticalIndexReadyInternal := FALSE;
tonVerticalTimedUp(IN := FALSE);
tonVerticalTimedDown(IN := FALSE);
bDriveRunRequestInternal := FALSE;
bAirBlowRequestInternal := FALSE;
bVerticalDownRequestInternal := FALSE;
bFeedOnlyInternal := FALSE;
bPatchDetectedInternal := FALSE;
bPatchLeftSeenInternal := FALSE;
bPatchRightSeenInternal := FALSE;
bDriveMotionSeenInternal := FALSE;
tonFeed(IN := FALSE);
tonRelease(IN := FALSE);
tonVertical(IN := FALSE);

tonProcessSimulation(IN := FALSE);
tonSupportExtendTimeout(IN := FALSE);
tonSupportRetractTimeout(IN := FALSE);
eSupportFaultInternal := E_SupportCylinderFault.None;
bStopRequestInternal := FALSE;

stResultInternal.bValid := FALSE;
stResultInternal.bPassed := FALSE;
stResultInternal.eCode := E_ProcessResultCode.None;
stResultInternal.udiFaultCode := 0;
stResultInternal.udiAlertCode := 0;
stResultInternal.sDetail := '';

IF bEnableInternal AND bCommissionedInternal AND bSafetyOkInternal THEN
    IF bSupportRetractedInternal THEN
        eStateInternal := E_PatchStationState.Ready;
        usiStepInternal := 0;
    ELSE
        eStateInternal := E_PatchStationState.Homing;
        usiStepInternal := 30;
    END_IF
ELSE
    eStateInternal := E_PatchStationState.Disabled;
    usiStepInternal := 0;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestStart" Id="{25c812e0-7d98-48f5-a51a-d7b75e60a3d0}">
      <Declaration><![CDATA[METHOD PUBLIC RequestStart : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
RequestStart := FALSE;

IF bEnableInternal
    AND bCommissionedInternal
    AND bSafetyOkInternal
    AND bReadyInternal
    AND bStartPermittedInternal
    AND NOT bStopRequestInternal
    AND NOT bDriveFaultInternal
    AND bSupportRetractedInternal
THEN
    bFeedOnlyInternal := FALSE;
    bPatchDetectedInternal := FALSE;
    bPatchLeftSeenInternal := FALSE;
    bPatchRightSeenInternal := FALSE;
    bDriveMotionSeenInternal := FALSE;
    stResultInternal.bValid := FALSE;
    stResultInternal.bPassed := FALSE;
    stResultInternal.eCode := E_ProcessResultCode.None;
    stResultInternal.sDetail := '';

    eStateInternal := E_PatchStationState.Processing;
    usiStepInternal := 10;
    RequestStart := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestStop" Id="{18d6d99c-699b-4344-b667-37fee902e851}">
      <Declaration><![CDATA[METHOD PUBLIC RequestStop
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[bStopRequestInternal := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Update" Id="{f6ee0503-c772-4ebc-a880-089dbece365c}">
      <Declaration><![CDATA[METHOD PUBLIC Update
VAR_INPUT
    stProcessSettings : ST_PatchProcessSettings;
    bRunSequenceRequest : BOOL;
    bFeedOnlyRequest : BOOL;
    bStartPermitted : BOOL;
    bHoldUpRequired : BOOL;
    bPatchOpticalLeft : BOOL;
    bUseVerticalFeedback : BOOL;
    tVerticalMoveTime : TIME;
    bVerticalUpCommand : BOOL;
    bVerticalDownCommand : BOOL;
    bVerticalUp : BOOL;
    bVerticalDown : BOOL;
    bDriveStandstill : BOOL;
    bDriveBusy : BOOL;
    bDriveMoving : BOOL;
    bDriveFault : BOOL;
    bEnable           : BOOL;
    bCommissioned     : BOOL;
    bSafetyOk         : BOOL;
    bSupervisionEnable : BOOL;
    bReset            : BOOL;
    bSupportRetracted : BOOL;
    bSupportExtended  : BOOL;
    tSupportTimeout   : TIME;
	bManualMode 		: BOOL;
	bManualSupportExtendDesired : BOOL;
	bHomingAllowed : BOOL;
    bPatchOpticalRight : BOOL;
END_VAR
VAR_OUTPUT
    bVerticalIndexReady : BOOL;
    bDriveRunRequest : BOOL;
    bAirBlowRequest : BOOL;
    bVerticalDownRequest : BOOL;
    stStatus               : ST_PatchStageStatus;
    bSupportExtendRequest  : BOOL;
    bSupportRetractRequest : BOOL;
	bVerticalUpRequest 		: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stProcessSettingsInternal := stProcessSettings;

bEnableInternal := bEnable;
bManualModeInternal := bManualMode;
bManualSupportExtendDesiredInternal := bManualSupportExtendDesired;
bCommissionedInternal := bCommissioned;
bSafetyOkInternal := bSafetyOk;
bHomingAllowedInternal := bHomingAllowed;
bSupervisionEnableInternal := bSupervisionEnable;
bSupportRetractedInternal := bSupportRetracted;
bSupportExtendedInternal := bSupportExtended;
tSupportMoveTimeout := tSupportTimeout;

bStartPermittedInternal := bStartPermitted;
bHoldUpRequiredInternal := bHoldUpRequired;
bPatchOpticalLeftInternal := bPatchOpticalLeft;
bPatchOpticalRightInternal := bPatchOpticalRight;
bUseVerticalFeedbackInternal := bUseVerticalFeedback;
tVerticalMoveTimeInternal := tVerticalMoveTime;
bVerticalUpCommandInternal := bVerticalUpCommand;
bVerticalDownCommandInternal := bVerticalDownCommand;
bVerticalUpInternal := bVerticalUp; // Raw Input9; never forced by timed commissioning mode.
bVerticalDownInternal := bVerticalDown;
bDriveStandstillInternal := bDriveStandstill;
bDriveBusyInternal := bDriveBusy;
bDriveMovingInternal := bDriveMoving;
bDriveFaultInternal := bDriveFault;
rtFullSequence(CLK := bRunSequenceRequest);
rtFeedOnly(CLK := bFeedOnlyRequest);
IF bReset THEN
    RequestReset();
END_IF

// Commands are accepted only at stable/locked index, with no conflicting manual action.
IF bManualModeInternal AND bStartPermittedInternal AND NOT bReset THEN
    IF rtFullSequence.Q THEN
        RequestStart();
    ELSIF rtFeedOnly.Q AND bEnableInternal AND bCommissionedInternal AND bSafetyOkInternal
        AND NOT bBusyInternal AND NOT bFaultInternal AND NOT bStopRequestInternal
        AND ((bUseVerticalFeedbackInternal AND bVerticalUpInternal AND NOT bVerticalDownInternal)
            OR (NOT bUseVerticalFeedbackInternal AND bVerticalUpReadyInternal AND NOT bVerticalDownReadyInternal))
        AND bDriveStandstillInternal AND NOT bDriveBusyInternal AND NOT bDriveFaultInternal THEN
        eStateInternal := E_PatchStationState.Processing;
        usiStepInternal := 20;
        bFeedOnlyInternal := TRUE;
        bPatchDetectedInternal := FALSE;
        bPatchLeftSeenInternal := FALSE;
        bPatchRightSeenInternal := FALSE;
        bDriveMotionSeenInternal := FALSE;
        stResultInternal.bValid := FALSE;
    END_IF
END_IF
Cyclic();
bVerticalIndexReady := bVerticalIndexReadyInternal;
bDriveRunRequest := bDriveRunRequestInternal;
bAirBlowRequest := bAirBlowRequestInternal;
bVerticalDownRequest := bVerticalDownRequestInternal;

stStatus.eState := eStateInternal;
stStatus.bCommissioned := bCommissionedInternal;
stStatus.bHome := bHomeInternal;
stStatus.bReady := bReadyInternal;
stStatus.bBusy := bBusyInternal;
stStatus.bComplete := bCompleteInternal;
stStatus.bFault := bFaultInternal;
stStatus.eSupportFault := eSupportFaultInternal;
stStatus.sDiagnostic := sDiagnosticInternal;
IF NOT bUseVerticalFeedbackInternal THEN
    stStatus.sDiagnostic := CONCAT('TEMP timed vertical: ', sDiagnosticInternal);
END_IF

bSupportExtendRequest := bSupportExtendRequestInternal;
bSupportRetractRequest := bSupportRetractRequestInternal;
bVerticalUpRequest := bVerticalUpRequestInternal;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>