<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_VisionStation" Id="{da682161-7fdb-47e3-b49b-f4968c8b1f16}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_VisionStation IMPLEMENTS I_ProcessEquipment
VAR
    // Commissioning FAIL/fault injection; a real camera FAIL cannot be overridden.
    // FALSE = use the real camera verdicts (default)
    // TRUE  = inject FAIL after valid camera evaluation
    bSimulatedFail              : BOOL := FALSE;
    bSimulatedFault             : BOOL := FALSE;

    bEnableInternal             : BOOL;
    bCommissionedInternal       : BOOL;
    bSafetyOkInternal           : BOOL;
    bSupervisionEnableInternal  : BOOL;

    // Vision nest support feedback.
    bSupportRetractedInternal   : BOOL;
    bSupportExtendedInternal    : BOOL;

    // Vision / flipping tooling feedback.
    bHorizontalBackInternal     : BOOL;
    bHorizontalFrontInternal    : BOOL;
    bVerticalUpInternal         : BOOL;
    bVerticalDownInternal       : BOOL;
    bLimitOffInternal           : BOOL;
    bLimitOnInternal            : BOOL;
    bGripOpenedInternal         : BOOL;
    bGripClosedInternal         : BOOL;
    bRotate0Internal            : BOOL;
    bRotate180Internal          : BOOL;
    bRotate0RawInternal : BOOL;
    bRotate180RawInternal : BOOL;
    bCameraTriggerAcceptedInternal : BOOL;
    rtRotate0Raw : R_TRIG;
    tonFlipDeparture : TON;
    tFlipDepartureFilter : TIME := T#20MS;
    bFlipCaptureActive : BOOL;
    bFlipCaptureActivePrevious : BOOL;
    bFlipStart0Confirmed : BOOL;
    bFlipLeft0 : BOOL;
    bFlip90Seen : BOOL;
    bFlipTriggerLatched : BOOL;
    bFlipCaptureAccepted : BOOL;
    bFlipCaptureWindowMissed : BOOL;
	// Vision / Camera
	

    eStateInternal              : E_PatchStationState := E_PatchStationState.Disabled;
    usiStepInternal             : USINT := 0;
    bHomeInternal               : BOOL;
    bReadyInternal              : BOOL;
    bBusyInternal               : BOOL;
    bCompleteInternal           : BOOL;
    bFaultInternal              : BOOL;
    sDiagnosticInternal         : STRING(120);

    // Output requests.
    bSupportExtendRequestInternal   : BOOL;
    bSupportRetractRequestInternal  : BOOL;
    bHorizontalBackRequestInternal  : BOOL;
    bHorizontalFrontRequestInternal : BOOL;
    bVerticalUpRequestInternal      : BOOL;
    bVerticalDownRequestInternal    : BOOL;
    bLimitOffRequestInternal        : BOOL;
    bLimitOnRequestInternal         : BOOL;
    bGripCloseRequestInternal       : BOOL;
    bGripOpenRequestInternal        : BOOL;
    bRotate0RequestInternal         : BOOL;
    bRotate180RequestInternal       : BOOL;
	
	bTriggerRequestInternal			: BOOL;
	bChangeProgramRequestInternal	: BOOL;
	bGetResultsRequestInternal		: BOOL;
	bResetResultsRequestInternal	: BOOL;
	nSetProgramNumberInternal		: UDINT;
	bAcknowledgeResultsInternal		: BOOL;
	
	nCurrentProgramNumberInternal	: UDINT;
	bCameraResultsReadyInternal		: BOOL;
	nVisionResultsInternal			: ST_VisionResults;

    bStopRequestInternal        : BOOL;
    eSupportFaultInternal       : E_SupportCylinderFault := E_SupportCylinderFault.None;

    // Commissioning timing.
    tonStepDelay                : TON;
    tonRotate180Hold            : TON;
    tonMoveTimeout              : TON;
    tonSupportExtendTimeout     : TON;
    tonSupportRetractTimeout    : TON;
    tonToolingSensorConflict    : TON;
	tonIntermediatePosition 	: TON;
	tonChangeProgram			: TON := (PT := T#1S);

    tStepDelay                  : TIME := T#100MS;
    tRotate180Hold              : TIME := T#1S;
    tMoveTimeout                : TIME := T#30S;
    tSupportMoveTimeout         : TIME := T#5S;
    tToolingSensorConflict      : TIME := T#300MS;
	tIntermediatePosition 		: TIME := T#200MS;
	tTakingPictureWHileRotating	: TIME := T#100MS; // Delay AFTER the latched 90-degree marker; commission for the desired image.
	tDelayInspectionPlaceHolder	: TIME;

    bStepTargetReached          : BOOL;
    bToolingSensorConflict      : BOOL;
	
	rTrigger						: R_TRIG;
	tonCamera110Rearm             : TON;
	tonCameraTriggerDelay			: ARRAY [1..2] OF TON;
	tonTakingPictureWHileRotating	: TON;
	tonDelayInspectionPlaceHolder	: TON;

    stEmptyVisionResults        : ST_VisionResults;
    stResultInternal            : ST_ProcessResult;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cyclic" Id="{65862579-9f61-4da1-8e48-a04cc629adc5}">
      <Declaration><![CDATA[METHOD PUBLIC Cyclic
VAR_INPUT
END_VAR
VAR
	
	

END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Marker tracking uses raw feedback; endpoint qualification is independent.
rtRotate0Raw(CLK := bRotate0RawInternal);
bFlipCaptureActive := bEnableInternal AND bCommissionedInternal AND bSafetyOkInternal
    AND NOT bStopRequestInternal
    AND (eStateInternal = E_PatchStationState.Processing) AND (usiStepInternal = 100);
IF NOT bFlipCaptureActive THEN
    bFlipStart0Confirmed := FALSE;
    bFlipLeft0 := FALSE;
    bFlip90Seen := FALSE;
    bFlipTriggerLatched := FALSE;
    bFlipCaptureAccepted := FALSE;
    bFlipCaptureWindowMissed := FALSE;
ELSIF NOT bFlipCaptureActivePrevious THEN
    bFlipStart0Confirmed := bRotate0Internal AND NOT bRotate180RawInternal;
    bFlipLeft0 := FALSE;
    bFlip90Seen := FALSE;
    bFlipTriggerLatched := FALSE;
    bFlipCaptureAccepted := FALSE;
    bFlipCaptureWindowMissed := NOT bFlipStart0Confirmed;
END_IF
tonFlipDeparture(IN := bFlipCaptureActive AND bFlipStart0Confirmed AND NOT bFlipLeft0
    AND NOT bRotate0RawInternal AND NOT bRotate180RawInternal, PT := tFlipDepartureFilter);
IF tonFlipDeparture.Q THEN bFlipLeft0 := TRUE; END_IF
IF bFlipCaptureActive AND bFlipLeft0 AND rtRotate0Raw.Q
    AND NOT bFlip90Seen AND NOT bRotate180RawInternal THEN
    bFlip90Seen := TRUE;
END_IF
tonTakingPictureWHileRotating(IN := bFlipCaptureActive AND bFlip90Seen,
    PT := tTakingPictureWHileRotating);
IF bFlipCaptureActive THEN
    IF bFlipTriggerLatched AND bCameraTriggerAcceptedInternal THEN bFlipCaptureAccepted := TRUE; END_IF
    IF bRotate180RawInternal AND NOT bFlipCaptureAccepted THEN
        bFlipCaptureWindowMissed := TRUE;
    ELSIF tonTakingPictureWHileRotating.Q AND NOT bFlipTriggerLatched
        AND NOT bFlipCaptureWindowMissed THEN
        IF nCurrentProgramNumberInternal = 1 THEN
            bFlipTriggerLatched := TRUE;
        ELSE
            bFlipCaptureWindowMissed := TRUE;
        END_IF
    END_IF
END_IF
bFlipCaptureActivePrevious := bFlipCaptureActive;

// Rearm inspection 2 after entry and confirmed program selection.
tonCamera110Rearm(
    IN := (eStateInternal = E_PatchStationState.Processing)
        AND (usiStepInternal = 110)
        AND (nCurrentProgramNumberInternal = 2)
        AND NOT tonCameraTriggerDelay[1].IN
        AND NOT tonCameraTriggerDelay[2].IN,
    PT := T#500MS
);

bTriggerRequestInternal :=
    (eStateInternal = E_PatchStationState.Processing)
    AND (
        ((usiStepInternal = 100) AND (nCurrentProgramNumberInternal = 1)
            AND bFlipTriggerLatched AND NOT bFlipCaptureWindowMissed)
        OR ((usiStepInternal = 10) AND (nCurrentProgramNumberInternal = 0))
        OR ((usiStepInternal = 110) AND tonCamera110Rearm.Q)
        OR ((usiStepInternal = 180) AND (nCurrentProgramNumberInternal = 3))
    );
bGetResultsRequestInternal := FALSE;
bAcknowledgeResultsInternal := FALSE;
bChangeProgramRequestInternal := FALSE;
tonCameraTriggerDelay[1](PT := T#500MS);
tonCameraTriggerDelay[2](PT := T#500MS);
tonDelayInspectionPlaceHolder(PT := tDelayInspectionPlaceHolder);

 // ============================================================================
 // Vision Station / Flipping sequence
 // ============================================================================
 // Home:
 //   Nest DOWN, grip 0 deg, grip OPEN, vertical UP,
 //   vertical limit OFF, horizontal slide BACK.
 //
 // Process (active mechanical steps and camera inspections):
 //
 //   10  1st Vision Inspection - Program 0
 //   20  Nest UP and open grippers
 //   30  Vertical FULL DOWN - pick
 //   40  Grip CLOSE
 //   50  Vertical UP
 //   60  Horizontal FRONT
 //   70  Vertical INTERMEDIATE
 //   80  Vertical UP before flip
 //   90  Nest DOWN before flip                       // FIX: separated from Step 70
 //   100  Rotate 180; timed Program 1 capture and result acquisition
 //   110  3rd Vision Inspection - Program 2
 //  120  Rotate back to 0                            // FIX: nest remains DOWN
 //  130  Nest UP after rotation                      // FIX: separated from Step 100
 //  140  Vertical INTERMEDIATE - replace part
 //  150  Grip OPEN - release part
 //  160  Vertical UP after release
 //  170  Return tooling HOME
 //  180  4th Vision Inspection - Program 3
 //  190  Aggregate four camera verdicts, then Complete


// ============================================================================
// DEFAULT REQUESTS
// ============================================================================

// Default all requests OFF. Each active state below explicitly builds the
// desired command state and never energises opposing coils simultaneously.
bSupportExtendRequestInternal := FALSE;
bSupportRetractRequestInternal := FALSE;
bHorizontalBackRequestInternal := FALSE;
bHorizontalFrontRequestInternal := FALSE;
bVerticalUpRequestInternal := FALSE;
bVerticalDownRequestInternal := FALSE;
bLimitOffRequestInternal := FALSE;
bLimitOnRequestInternal := FALSE;
bGripCloseRequestInternal := FALSE;
bGripOpenRequestInternal := FALSE;
bRotate0RequestInternal := FALSE;
bRotate180RequestInternal := FALSE;

//bStepTargetReached := FALSE;
bFaultInternal := FALSE;


// ============================================================================
// HOME FEEDBACK
// ============================================================================

bHomeInternal :=
    bSupportRetractedInternal
    AND NOT bSupportExtendedInternal
    AND bHorizontalBackInternal
    AND NOT bHorizontalFrontInternal
    AND bVerticalUpInternal
    AND NOT bVerticalDownInternal
    AND NOT bLimitOnInternal
    AND bLimitOffInternal
    AND bGripOpenedInternal
    AND NOT bGripClosedInternal
    AND bRotate0Internal
    AND NOT bRotate180Internal;


// ============================================================================
// TOOLING SENSOR PLAUSIBILITY
// ============================================================================

bToolingSensorConflict :=
    (bSupportRetractedInternal AND bSupportExtendedInternal)
    OR (bHorizontalBackInternal AND bHorizontalFrontInternal)
    OR (bVerticalUpInternal AND bVerticalDownInternal)
    OR (bLimitOffInternal AND bLimitOnInternal)
    OR (bGripOpenedInternal AND bGripClosedInternal)
    OR (bRotate0RawInternal AND bRotate180RawInternal);

// End-position sensors can overlap briefly during pneumatic transitions.
// Only treat contradictory feedback as a real fault when it persists.
tonToolingSensorConflict(
    IN := bSupervisionEnableInternal
        AND bSafetyOkInternal
        AND bToolingSensorConflict,
    PT := tToolingSensorConflict
);


// ============================================================================
// MAIN STATE CONTROL
// ============================================================================

IF bEnableInternal AND bSimulatedFault THEN

    eStateInternal := E_PatchStationState.Fault;
    usiStepInternal := 0;
    sDiagnosticInternal := 'Vision: simulated station fault';


ELSIF bFlipCaptureWindowMissed THEN
    eStateInternal := E_PatchStationState.Fault;
    usiStepInternal := 0;
    bTriggerRequestInternal := FALSE;
    sDiagnosticInternal := 'Vision: rotation reference or moving-image window missed';
    stResultInternal.bValid := TRUE;
    stResultInternal.bPassed := FALSE;
    stResultInternal.eCode := E_ProcessResultCode.Fail;
    stResultInternal.udiFaultCode := 12;
    stResultInternal.udiAlertCode := 0;
    stResultInternal.sDetail := sDiagnosticInternal;

ELSIF tonToolingSensorConflict.Q THEN

    eStateInternal := E_PatchStationState.Fault;
    usiStepInternal := 0;
    sDiagnosticInternal := 'Vision: contradictory tooling sensors';


ELSIF bFaultInternal THEN

    // Fault state handled below.


ELSIF bStopRequestInternal THEN

    // Controlled station stop: start one deterministic return-to-home sequence.
    // Clear the request here so the homing step counter is not reset every scan.
    eStateInternal := E_PatchStationState.Homing;
    usiStepInternal := 0;
    bStopRequestInternal := FALSE;


ELSIF NOT bCommissionedInternal THEN

    eStateInternal := E_PatchStationState.Disabled;
    usiStepInternal := 0;
    sDiagnosticInternal := 'Vision: station disabled';


ELSIF NOT bSafetyOkInternal THEN

    eStateInternal := E_PatchStationState.Disabled;
    usiStepInternal := 0;
    sDiagnosticInternal := 'Vision: disabled by Safety';


ELSIF NOT bEnableInternal THEN

    IF bHomeInternal THEN

        eStateInternal := E_PatchStationState.Disabled;
        usiStepInternal := 0;
        sDiagnosticInternal := 'Vision: disabled - tooling home';

    ELSE

        eStateInternal := E_PatchStationState.Homing;
        usiStepInternal := 0;
        sDiagnosticInternal := 'Vision: disabled - returning tooling home';

    END_IF


ELSE

    CASE eStateInternal OF


        // ====================================================================
        // DISABLED / HOMING
        // ====================================================================

        E_PatchStationState.Disabled,
        E_PatchStationState.Homing:

            // Deterministic / collision-conscious home sequence used by
            // System Initialising and controlled station recovery.
            //
			// Defined HOME:
			//   Nest DOWN, vertical UP, rotation 0 deg, grip OPEN,
			//   vertical limit OFF, horizontal slide BACK.

            // Request program 0 during homing; mechanical Ready still does not confirm camera Ready.
            
			//Leaving camera with the right program to performance first test--------------------------
			
			IF nCurrentProgramNumberInternal<> 0 THEN
				
				nSetProgramNumberInternal				:= 0;
				bChangeProgramRequestInternal			:= TRUE;
				
			ELSIF nCurrentProgramNumberInternal = 0 THEN
				
				bChangeProgramRequestInternal			:= FALSE;
				
			END_IF
			

            
			//-------------------------------------------------------------------------------------------
            IF usiStepInternal = 0 THEN

                IF bHomeInternal THEN
                    usiStepInternal := 70;
                ELSE
                    usiStepInternal := 10;
                END_IF

            END_IF


            CASE usiStepInternal OF
			

				10: // Vertical UP

                    bVerticalUpRequestInternal := NOT bVerticalUpInternal;

                    bStepTargetReached :=
                        bVerticalUpInternal
                        AND NOT bVerticalDownInternal;

                    sDiagnosticInternal := 'Vision homing: vertical UP';


                20: // Nest DOWN / support retracted

                    bVerticalUpRequestInternal := NOT bVerticalUpInternal;
                    bSupportRetractRequestInternal := NOT bSupportRetractedInternal;

                    bStepTargetReached :=
                        bSupportRetractedInternal
                        AND NOT bSupportExtendedInternal;

                    sDiagnosticInternal := 'Vision homing: nest support DOWN';


                30: // Rotate gripper to 0 deg

                    bVerticalUpRequestInternal := NOT bVerticalUpInternal;
                    bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
                    bRotate0RequestInternal := NOT bRotate0Internal;

                    bStepTargetReached :=
                        bRotate0Internal
                        AND NOT bRotate180Internal;

                    sDiagnosticInternal := 'Vision homing: rotate grip to 0 deg';


                40: // Grip OPEN

                    bVerticalUpRequestInternal := NOT bVerticalUpInternal;
                    bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
                    bRotate0RequestInternal := NOT bRotate0Internal;
                    bGripOpenRequestInternal := NOT bGripOpenedInternal;

                    bStepTargetReached :=
                        bGripOpenedInternal
                        AND NOT bGripClosedInternal;

                    sDiagnosticInternal := 'Vision homing: grip OPEN';


				50: // Vertical limit OFF
				
					bVerticalUpRequestInternal := NOT bVerticalUpInternal;
					bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
					bRotate0RequestInternal := NOT bRotate0Internal;
					bGripOpenRequestInternal := NOT bGripOpenedInternal;
				
					bLimitOnRequestInternal := FALSE;
					bLimitOffRequestInternal := NOT bLimitOffInternal;
				
					bStepTargetReached :=
						bLimitOffInternal
						AND NOT bLimitOnInternal;
				
					sDiagnosticInternal := 'Vision homing: vertical limit OFF';


                60: // Horizontal slide BACK

                    bVerticalUpRequestInternal := NOT bVerticalUpInternal;
                    bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
                    bRotate0RequestInternal := NOT bRotate0Internal;
                    bGripOpenRequestInternal := NOT bGripOpenedInternal;

                    bLimitOnRequestInternal := FALSE;
					bLimitOffRequestInternal := NOT bLimitOffInternal;

                    bHorizontalBackRequestInternal := NOT bHorizontalBackInternal;

                    bStepTargetReached :=
                        bHorizontalBackInternal
                        AND NOT bHorizontalFrontInternal;

                    sDiagnosticInternal := 'Vision homing: horizontal slide BACK';


                70: // Verify complete HOME before declaring Ready

                    bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
                    bHorizontalBackRequestInternal := NOT bHorizontalBackInternal;
                    bVerticalUpRequestInternal := NOT bVerticalUpInternal;

					bLimitOnRequestInternal := FALSE;
					bLimitOffRequestInternal := NOT bLimitOffInternal;

                    bGripOpenRequestInternal := NOT bGripOpenedInternal;
                    bRotate0RequestInternal := NOT bRotate0Internal;

                    // Modified by Thays - TEMPORARY: verify mechanical HOME without requiring Keyence program 0.
                    // bStepTargetReached := bHomeInternal AND (nCurrentProgramNumberInternal = 0);
                    bStepTargetReached := bHomeInternal;

                    sDiagnosticInternal := 'Vision homing: verifying HOME';
					

                ELSE

                    usiStepInternal := 10;
                    bStepTargetReached := FALSE;

            END_CASE


            tonStepDelay(
                IN := bStepTargetReached,
                PT := tStepDelay
            );

            tonMoveTimeout(
                IN := NOT bStepTargetReached,
                PT := tMoveTimeout
            );


            // ================================================================
            // HOMING TIMEOUT SUPERVISION
            // ================================================================

            IF tonMoveTimeout.Q THEN

                tonMoveTimeout(IN := FALSE);
                tonStepDelay(IN := FALSE);

                eStateInternal := E_PatchStationState.Fault;
                usiStepInternal := 0;

                sDiagnosticInternal := 'Vision: homing movement timeout';

                stResultInternal.bValid := TRUE;
                stResultInternal.bPassed := FALSE;
                stResultInternal.eCode := E_ProcessResultCode.Fail;
                stResultInternal.udiFaultCode := 11;
                stResultInternal.udiAlertCode := 0;
                stResultInternal.sDetail := 'Vision homing movement timeout';


            ELSIF tonStepDelay.Q THEN

                tonMoveTimeout(IN := FALSE);
                tonStepDelay(IN := FALSE);

                IF usiStepInternal < 70 THEN

                    usiStepInternal := usiStepInternal + 10;

                ELSE

                    eStateInternal := E_PatchStationState.Ready;
                    usiStepInternal := 0;
                    sDiagnosticInternal := 'Vision: ready - tooling home';
					bStepTargetReached					:= FALSE;

                END_IF

            END_IF


        // ====================================================================
        // READY
        // ====================================================================

        E_PatchStationState.Ready:

            // Reset can enter Ready directly when tooling is already home.
            // Restore the camera independently of the mechanical homing path.
            IF nCurrentProgramNumberInternal <> 0 THEN
                nSetProgramNumberInternal := 0;
                bChangeProgramRequestInternal := TRUE;
            END_IF

            tonStepDelay(IN := FALSE);
            tonRotate180Hold(IN := FALSE);
            tonMoveTimeout(IN := FALSE);

            // Hold/restore the defined HOME position.
            bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
            bHorizontalBackRequestInternal := NOT bHorizontalBackInternal;
            bVerticalUpRequestInternal := NOT bVerticalUpInternal;

			bLimitOnRequestInternal := FALSE;
			bLimitOffRequestInternal := NOT bLimitOffInternal;

            bGripOpenRequestInternal := NOT bGripOpenedInternal;
            bRotate0RequestInternal := NOT bRotate0Internal;

            IF NOT bHomeInternal THEN

                eStateInternal := E_PatchStationState.Homing;
                sDiagnosticInternal := 'Vision: lost home - recovering';

            ELSE

                sDiagnosticInternal := 'Vision: ready - waiting for cycle start';

            END_IF


        // ====================================================================
        // PROCESSING
        // ====================================================================

        E_PatchStationState.Processing:

            // Each scan must prove completion of the active step.
            bStepTargetReached := FALSE;

            CASE usiStepInternal OF


				// ------------------------------------------------------------
                // STEP 10 - CAMERA PROGRAM 0 - FIRST INSPECTION
                // ------------------------------------------------------------
				10:
                    // Acquire program 0, then confirm the change to program 1.
                    // Recover an interrupted cycle before accepting the first result.
                    // Once acquisition/program-1 change starts, do not request 0 again.
                    IF (nCurrentProgramNumberInternal <> 0)
                        AND NOT tonCameraTriggerDelay[1].IN
                        AND NOT tonCameraTriggerDelay[2].IN
                    THEN
                        nSetProgramNumberInternal := 0;
                        bChangeProgramRequestInternal := TRUE;
                    END_IF

                    
					
					
					IF (nCurrentProgramNumberInternal = 0)
                        AND bCameraResultsReadyInternal AND NOT tonCameraTriggerDelay[2].IN THEN
						
						bGetResultsRequestInternal			:= TRUE;
						bAcknowledgeResultsInternal			:= TRUE;
						tonCameraTriggerDelay[1].IN			:= TRUE;
						
						
					END_IF
					
					IF tonCameraTriggerDelay[1].Q THEN
							
							bGetResultsRequestInternal			:= FALSE;
							bAcknowledgeResultsInternal			:= FALSE;
							nSetProgramNumberInternal			:= 1;
							bChangeProgramRequestInternal		:= TRUE;
							tonCameraTriggerDelay[2].IN			:= TRUE;
							tonCameraTriggerDelay[1].IN			:= FALSE;
							
							
					END_IF
					// Hold program selection until the camera reports the requested program.
                    IF tonCameraTriggerDelay[2].IN THEN
                        nSetProgramNumberInternal := 1;
                        bChangeProgramRequestInternal := (nCurrentProgramNumberInternal <> 1);
                    END_IF
                    IF tonCameraTriggerDelay[2].Q AND (nCurrentProgramNumberInternal = 1) THEN
							
							
							bChangeProgramRequestInternal		:= FALSE;
							bStepTargetReached					:= TRUE;
                            // Keep delay 2 complete until this step advances.
							
							
					END_IF
						
                    sDiagnosticInternal := 'Vision: Camera first inspection ';
					

                // ------------------------------------------------------------
                // STEP 20 - NEST UP AND OPEN GRIPPERS
                // ------------------------------------------------------------

                20:

                    bSupportExtendRequestInternal := NOT bSupportExtendedInternal;
                    bHorizontalBackRequestInternal := NOT bHorizontalBackInternal;
                    bVerticalUpRequestInternal := NOT bVerticalUpInternal;

                    // Keep intermediate stop ON before the pick movement.
                    bLimitOffRequestInternal := FALSE;
                    bLimitOnRequestInternal := NOT bLimitOnInternal;

                    bGripOpenRequestInternal := NOT bGripOpenedInternal;
                    bRotate0RequestInternal := NOT bRotate0Internal;

                    bStepTargetReached := bSupportExtendedInternal;

                    sDiagnosticInternal := 'Vision: nest support UP and Open grippers ';


                // ------------------------------------------------------------
                // STEP 30 - FULL VERTICAL DOWN FOR PICK
                // ------------------------------------------------------------

                30:

                    bSupportExtendRequestInternal := NOT bSupportExtendedInternal;
                    bHorizontalBackRequestInternal := NOT bHorizontalBackInternal;

                    // Retract the intermediate stop to allow FULL DOWN.
                    // Coil4 = Limit OFF.
                    // Coil5 = OFF.
                    bLimitOffRequestInternal := TRUE;
                    bLimitOnRequestInternal := FALSE;

                    bVerticalDownRequestInternal := NOT bVerticalDownInternal;

                    bGripOpenRequestInternal := NOT bGripOpenedInternal;
                    bRotate0RequestInternal := NOT bRotate0Internal;

                    bStepTargetReached :=
                        bVerticalDownInternal
                        AND NOT bVerticalUpInternal
                        AND bLimitOffInternal
                        AND NOT bLimitOnInternal;

                    sDiagnosticInternal := 'Vision: vertical FULL DOWN - pick';


                // ------------------------------------------------------------
                // STEP 40 - GRIP CLOSE AT FULL DOWN
                // ------------------------------------------------------------

                40:

                    bSupportExtendRequestInternal := NOT bSupportExtendedInternal;
                    bHorizontalBackRequestInternal := NOT bHorizontalBackInternal;

                    // Keep stop retracted while gripping at FULL DOWN.
                    bLimitOffRequestInternal := TRUE;
                    bLimitOnRequestInternal := FALSE;

                    bVerticalDownRequestInternal := NOT bVerticalDownInternal;

                    bGripCloseRequestInternal := NOT bGripClosedInternal;
                    bRotate0RequestInternal := NOT bRotate0Internal;

                    bStepTargetReached :=
                        bGripClosedInternal
                        AND NOT bGripOpenedInternal;

                    sDiagnosticInternal := 'Vision: grip CLOSE at full DOWN';


                // ------------------------------------------------------------
                // STEP 50 - VERTICAL UP
                // ------------------------------------------------------------

                50:

                    bSupportExtendRequestInternal := NOT bSupportExtendedInternal;
                    bHorizontalBackRequestInternal := NOT bHorizontalBackInternal;
                    bVerticalUpRequestInternal := NOT bVerticalUpInternal;

                    // Keep stop retracted until vertical is safely UP.
                    bLimitOffRequestInternal := TRUE;
                    bLimitOnRequestInternal := FALSE;

                    bGripCloseRequestInternal := NOT bGripClosedInternal;
                    bRotate0RequestInternal := NOT bRotate0Internal;

                    bStepTargetReached :=
                        bVerticalUpInternal
                        AND NOT bVerticalDownInternal;

                    sDiagnosticInternal := 'Vision: vertical UP with part';


                // ------------------------------------------------------------
                // STEP 60 - HORIZONTAL FRONT
                // ------------------------------------------------------------

                60:

                    bSupportExtendRequestInternal := NOT bSupportExtendedInternal;
                    bHorizontalFrontRequestInternal := NOT bHorizontalFrontInternal;
                    bVerticalUpRequestInternal := NOT bVerticalUpInternal;

                    // Vertical is safely UP. Extend the intermediate stop
                    // before commanding the next DOWN movement.
                    bLimitOffRequestInternal := FALSE;
                    bLimitOnRequestInternal := NOT bLimitOnInternal;

                    bGripCloseRequestInternal := NOT bGripClosedInternal;
                    bRotate0RequestInternal := NOT bRotate0Internal;

                    bStepTargetReached :=
                        bHorizontalFrontInternal
                        AND NOT bHorizontalBackInternal
                        AND bLimitOnInternal
                        AND NOT bLimitOffInternal;

                    sDiagnosticInternal := 'Vision: horizontal FRONT - limit ON';


                // ------------------------------------------------------------
                // STEP 70 - VERTICAL INTERMEDIATE
                // ------------------------------------------------------------

                70:

                    bSupportExtendRequestInternal := NOT bSupportExtendedInternal;
                    bHorizontalFrontRequestInternal := NOT bHorizontalFrontInternal;

                    // Limit ON creates the mechanical stop for INTERMEDIATE.
                    bLimitOffRequestInternal := FALSE;
                    bLimitOnRequestInternal := NOT bLimitOnInternal;

                    // Keep DOWN command active while resting against the stop.
                    bVerticalDownRequestInternal := TRUE;

                    bGripCloseRequestInternal := NOT bGripClosedInternal;
                    bRotate0RequestInternal := NOT bRotate0Internal;

                    // There is no dedicated vertical INTERMEDIATE sensor.
                    // Intermediate is confirmed by:
                    //   Limit ON
                    //   Vertical UP = FALSE
                    //   Vertical DOWN = FALSE
                    // held stable for tIntermediatePosition.
                    tonIntermediatePosition(
                        IN := bLimitOnInternal
                            AND NOT bVerticalUpInternal
                            AND NOT bVerticalDownInternal,
                        PT := tIntermediatePosition
                    );

                    bStepTargetReached := tonIntermediatePosition.Q;

                    sDiagnosticInternal := 'Vision: vertical INTERMEDIATE at front';


                // ------------------------------------------------------------
                // STEP 80 - VERTICAL UP BEFORE FLIP
                // FIX: split vertical UP and support DOWN into separate steps.
                // ------------------------------------------------------------

                80:

                    bSupportExtendRequestInternal := NOT bSupportExtendedInternal;
                    bHorizontalFrontRequestInternal := NOT bHorizontalFrontInternal;
                    bVerticalUpRequestInternal := NOT bVerticalUpInternal;

                    // Keep intermediate stop ON.
                    bLimitOffRequestInternal := FALSE;
                    bLimitOnRequestInternal := NOT bLimitOnInternal;

                    bGripCloseRequestInternal := NOT bGripClosedInternal;
                    bRotate0RequestInternal := NOT bRotate0Internal;

                    // FIX: removed simultaneous retract request from Step 70.
                    // OLD: bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
                    // OLD: bStepTargetReached :=
                    //          (bVerticalUpInternal AND NOT bVerticalDownInternal)
                    //          AND (bSupportRetractedInternal AND NOT bSupportExtendedInternal);
                    bStepTargetReached :=
                        bVerticalUpInternal
                        AND NOT bVerticalDownInternal;

                    sDiagnosticInternal := 'Vision: vertical UP before flip';

                // ------------------------------------------------------------
                // STEP 90 - NEST SUPPORT DOWN BEFORE FLIP
                // FIX: retract support only after vertical UP is confirmed.
                // ------------------------------------------------------------

                90:

                    // FIX: support extension remains FALSE by default.
                    bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
                    bHorizontalFrontRequestInternal := NOT bHorizontalFrontInternal;
                    bVerticalUpRequestInternal := NOT bVerticalUpInternal;

                    bLimitOffRequestInternal := FALSE;
                    bLimitOnRequestInternal := NOT bLimitOnInternal;

                    bGripCloseRequestInternal := NOT bGripClosedInternal;
                    bRotate0RequestInternal := NOT bRotate0Internal;

                    bStepTargetReached :=
                        bSupportRetractedInternal
                        AND NOT bSupportExtendedInternal
                        AND bRotate0Internal AND NOT bRotate180Internal;

                    sDiagnosticInternal := 'Vision: nest support DOWN before flip';

                // ------------------------------------------------------------
                // STEP 100 - ROTATE 180 AND HOLD
                // ------------------------------------------------------------

                100: // Support retraction was confirmed in step 90.

					// Program 1 trigger now follows the first valid 90-degree marker.
                    bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
                    bHorizontalFrontRequestInternal := NOT bHorizontalFrontInternal;
                    bVerticalUpRequestInternal := NOT bVerticalUpInternal;

                    bLimitOffRequestInternal := FALSE;
                    bLimitOnRequestInternal := NOT bLimitOnInternal;

                    bGripCloseRequestInternal := NOT bGripClosedInternal;
                    bRotate180RequestInternal := NOT bRotate180Internal;

                    // Acquire program 1 before requesting program 2.
                    
					//Camera
					IF nCurrentProgramNumberInternal = 1 THEN
					
					IF bCameraResultsReadyInternal AND NOT tonCameraTriggerDelay[2].IN THEN
						
						bGetResultsRequestInternal			:= TRUE;
						bAcknowledgeResultsInternal			:= TRUE;
						tonCameraTriggerDelay[1].IN			:= TRUE;
						
						
					END_IF
					
					END_IF
					IF tonCameraTriggerDelay[1].Q THEN
							
							bGetResultsRequestInternal			:= FALSE;
							bAcknowledgeResultsInternal			:= FALSE;
							nSetProgramNumberInternal			:= 2;
							tonDelayInspectionPlaceHolder.IN	:= TRUE;
							bChangeProgramRequestInternal		:= TRUE;
							tonCameraTriggerDelay[2].IN			:= TRUE;
							tonCameraTriggerDelay[1].IN			:= FALSE;
							
							
					END_IF
					// Hold program selection until the camera reports the requested program.
                    IF tonCameraTriggerDelay[2].IN THEN
                        nSetProgramNumberInternal := 2;
                        bChangeProgramRequestInternal := (nCurrentProgramNumberInternal <> 2);
                    END_IF
                    IF tonCameraTriggerDelay[2].Q AND (nCurrentProgramNumberInternal = 2) THEN
							
							
							bChangeProgramRequestInternal		:= FALSE;

							
							
					END_IF
					// The moving-image delay is not restarted by the program-change placeholder.
					
					bStepTargetReached := tonDelayInspectionPlaceHolder.Q
                        AND (nCurrentProgramNumberInternal = 2)
                        AND bRotate180Internal AND NOT bRotate0Internal;
					
					                    
                    // Physical 180 completion is now qualified above before inspection 3.
                    //tonDelayInspectionPlaceHolder.IN := bRotate180Internal AND NOT bRotate0Internal;
                    //bStepTargetReached := bRotate180Internal AND NOT bRotate0Internal AND tonDelayInspectionPlaceHolder.Q;
                    sDiagnosticInternal := 'Vision: rotate 180, marker-based image 2';
				
                // Pending: accepted-trigger/fresh-result handshake and supervised visual inspection recovery.
        
				// ------------------------------------------------------------
                // STEP 110 - CAMERA PROGRAM 2 - THIRD INSPECTION
                // ------------------------------------------------------------
				
				110:
					tonDelayInspectionPlaceHolder.IN		:= FALSE;

                    // Acquire program 2 before requesting program 3.
                    
					IF nCurrentProgramNumberInternal = 2 THEN
					
					IF bCameraResultsReadyInternal AND NOT tonCameraTriggerDelay[2].IN THEN
						
						bGetResultsRequestInternal			:= TRUE;
						bAcknowledgeResultsInternal			:= TRUE;
						tonCameraTriggerDelay[1].IN			:= TRUE;
						
						
					END_IF
					END_IF
					
					IF tonCameraTriggerDelay[1].Q THEN
							
							bGetResultsRequestInternal			:= FALSE;
							bAcknowledgeResultsInternal			:= FALSE;
							nSetProgramNumberInternal			:= 3;
							bChangeProgramRequestInternal		:= TRUE;
							tonCameraTriggerDelay[2].IN			:= TRUE;
							tonCameraTriggerDelay[1].IN			:= FALSE;
							
							
					END_IF
					// Hold program selection until the camera reports the requested program.
                    IF tonCameraTriggerDelay[2].IN THEN
                        nSetProgramNumberInternal := 3;
                        bChangeProgramRequestInternal := (nCurrentProgramNumberInternal <> 3);
                    END_IF
                    IF tonCameraTriggerDelay[2].Q AND (nCurrentProgramNumberInternal = 3) THEN
							
							
							bChangeProgramRequestInternal		:= FALSE;
							bStepTargetReached					:= TRUE;
                            // Keep delay 2 complete until this step advances.
							
							
					END_IF
				
                    
                    //bStepTargetReached := TRUE; // Modified by Thays - no camera inspection result.

                // ------------------------------------------------------------
                // STEP 120 - ROTATE BACK TO 0
                // FIX: keep support DOWN until rotation is confirmed at 0 deg.
                // ------------------------------------------------------------

                120: 
					
                    bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
                    bHorizontalFrontRequestInternal := NOT bHorizontalFrontInternal;
                    bVerticalUpRequestInternal := NOT bVerticalUpInternal;

                    bLimitOffRequestInternal := FALSE;
                    bLimitOnRequestInternal := NOT bLimitOnInternal;

                    bGripCloseRequestInternal := NOT bGripClosedInternal;
                    bRotate0RequestInternal := NOT bRotate0Internal;

                    // FIX: previously Step 90 commanded support UP and DOWN
                    // simultaneously while rotating, conflicting with rotation permissive.
                    // OLD: bSupportExtendRequestInternal := NOT bSupportExtendedInternal;
                    // OLD: bStepTargetReached :=
                    //          (bRotate0Internal AND NOT bRotate180Internal)
                    //          AND (bSupportExtendedInternal AND NOT bSupportRetractedInternal)
                    //          (*AND bGetResultsReadyRequestInternal*);
                    bStepTargetReached :=
                        bRotate0Internal
                        AND NOT bRotate180Internal;

                    sDiagnosticInternal := 'Vision: rotate back to 0 with nest DOWN';

                // ------------------------------------------------------------
                // STEP 130 - NEST SUPPORT UP AFTER ROTATION
                // FIX: move support only after rotation to 0 deg is complete.
                // ------------------------------------------------------------
				
				
					

                130:

                    bSupportExtendRequestInternal := NOT bSupportExtendedInternal;
                    bHorizontalFrontRequestInternal := NOT bHorizontalFrontInternal;
                    bVerticalUpRequestInternal := NOT bVerticalUpInternal;

                    // Intermediate stop must remain ON for replace movement.
                    bLimitOffRequestInternal := FALSE;
                    bLimitOnRequestInternal := NOT bLimitOnInternal;

                    bGripCloseRequestInternal := NOT bGripClosedInternal;
                    // FIX: do not request rotation while the support is moving UP.
                    // OLD: bRotate0RequestInternal := NOT bRotate0Internal;

                    bStepTargetReached :=
                        bSupportExtendedInternal
                        AND NOT bSupportRetractedInternal;

                    sDiagnosticInternal := 'Vision: nest support UP after rotate 0';

                // Pending: accepted-trigger/fresh-result handshake and supervised visual inspection recovery.
				

                // ------------------------------------------------------------
                // STEP 140 - VERTICAL INTERMEDIATE FOR REPLACE
                // ------------------------------------------------------------

                140: // FIX: renumbered after separating support movements.

                    bSupportExtendRequestInternal := NOT bSupportExtendedInternal;
                    bHorizontalFrontRequestInternal := NOT bHorizontalFrontInternal;

                    // Limit ON creates the mechanical INTERMEDIATE position.
                    bLimitOffRequestInternal := FALSE;
                    bLimitOnRequestInternal := NOT bLimitOnInternal;

                    // Hold DOWN against the intermediate mechanical stop.
                    bVerticalDownRequestInternal := TRUE;

                    bGripCloseRequestInternal := NOT bGripClosedInternal;
                    bRotate0RequestInternal := NOT bRotate0Internal;

                    tonIntermediatePosition(
                        IN := bLimitOnInternal
                            AND NOT bVerticalUpInternal
                            AND NOT bVerticalDownInternal,
                        PT := tIntermediatePosition
                    );

                    bStepTargetReached := tonIntermediatePosition.Q;

                    sDiagnosticInternal := 'Vision: vertical INTERMEDIATE - replace part';


                // ------------------------------------------------------------
                // STEP 150 - GRIP OPEN AT INTERMEDIATE
                // ------------------------------------------------------------

                150: // FIX: renumbered after separating support movements.

                    bSupportExtendRequestInternal := NOT bSupportExtendedInternal;
                    bHorizontalFrontRequestInternal := NOT bHorizontalFrontInternal;

                    // Hold vertical against the intermediate stop.
                    bVerticalDownRequestInternal := TRUE;

                    bLimitOffRequestInternal := FALSE;
                    bLimitOnRequestInternal := NOT bLimitOnInternal;

                    bGripOpenRequestInternal := NOT bGripOpenedInternal;
                    bRotate0RequestInternal := NOT bRotate0Internal;

                    bStepTargetReached :=
                        bGripOpenedInternal
                        AND NOT bGripClosedInternal;

                    sDiagnosticInternal := 'Vision: grip OPEN - release part';


                // ------------------------------------------------------------
                // STEP 160 - VERTICAL UP
                // ------------------------------------------------------------

                160: // FIX: renumbered after separating support movements.

                    bSupportExtendRequestInternal := NOT bSupportExtendedInternal;
                    bHorizontalFrontRequestInternal := NOT bHorizontalFrontInternal;

                    bVerticalUpRequestInternal := NOT bVerticalUpInternal;

                    bLimitOffRequestInternal := FALSE;
                    bLimitOnRequestInternal := NOT bLimitOnInternal;

                    bGripOpenRequestInternal := NOT bGripOpenedInternal;
                    bRotate0RequestInternal := NOT bRotate0Internal;

                    bStepTargetReached :=
                        bVerticalUpInternal
                        AND NOT bVerticalDownInternal;

                    sDiagnosticInternal := 'Vision: vertical UP after release';


                // ------------------------------------------------------------
                // STEP 170 - RETURN HOME
                // ------------------------------------------------------------

                170: // FIX: renumbered after separating support movements.

                    bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
                    bHorizontalBackRequestInternal := NOT bHorizontalBackInternal;
                    bVerticalUpRequestInternal := NOT bVerticalUpInternal;

                    // HOME requires the intermediate stop removed.
					bLimitOnRequestInternal := FALSE;
					bLimitOffRequestInternal := NOT bLimitOffInternal;

                    bGripOpenRequestInternal := NOT bGripOpenedInternal;
                    bRotate0RequestInternal := NOT bRotate0Internal;

                    bStepTargetReached := bHomeInternal;

                    sDiagnosticInternal := 'Vision: returning tooling to home';
				
				// ------------------------------------------------------------
                // STEP 180 - CAMERA PBUB - FOURTH INSPECTION
                // ------------------------------------------------------------                
                180:
                    // Only program 3 may supply this inspection's result.
                    IF (nCurrentProgramNumberInternal = 3)
                        AND bCameraResultsReadyInternal
                        AND NOT tonCameraTriggerDelay[2].IN
                    THEN
                        bGetResultsRequestInternal := TRUE;
                        bAcknowledgeResultsInternal := TRUE;
                        tonCameraTriggerDelay[1].IN := TRUE;
                    END_IF

                    // Finish the delay even after the camera returns to program 0.
                    IF tonCameraTriggerDelay[1].Q THEN
                        bGetResultsRequestInternal := FALSE;
                        bAcknowledgeResultsInternal := FALSE;
                        nSetProgramNumberInternal := 0;
                        bChangeProgramRequestInternal := TRUE;
                        tonCameraTriggerDelay[2].IN := TRUE;
                        tonCameraTriggerDelay[1].IN := FALSE;
                    END_IF

                    // Hold program selection until the camera reports the requested program.
                    IF tonCameraTriggerDelay[2].IN THEN
                        nSetProgramNumberInternal := 0;
                        bChangeProgramRequestInternal := (nCurrentProgramNumberInternal <> 0);
                    END_IF
                    IF tonCameraTriggerDelay[2].Q AND (nCurrentProgramNumberInternal = 0) THEN
                        bChangeProgramRequestInternal := FALSE;
                        bStepTargetReached := TRUE;
                        // Keep delay 2 complete until this step advances.
                    END_IF

                    sDiagnosticInternal := 'Vision: Camera fourth inspection';

				190:
				
					bStepTargetReached := TRUE;

                // Pending: accepted-trigger/fresh-result handshake and supervised visual inspection recovery.

                ELSE

                    eStateInternal := E_PatchStationState.Fault;
                    usiStepInternal := 0;
                    sDiagnosticInternal := 'Vision: invalid sequence step';

            END_CASE


            // ================================================================
            // PROCESSING TRANSITIONS
            // ================================================================

            
                tonStepDelay(
                    IN := bStepTargetReached,
                    PT := tStepDelay
                );



            tonMoveTimeout(
                IN := NOT bStepTargetReached,
                PT := tMoveTimeout
            );


            // ================================================================
            // PROCESSING MOVEMENT TIMEOUT SUPERVISION
            // ================================================================

            IF tonMoveTimeout.Q THEN

                tonMoveTimeout(IN := FALSE);
                tonStepDelay(IN := FALSE);
                tonRotate180Hold(IN := FALSE);

                eStateInternal := E_PatchStationState.Fault;
                usiStepInternal := 0;

                sDiagnosticInternal := 'Vision: tooling movement or camera handshake timeout';

                stResultInternal.bValid := TRUE;
                stResultInternal.bPassed := FALSE;
                stResultInternal.eCode := E_ProcessResultCode.Fail;
                stResultInternal.udiFaultCode := 10;
                stResultInternal.udiAlertCode := 0;
                stResultInternal.sDetail := sDiagnosticInternal;

			(*
            ELSIF (usiStepInternal = 20) AND bStepTargetReached THEN

                tonMoveTimeout(IN := FALSE);
                tonRotate180Hold(IN := FALSE);
                // FIX CAMERA PREPARATION: route through camera 2 placeholder.
                // OLD: usiStepInternal := 100;
                usiStepInternal := 95;*)


            ELSIF (usiStepInternal < 190) AND tonStepDelay.Q THEN

                tonMoveTimeout(IN := FALSE);
                tonStepDelay(IN := FALSE);

                // Advance through the active steps in increments of 10.
              
                // The next step must start with fresh camera delays.
                tonCameraTriggerDelay[1](IN := FALSE);
                tonCameraTriggerDelay[2](IN := FALSE);
                usiStepInternal := usiStepInternal + 10;
            ELSIF usiStepInternal = 190 THEN

                    stResultInternal.CameraResults := nVisionResultsInternal;
                    stResultInternal.udiFaultCode := 0;
                    stResultInternal.udiAlertCode := 0;
                    stResultInternal.bValid :=
                        nVisionResultsInternal.aInspectionCompleted[1]
                        AND nVisionResultsInternal.aInspectionCompleted[2]
                        AND nVisionResultsInternal.aInspectionCompleted[3]
                        AND nVisionResultsInternal.aInspectionCompleted[4];

                    IF stResultInternal.bValid THEN
                        stResultInternal.bPassed :=
                            nVisionResultsInternal.aInspectionPassed[1]
                            AND nVisionResultsInternal.aInspectionPassed[2]
                            AND nVisionResultsInternal.aInspectionPassed[3]
                            AND nVisionResultsInternal.aInspectionPassed[4]
                            AND NOT bSimulatedFail;
                        stResultInternal.CameraResults.bGeneralPass := stResultInternal.bPassed;
                        stResultInternal.CameraResults.bGeneralFail := NOT stResultInternal.bPassed;

                        IF stResultInternal.bPassed THEN
                            stResultInternal.eCode := E_ProcessResultCode.Pass;
                            stResultInternal.sDetail := 'Vision: four camera inspections PASS';
                        ELSE
                            stResultInternal.eCode := E_ProcessResultCode.Fail;
                            stResultInternal.sDetail := 'Vision: camera inspection FAIL or commissioning FAIL injection';
                        END_IF
                        eStateInternal := E_PatchStationState.Complete;
                    ELSE
                        // No valid automatic verdict: retain the existing fault workflow.
                        stResultInternal.bPassed := FALSE;
                        stResultInternal.eCode := E_ProcessResultCode.None;
                        stResultInternal.udiFaultCode := 11;
                        stResultInternal.sDetail := 'Vision: incomplete camera results - manual inspection required';
                        sDiagnosticInternal := stResultInternal.sDetail;
                        eStateInternal := E_PatchStationState.Fault;
                    END_IF
                    usiStepInternal := 0;

                END_IF

           


        // ====================================================================
        // COMPLETE
        // ====================================================================

        E_PatchStationState.Complete:

            tonStepDelay(IN := FALSE);
            tonRotate180Hold(IN := FALSE);
            tonMoveTimeout(IN := FALSE);

            // Keep/restore HOME after process completion.
            bSupportRetractRequestInternal := NOT bSupportRetractedInternal;
            bHorizontalBackRequestInternal := NOT bHorizontalBackInternal;
            bVerticalUpRequestInternal := NOT bVerticalUpInternal;

			bLimitOnRequestInternal := FALSE;
			bLimitOffRequestInternal := NOT bLimitOffInternal;

            bGripOpenRequestInternal := NOT bGripOpenedInternal;
            bRotate0RequestInternal := NOT bRotate0Internal;

            sDiagnosticInternal := 'Vision: flipping complete';


        // ====================================================================
        // FAULT
        // ====================================================================

        E_PatchStationState.Fault:

            tonStepDelay(IN := FALSE);
            tonRotate180Hold(IN := FALSE);
            tonMoveTimeout(IN := FALSE);

            IF stResultInternal.udiFaultCode = 12 THEN
                sDiagnosticInternal := stResultInternal.sDetail;
            ELSE
                sDiagnosticInternal := 'Vision: fault';
            END_IF


        ELSE

            eStateInternal := E_PatchStationState.Fault;
            usiStepInternal := 0;
            sDiagnosticInternal := 'Vision: invalid station state';

    END_CASE

END_IF


// ============================================================================
// FINAL MECHANICAL MOVEMENT INTERLOCKS
// ============================================================================
//
// Independent mechanical permissives applied AFTER the state machine.
// These prevent unsafe movement requests from reaching the physical outputs
// even if a future sequence modification generates an invalid combination.


// ============================================================================
// HORIZONTAL MOVEMENT PERMISSIVE
// ============================================================================
//
// Horizontal movement is only permitted when the vertical tooling is
// positively confirmed UP.

IF NOT (
    bVerticalUpInternal
    AND NOT bVerticalDownInternal
) THEN

    bHorizontalBackRequestInternal := FALSE;
    bHorizontalFrontRequestInternal := FALSE;

END_IF


// ============================================================================
// ROTATION MOVEMENT PERMISSIVE
// ============================================================================
//
// Rotation is only permitted when:
//   Vertical = UP
//   Support / Nest = DOWN

IF NOT (
    bVerticalUpInternal
    AND NOT bVerticalDownInternal
    AND bSupportRetractedInternal
    AND NOT bSupportExtendedInternal
) THEN

    bRotate0RequestInternal := FALSE;
    bRotate180RequestInternal := FALSE;

END_IF


// ============================================================================
// FULL DOWN / INTERMEDIATE STOP PERMISSIVE
// ============================================================================
//
// Steps 20 and 30 correspond to FULL DOWN pick/grip (active CASE labels).
//
// FULL DOWN is only allowed after the intermediate mechanical stop has been
// positively confirmed retracted:
//
//   Limit OFF = TRUE
//   Limit ON  = FALSE
//
// This does NOT apply to Steps 60 / 120 / 130 because those steps
// intentionally command DOWN against the intermediate stop.

IF (eStateInternal = E_PatchStationState.Processing)
    AND (
        (usiStepInternal = 20)
        OR (usiStepInternal = 30)
    )
    AND NOT (
        bLimitOffInternal
        AND NOT bLimitOnInternal
    )
THEN

    bVerticalDownRequestInternal := FALSE;

END_IF


// ============================================================================
// OPPOSING OUTPUT HARD INTERLOCKS
// ============================================================================
//
// Never allow opposing pneumatic requests simultaneously.
// If both commands are requested, remove BOTH requests.
// Existing timeout supervision will detect failure to reach the target.


// Support Extend / Retract
IF bSupportExtendRequestInternal
    AND bSupportRetractRequestInternal
THEN

    bSupportExtendRequestInternal := FALSE;
    bSupportRetractRequestInternal := FALSE;

END_IF


// Horizontal Back / Front
IF bHorizontalBackRequestInternal
    AND bHorizontalFrontRequestInternal
THEN

    bHorizontalBackRequestInternal := FALSE;
    bHorizontalFrontRequestInternal := FALSE;

END_IF


// Vertical Up / Down
IF bVerticalUpRequestInternal
    AND bVerticalDownRequestInternal
THEN

    bVerticalUpRequestInternal := FALSE;
    bVerticalDownRequestInternal := FALSE;

END_IF


// Intermediate Stop OFF / ON
IF bLimitOffRequestInternal
    AND bLimitOnRequestInternal
THEN

    bLimitOffRequestInternal := FALSE;
    bLimitOnRequestInternal := FALSE;

END_IF


// Grip Close / Open
IF bGripCloseRequestInternal
    AND bGripOpenRequestInternal
THEN

    bGripCloseRequestInternal := FALSE;
    bGripOpenRequestInternal := FALSE;

END_IF


// Rotation 0 / 180
IF bRotate0RequestInternal
    AND bRotate180RequestInternal
THEN

    bRotate0RequestInternal := FALSE;
    bRotate180RequestInternal := FALSE;

END_IF


// ============================================================================
// SUPPORT CYLINDER SUPERVISION
// ============================================================================

tonSupportExtendTimeout(
    IN := bSupervisionEnableInternal
        AND bSafetyOkInternal
        AND bSupportExtendRequestInternal
        AND NOT bSupportExtendedInternal
        AND (eStateInternal <> E_PatchStationState.Fault),
    PT := tSupportMoveTimeout
);

tonSupportRetractTimeout(
    IN := bSupervisionEnableInternal
        AND bSafetyOkInternal
        AND bSupportRetractRequestInternal
        AND NOT bSupportRetractedInternal
        AND (eStateInternal <> E_PatchStationState.Fault),
    PT := tSupportMoveTimeout
);


// ============================================================================
// SUPPORT CYLINDER FAULT SUPERVISION
// ============================================================================

IF tonSupportExtendTimeout.Q THEN

    eSupportFaultInternal := E_SupportCylinderFault.ExtendTimeout;

    eStateInternal := E_PatchStationState.Fault;
    usiStepInternal := 0;

    stResultInternal.bValid := TRUE;
    stResultInternal.bPassed := FALSE;
    stResultInternal.eCode := E_ProcessResultCode.Fail;
    stResultInternal.udiFaultCode := 1;
    stResultInternal.udiAlertCode := 0;
    stResultInternal.sDetail := 'Vision: support UP feedback timeout';

    sDiagnosticInternal := 'Vision: support UP feedback timeout';


ELSIF tonSupportRetractTimeout.Q THEN

    eSupportFaultInternal := E_SupportCylinderFault.RetractTimeout;

    eStateInternal := E_PatchStationState.Fault;
    usiStepInternal := 0;

    stResultInternal.bValid := TRUE;
    stResultInternal.bPassed := FALSE;
    stResultInternal.eCode := E_ProcessResultCode.Fail;
    stResultInternal.udiFaultCode := 2;
    stResultInternal.udiAlertCode := 0;
    stResultInternal.sDetail := 'Vision: support DOWN feedback timeout';

    sDiagnosticInternal := 'Vision: support DOWN feedback timeout';

END_IF


// Clear pending camera delays after completion, stop, disable or fault.
IF eStateInternal <> E_PatchStationState.Processing THEN
    tonCameraTriggerDelay[1](IN := FALSE);
    tonCameraTriggerDelay[2](IN := FALSE);
    tonCamera110Rearm(IN := FALSE);
    tonTakingPictureWHileRotating(IN := FALSE);
    tonDelayInspectionPlaceHolder(IN := FALSE);
    bTriggerRequestInternal := FALSE;
END_IF

// ============================================================================
// STATUS
// ============================================================================

bReadyInternal :=
    (eStateInternal = E_PatchStationState.Ready)
    AND bHomeInternal;

bBusyInternal :=
    (eStateInternal = E_PatchStationState.Processing)
    OR ((eStateInternal = E_PatchStationState.Homing) AND NOT bHomeInternal);

bCompleteInternal :=
    (eStateInternal = E_PatchStationState.Complete);

bFaultInternal :=
    (eStateInternal = E_PatchStationState.Fault);]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetResult" Id="{7bfc6964-8b28-4f8c-8568-3f1997d1b2ca}">
      <Declaration><![CDATA[METHOD PUBLIC GetResult : ST_ProcessResult
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[GetResult := stResultInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialise" Id="{b60352d8-fc31-480d-8c87-753db464b955}">
      <Declaration><![CDATA[METHOD PUBLIC Initialise]]></Declaration>
      <Implementation>
        <ST><![CDATA[bFlipCaptureActivePrevious := FALSE;
bFlipStart0Confirmed := FALSE;
bFlipLeft0 := FALSE;
bFlip90Seen := FALSE;
bFlipTriggerLatched := FALSE;
bFlipCaptureAccepted := FALSE;
bFlipCaptureWindowMissed := FALSE;
tonFlipDeparture(IN := FALSE);
tonTakingPictureWHileRotating(IN := FALSE);

tonStepDelay(IN := FALSE);
tonRotate180Hold(IN := FALSE);
tonMoveTimeout(IN := FALSE);
tonSupportExtendTimeout(IN := FALSE);
tonSupportRetractTimeout(IN := FALSE);

eSupportFaultInternal := E_SupportCylinderFault.None;
eStateInternal := E_PatchStationState.Disabled;
usiStepInternal := 0;
bHomeInternal := FALSE;
bReadyInternal := FALSE;
bBusyInternal := FALSE;
bCompleteInternal := FALSE;
bFaultInternal := FALSE;
bStopRequestInternal := FALSE;

bSupportExtendRequestInternal := FALSE;
bSupportRetractRequestInternal := FALSE;
bHorizontalBackRequestInternal := FALSE;
bHorizontalFrontRequestInternal := FALSE;
bVerticalUpRequestInternal := FALSE;
bVerticalDownRequestInternal := FALSE;
bLimitOffRequestInternal := FALSE;
bLimitOnRequestInternal := FALSE;
bGripCloseRequestInternal := FALSE;
bGripOpenRequestInternal := FALSE;
bRotate0RequestInternal := FALSE;
bRotate180RequestInternal := FALSE;

sDiagnosticInternal := '';

stResultInternal.bValid := FALSE;
stResultInternal.bPassed := FALSE;
stResultInternal.eCode := E_ProcessResultCode.None;
stResultInternal.udiFaultCode := 0;
stResultInternal.udiAlertCode := 0;
stResultInternal.sDetail := '';
stResultInternal.CameraResults := stEmptyVisionResults;
nVisionResultsInternal := stEmptyVisionResults;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsBusy" Id="{6b8107df-1d67-4933-b0f5-867eee51379e}">
      <Declaration><![CDATA[METHOD PUBLIC IsBusy : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsBusy := bBusyInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsDone" Id="{463ff2bb-de2f-4777-9e7f-15ce22a41f36}">
      <Declaration><![CDATA[METHOD PUBLIC IsDone : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsDone := bCompleteInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsFaulted" Id="{02d98b44-e482-4a3a-a664-c71e4343e0af}">
      <Declaration><![CDATA[METHOD PUBLIC IsFaulted : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsFaulted := bFaultInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="IsReady" Id="{f1d3b7b6-df6d-491f-8e1a-6d304eece17e}">
      <Declaration><![CDATA[METHOD PUBLIC IsReady : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IsReady := bReadyInternal;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestReset" Id="{849d3e61-29bd-4d8e-807b-09a357055065}">
      <Declaration><![CDATA[METHOD PUBLIC RequestReset
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[bFlipCaptureActivePrevious := FALSE;
bFlipStart0Confirmed := FALSE;
bFlipLeft0 := FALSE;
bFlip90Seen := FALSE;
bFlipTriggerLatched := FALSE;
bFlipCaptureAccepted := FALSE;
bFlipCaptureWindowMissed := FALSE;
tonFlipDeparture(IN := FALSE);
tonTakingPictureWHileRotating(IN := FALSE);

tonStepDelay(IN := FALSE);
tonRotate180Hold(IN := FALSE);
tonMoveTimeout(IN := FALSE);
tonSupportExtendTimeout(IN := FALSE);
tonSupportRetractTimeout(IN := FALSE);

eSupportFaultInternal := E_SupportCylinderFault.None;
bStopRequestInternal := FALSE;

stResultInternal.bValid := FALSE;
stResultInternal.bPassed := FALSE;
stResultInternal.eCode := E_ProcessResultCode.None;
stResultInternal.udiFaultCode := 0;
stResultInternal.udiAlertCode := 0;
stResultInternal.sDetail := '';
stResultInternal.CameraResults := stEmptyVisionResults;
nVisionResultsInternal := stEmptyVisionResults;

IF bEnableInternal AND bCommissionedInternal AND bSafetyOkInternal THEN
    IF bHomeInternal THEN
        eStateInternal := E_PatchStationState.Ready;
    ELSE
        eStateInternal := E_PatchStationState.Homing;
    END_IF
ELSE
    eStateInternal := E_PatchStationState.Disabled;
END_IF

usiStepInternal := 0;


bChangeProgramRequestInternal	:= FALSE;
bTriggerRequestInternal			:= FALSE;
bGetResultsRequestInternal		:= FALSE;
bResetResultsRequestInternal	:= FALSE;
nSetProgramNumberInternal		:= 0;
bAcknowledgeResultsInternal		:= FALSE;

bStepTargetReached 				:= FALSE;

tonTakingPictureWHileRotating.IN := FALSE;
tonCameraTriggerDelay[1].IN			:= FALSE;
tonCameraTriggerDelay[2].IN			:= FALSE;
tonDelayInspectionPlaceHolder.IN 	:= FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestStart" Id="{a1f1fc65-484d-43e4-b289-6715c8e6c817}">
      <Declaration><![CDATA[METHOD PUBLIC RequestStart : BOOL
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
RequestStart := FALSE;

IF bEnableInternal
    AND bCommissionedInternal
    AND bSafetyOkInternal
    AND bReadyInternal
    AND bHomeInternal
THEN
bFlipCaptureActivePrevious := FALSE;
bFlipStart0Confirmed := FALSE;
bFlipLeft0 := FALSE;
bFlip90Seen := FALSE;
bFlipTriggerLatched := FALSE;
bFlipCaptureAccepted := FALSE;
bFlipCaptureWindowMissed := FALSE;
tonFlipDeparture(IN := FALSE);
tonTakingPictureWHileRotating(IN := FALSE);

    stResultInternal.bValid := FALSE;
    stResultInternal.bPassed := FALSE;
    stResultInternal.eCode := E_ProcessResultCode.None;
    stResultInternal.udiFaultCode := 0;
    stResultInternal.udiAlertCode := 0;
    stResultInternal.sDetail := '';
    stResultInternal.CameraResults := stEmptyVisionResults;
    nVisionResultsInternal := stEmptyVisionResults;

    eSupportFaultInternal := E_SupportCylinderFault.None;
    eStateInternal := E_PatchStationState.Processing;
    usiStepInternal := 10;
    RequestStart := TRUE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestStop" Id="{c0843154-582c-4b39-b05f-d6fcabc70c1d}">
      <Declaration><![CDATA[METHOD PUBLIC RequestStop
VAR_INPUT
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[bStopRequestInternal := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Update" Id="{632cb56e-471f-4b5a-b14f-7c50434086c7}">
      <Declaration><![CDATA[METHOD PUBLIC Update
VAR_INPUT
    bEnable             : BOOL;
    bCommissioned       : BOOL;
    bSafetyOk           : BOOL;
    bSupervisionEnable  : BOOL;
    bReset              : BOOL;

    bSupportRetracted   : BOOL;
    bSupportExtended    : BOOL;

    bHorizontalBack     : BOOL;
    bHorizontalFront    : BOOL;
    bVerticalUp         : BOOL;
    bVerticalDown       : BOOL;
    bLimitOff           : BOOL;
    bLimitOn            : BOOL;
    bGripOpened         : BOOL;
    bGripClosed         : BOOL;
    bRotate0            : BOOL;
    bRotate180          : BOOL;
    bRotate0Raw : BOOL;
    bRotate180Raw : BOOL;
    bCameraTriggerAccepted : BOOL;
	
	//CAMERA
	nCurrentProgramNumber: UDINT;
	nVisionCameraResults: ST_VisionResults;
	bResultsReady		: BOOL;

    tSupportTimeout     : TIME;
END_VAR
VAR_OUTPUT
    stStatus                 : ST_PatchStageStatus;

    bSupportExtendRequest    : BOOL;
    bSupportRetractRequest   : BOOL;
    bHorizontalBackRequest   : BOOL;
    bHorizontalFrontRequest  : BOOL;
    bVerticalUpRequest       : BOOL;
    bVerticalDownRequest     : BOOL;
    bLimitOffRequest         : BOOL;
    bLimitOnRequest          : BOOL;
    bGripCloseRequest        : BOOL;
    bGripOpenRequest         : BOOL;
    bRotate0Request          : BOOL;
    bRotate180Request        : BOOL;
	
	//camera
	bTriggerRequest			: BOOL;
	bChangeProgramRequest	: BOOL;
	bGetResultsRequest		: BOOL;
	bRequestResetResults	: BOOL;
	nProgramNumber			: UDINT;
	bAcknowledgeResults		: BOOL;

	
	
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[
	
bEnableInternal := bEnable;
bCommissionedInternal := bCommissioned;
bSafetyOkInternal := bSafetyOk;
bSupervisionEnableInternal := bSupervisionEnable;

bSupportRetractedInternal := bSupportRetracted;
bSupportExtendedInternal := bSupportExtended;

bHorizontalBackInternal := bHorizontalBack;
bHorizontalFrontInternal := bHorizontalFront;
bVerticalUpInternal := bVerticalUp;
bVerticalDownInternal := bVerticalDown;
bLimitOffInternal := bLimitOff;
bLimitOnInternal := bLimitOn;
bGripOpenedInternal := bGripOpened;
bGripClosedInternal := bGripClosed;
bRotate0Internal := bRotate0;
bRotate180Internal := bRotate180;
bRotate0RawInternal := bRotate0Raw;
bRotate180RawInternal := bRotate180Raw;
bCameraTriggerAcceptedInternal := bCameraTriggerAccepted;

tSupportMoveTimeout := tSupportTimeout;

// Camera inputs must be current when reset and Cyclic evaluate the handshake.
nCurrentProgramNumberInternal	:= 		nCurrentProgramNumber;
bCameraResultsReadyInternal		:= 		bResultsReady;
nVisionResultsInternal			:= 	nVisionCameraResults;

IF bReset THEN
    RequestReset();
END_IF

Cyclic();

stStatus.eState := eStateInternal;
stStatus.bCommissioned := bCommissionedInternal;
stStatus.bHome := bHomeInternal;
stStatus.bReady := bReadyInternal;
stStatus.bBusy := bBusyInternal;
stStatus.bComplete := bCompleteInternal;
stStatus.bFault := bFaultInternal;
stStatus.eSupportFault := eSupportFaultInternal;
stStatus.sDiagnostic := sDiagnosticInternal;

bSupportExtendRequest := bSupportExtendRequestInternal;
bSupportRetractRequest := bSupportRetractRequestInternal;
bHorizontalBackRequest := bHorizontalBackRequestInternal;
bHorizontalFrontRequest := bHorizontalFrontRequestInternal;
bVerticalUpRequest := bVerticalUpRequestInternal;
bVerticalDownRequest := bVerticalDownRequestInternal;
bLimitOffRequest := bLimitOffRequestInternal;
bLimitOnRequest := bLimitOnRequestInternal;
bGripCloseRequest := bGripCloseRequestInternal;
bGripOpenRequest := bGripOpenRequestInternal;
bRotate0Request := bRotate0RequestInternal;
bRotate180Request := bRotate180RequestInternal;

//camera
bTriggerRequest					:=		bTriggerRequestInternal;
bChangeProgramRequest			:=		bChangeProgramRequestInternal;
bGetResultsRequest				:= 		bGetResultsRequestInternal;
bRequestResetResults			:=		bResetResultsRequestInternal;
nProgramNumber 					:= 		nSetProgramNumberInternal;
bAcknowledgeResults				:= 		bAcknowledgeResultsInternal;



]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>