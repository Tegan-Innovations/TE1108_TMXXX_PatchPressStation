<div id="PatchIndexTable" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiImage" data-tchmi-height="250" data-tchmi-height-unit="px" data-tchmi-left="21" data-tchmi-left-unit="px" data-tchmi-src="Images/Project/PatchIndexTableV2.png" data-tchmi-top="25" data-tchmi-top-unit="px" data-tchmi-width="255" data-tchmi-width-unit="px" data-tchmi-zindex="7">
<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[
  {
    "event": "%s%ADS.PLC1.GVL_HMI.stStatus.uiPatchDispenseNestId%/s%",
    "actions": [
      {
        "objectType": "JavaScript",
        "active": true,
        "sourceLines": [
          "(function () {",
          "    var control = TcHmi.Controls.get('PatchIndexTable');",
          "",
          "    if (!control) {",
          "        console.error('Control PatchIndexTable was not found.');",
          "        return;",
          "    }",
          "",
          "    var symPatch = '%s%ADS.PLC1.GVL_HMI.stStatus.uiPatchDispenseNestId%/s%';",
          "    var symHeat = '%s%ADS.PLC1.GVL_HMI.stStatus.uiHeatStakeNestId%/s%';",
          "    var symVision = '%s%ADS.PLC1.GVL_HMI.stStatus.uiVisionNestId%/s%';",
          "",
          "    TcHmi.Symbol.readEx2(symPatch, function (patchData) {",
          "        if (patchData.error !== TcHmi.Errors.NONE) { return; }",
          "        TcHmi.Symbol.readEx2(symHeat, function (heatData) {",
          "            if (heatData.error !== TcHmi.Errors.NONE) { return; }",
          "            TcHmi.Symbol.readEx2(symVision, function (visionData) {",
          "                if (visionData.error !== TcHmi.Errors.NONE) { return; }",
          "",
          "                var patchNest = Number(patchData.value);",
          "                var heatNest = Number(heatData.value);",
          "                var visionNest = Number(visionData.value);",
          "                var ids = [patchNest, heatNest, visionNest];",
          "",
          "                var valid = ids.every(function (v) {",
          "                    return Number.isInteger(v) && v >= 1 && v <= 4;",
          "                });",
          "",
          "                if (!valid || new Set(ids).size !== 3) {",
          "                    console.warn('Indexer station Nest IDs are not valid yet:', ids);",
          "                    return;",
          "                }",
          "",
          "                // Nests are always 1,2,3,4. The missing ID is the operator nest.",
          "                var operatorNest = 10 - patchNest - heatNest - visionNest;",
          "",
          "                // PatchIndexTableV2.png calibration:",
          "                // 0 deg: Nest 2 bottom, Nest 1 right, Nest 4 top, Nest 3 left.",
          "                var angleByOperatorNest = {",
          "                    2: 0,",
          "                    1: 90,",
          "                    4: 180,",
          "                    3: 270",
          "                };",
          "",
          "                var targetNormalized = angleByOperatorNest[operatorNest];",
          "                if (typeof targetNormalized !== 'number') { return; }",
          "",
          "                var angleKey = 'patchPressManualIndexerAngle';",
          "                var frameKey = 'patchPressManualIndexerFrame';",
          "",
          "                if (typeof window[angleKey] !== 'number') {",
          "                    window[angleKey] = targetNormalized;",
          "                    control.setTransform([",
          "                        {",
          "                            transformType: 'Rotate',",
          "                            angleUnit: 'deg',",
          "                            angle: targetNormalized",
          "                        }",
          "                    ]);",
          "                    return;",
          "                }",
          "",
          "                if (window[frameKey]) {",
          "                    window.cancelAnimationFrame(window[frameKey]);",
          "                    window[frameKey] = null;",
          "                }",
          "",
          "                var startAngle = window[angleKey];",
          "                var startNormalized = ((startAngle % 360) + 360) % 360;",
          "                // Use the shortest signed quarter-turn so the image",
          "                // follows the real index direction instead of taking",
          "                // the long 270-degree path.",
          "                var delta = ((targetNormalized - startNormalized + 540) % 360) - 180;",
          "",
          "                if (delta === 0) {",
          "                    control.setTransform([",
          "                        {",
          "                            transformType: 'Rotate',",
          "                            angleUnit: 'deg',",
          "                            angle: startAngle",
          "                        }",
          "                    ]);",
          "                    return;",
          "                }",
          "",
          "                var targetAngle = startAngle + delta;",
          "                var duration = 550;",
          "                var startTime = null;",
          "",
          "                function easeInOut(p) {",
          "                    return p < 0.5",
          "                        ? 2 * p * p",
          "                        : 1 - Math.pow(-2 * p + 2, 2) / 2;",
          "                }",
          "",
          "                function animate(currentTime) {",
          "                    if (startTime === null) { startTime = currentTime; }",
          "                    var progress = Math.min((currentTime - startTime) / duration, 1);",
          "                    var eased = easeInOut(progress);",
          "                    var animatedAngle = startAngle + (targetAngle - startAngle) * eased;",
          "",
          "                    control.setTransform([",
          "                        {",
          "                            transformType: 'Rotate',",
          "                            angleUnit: 'deg',",
          "                            angle: animatedAngle",
          "                        }",
          "                    ]);",
          "",
          "                    window[angleKey] = animatedAngle;",
          "",
          "                    if (progress < 1) {",
          "                        window[frameKey] = window.requestAnimationFrame(animate);",
          "                    } else {",
          "                        window[angleKey] = targetAngle;",
          "                        window[frameKey] = null;",
          "                    }",
          "                }",
          "",
          "                window[frameKey] = window.requestAnimationFrame(animate);",
          "            });",
          "        });",
          "    });",
          "}());"
        ],
        "asyncWait": false
      }
    ]
  }
]</script>
</div>
