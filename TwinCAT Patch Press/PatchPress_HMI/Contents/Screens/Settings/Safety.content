<div id="SafetySettings" data-tchmi-type="TcHmi.Controls.System.TcHmiContent" data-tchmi-width="1080" data-tchmi-height="480" data-tchmi-left="0" data-tchmi-top="0">
<div id="SafetySettingsTitle" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="24" data-tchmi-left-unit="px" data-tchmi-top="10" data-tchmi-top-unit="px" data-tchmi-width="1020" data-tchmi-width-unit="px" data-tchmi-height="36" data-tchmi-height-unit="px" data-tchmi-text="SAFETY - MAIN DOOR" data-tchmi-text-font-size="23" data-tchmi-text-vertical-alignment="Center" data-tchmi-text-font-weight="Bold"></div>
<div id="SafetySettingsHint" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="24" data-tchmi-left-unit="px" data-tchmi-top="55" data-tchmi-top-unit="px" data-tchmi-width="1020" data-tchmi-width-unit="px" data-tchmi-height="36" data-tchmi-height-unit="px" data-tchmi-text="Door unlock uses head temperature. Apply only while Stopped and idle." data-tchmi-text-font-size="17" data-tchmi-text-vertical-alignment="Center"></div>
<div id="SafetyHeadName" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="24" data-tchmi-left-unit="px" data-tchmi-top="112" data-tchmi-top-unit="px" data-tchmi-width="420" data-tchmi-width-unit="px" data-tchmi-height="30" data-tchmi-height-unit="px" data-tchmi-text="PARAMETER" data-tchmi-text-font-size="15" data-tchmi-text-font-weight="Bold"></div>
<div id="SafetyHeadEdit" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="450" data-tchmi-left-unit="px" data-tchmi-top="112" data-tchmi-top-unit="px" data-tchmi-width="120" data-tchmi-width-unit="px" data-tchmi-height="30" data-tchmi-height-unit="px" data-tchmi-text="EDIT" data-tchmi-text-font-size="15" data-tchmi-text-font-weight="Bold"></div>
<div id="SafetyHeadApplied" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="600" data-tchmi-left-unit="px" data-tchmi-top="112" data-tchmi-top-unit="px" data-tchmi-width="120" data-tchmi-width-unit="px" data-tchmi-height="30" data-tchmi-height-unit="px" data-tchmi-text="APPLIED" data-tchmi-text-font-size="15" data-tchmi-text-font-weight="Bold"></div>
<div id="SafetyHeadUnit" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="750" data-tchmi-left-unit="px" data-tchmi-top="112" data-tchmi-top-unit="px" data-tchmi-width="280" data-tchmi-width-unit="px" data-tchmi-height="30" data-tchmi-height-unit="px" data-tchmi-text="UNIT / ALLOWED RANGE" data-tchmi-text-font-size="15" data-tchmi-text-font-weight="Bold"></div>
<div id="SafetyHeadTemperatureLabel" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="24" data-tchmi-left-unit="px" data-tchmi-top="155" data-tchmi-top-unit="px" data-tchmi-width="420" data-tchmi-width-unit="px" data-tchmi-height="34" data-tchmi-height-unit="px" data-tchmi-text="Head temperature feedback" data-tchmi-text-font-size="17"></div>
<div id="SafetyHeadTemperature" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiNumericInput" data-tchmi-left="600" data-tchmi-left-unit="px" data-tchmi-top="155" data-tchmi-top-unit="px" data-tchmi-width="120" data-tchmi-width-unit="px" data-tchmi-height="34" data-tchmi-height-unit="px" data-tchmi-value="%s%ADS.PLC1.GVL_HMI.stStatus.stHeatStakeTemperature.rOverTempTemperatureC%/s%" data-tchmi-decimal-digits="1" data-tchmi-value-font-size="18" data-tchmi-reset-to-last-valid-value="True" data-tchmi-auto-focus-out="True" data-tchmi-is-enabled="False"></div>
<div id="SafetyHeadTemperatureUnit" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="750" data-tchmi-left-unit="px" data-tchmi-top="155" data-tchmi-top-unit="px" data-tchmi-width="280" data-tchmi-width-unit="px" data-tchmi-height="34" data-tchmi-height-unit="px" data-tchmi-text="deg C" data-tchmi-text-font-size="16"></div>
<div id="SafetyDoorHotLimitLabel" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="24" data-tchmi-left-unit="px" data-tchmi-top="210" data-tchmi-top-unit="px" data-tchmi-width="420" data-tchmi-width-unit="px" data-tchmi-height="34" data-tchmi-height-unit="px" data-tchmi-text="Hot-head threshold for door unlock" data-tchmi-text-font-size="17"></div>
<div id="SafetyDoorHotLimitEdit" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiNumericInput" data-tchmi-left="450" data-tchmi-left-unit="px" data-tchmi-top="210" data-tchmi-top-unit="px" data-tchmi-width="120" data-tchmi-width-unit="px" data-tchmi-height="34" data-tchmi-height-unit="px" data-tchmi-value="%s%ADS.PLC1.GVL_HMI.rSafetyDoorHotLimitEditC|BindingMode=TwoWay%/s%" data-tchmi-decimal-digits="1" data-tchmi-value-font-size="18" data-tchmi-reset-to-last-valid-value="True" data-tchmi-auto-focus-out="True" data-tchmi-min-value="20" data-tchmi-max-value="40" data-tchmi-is-enabled="%f%%s%ADS.PLC1.GVL_HMI.bSafetySettingsAllowed%/s% &amp;&amp; !%s%ADS.PLC1.GVL_HMI.bStationSettingsSaving%/s%%/f%"></div>
<div id="SafetyDoorHotLimitApplied" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiNumericInput" data-tchmi-left="600" data-tchmi-left-unit="px" data-tchmi-top="210" data-tchmi-top-unit="px" data-tchmi-width="120" data-tchmi-width-unit="px" data-tchmi-height="34" data-tchmi-height-unit="px" data-tchmi-value="%s%ADS.PLC1.GVL_HMI.rSafetyDoorHotLimitAppliedC%/s%" data-tchmi-decimal-digits="1" data-tchmi-value-font-size="18" data-tchmi-reset-to-last-valid-value="True" data-tchmi-auto-focus-out="True" data-tchmi-min-value="20" data-tchmi-max-value="40" data-tchmi-is-enabled="False"></div>
<div id="SafetyDoorHotLimitUnit" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="750" data-tchmi-left-unit="px" data-tchmi-top="210" data-tchmi-top-unit="px" data-tchmi-width="280" data-tchmi-width-unit="px" data-tchmi-height="34" data-tchmi-height-unit="px" data-tchmi-text="deg C   20 - 40" data-tchmi-text-font-size="16"></div>
<div id="SafetyDoorHotBehavior" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="24" data-tchmi-left-unit="px" data-tchmi-top="265" data-tchmi-top-unit="px" data-tchmi-width="1020" data-tchmi-width-unit="px" data-tchmi-height="65" data-tchmi-height-unit="px" data-tchmi-text="At or above the limit: acknowledge Unlock. Below the limit: automatic unlock in Stopped." data-tchmi-text-font-size="17" data-tchmi-word-wrap="True"></div>
<div id="SafetySettingsApply" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-left="24" data-tchmi-left-unit="px" data-tchmi-top="375" data-tchmi-top-unit="px" data-tchmi-width="140" data-tchmi-width-unit="px" data-tchmi-height="42" data-tchmi-height-unit="px" data-tchmi-text="APPLY" data-tchmi-text-font-size="18" data-tchmi-is-enabled="%f%%s%ADS.PLC1.GVL_HMI.bSafetySettingsAllowed%/s% &amp;&amp; !%s%ADS.PLC1.GVL_HMI.bStationSettingsSaving%/s%%/f%"><script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onPressed",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%s%ADS.PLC1.GVL_HMI.rSafetyDoorHotLimitEditC%/s%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/REAL",
          "symbolExpression": "%ctrl%SafetyDoorHotLimitEdit::Value%/ctrl%"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%s%ADS.PLC1.GVL_HMI.bSafetySettingsApply%/s%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/BOOL",
          "value": true
        },
        "asyncWait": true
      }
    ]
  }
]</script></div>
<div id="SafetySettingsCancel" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-left="180" data-tchmi-left-unit="px" data-tchmi-top="375" data-tchmi-top-unit="px" data-tchmi-width="140" data-tchmi-width-unit="px" data-tchmi-height="42" data-tchmi-height-unit="px" data-tchmi-text="CANCEL" data-tchmi-text-font-size="18" data-tchmi-is-enabled="True"><script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onPressed",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%s%ADS.PLC1.GVL_HMI.bSafetySettingsCancel%/s%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/BOOL",
          "value": true
        },
        "asyncWait": true
      }
    ]
  }
]</script></div>
<div id="SafetySettingsMessage" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="350" data-tchmi-left-unit="px" data-tchmi-top="375" data-tchmi-top-unit="px" data-tchmi-width="690" data-tchmi-width-unit="px" data-tchmi-height="44" data-tchmi-height-unit="px" data-tchmi-text="%s%ADS.PLC1.GVL_HMI.sSafetySettingsMessage%/s%" data-tchmi-text-font-size="16" data-tchmi-word-wrap="True"></div>
<div id="SafetySaveErrorLabel" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="24" data-tchmi-left-unit="px" data-tchmi-top="440" data-tchmi-top-unit="px" data-tchmi-width="150" data-tchmi-width-unit="px" data-tchmi-height="26" data-tchmi-height-unit="px" data-tchmi-text="Save error ID:" data-tchmi-text-font-size="15"></div>
<div id="SafetySaveErrorId" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiNumericInput" data-tchmi-left="175" data-tchmi-left-unit="px" data-tchmi-top="440" data-tchmi-top-unit="px" data-tchmi-width="120" data-tchmi-width-unit="px" data-tchmi-height="26" data-tchmi-height-unit="px" data-tchmi-value="%s%ADS.PLC1.GVL_HMI.udiStationSettingsSaveErrorId%/s%" data-tchmi-is-enabled="False" data-tchmi-decimal-digits="0"></div>

<script data-tchmi-target-attribute="data-tchmi-background-color" type="application/json">
{
  "color": "rgba(255, 255, 255, 1)"
}
</script>
</div>
