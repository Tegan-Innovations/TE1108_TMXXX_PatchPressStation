<div id="VisionHead750" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="750" data-tchmi-left-unit="px" data-tchmi-top="82" data-tchmi-top-unit="px" data-tchmi-width="280" data-tchmi-width-unit="px" data-tchmi-height="28" data-tchmi-height-unit="px" data-tchmi-text="UNIT / ALLOWED RANGE" data-tchmi-text-font-size="15" data-tchmi-text-vertical-alignment="Center" data-tchmi-text-font-weight="Bold"></div>
<div id="VisionLabeludiMovingTriggerDelayMs" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="24" data-tchmi-left-unit="px" data-tchmi-top="116" data-tchmi-top-unit="px" data-tchmi-width="420" data-tchmi-width-unit="px" data-tchmi-height="32" data-tchmi-height-unit="px" data-tchmi-text="Photo delay after 90 deg marker" data-tchmi-text-font-size="17" data-tchmi-text-vertical-alignment="Center"></div>
<div id="VisionEditudiMovingTriggerDelayMs" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiNumericInput" data-tchmi-left="450" data-tchmi-left-unit="px" data-tchmi-top="116" data-tchmi-top-unit="px" data-tchmi-width="120" data-tchmi-width-unit="px" data-tchmi-height="32" data-tchmi-height-unit="px" data-tchmi-value="%s%ADS.PLC1.GVL_HMI.stVisionProcessEdit.udiMovingTriggerDelayMs|BindingMode=TwoWay%/s%" data-tchmi-decimal-digits="0" data-tchmi-min-value="0" data-tchmi-max-value="1000" data-tchmi-reset-to-last-valid-value="True" data-tchmi-auto-focus-out="True" data-tchmi-value-font-size="18" data-tchmi-is-enabled="%f%%s%ADS.PLC1.GVL_HMI.bStationSettingsAllowed%/s% &amp;&amp; !%s%ADS.PLC1.GVL_HMI.bStationSettingsSaving%/s%%/f%"></div>
<div id="VisionAppliedudiMovingTriggerDelayMs" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiNumericInput" data-tchmi-left="600" data-tchmi-left-unit="px" data-tchmi-top="116" data-tchmi-top-unit="px" data-tchmi-width="120" data-tchmi-width-unit="px" data-tchmi-height="32" data-tchmi-height-unit="px" data-tchmi-value="%s%ADS.PLC1.GVL_HMI.stVisionProcessApplied.udiMovingTriggerDelayMs%/s%" data-tchmi-decimal-digits="0" data-tchmi-min-value="0" data-tchmi-max-value="1000" data-tchmi-reset-to-last-valid-value="True" data-tchmi-auto-focus-out="True" data-tchmi-value-font-size="18" data-tchmi-is-enabled="False"></div>
<div id="VisionUnitudiMovingTriggerDelayMs" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="750" data-tchmi-left-unit="px" data-tchmi-top="116" data-tchmi-top-unit="px" data-tchmi-width="290" data-tchmi-width-unit="px" data-tchmi-height="32" data-tchmi-height-unit="px" data-tchmi-text="ms   0 - 1000" data-tchmi-text-font-size="16" data-tchmi-text-vertical-alignment="Center"></div>
<div id="VisionLabeludiRotaryConfirmMs" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="24" data-tchmi-left-unit="px" data-tchmi-top="161" data-tchmi-top-unit="px" data-tchmi-width="420" data-tchmi-width-unit="px" data-tchmi-height="32" data-tchmi-height-unit="px" data-tchmi-text="0 / 180 deg position confirmation" data-tchmi-text-font-size="17" data-tchmi-text-vertical-alignment="Center"></div>
<div id="VisionEditudiRotaryConfirmMs" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiNumericInput" data-tchmi-left="450" data-tchmi-left-unit="px" data-tchmi-top="161" data-tchmi-top-unit="px" data-tchmi-width="120" data-tchmi-width-unit="px" data-tchmi-height="32" data-tchmi-height-unit="px" data-tchmi-value="%s%ADS.PLC1.GVL_HMI.stVisionProcessEdit.udiRotaryConfirmMs|BindingMode=TwoWay%/s%" data-tchmi-decimal-digits="0" data-tchmi-min-value="1000" data-tchmi-max-value="3000" data-tchmi-reset-to-last-valid-value="True" data-tchmi-auto-focus-out="True" data-tchmi-value-font-size="18" data-tchmi-is-enabled="%f%%s%ADS.PLC1.GVL_HMI.bStationSettingsAllowed%/s% &amp;&amp; !%s%ADS.PLC1.GVL_HMI.bStationSettingsSaving%/s%%/f%"></div>
<div id="VisionAppliedudiRotaryConfirmMs" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiNumericInput" data-tchmi-left="600" data-tchmi-left-unit="px" data-tchmi-top="161" data-tchmi-top-unit="px" data-tchmi-width="120" data-tchmi-width-unit="px" data-tchmi-height="32" data-tchmi-height-unit="px" data-tchmi-value="%s%ADS.PLC1.GVL_HMI.stVisionProcessApplied.udiRotaryConfirmMs%/s%" data-tchmi-decimal-digits="0" data-tchmi-min-value="1000" data-tchmi-max-value="3000" data-tchmi-reset-to-last-valid-value="True" data-tchmi-auto-focus-out="True" data-tchmi-value-font-size="18" data-tchmi-is-enabled="False"></div>
<div id="VisionUnitudiRotaryConfirmMs" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="750" data-tchmi-left-unit="px" data-tchmi-top="161" data-tchmi-top-unit="px" data-tchmi-width="290" data-tchmi-width-unit="px" data-tchmi-height="32" data-tchmi-height-unit="px" data-tchmi-text="ms   1000 - 3000" data-tchmi-text-font-size="16" data-tchmi-text-vertical-alignment="Center"></div>
<div id="VisionSettingsCameraHint" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="24" data-tchmi-left-unit="px" data-tchmi-top="225" data-tchmi-top-unit="px" data-tchmi-width="1020" data-tchmi-width-unit="px" data-tchmi-height="28" data-tchmi-height-unit="px" data-tchmi-text="Exposure, lighting, OCR and judgment criteria: adjust in VS Creator." data-tchmi-text-font-size="16" data-tchmi-text-vertical-alignment="Center"></div>
<div id="VisionSettingsCaptureHint" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="24" data-tchmi-left-unit="px" data-tchmi-top="258" data-tchmi-top-unit="px" data-tchmi-width="1020" data-tchmi-width-unit="px" data-tchmi-height="28" data-tchmi-height-unit="px" data-tchmi-text="Moving image uses the first 90 deg marker. Delay does not define an exact angle." data-tchmi-text-font-size="15" data-tchmi-text-vertical-alignment="Center"></div>
<div id="VisionSettings_Apply" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-left="24" data-tchmi-left-unit="px" data-tchmi-top="395" data-tchmi-top-unit="px" data-tchmi-width="140" data-tchmi-width-unit="px" data-tchmi-height="42" data-tchmi-height-unit="px" data-tchmi-text="APPLY" data-tchmi-text-font-size="18" data-tchmi-is-enabled="%f%%s%ADS.PLC1.GVL_HMI.bStationSettingsAllowed%/s% &amp;&amp; !%s%ADS.PLC1.GVL_HMI.bStationSettingsSaving%/s%%/f%"><script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onPressed",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%s%ADS.PLC1.GVL_HMI.stVisionProcessEdit.udiMovingTriggerDelayMs%/s%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/UDINT",
          "symbolExpression": "%ctrl%VisionEditudiMovingTriggerDelayMs::Value%/ctrl%"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%s%ADS.PLC1.GVL_HMI.stVisionProcessEdit.udiRotaryConfirmMs%/s%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/UDINT",
          "symbolExpression": "%ctrl%VisionEditudiRotaryConfirmMs::Value%/ctrl%"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%s%ADS.PLC1.GVL_HMI.bVisionSettingsApply%/s%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/BOOL",
          "value": true
        },
        "asyncWait": true
      }
    ]
  }
]</script></div>
<div id="VisionSettings_Cancel" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-left="180" data-tchmi-left-unit="px" data-tchmi-top="395" data-tchmi-top-unit="px" data-tchmi-width="140" data-tchmi-width-unit="px" data-tchmi-height="42" data-tchmi-height-unit="px" data-tchmi-text="CANCEL" data-tchmi-text-font-size="18" data-tchmi-is-enabled="True"><script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onPressed",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%s%ADS.PLC1.GVL_HMI.bVisionSettingsCancel%/s%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/BOOL",
          "value": true
        },
        "asyncWait": true
      }
    ]
  }
]</script></div>
<div id="VisionSettingsMessage" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="350" data-tchmi-left-unit="px" data-tchmi-top="395" data-tchmi-top-unit="px" data-tchmi-width="700" data-tchmi-width-unit="px" data-tchmi-height="44" data-tchmi-height-unit="px" data-tchmi-text="%s%ADS.PLC1.GVL_HMI.sVisionSettingsMessage%/s%" data-tchmi-text-font-size="16" data-tchmi-text-vertical-alignment="Center"></div>
<div id="VisionSettingsSaveError" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="24" data-tchmi-left-unit="px" data-tchmi-top="445" data-tchmi-top-unit="px" data-tchmi-width="150" data-tchmi-width-unit="px" data-tchmi-height="24" data-tchmi-height-unit="px" data-tchmi-text="Save error ID:" data-tchmi-text-font-size="14" data-tchmi-text-vertical-alignment="Center"></div>
<div id="VisionSettingsSaveErrorId" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiNumericInput" data-tchmi-left="175" data-tchmi-left-unit="px" data-tchmi-top="445" data-tchmi-top-unit="px" data-tchmi-width="110" data-tchmi-width-unit="px" data-tchmi-height="24" data-tchmi-height-unit="px" data-tchmi-value="%s%ADS.PLC1.GVL_HMI.udiStationSettingsSaveErrorId%/s%" data-tchmi-is-enabled="False" data-tchmi-decimal-digits="0"></div>

<script data-tchmi-target-attribute="data-tchmi-background-color" type="application/json">
{
  "color": "rgba(255, 255, 255, 1)"
}
</script>
</div>
