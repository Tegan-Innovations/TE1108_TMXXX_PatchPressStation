<div id="VisionSettingsHint" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="24" data-tchmi-left-unit="px" data-tchmi-top="46" data-tchmi-top-unit="px" data-tchmi-width="1030" data-tchmi-width-unit="px" data-tchmi-height="28" data-tchmi-height-unit="px" data-tchmi-text="Apply in Stopped or Ready to Start. Values are saved after Apply." data-tchmi-text-font-size="15" data-tchmi-text-vertical-alignment="Center"></div>
