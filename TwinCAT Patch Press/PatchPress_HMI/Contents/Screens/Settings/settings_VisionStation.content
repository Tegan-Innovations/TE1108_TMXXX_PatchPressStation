<div id="VisionSettings_Apply" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-left="24" data-tchmi-left-unit="px" data-tchmi-top="385" data-tchmi-top-unit="px" data-tchmi-width="140" data-tchmi-width-unit="px" data-tchmi-height="42" data-tchmi-height-unit="px" data-tchmi-text="APPLY" data-tchmi-text-font-size="18" data-tchmi-is-enabled="%f%%s%ADS.PLC1.GVL_HMI.bStationSettingsAllowed%/s% &amp;&amp; !%s%ADS.PLC1.GVL_HMI.bStationSettingsSaving%/s%%/f%" data-tchmi-zindex="2"><script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onPressed",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%s%ADS.PLC1.GVL_HMI.stVisionProcessEdit.udiMovingTriggerDelayMs%/s%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/UDINT",
          "symbolExpression": "%ctrl%VisionEditudiMovingTriggerDelayMs::Value%/ctrl%"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%s%ADS.PLC1.GVL_HMI.stVisionProcessEdit.udiRotaryConfirmMs%/s%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/UDINT",
          "symbolExpression": "%ctrl%VisionEditudiRotaryConfirmMs::Value%/ctrl%"
        },
        "asyncWait": true
      },
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%s%ADS.PLC1.GVL_HMI.bVisionSettingsApply%/s%",
        "value": {
          "objectType": "StaticValue",
          "valueType": "tchmi:general#/definitions/BOOL",
          "value": true
        },
        "asyncWait": true
      }
    ]
  }
]</script></div>
<div id="VisionSettings_Cancel" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-left="180" data-tchmi-left-unit="px" data-tchmi-top="385" data-tchmi-top-unit="px" data-tchmi-width="140" data-tchmi-width-unit="px" data-tchmi-height="42" data-tchmi-height-unit="px" data-tchmi-text="CANCEL" data-tchmi-text-font-size="18" data-tchmi-is-enabled="True" data-tchmi-zindex="2"><script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">[
