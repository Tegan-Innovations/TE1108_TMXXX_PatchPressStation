                        <div id="TcHmiHtmlHost_PatchSupportRetracted" data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost" data-tchmi-left="78" data-tchmi-left-unit="px" data-tchmi-top="35" data-tchmi-top-unit="px" data-tchmi-width="24" data-tchmi-width-unit="px" data-tchmi-height="24" data-tchmi-height-unit="px">
