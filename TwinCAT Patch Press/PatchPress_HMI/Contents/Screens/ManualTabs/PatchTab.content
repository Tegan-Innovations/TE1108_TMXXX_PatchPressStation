            <script data-tchmi-target-attribute="data-tchmi-border-width" type="application/json">{"left":5,"right":5,"top":5,"bottom":5,"leftUnit":"px","rightUnit":"px","topUnit":"px","bottomUnit":"px"}</script>
            <script data-tchmi-target-attribute="data-tchmi-border-radius" type="application/json">{"topLeft":50,"topRight":50,"bottomLeft":50,"bottomRight":50,"topLeftUnit":"px","topRightUnit":"px","bottomLeftUnit":"px","bottomRightUnit":"px"}</script>
            <script data-tchmi-target-attribute="data-tchmi-border-color" type="application/json">{"color":"rgba(74,74,74,1)"}</script>
        
<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%s%ADS.PLC1.GVL_HMI.stStatus.bPatchSupportRetracted%/s%",
    "actions": [
      {
        "objectType": "Condition",
        "active": true,
        "parts": [
          {
            "if": [
              {
                "compare1": {
                  "objectType": "Symbol",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "symbolExpression": "%s%ADS.PLC1.GVL_HMI.stStatus.bPatchSupportRetracted%/s%"
                },
                "compare2": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:general#/definitions/BOOL",
                  "value": true
                },
                "compareOperator": "==",
                "logic": null
              }
            ],
            "then": [
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctx%owner::BackgroundColor%/ctx%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:framework#/definitions/Color",
                  "value": {
                    "angle": 45.0,
                    "stopPoints": [
                      {
                        "color": "rgba(19, 113, 19, 1)",
                        "stop": "0%"
                      },
                      {
                        "color": "rgba(35, 195, 35, 1)",
                        "stop": "100%"
                      }
                    ]
                  }
                },
                "asyncWait": true
              }
            ]
          },
          {
            "else": [
              {
                "objectType": "WriteToSymbol",
                "active": true,
                "symbolExpression": "%ctx%owner::BackgroundColor%/ctx%",
                "value": {
                  "objectType": "StaticValue",
                  "valueType": "tchmi:framework#/definitions/Color",
                  "value": {
                    "color": "rgba(137, 137, 137, 1)"
                  }
                },
                "asyncWait": true
              }
            ]
          }
        ],
        "asyncWait": true
      }
    ]
  }
]
</script>
</div>
