<div id="VisionTab"
     data-tchmi-type="TcHmi.Controls.System.TcHmiContent"
     data-tchmi-top="0"
     data-tchmi-left="0"
     data-tchmi-width="1020"
     data-tchmi-height="395">

    <!-- ============================================================ -->
    <!-- VISION STATION ENABLE                                       -->
    <!-- ============================================================ -->

    <div id="VisionStationEnable"
         data-tchmi-type="TcHmi.Controls.System.TcHmiContainer"
         data-tchmi-left="5"
         data-tchmi-left-unit="px"
         data-tchmi-top="5"
         data-tchmi-top-unit="px"
         data-tchmi-width="155"
         data-tchmi-width-unit="px"
         data-tchmi-height="280"
         data-tchmi-height-unit="px">

        <div id="TcHmiRectangle_VisionEnable"
             data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiRectangle"
             data-tchmi-left="0"
             data-tchmi-left-unit="px"
             data-tchmi-top="12"
             data-tchmi-top-unit="px"
             data-tchmi-width="155"
             data-tchmi-width-unit="px"
             data-tchmi-height="268"
             data-tchmi-height-unit="px">

            <script data-tchmi-target-attribute="data-tchmi-border-width" type="application/json">
                {
                    "left": 1,
                    "right": 1,
                    "top": 1,
                    "bottom": 1,
                    "leftUnit": "px",
                    "rightUnit": "px",
                    "topUnit": "px",
                    "bottomUnit": "px"
                }
            </script>

            <script data-tchmi-target-attribute="data-tchmi-border-style" type="application/json">
                {
                    "left": "Solid",
                    "right": "Solid",
                    "top": "Solid",
                    "bottom": "Solid"
                }
            </script>
        </div>

        <div id="TcHmiTextblock_VisionEnableTitle"
             data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock"
             data-tchmi-left="2"
             data-tchmi-left-unit="px"
             data-tchmi-top="0"
             data-tchmi-top-unit="px"
             data-tchmi-width="150"
             data-tchmi-width-unit="px"
             data-tchmi-height="25"
             data-tchmi-height-unit="px"
             data-tchmi-text="Vision Station Enable"
             data-tchmi-text-font-size="17"
             data-tchmi-text-font-weight="Bold"
             data-tchmi-text-horizontal-alignment="Center"
             data-tchmi-zindex="5">

            <script data-tchmi-target-attribute="data-tchmi-background-color" type="application/json">
                {
                    "color": "rgba(255,255,255,1)"
                }
            </script>
        </div>


        <!-- Reserved for Vision Station image -->
        <div id="TcHmiTextblock_VisionStationImage"
             data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock"
             data-tchmi-left="15"
             data-tchmi-left-unit="px"
             data-tchmi-top="115"
             data-tchmi-top-unit="px"
             data-tchmi-width="125"
             data-tchmi-width-unit="px"
             data-tchmi-height="120"
             data-tchmi-height-unit="px"
             data-tchmi-text="Vision Station&#10;Image"
             data-tchmi-text-font-size="15"
             data-tchmi-text-horizontal-alignment="Center"
             data-tchmi-text-vertical-alignment="Center">
        </div>

        <div id="TcHmiCheckbox_VisionStationEnable" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiCheckbox" data-tchmi-height="40" data-tchmi-height-unit="px" data-tchmi-left="18" data-tchmi-left-unit="px" data-tchmi-text="Enable" data-tchmi-top="35" data-tchmi-top-unit="px" data-tchmi-width="120" data-tchmi-width-unit="px" data-tchmi-text-font-style="Normal" data-tchmi-text-font-size="20" data-tchmi-zindex="22" data-tchmi-text-horizontal-alignment="Center" data-tchmi-state-symbol="%s%ADS.PLC1.GVL_HMI.stCommands.bVisionManualEnable|BindingMode=TwoWay%/s%" data-tchmi-is-enabled="%s%ADS.PLC1.GVL_HMI.stStatus.bVisionManualEnableAllowed%/s%">
            <script data-tchmi-target-attribute="data-tchmi-border-style" type="application/json">
                {
                  "left": "Solid",
                  "right": "Solid",
                  "top": "Solid",
                  "bottom": "Solid"
                }
            </script>

            <script data-tchmi-target-attribute="data-tchmi-border-width" type="application/json">
                {
                  "left": 1,
                  "right": 1,
                  "top": 1,
                  "bottom": 1,
                  "leftUnit": "px",
                  "rightUnit": "px",
                  "topUnit": "px",
                  "bottomUnit": "px"
                }
            </script>

            <script data-tchmi-target-attribute="data-tchmi-border-color" type="application/json">
                {
                  "color": "rgba(168, 162, 162, 1)"
                }
            </script>
        </div>
    </div>


    <!-- ============================================================ -->
    <!-- FLIPPING CONTROL                                            -->
    <!-- ============================================================ -->

    <div id="FlippingControl"
         data-tchmi-type="TcHmi.Controls.System.TcHmiContainer"
         data-tchmi-left="170"
         data-tchmi-left-unit="px"
         data-tchmi-top="5"
         data-tchmi-top-unit="px"
         data-tchmi-width="455"
         data-tchmi-width-unit="px"
         data-tchmi-height="280"
         data-tchmi-height-unit="px">

        <div id="TcHmiRectangle_VisionFlipping"
             data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiRectangle"
             data-tchmi-left="0"
             data-tchmi-left-unit="px"
             data-tchmi-top="12"
             data-tchmi-top-unit="px"
             data-tchmi-width="455"
             data-tchmi-width-unit="px"
             data-tchmi-height="268"
             data-tchmi-height-unit="px">

            <script data-tchmi-target-attribute="data-tchmi-border-width" type="application/json">
                {
                    "left":1,"right":1,"top":1,"bottom":1,
                    "leftUnit":"px","rightUnit":"px",
                    "topUnit":"px","bottomUnit":"px"
                }
            </script>

            <script data-tchmi-target-attribute="data-tchmi-border-style" type="application/json">
                {
                    "left":"Solid","right":"Solid",
                    "top":"Solid","bottom":"Solid"
                }
            </script>
        </div>

        <div id="TcHmiTextblock_VisionFlippingTitle"
             data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock"
             data-tchmi-left="20"
             data-tchmi-left-unit="px"
             data-tchmi-top="0"
             data-tchmi-top-unit="px"
             data-tchmi-width="135"
             data-tchmi-width-unit="px"
             data-tchmi-height="25"
             data-tchmi-height-unit="px"
             data-tchmi-text="Flipping Control"
             data-tchmi-text-font-size="18"
             data-tchmi-text-font-weight="Bold"
             data-tchmi-text-horizontal-alignment="Center"
             data-tchmi-zindex="5">

            <script data-tchmi-target-attribute="data-tchmi-background-color" type="application/json">
                {"color":"rgba(255,255,255,1)"}
            </script>
        </div>


        <!-- ================= HORIZONTAL ================= -->

        <div id="HorizontalControl"
             data-tchmi-type="TcHmi.Controls.System.TcHmiContainer"
             data-tchmi-left="10"
             data-tchmi-left-unit="px"
             data-tchmi-top="35"
             data-tchmi-top-unit="px"
             data-tchmi-width="100"
             data-tchmi-width-unit="px"
             data-tchmi-height="225"
             data-tchmi-height-unit="px">

            <div id="TcHmiTextblock_VisionHorizontal"
                 data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock"
                 data-tchmi-left="0"
                 data-tchmi-top="0"
                 data-tchmi-width="100"
                 data-tchmi-height="25"
                 data-tchmi-text="Horizontal"
                 data-tchmi-text-font-size="16"
                 data-tchmi-text-font-weight="Bold"
                 data-tchmi-text-horizontal-alignment="Center">
            </div>

            <div id="TcHmiHtmlHost_VisionHorizontalBack"
                 data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost"
                 data-tchmi-height="25"
                 data-tchmi-height-unit="px"
                 data-tchmi-left="4"
                 data-tchmi-left-unit="px"
                 data-tchmi-top="28"
                 data-tchmi-top-unit="px"
                 data-tchmi-width="25"
                 data-tchmi-width-unit="px">
                <script data-tchmi-target-attribute="data-tchmi-border-style" type="application/json">
                    { "left":"Solid","right":"Solid","top":"Solid","bottom":"Solid" }
                </script>
                <script data-tchmi-target-attribute="data-tchmi-border-width" type="application/json">
                    { "left":5,"right":5,"top":5,"bottom":5,"leftUnit":"px","rightUnit":"px","topUnit":"px","bottomUnit":"px" }
                </script>
                <script data-tchmi-target-attribute="data-tchmi-border-radius" type="application/json">
                    { "topLeft":50.0,"topRight":50.0,"bottomLeft":50.0,"bottomRight":50.0,"topLeftUnit":"px","topRightUnit":"px","bottomLeftUnit":"px","bottomRightUnit":"px" }
                </script>

                <script data-tchmi-target-attribute="data-tchmi-border-color" type="application/json">
                    { "color":"rgba(74, 74, 74, 1)" }
                </script>

                <script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
                    [
                      {
                        "event": "%s%ADS.PLC1.GVL_HMI.stStatus.bVisionHorizontalBack%/s%",
                        "actions": [
                          {
                            "objectType": "Condition",
                            "active": true,
                            "parts": [
                              {
                                "if": [
                                  {
                                    "compare1": {
                                      "objectType": "Symbol",
                                      "valueType": "tchmi:general#/definitions/BOOL",
                                      "symbolExpression": "%s%ADS.PLC1.GVL_HMI.stStatus.bVisionHorizontalBack%/s%"
                                    },
                                    "compare2": {
                                      "objectType": "StaticValue",
                                      "valueType": "tchmi:general#/definitions/BOOL",
                                      "value": true
                                    },
                                    "compareOperator": "==",
                                    "logic": null
                                  }
                                ],
                                "then": [
                                  {
                                    "objectType": "WriteToSymbol",
                                    "active": true,
                                    "symbolExpression": "%ctx%owner::BackgroundColor%/ctx%",
                                    "value": {
                                      "objectType": "StaticValue",
                                      "valueType": "tchmi:framework#/definitions/Color",
                                      "value": {
                                        "angle": 45.0,
                                        "stopPoints": [
                                          {
                                            "color": "rgba(19, 113, 19, 1)",
                                            "stop": "0%"
                                          },
                                          {
                                            "color": "rgba(35, 195, 35, 1)",
                                            "stop": "100%"
                                          }
                                        ]
                                      }
                                    },
                                    "asyncWait": true
                                  }
                                ]
                              },
                              {
                                "else": [
                                  {
                                    "objectType": "WriteToSymbol",
                                    "active": true,
                                    "symbolExpression": "%ctx%owner::BackgroundColor%/ctx%",
                                    "value": {
                                      "objectType": "StaticValue",
                                      "valueType": "tchmi:framework#/definitions/Color",
                                      "value": {
                                        "color": "rgba(137, 137, 137, 1)"
                                      }
                                    },
                                    "asyncWait": true
                                  }
                                ]
                              }
                            ],
                            "asyncWait": true
                          }
                        ]
                      }
                    ]
                </script>
            </div>

            <div id="TcHmiTextblock_VisionHorizontalBackFeedback"
                 data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock"
                 data-tchmi-left="30"
                 data-tchmi-top="29"
                 data-tchmi-width="60"
                 data-tchmi-height="24"
                 data-tchmi-text="Back"
                 data-tchmi-text-font-size="14" data-tchmi-text-vertical-alignment="Top" data-tchmi-text-horizontal-alignment="Center">
            </div>

            <div id="TcHmiHtmlHost_VisionHorizontalFront"
                 data-tchmi-type="TcHmi.Controls.System.TcHmiHtmlHost"
                 data-tchmi-height="25"
                 data-tchmi-height-unit="px"
                 data-tchmi-left="4"
                 data-tchmi-left-unit="px"
                 data-tchmi-top="54"
                 data-tchmi-top-unit="px"
                 data-tchmi-width="25"
                 data-tchmi-width-unit="px">
                <script data-tchmi-target-attribute="data-tchmi-border-style" type="application/json">
                    { "left":"Solid","right":"Solid","top":"Solid","bottom":"Solid" }
                </script>
                <script data-tchmi-target-attribute="data-tchmi-border-width" type="application/json">
