                </script>
                <script data-tchmi-target-attribute="data-tchmi-border-radius" type="application/json">
                    { "topLeft":50.0,"topRight":50.0,"bottomLeft":50.0,"bottomRight":50.0,"topLeftUnit":"px","topRightUnit":"px","bottomLeftUnit":"px","bottomRightUnit":"px" }
                </script>

                <script data-tchmi-target-attribute="data-tchmi-border-color" type="application/json">
                    { "color":"rgba(74, 74, 74, 1)" }
                </script>

                <script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
                    [
                      {
                        "event": "%s%ADS.PLC1.GVL_HMI.stStatus.bVisionHorizontalFront%/s%",
                        "actions": [
                          {
                            "objectType": "Condition",
                            "active": true,
                            "parts": [
                              {
                                "if": [
                                  {
                                    "compare1": {
                                      "objectType": "Symbol",
                                      "valueType": "tchmi:general#/definitions/BOOL",
                                      "symbolExpression": "%s%ADS.PLC1.GVL_HMI.stStatus.bVisionHorizontalFront%/s%"
                                    },
                                    "compare2": {
                                      "objectType": "StaticValue",
                                      "valueType": "tchmi:general#/definitions/BOOL",
                                      "value": true
                                    },
                                    "compareOperator": "==",
                                    "logic": null
                                  }
                                ],
                                "then": [
                                  {
                                    "objectType": "WriteToSymbol",
                                    "active": true,
                                    "symbolExpression": "%ctx%owner::BackgroundColor%/ctx%",
                                    "value": {
                                      "objectType": "StaticValue",
                                      "valueType": "tchmi:framework#/definitions/Color",
                                      "value": {
                                        "angle": 45.0,
                                        "stopPoints": [
                                          { "color": "rgba(19, 113, 19, 1)", "stop": "0%" },
                                          { "color": "rgba(35, 195, 35, 1)", "stop": "100%" }
                                        ]
                                      }
                                    },
                                    "asyncWait": true
                                  }
                                ]
                              },
                              {
                                "else": [
                                  {
                                    "objectType": "WriteToSymbol",
                                    "active": true,
                                    "symbolExpression": "%ctx%owner::BackgroundColor%/ctx%",
                                    "value": {
                                      "objectType": "StaticValue",
                                      "valueType": "tchmi:framework#/definitions/Color",
                                      "value": { "color": "rgba(137, 137, 137, 1)" }
                                    },
                                    "asyncWait": true
                                  }
                                ]
                              }
                            ],
                            "asyncWait": true
                          }
                        ]
                      }
                    ]
                </script>
            </div>

            <div id="TcHmiTextblock_VisionHorizontalFrontFeedback"
                 data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock"
                 data-tchmi-left="30"
                 data-tchmi-top="55"
                 data-tchmi-width="60"
                 data-tchmi-height="24"
                 data-tchmi-text="Front"
                 data-tchmi-text-font-size="14" data-tchmi-text-vertical-alignment="Top" data-tchmi-text-horizontal-alignment="Center">
            </div>

            <div id="TcHmiButton_VisionHorizontalBack"
                 data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton"
                 data-tchmi-left="10"
                 data-tchmi-top="106"
                 data-tchmi-width="80"
                 data-tchmi-height="45"
                 data-tchmi-text="Back"
                 data-tchmi-text-font-size="16"
                 data-tchmi-is-enabled="%s%ADS.PLC1.GVL_HMI.stStatus.bVisionHorizontalBackAllowed%/s%" data-tchmi-state-symbol="%s%ADS.PLC1.GVL_HMI.stCommands.bVisionHorizontalBackRequest|BindingMode=TwoWay%/s%">

                <script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
                    [
                      {
                        "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onPressed",
                        "actions": [
                          {
                            "objectType": "WriteToSymbol",
                            "active": true,
                            "symbolExpression": "%s%ADS.PLC1.GVL_HMI.stCommands.bVisionHorizontalBackRequest%/s%",
                            "value": {
                              "objectType": "StaticValue",
                              "valueType": "tchmi:general#/definitions/BOOL",
                              "value": true
                            },
                            "asyncWait": true
                          }
                        ]
                      },
                      {
                        "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onReleased",
                        "actions": [
                          {
                            "objectType": "WriteToSymbol",
                            "active": true,
                            "symbolExpression": "%s%ADS.PLC1.GVL_HMI.stCommands.bVisionHorizontalBackRequest%/s%",
                            "value": {
                              "objectType": "StaticValue",
                              "valueType": "tchmi:general#/definitions/BOOL",
                              "value": false
                            },
                            "asyncWait": true
                          }
                        ]
                      }
                    ]
                </script>
            </div>

            <div id="TcHmiButton_VisionHorizontalFront"
                 data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton"
                 data-tchmi-left="10"
                 data-tchmi-top="160"
                 data-tchmi-width="80"
                 data-tchmi-height="45"
                 data-tchmi-text="Front"
                 data-tchmi-text-font-size="16"
                 data-tchmi-is-enabled="%s%ADS.PLC1.GVL_HMI.stStatus.bVisionHorizontalFrontAllowed%/s%" data-tchmi-state-symbol="%s%ADS.PLC1.GVL_HMI.stCommands.bVisionHorizontalFrontRequest|BindingMode=TwoWay%/s%">

                <script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
                    [
                      {
                        "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onPressed",
                        "actions": [
                          {
                            "objectType": "WriteToSymbol",
                            "active": true,
                            "symbolExpression": "%s%ADS.PLC1.GVL_HMI.stCommands.bVisionHorizontalFrontRequest%/s%",
                            "value": {
                              "objectType": "StaticValue",
                              "valueType": "tchmi:general#/definitions/BOOL",
                              "value": true
                            },
                            "asyncWait": true
                          }
                        ]
                      },
                      {
                        "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onReleased",
                        "actions": [
                          {
                            "objectType": "WriteToSymbol",
                            "active": true,
                            "symbolExpression": "%s%ADS.PLC1.GVL_HMI.stCommands.bVisionHorizontalFrontRequest%/s%",
                            "value": {
                              "objectType": "StaticValue",
                              "valueType": "tchmi:general#/definitions/BOOL",
                              "value": false
                            },
                            "asyncWait": true
                          }
                        ]
                      }
                    ]
                </script>
            </div>

        </div>


        <!-- ================= VERTICAL ================= -->

        <div id="VerticalControl"
