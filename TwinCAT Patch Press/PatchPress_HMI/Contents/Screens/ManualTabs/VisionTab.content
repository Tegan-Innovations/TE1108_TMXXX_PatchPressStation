                    { "color":"rgba(74, 74, 74, 1)" }
                </script>

                <script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
                    [
                      {
                        "event": "%s%ADS.PLC1.GVL_HMI.stStatus.bVisionRotate0%/s%",
                        "actions": [
                          {
                            "objectType": "Condition",
                            "active": true,
                            "parts": [
                              {
                                "if": [
                                  {
                                    "compare1": {
                                      "objectType": "Symbol",
                                      "valueType": "tchmi:general#/definitions/BOOL",
                                      "symbolExpression": "%s%ADS.PLC1.GVL_HMI.stStatus.bVisionRotate0%/s%"
                                    },
                                    "compare2": {
                                      "objectType": "StaticValue",
                                      "valueType": "tchmi:general#/definitions/BOOL",
                                      "value": true
                                    },
                                    "compareOperator": "==",
                                    "logic": null
                                  }
                                ],
                                "then": [
                                  {
                                    "objectType": "WriteToSymbol",
                                    "active": true,
                                    "symbolExpression": "%ctx%owner::BackgroundColor%/ctx%",
                                    "value": {
                                      "objectType": "StaticValue",
                                      "valueType": "tchmi:framework#/definitions/Color",
                                      "value": {
                                        "angle": 45.0,
                                        "stopPoints": [
                                          { "color": "rgba(19, 113, 19, 1)", "stop": "0%" },
                                          { "color": "rgba(35, 195, 35, 1)", "stop": "100%" }
                                        ]
                                      }
                                    },
                                    "asyncWait": true
                                  }
                                ]
                              },
                              {
                                "else": [
                                  {
                                    "objectType": "WriteToSymbol",
                                    "active": true,
                                    "symbolExpression": "%ctx%owner::BackgroundColor%/ctx%",
                                    "value": {
                                      "objectType": "StaticValue",
                                      "valueType": "tchmi:framework#/definitions/Color",
                                      "value": { "color": "rgba(137, 137, 137, 1)" }
                                    },
                                    "asyncWait": true
                                  }
                                ]
                              }
                            ],
                            "asyncWait": true
                          }
                        ]
                      }
                    ]
                </script>
            </div>

