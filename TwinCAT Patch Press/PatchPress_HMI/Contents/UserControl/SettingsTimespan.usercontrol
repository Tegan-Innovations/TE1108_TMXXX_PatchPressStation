<div id="SettingsTimespan" data-tchmi-type="TcHmi.Controls.System.TcHmiUserControl" data-tchmi-left="0" data-tchmi-top="0" data-tchmi-width="100" data-tchmi-width-unit="%" data-tchmi-height="100" data-tchmi-height-unit="%" data-tchmi-creator-viewport-width="115" data-tchmi-creator-viewport-height="26">
<div id="SettingsTimeDisplay" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTextblock" data-tchmi-left="0" data-tchmi-top="0" data-tchmi-right="26" data-tchmi-height="100" data-tchmi-height-unit="%" data-tchmi-text="%pp%Value%/pp%" data-tchmi-text-font-size="16" data-tchmi-text-horizontal-alignment="Left" data-tchmi-text-vertical-alignment="Center">
<script data-tchmi-target-attribute="data-tchmi-background-color" type="application/json">
{
  "color": "rgba(255,255,255,1)"
}
</script>
<script data-tchmi-target-attribute="data-tchmi-content-padding" type="application/json">
{
  "left": 3,
  "right": 3,
  "top": 0,
  "bottom": 0
}
</script>
<script data-tchmi-target-attribute="data-tchmi-border-width" type="application/json">
{
  "left": 1,
  "right": 1,
  "top": 1,
  "bottom": 1,
  "leftUnit": "px",
  "rightUnit": "px",
  "topUnit": "px",
  "bottomUnit": "px"
}
</script>
<script data-tchmi-target-attribute="data-tchmi-border-style" type="application/json">
{
  "left": "Solid",
  "right": "Solid",
  "top": "Solid",
  "bottom": "Solid"
}
</script>
<script data-tchmi-target-attribute="data-tchmi-border-color" type="application/json">
{
  "color": "rgba(180,180,180,1)"
}
</script>
</div>
<div id="SettingsTimeOpen" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiButton" data-tchmi-right="0" data-tchmi-top="0" data-tchmi-width="26" data-tchmi-height="100" data-tchmi-height-unit="%" data-tchmi-text="" data-tchmi-background-image="Images/SettingsTimePicker.svg" data-tchmi-background-image-horizontal-alignment="Center" data-tchmi-background-image-vertical-alignment="Center">
<script data-tchmi-target-attribute="data-tchmi-background-color" type="application/json">
{
  "color": "rgba(0,120,215,1)"
}
</script>
<script data-tchmi-target-attribute="data-tchmi-access-config" type="application/json">
"%pp%EditorAccess%/pp%"
</script>
<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onPressed",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%ctrl%SettingsTimeDraft::Value%/ctrl%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/TimeSpan",
          "symbolExpression": "%pp%Value%/pp%"
        },
        "asyncWait": true
      },
      {
        "objectType": "ControlApiFunction",
        "active": true,
        "control": "SettingsTimeDraft",
        "fn": "openTimespanPicker",
        "asyncWait": true
      }
    ]
  }
]
</script>
</div>
<div id="SettingsTimeDraft" data-tchmi-type="TcHmi.Controls.Beckhoff.TcHmiTimespanPicker" data-tchmi-left="0" data-tchmi-top="0" data-tchmi-width="0" data-tchmi-height="0" data-tchmi-direct-display="False" data-tchmi-show-confirmation-buttons="True" data-tchmi-min-value="%pp%MinValue%/pp%" data-tchmi-max-value="%pp%MaxValue%/pp%" data-tchmi-reset-to-last-valid-value="True">
<script data-tchmi-target-attribute="data-tchmi-access-config" type="application/json">
"%pp%EditorAccess%/pp%"
</script>
<script data-tchmi-target-attribute="data-tchmi-trigger" type="application/json">
[
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onConfirmed",
    "actions": [
      {
        "objectType": "WriteToSymbol",
        "active": true,
        "symbolExpression": "%pp%Value%/pp%",
        "value": {
          "objectType": "Symbol",
          "valueType": "tchmi:general#/definitions/TimeSpan",
          "symbolExpression": "%ctx%owner::Value%/ctx%"
        },
        "asyncWait": true
      }
    ]
  },
  {
    "event": "%ctx%owner::Id|EventRegistrationMode=Resolve%/ctx%.onDetached",
    "actions": [
      {
        "objectType": "ControlApiFunction",
        "active": true,
        "control": "SettingsTimeDraft",
        "fn": "closeTimespanPicker",
        "asyncWait": true
      }
    ]
  }
]
</script>
</div>
</div>
